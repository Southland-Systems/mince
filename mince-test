        cases = [
            ("shell", [commands], [
                {"output": {"commands": commands}}, {"output": ended},
            ], "y\n"),
            ("agent", [commands, extra], [
                MockResponsesAPI.tool_response(
                    ("shell", {"commands": commands}), ("shell", {"commands": extra}),
                ),
                MockResponsesAPI.tool_response(("session", {
                    "action": "end", "reason": "Traced agent work inspected",
                })),
            ], None),
        ]
        for mode, command_groups, responses, review_input in cases:
            capture = self.work / f"{mode}-trace-invocations.jsonl"
            with MockResponsesAPI(responses) as mock:
                result = self.run(
                    "--task", "Inspect offline shell tracing.", f"--{mode}",
                    "--shell-trace", "--shell-networking", "on",
                    "--model", "offline-test-model", "--base-url", mock.url,
                    "--log", "off", input_text=review_input,
                    environment_updates={
                        "PATH": self.test_path, "MINCE_TEST_STRACE_CAPTURE": str(capture),
