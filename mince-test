                    "action": "session_end",
                    "commands": [],
                    "reason": "First shell session completed",
                }
            },
            {
                "output": {
                    "commands": [
                        {
                            "command": "printf second-shell",
                            "reason": "Produce the reused shell output",
                        }
                    ]
                }
            },
            {
                "output": {
                    "action": "session_end",
                    "commands": [],
                    "reason": "Reused shell session completed",
                }
            },
        ]
        with MockResponsesAPI(responses) as mock:
            first = self.run(
                "--task",
                "Run the first offline shell session.",
                "--shell",
                "--noninteractive",
                "--model",
                "offline-test-model",
                "--base-url",
                mock.url,
                "--log",
                "off",
                "--no-api-log",
            )
            session_name = re_search(
                r"state_session_name=(\S+)",
                first.stdout,
            )
            require(session_name is not None, "initial shell session name was not printed")
            second = self.run(
                "--task",
                "Run the reused offline shell session.",
                "--shell",
                "--shell-confirm",
                "--reuse-session",
                session_name,
                "--noninteractive",
                "--model",
                "offline-test-model",
                "--base-url",
                mock.url,
                "--log",
                "off",
                "--no-api-log",
            )
        require(
            "Reused shell session completed" in second.stdout,
            "reused shell session did not finish",
        )
        require(len(mock.requests) == 4, "expected two requests per shell session")
        reused_input = str(mock.requests[2].get("input", ""))
        require(
            "<previous_turn>" in reused_input
            and "First shell session completed" in reused_input,
            "completed shell history was not included in the reused request",
        )
        state = self.run(
            "--state-print-json",
            session_name,
            "2",
            "response_shell_output",
        )
        require(
            "second-shell" in state.stdout,
            "reused shell output was not saved in state",
        )

    def test_patch_branch_merge_and_remove(self) -> None:
        repo = self.work / "patch-branch-management-repo"
        repo.mkdir()
        target = repo / "target.txt"
        target.write_text("base\n", encoding="utf-8")

        def git(*arguments: str) -> str:
            completed = subprocess.run(
                ["git", *arguments],
                cwd=repo,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
            )
            require(
                completed.returncode == 0,
                f"git {arguments!r} failed: {completed.stderr}",
            )
            return completed.stdout.strip()

        git("init")
        git("config", "user.email", "offline@example.test")
        git("config", "user.name", "Offline Test")
        git("add", "target.txt")
        git("commit", "-m", "Initial branch management fixture")
        git("branch", "-M", "main")
        git("switch", "--create", "mcefeature")
        target.write_text("merged\n", encoding="utf-8")
        git("add", "target.txt")
        git("commit", "-m", "Feature branch fixture")
        git("switch", "main")

        self.run(
            "--patch-merge",
            "Merge offline branch fixture",
            "--patch-branch",
            "feature",
            cwd=repo,
        )
        require(
            target.read_text(encoding="utf-8") == "merged\n",
            "patch branch merge did not update the target",
        )
        require(
            git("branch", "--list", "mcefeature") == "",
            "merged patch branch was not deleted",
        )

        git("switch", "--create", "mceorphan")
        git("switch", "main")
        self.run(
            "--patch-branch-remove",
            "orphan",
            cwd=repo,
        )
        require(
            git("branch", "--list", "mceorphan") == "",
            "patch branch removal did not delete the branch",
        )

    def close(self) -> None:
        self._temporary_directory.cleanup()


def re_search(pattern: str, text: str) -> str | None:
    import re

    match = re.search(pattern, text)
    return match.group(1) if match else None


