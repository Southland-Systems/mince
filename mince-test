    def test_resume_session_chain_and_turn_cutoff(self) -> None:
        target = self.work / "resume-chain-context.txt"
        target.write_text("Chained resume context\n", encoding="utf-8")
        original_task = "Preserve the original task in the resumed chain."
        updated_task = "Use the task from the newer branch."
        responses = [
            "Initial chain answer",
            "Updated chain answer",
            "Continued chain answer",
            "Forked chain answer",
        ]
        with MockResponsesAPI(responses) as mock:
            common = (
                "--model", "offline-test-model", "--base-url", mock.url,
                "--log", "off", "--no-api-log",
            )
            initial = self.run(
                "--task", original_task, "--files", target, *common,
            )
            initial_name = session_name_from_result(initial, noninteractive=False)
            initial_snapshot = self.state_snapshot(initial_name)
            updated = self.run(
                "--task", updated_task, "--resume-session", initial_name, *common,
            )
            updated_name = self.resumed_session_name(
                updated, initial_name, 0, noninteractive=False,
            )
            updated_snapshot = self.state_snapshot(updated_name)
            continued = self.run("--resume-session", updated_name, *common)
            continued_name = self.resumed_session_name(
                continued, updated_name, 1, noninteractive=False,
            )
            continued_snapshot = self.state_snapshot(continued_name)
            forked = self.run("--resume-session", continued_name, "0", *common)
        forked_name = self.resumed_session_name(
            forked, continued_name, 0, noninteractive=False,
        )
        require(
            len(mock.requests) == 4
            and len({initial_name, updated_name, continued_name, forked_name}) == 4,
            "chained resumes reused session names or made unexpected API requests",
        )
        for request, task in zip(
            mock.requests, (original_task, updated_task, updated_task, original_task),
        ):
            prompt = request_prompt(request)
            require(
                str(request["instructions"]).startswith(task + "\n")
                and task not in prompt
                and "1 Chained resume context" in prompt_section(prompt, "files"),
                "chained resume recovered the wrong selected task or lost inherited file context",
            )
        require(
            [self.state_turn_numbers(name) for name in (
                initial_name, updated_name, continued_name, forked_name,
            )] == [[0], [1], [2], [1]],
            "chained resume numbered local turns using hidden future history",
        )
        for name, snapshot in (
            (initial_name, initial_snapshot),
            (updated_name, updated_snapshot),
            (continued_name, continued_snapshot),
        ):
            require(
                self.state_snapshot(name) == snapshot,
                "chained resume modified an ancestor session",
            )
        for turn, task, response in (
            (0, original_task, responses[0]),
            (1, updated_task, responses[1]),
            (2, updated_task, responses[2]),
        ):
            require(
                self.state_artifacts(continued_name, turn, "request_task", "response")
                == {"request_task": task, "response": response},
                "state printing did not follow the resumed session chain",
            )
        require(
            self.state_artifacts(forked_name, "0", "request_task", "response")
            == {"request_task": original_task, "response": responses[0]}
            and self.state_artifacts(forked_name, "1", "request_task", "response")
            == {"request_task": original_task, "response": responses[3]},
            "forking at an inherited turn exposed the wrong ancestor or local response",
        )
        hidden = self.run(
            "--state-print-json", forked_name, "2", "response", check=False,
        )
        require(
            hidden.returncode != 0 and "has no turn 2" in hidden.stderr,
            "state printing exposed an ancestor turn beyond the selected resume cutoff",
        )

