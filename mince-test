def re_search(pattern: str, text: str) -> str | None:
    match = re.search(pattern, text)
    return match.group(1) if match else None


def request_prompt(request: dict[str, Any]) -> str:
    input_value = request.get("input")
    if isinstance(input_value, str):
        return input_value
    require(isinstance(input_value, list), "request input was not text or an item array")
    messages = [
        item for item in input_value
        if isinstance(item, dict) and item.get("role") == "user"
    ]
    require(len(messages) == 1, "request did not contain exactly one user message")
    content = messages[0].get("content")
    if isinstance(content, list):
        text_parts = [
            part for part in content
            if isinstance(part, dict) and part.get("type") == "input_text"
        ]
        require(
            len(text_parts) == 1 and isinstance(text_parts[0].get("text"), str),
            "multimodal request did not contain exactly one user text part",
        )
        return str(text_parts[0]["text"])
    require(isinstance(content, str), "request user content was not text or a content array")
    return str(content)


def request_instructions(request: dict[str, Any]) -> str:
    instructions = request.get("instructions")
    require(isinstance(instructions, str), "request instructions were not text")
    return str(instructions)


def request_file_contexts(request: dict[str, Any]) -> dict[str, str]:
    files = prompt_section(request_prompt(request), "files")
    sections = re.findall(r"(?ms)^<file(?:\s[^>]*)?>\n.*?^</file>", files)
    contexts: dict[str, str] = {}
    for section in sections:
        path = prompt_attributes(section, "file").get("path", "")
        require(bool(path) and path not in contexts, "file context omitted a path or duplicated it")
        contexts[path] = section
    return contexts


def request_history_turns(request: dict[str, Any]) -> dict[int, str]:
    history = prompt_section(request_prompt(request), "agent_history")
    sections = re.findall(r"(?ms)^<agent_turn(?:\s[^>]*)?>\n.*?^</agent_turn>", history)
    turns: dict[int, str] = {}
    for section in sections:
        identifier = prompt_attributes(section, "agent_turn").get("ID", "")
        require(
            identifier.isascii() and identifier.isdigit() and int(identifier) not in turns,
            "agent history omitted a non-negative entry ID or duplicated it",
        )
        turns[int(identifier)] = section
    return turns


def require_task_placement(
    request: dict[str, Any],
    task: str,
) -> None:
    instructions = request_instructions(request)
    prompt = request_prompt(request)
    require(
        prompt_section(instructions, "user_supplied_instructions") == task.strip()
        and instructions.count("<user_supplied_instructions>\n") == 1
        and "<user_supplied_instructions>\n" not in prompt
        and prompt_attributes(instructions, "user_supplied_instructions") == {},
        "task instructions were misplaced, duplicated, or given context metadata",
    )


def require_summary_request(request: dict[str, Any]) -> None:
    tools = request.get("tools", [])
    instructions = request_instructions(request)
    require(
        len(tools) == 1 and tools[0].get("name") == "context_summary"
        and tools[0].get("strict") is True
        and set(tools[0]["parameters"]["properties"]) == {"summary"}
        and tools[0]["parameters"]["required"] == ["summary"]
        and request.get("tool_choice") == "required"
        and request.get("parallel_tool_calls") is False
        and request["text"]["format"] == {"type": "text"}
        and "Ignore the controller's `<system>` section"
        in prompt_section(instructions, "core_system_instructions")
        and "<user_supplied_instructions>\n" not in instructions
        and "<tool_call_instructions>\n" not in instructions
        and "<agent_instructions" not in request_prompt(request),
        "context summary request omitted its single native tool or reused serialized controller instructions",
    )


def require_state_request(
    artifacts: dict[str, str],
    request: dict[str, Any],
) -> None:
    system_prompt = request_instructions(request)
    user_prompt = request_prompt(request)
    sections = [
        f"<system>\n{system_prompt}\n</system>",
        f"<user>\n{user_prompt}\n</user>",
    ]
    if request.get("tools"):
        sections.append(
            f"<tools>\n{json.dumps(request['tools'], indent=2, ensure_ascii=False)}\n</tools>"
        )
    require(
        artifacts.get("request_system_prompt") == system_prompt
        and artifacts.get("request") == "\n\n".join(sections),
        "state request did not preserve the exact tagged system, user, and tool context",
    )


def require_failed_state_turn(
    artifacts: dict[str, str],
    diagnostic: str,
) -> None:
    error = artifacts.get("response_error", "")
    require(
        error.startswith("ERROR: ") and diagnostic in error
        and "response" not in artifacts
        and ".response" not in artifacts
        and "response_reasoning_encrypted_content" not in artifacts,
        f"failed state turn was marked complete or omitted its response error: {diagnostic}",
    )


def require_cumulative_stats(
    result: subprocess.CompletedProcess[str],
    usage: dict[str, int],
    response_cost: str | None = None,
) -> str:
    lines = [
        line for line in result.stderr.splitlines()
        if line.startswith("total_processing_time=")
    ]
    require(len(lines) == 1, "cumulative statistics were not emitted exactly once")
    fields: dict[str, str] = {}
    for field in lines[0].split():
        name, separator, value = field.partition("=")
        require(
            bool(separator) and bool(name) and name not in fields,
            "cumulative statistics contained an invalid or duplicate field",
        )
        fields[name] = value
    processing_time = fields.pop("total_processing_time", "")
    expected = {f"total_response_{key}": str(value) for key, value in usage.items()}
    if response_cost is not None:
        expected["total_response_cost"] = response_cost
    require(
        re.fullmatch(r"\d+s", processing_time) is not None and fields == expected,
        f"cumulative processing time, usage, or cost was incorrect: {lines[0]}",
    )
    return lines[0]


def prompt_attributes(prompt: str, tag: str) -> dict[str, str]:
    header = re_search(rf"(?m)^<{re.escape(tag)}((?:\s[^>]*)?)>", prompt)
    require(header is not None, f"request prompt omitted <{tag}> metadata")
    attributes: dict[str, str] = {}
    for field in shlex.split(str(header)):
        name, _, value = field.partition("=")
        require(bool(name) and name not in attributes, f"invalid or duplicate <{tag}> attribute")
        attributes[name] = value
    return attributes


def context_token_count(prompt: str, tag: str) -> int:
    value = prompt_attributes(prompt, tag).get("token_count", "")
    require(
        value.isascii() and value.isdigit(),
        f"<{tag}> omitted a non-negative token count",
    )
    return int(value)


def shell_output_artifacts(artifacts: dict[str, str]) -> dict[str, str]:
    return {
        name: content for name, content in artifacts.items()
        if name == "response_shell_output" or name.startswith("response_shell_output_")
    }


def prompt_section(prompt: str, tag: str) -> str:
    section = re_search(
        rf"(?s)<{re.escape(tag)}(?:\s[^>]*)?>\n(.*?)\n</{re.escape(tag)}>",
        prompt,
    )
    require(section is not None, f"request prompt omitted <{tag}>")
    return str(section)


def contained_arguments(command: list[str]) -> list[str]:
    require("--" in command, "systemd-run command omitted its argument separator")
    return command[command.index("--") + 1:]


def systemd_properties(command: list[str]) -> dict[str, str]:
    require("--" in command, "systemd-run command omitted its argument separator")
    properties: dict[str, str] = {}
    for argument in command[:command.index("--")]:
        if not argument.startswith("--property="):
            continue
        name, separator, value = argument[len("--property="):].partition("=")
        require(
            bool(separator) and bool(name) and name not in properties,
            f"invalid or duplicate systemd property: {argument}",
        )
        properties[name] = value
    return properties


def session_name_from_result(
    result: subprocess.CompletedProcess[str],
    *,
    noninteractive: bool,
 ) -> str:
    if noninteractive:
        lines = result.stdout.rstrip().splitlines()
        session_name = re_search(r"^([^=\s]+)$", lines[-1]) if lines else None
    else:
        session_name = re_search(
            r"(?m)^session_name=(\S+)$",
            result.stderr,
        )
    expected_output = (
        "a plain session name"
        if noninteractive
        else "session_name=SESSION"
    )
    require(
        session_name is not None,
        f"{expected_output} was not printed",
    )
    return str(session_name)


