             {"content_line_array": ["bad\nline"]}, "line endings"),
            ("nonstring-content", b"one\ntwo\n", "lf",
             {"content_line_array": [1]}, "array of strings"),
            ("wrong-eol", b"one\r\ntwo\r\n", "lf", {}, "does not match"),
            ("mixed-eol", b"one\r\ntwo\n", "lf", {}, "mixed line endings"),
            ("empty-range", b"", "lf", {"start_line": 2, "end_line": 2}, "line 1"),
        ]
        for name, source, line_ending, updates, diagnostic in cases:
            target = self.work / f"invalid-{name}.txt"
            target.write_bytes(source)
