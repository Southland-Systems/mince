            MockResponsesAPI.tool_response(
                ("load_file_from_storage", {
                    "paths": [str(missing), str(small), str(large), str(deferred)],
                    "expires_in_turns": 4,
                }),
                ("shell", {"commands": [{
                    "command": f"printf 'Now bounded context\\n' > {shlex.quote(str(large))}",
                    "reason": "Reduce the fixture before an explicit reload",
                }]}),
            ),
            MockResponsesAPI.tool_response(("agent", {
                "task": task, "context": "", "reason": "Advance independent file-error expiry",
            })),
            MockResponsesAPI.tool_response(("load_file_from_storage", {
                "paths": [str(large), str(deferred)], "expires_in_turns": 4,
            })),
            MockResponsesAPI.tool_response(("session", {
                "action": "end", "reason": "Bounded file context checked",
            })),
        ]
        with MockResponsesAPI(responses) as mock:
            result = self.run(
                "--task", task, "--agent", "--no-line-numbers",
                "--agent-context-expires", "3", "1", "4", "--token-limit", "65534",
                "--model", "offline-test-model", "--base-url", mock.url, "--log", "off",
            )
        require(len(mock.requests) == 4, "unexpected bounded-file request count")
        session_name = session_name_from_result(result, noninteractive=False)
        artifacts = self.state_artifacts(session_name, "0", "response_agent_file_contexts")
        entries = json.loads(artifacts["response_agent_file_contexts"])
        contexts = {entry["path"]: entry["section"] for entry in entries}
        require(
            len(entries) == 4 and set(contexts) == {str(missing), str(small), str(large), str(deferred)},
            "bounded file loading lost a requested path or duplicated its context",
        )
        for path, total_lines in ((large, "1"), (deferred, "0")):
            attributes = prompt_attributes(contexts[str(path)], "file")
            require(
                attributes["error"] == "TOKEN LIMIT EXCEEDED: file could not be loaded"
                and attributes["total_lines"] == total_lines
                and attributes["expires_in_turns"] == "1"
                and context_token_count(contexts[str(path)], "file") == 0
                and contexts[str(path)].split("\n", 1)[1] == "</file>",
                "file-budget exhaustion read a later path or lost bounded-error metadata and minimum expiry",
            )
        missing_attributes = prompt_attributes(contexts[str(missing)], "file")
        require(
            missing_attributes["error"] == f"MISSING FILE: {missing}"
            and missing_attributes["expires_in_turns"] == "1"
            and "1 Usable loaded context" in contexts[str(small)],
            "file loading lost missing-file diagnostics or earlier usable numbered content",
        )
        first_files = request_file_contexts(mock.requests[1])
        expired_files = request_file_contexts(mock.requests[2])
        final_files = request_file_contexts(mock.requests[3])
        require(
            set(first_files) == set(contexts)
            and set(expired_files) == {str(small)}
            and set(final_files) == {str(small), str(large), str(deferred)}
            and all(
                prompt_attributes(first_files[str(path)], "file")["expires_in_turns"] == "0"
                for path in (missing, large, deferred)
            )
            and "TOKEN LIMIT EXCEEDED: file could not be loaded"
            in prompt_attributes(first_files[str(large)], "file")["error"]
            and "1 Now bounded context" not in first_files[str(large)]
            and "1 Now bounded context" in final_files[str(large)]
            and "1 Deferred loaded context" in final_files[str(deferred)]
            and all(
                "error" not in prompt_attributes(final_files[str(path)], "file")
                and prompt_attributes(final_files[str(path)], "file")["expires_in_turns"] == "3"
                and prompt_attributes(final_files[str(path)], "file")["ID"]
                == prompt_attributes(contexts[str(path)], "file")["ID"]
                for path in (large, deferred)
            )
            and all(
                "1 Usable loaded context" in files[str(small)]
                for files in (first_files, expired_files, final_files)
            ),
            "bounded errors were automatically retried, failed to expire independently, or lost stable IDs on explicit reload",
        )
        require(
            all("1 Budget-only sentinel" not in request_prompt(request) for request in mock.requests)
            and large.read_text(encoding="utf-8") == "Now bounded context\n"
            and not missing.exists(),
            "over-budget content reached the controller or file loading created a missing input",
        )

