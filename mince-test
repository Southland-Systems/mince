                    "--log", "off",
                    *(("--noninteractive",) if noninteractive else ()),
                    input_text=review_input,
                )
            require(
                len(mock.requests) == (2 if accepted else 1),
                f"{name} plan made an unexpected number of API requests",
            )
            require_task_placement(mock.requests[0], original_task)
            require(
                original_task not in request_prompt(mock.requests[0])
                and "1 offline plan context" in request_prompt(mock.requests[0]),
