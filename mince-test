            (("--contain-read-path", "bad\npath"), "cannot contain control characters"),
            (("--contain-bind-read-only", missing, destination), "bind source does not exist"),
            (("--contain-bind-write", regular, directory), "must both be files or both be directories"),
            (("--contain-bind-read-only", directory, destination,
              "--contain-bind-write", other_directory, destination),
             "multiple bind sources target the same destination"),
            (("--contain-bind-write", regular, directory / "destination:invalid"), "cannot contain ':'"),
        ]
        for arguments, diagnostic in cases:
            failed = self.run(
                "--contain-dry-run", *arguments, executable="mince-contain",
                cwd=self.work, check=False,
                environment_updates={"MINCE_TEST_SYSTEMD_CAPTURE": str(capture)},
            )
            require(
                failed.returncode == 2 and diagnostic in failed.stderr
                and failed.stdout == "" and not capture.exists(),
                f"invalid containment arguments {arguments!r} were accepted or executed: {failed.stderr}",
            )
        for shell, diagnostic in ((None, "requires SHELL to be set"), (str(missing), "executable was not found")):
            failed = self.run(
                "--contain-use-shell", executable="mince-contain",
                cwd=self.work, check=False, environment_updates={"SHELL": shell},
            )
            require(
                failed.returncode == 2 and diagnostic in failed.stderr,
                "invalid SHELL was accepted by the containment wrapper",
            )
        failed = self.run(
            "--contain-state", "read-only", "--contain-dry-run",
            executable="mince-contain", cwd=self.work, check=False,
            environment_updates={"HOME": str(self.root / "missing-contain-home")},
        )
        require(
            failed.returncode == 2 and "read-only Mince state directory does not exist" in failed.stderr,
            "read-only containment state was silently created",
        )
        isolated_bin = self.root / "no-systemd-bin"
        isolated_bin.mkdir()
        wrapper = shutil.which("mince-contain")
        require(wrapper is not None, "mince-contain was not found on PATH")
        (isolated_bin / "mince-contain").symlink_to(Path(str(wrapper)).absolute())
        (isolated_bin / "python3").symlink_to(sys.executable)
        environment = {"PATH": str(isolated_bin)}
        no_arguments = self.run(
            executable="mince-contain", environment_updates=environment,
        )
        help_result = self.run(
            "--contain-help", executable="mince-contain", environment_updates=environment,
        )
        failed = self.run(
            "--contain-dry-run", "--print-default-config",
            executable="mince-contain", environment_updates=environment, check=False,
        )
        require(
            "--contain-help" in no_arguments.stdout
            and "--help" in no_arguments.stdout
            and "Usage: mcec" in help_result.stdout
            and failed.returncode == 2 and "systemd-run was not found on PATH" in failed.stderr,
            "wrapper help or missing systemd-run handling was incorrect:\n"
            f"no arguments: {no_arguments!r}\n"
            f"containment help: {help_result!r}\n"
            f"missing systemd-run: {failed!r}",
        )
        (isolated_bin / "systemd-run").symlink_to(self.systemd_run)
        missing_trace = self.work / "unavailable-contain-trace.log"
        failed = self.run(
            "--contain-dry-run", "--contain-trace", missing_trace, "--print-default-config",
            executable="mince-contain", environment_updates=environment, check=False,
