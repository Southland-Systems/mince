    @staticmethod
    def _patch_file_entry(
        path: Path,
        *,
        total_lines: int,
        line_ending: str = "lf",
        patches: list[dict[str, Any]],
    ) -> dict[str, Any]:
        return {
            "document": {
                "path": str(path),
                "encoding": "utf-8",
                "line_ending": line_ending,
                "total_lines": total_lines,
            },
            "patches": patches,
        }

    def _patch_manifest(
        self,
        path: Path,
        *,
        line_ending: str = "lf",
        total_lines: int = 3,
        patches: list[dict[str, Any]],
    ) -> dict[str, Any]:
        return {
            "files": [
                self._patch_file_entry(
                    path,
                    total_lines=total_lines,
                    line_ending=line_ending,
                    patches=patches,
                )
            ],
            "commit_message": "Apply offline test patch",
        }

    def test_multifile_patch_and_new_file(self) -> None:
        existing = self.work / "multi-existing.txt"
        created = self.work / "multi-created.txt"
        existing.write_text("first\nsecond\n", encoding="utf-8")
        manifest = {
            "files": [
                self._patch_file_entry(
                    existing,
                    total_lines=2,
                    patches=[
                        {
                            "patch_id": "multi-p1",
                            "block_id": "multi-b1",
                            "start_line": 1,
                            "end_line": 1,
                            "content_line_array": ["first-updated"],
                            "summary": "Update the existing file",
                            "confidence": 1.0,
                            "needs_manual_review": False,
                        }
                    ],
                ),
                self._patch_file_entry(
                    created,
                    total_lines=1,
                    patches=[
                        {
                            "patch_id": "multi-p2",
                            "block_id": "multi-b2",
                            "start_line": 1,
                            "end_line": 1,
                            "content_line_array": ["created-content"],
                            "summary": "Create the missing file",
                            "confidence": 1.0,
                            "needs_manual_review": False,
                        }
                    ],
                ),
            ],
            "commit_message": "Apply the multifile offline patch",
        }
        manifest_path = self.work / "multifile.json"
        manifest_path.write_text(
            json.dumps(manifest),
            encoding="utf-8",
        )
        self.run(
            "--patch-file-apply",
            manifest_path,
            "--patch-suffix",
            ".multi",
            "--log",
            "off",
        )
        require(
            existing.with_name(existing.name + ".multi").read_text(
                encoding="utf-8"
            ) == "first-updated\nsecond\n",
            "multifile patch changed the existing file incorrectly",
        )
        require(
            created.with_name(created.name + ".multi").read_text(
                encoding="utf-8"
            ) == "created-content",
            "patch did not create the missing file",
        )

    def test_empty_file_patch_insertion(self) -> None:
