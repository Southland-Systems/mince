    def test_patch_branch_merge_and_remove(self) -> None:
        repo = self.work / "patch-branch-management-repo"
        repo.mkdir()
        target = repo / "target.txt"
        target.write_text("base\n", encoding="utf-8")

        def git(*arguments: str) -> str:
            completed = subprocess.run(
                ["git", *arguments],
                cwd=repo,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
            )
            require(
                completed.returncode == 0,
                f"git {arguments!r} failed: {completed.stderr}",
            )
            return completed.stdout.strip()

        git("init")
        git("config", "user.email", "offline@example.test")
        git("config", "user.name", "Offline Test")
        git("add", "target.txt")
        git("commit", "-m", "Initial branch management fixture")
        git("branch", "-M", "main")
        git("switch", "--create", "mcefeature")
        target.write_text("merged\n", encoding="utf-8")
        git("add", "target.txt")
        git("commit", "-m", "Feature branch fixture")
        git("switch", "main")

        self.run(
            "--patch-merge",
            "Merge offline branch fixture",
            "--patch-branch",
            "feature",
            cwd=repo,
        )
        require(
            target.read_text(encoding="utf-8") == "merged\n",
            "patch branch merge did not update the target",
        )
        require(
            git("branch", "--list", "mcefeature") == "",
