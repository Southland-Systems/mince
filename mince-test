    def test_token_cost_formats_and_validation(self) -> None:
        usage = {"input_tokens": 1000, "output_tokens": 500, "total_tokens": 1500}
        expected_cost = "0.0020:0.0020:0.0040"
        cases = [
            (("2", "4"), expected_cost),
            (("2:4",), expected_cost),
            (("2 4",), expected_cost),
            ((" 2 : 4 ",), expected_cost),
            (("0:0",), "0.0000:0.0000:0.0000"),
            (("off",), None),
        ]
        response = {"output_text": "Offline token cost answer", "usage": usage}
        with MockResponsesAPI([response] * len(cases)) as mock:
            common = (
                "--ask", "Check offline token cost formats.",
                "--model", "offline-test-model", "--base-url", mock.url,
                "--log", "off",
            )
            for costs, expected in cases:
                result = self.run(*common, "--token-cost", *costs)
                cost_fields = re.findall(
                    r"(?:^|\s)response_cost=(\S+)", result.stderr,
                )
                require(
                    result.stdout == "Offline token cost answer\n"
                    and cost_fields == ([] if expected is None else [expected]),
                    f"token costs {costs!r} were parsed incorrectly or reported more than once",
                )
            for costs in (
                ("2",), ("2:4:6",), ("nan:4",),
                ("2:inf",), ("2 -4",), ("off", "4"),
            ):
                failed = self.run(*common, "--token-cost", *costs, check=False)
                require(
                    failed.returncode == 1 and failed.stdout == ""
                    and "token_cost:" in failed.stderr,
                    f"invalid token costs {costs!r} were accepted or omitted their diagnostic",
                )
