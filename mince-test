    def test_contain_trace(self) -> None:
        selected = self.work / "contain-trace"
        selected.mkdir()
        for variant in ("new", "symlink"):
            capture = self.work / f"contain-trace-{variant}.json"
            trace_capture = self.work / f"contain-strace-{variant}.jsonl"
            if variant == "new":
                trace = selected / 'trace % "quoted" output.log'
                source = trace
                expected_mode = 0o600
            else:
                source = self.work / "existing-contain-trace.log"
                source.write_text("Existing trace must survive dry-run\n", encoding="utf-8")
                source.chmod(0o640)
                trace = selected / "trace-link.log"
                trace.symlink_to(source)
                expected_mode = 0o640
            before = source.read_bytes() if source.exists() else None
            environment = {
                "MINCE_TEST_SYSTEMD_CAPTURE": str(capture),
                "MINCE_TEST_SYSTEMD_EXECUTE": "1",
                "MINCE_TEST_STRACE_CAPTURE": str(trace_capture),
            }
            arguments = (
                "--contain-working-directory", selected,
                "--contain-trace", trace.name, "--print-default-config",
            )
            command = self.contain_command(*arguments, environment_updates=environment)
            expected_arguments = [
                str(self.strace), *STRACE_OPTIONS, "-o", str(trace),
                "--", "mince", "--print-default-config",
            ]
            properties = systemd_properties(command)
            binding = str(source) if source == trace else f"{source.resolve()}:{trace}"
            require(
                contained_arguments(command) == expected_arguments
                and str(trace).replace("%", "%%") in shlex.split(properties["ReadWritePaths"])
                and binding.replace("%", "%%") in shlex.split(properties["BindPaths"])
                and not capture.exists() and not trace_capture.exists()
                and (source.read_bytes() if source.exists() else None) == before,
                f"{variant} containment trace dry-run changed files or omitted trace arguments and grants",
            )
            result = self.run(
                *arguments, executable="mince-contain", environment_updates=environment,
            )
            recorded = json.loads(capture.read_text(encoding="utf-8"))
            require(
                json.loads(result.stdout)["shell_trace"] == "off"
                and recorded["arguments"] == command[1:]
                and [json.loads(line) for line in trace_capture.read_text(encoding="utf-8").splitlines()]
                == [expected_arguments[1:]]
                and source.read_text(encoding="utf-8") == OFFLINE_TRACE_TEXT
                and source.stat().st_mode & 0o777 == expected_mode
                and (variant != "symlink" or trace.is_symlink()),
                f"{variant} containment tracing failed to execute, preserve permissions, or retain its symlink",
            )

