    def test_api_key_redaction(self) -> None:
        profile_name = "key_redaction"
        secret = "abcd-secret-wxyz"
        masked = "abcd********wxyz"
        self.run("--copy-profile", profile_name)
        try:
            self.run(
                "--profile", profile_name, "--set-config", f"api_key={secret}",
            )
            outputs = [
                self.run("--profile", profile_name, "--get-config", "api_key"),
                self.run("--profile", profile_name, "--get-config-detail", "api_key"),
                self.run("--profile", profile_name, "--print-current-config"),
                self.run("--print-profiles-json", profile_name),
                self.run("--print-profiles", profile_name, "--noninteractive"),
            ]
            for result in outputs:
                require(
                    masked in result.stdout
                    and secret not in result.stdout + result.stderr,
                    "configuration output exposed an API key or omitted its masked value",
                )
            profile_path = self.home / ".local/state/mince" / f"{profile_name}.json"
            require(
                json.loads(profile_path.read_text(encoding="utf-8"))["api_key"] == secret,
                "printing configuration replaced the stored API key with its masked value",
            )
            with MockResponsesAPI(["offline redaction answer"]) as mock:
                result = self.run(
                    "--profile", profile_name, "--ask", "Check offline key redaction.",
                    "--model", "offline-test-model", "--base-url", mock.url,
                    "--log", "on", "--no-api-log",
                )
            require(
                len(mock.requests) == 1 and result.stdout == "offline redaction answer\n",
                "redaction check made an unexpected request or omitted the response",
            )
            session_name = session_name_from_result(result, noninteractive=False)
            log = (self.home / ".local/state/mince/logs" / f"{session_name}.txt").read_text(
                encoding="utf-8",
