    def test_saved_patch_validation_and_line_endings(self) -> None:
        target = self.work / "patch-target.txt"
        target.write_text("alpha\nbeta\ngamma\n", encoding="utf-8")
        manifest = self._patch_manifest(
            target,
            patches=[
                {
                    "patch_id": "p1",
                    "block_id": "b1",
                    "start_line": 2,
                    "end_line": 2,
                    "content_line_array": ["beta-updated"],
                    "summary": "Update beta",
                    "confidence": 1.0,
                    "needs_manual_review": False,
                }
            ],
        )
        manifest_path = self.work / "patch.json"
        manifest_path.write_text(
            json.dumps(manifest),
            encoding="utf-8",
        )
        printed = self.run(
            "--patch-file-print",
            manifest_path,
            "--log",
            "off",
        )
        require("-beta" in printed.stdout, "patch diff omitted the original line")
        require(
            "+beta-updated" in printed.stdout,
            "patch diff omitted the replacement line",
        )
        self.run(
            "--patch-file-apply",
            manifest_path,
            "--patch-suffix",
            ".patched",
            "--log",
            "off",
        )
        require(
            target.with_name(target.name + ".patched").read_text(
                encoding="utf-8"
            ) == "alpha\nbeta-updated\ngamma\n",
            "saved patch produced incorrect output",
