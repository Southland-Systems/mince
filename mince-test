    def test_tree_retry_and_session_resume(self) -> None:
        for kind, status, expected_status, first_request_count in (
            ("transient", 503, 0, 3),
            ("permanent", 401, 1, 2),
        ):
            source_turn = first_request_count - 1
            tree = self.work / f"retry-tree-{kind}"
            tree.mkdir()
            targets = [tree / "a.txt", tree / "b.txt"]
            for target in targets:
                target.write_text(f"Offline {target.name} tree context\n", encoding="utf-8")
            error = {
                "http_status": status,
                "error": {
                    "message": f"offline {kind} tree failure",
                    "type": "server_error" if kind == "transient" else "invalid_request_error",
                },
            }
            responses = [error, "Tree B completed", "Tree A recovered"]
            with MockResponsesAPI(responses) as mock:
                common = (
                    "--tree-files", tree, "--tree-task", "Recover the offline tree results.",
                    "--tree-parallel", "1", "--retry", "2",
                    "--model", "offline-test-model", "--base-url", mock.url,
                    "--log", "on",
                )
                first = self.run(*common, check=False)
                require(
                    first.returncode == expected_status
                    and len(mock.requests) == first_request_count
                    and f"offline {kind} tree failure" in first.stderr,
                    f"{kind} tree failure used an incorrect retry policy or exit status",
                )
                source_name = session_name_from_result(first, noninteractive=False)
                failed_state = self.state_artifacts(source_name, "0")
                require_failed_state_turn(failed_state, f"offline {kind} tree failure")
                require_state_request(failed_state, mock.requests[0])
                completed_state = self.state_artifacts(source_name, "1")
                require(
                    self.state_turn_numbers(source_name) == list(range(source_turn + 1))
                    and str(targets[0]) in failed_state["response_error"]
                    and completed_state["response"] == "Tree B completed"
                    and "response_error" not in completed_state,
                    "tree attempts did not retain separate failed and completed state turns",
                )
                require_state_request(completed_state, mock.requests[1])
                if kind == "transient":
                    reset_message = "succeeded after 1 retry; retry counter reset."
                    require(
                        reset_message in self.session_log(source_name)
                        and reset_message not in first.stderr
                        and self.state_artifacts(source_name, "2", "response")["response"]
                        == "Tree A recovered",
                        "successful tree recovery lost its completed turn or retry-reset log",
                    )
                source_state = self.state_snapshot(source_name)
                source_tree = self.home / ".local/state/mince/trees" / source_name
                source_outputs = {
                    target.name: (source_tree / tree.name / target.name).read_bytes()
                    for target in targets
                }
                source_combined = (source_tree / f"{source_name}.md").read_bytes()
                resumed = self.run(*common, "--resume-session", source_name)
            resumed_name = session_name_from_result(resumed, noninteractive=False)
            require(
                resumed_name != source_name
                and self.state_artifacts(resumed_name, "resume_session", "resume_session_turn") == {
                    "resume_session": source_name, "resume_session_turn": str(source_turn),
                }
                and self.state_turn_numbers(resumed_name)
                == ([] if kind == "transient" else [source_turn + 1]),
                "tree resume lost its source cutoff or allocated incorrect local request turns",
            )
            requested_paths = [
                prompt_attributes(
                    prompt_section(request_prompt(request), "files"), "file",
                )["path"]
                for request in mock.requests
            ]
            require(
                requested_paths == [str(targets[0]), str(targets[1]), str(targets[0])]
                and mock.requests[0] == mock.requests[2],
                "tree retry or resume repeated completed work, selected the wrong file, or changed its request",
            )
            resumed_tree = self.home / ".local/state/mince/trees" / resumed_name
            combined = (resumed_tree / f"{resumed_name}.md").read_text(encoding="utf-8")
            require(
                (resumed_tree / tree.name / "a.txt").read_text(encoding="utf-8")
                == "Tree A recovered"
                and (resumed_tree / tree.name / "b.txt").read_bytes() == source_outputs["b.txt"]
                and combined.count("Tree A recovered") == combined.count("Tree B completed") == 1
                and combined.index("Tree A recovered") < combined.index("Tree B completed"),
                "tree resume did not retain completed output and combine recovered results in path order",
            )
            require(
                self.state_snapshot(source_name) == source_state
                and (source_tree / f"{source_name}.md").read_bytes() == source_combined
                and all(
                    (source_tree / tree.name / name).read_bytes() == content
                    for name, content in source_outputs.items()
                ),
                "tree resume modified the source session's state or result files",
            )


