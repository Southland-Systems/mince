                {"action": "remove", "numbers": [1, AGENT_TASK_LIST_CAPACITY + 1]},
            ]})),
            MockResponsesAPI.tool_response(("meta_task_list", {"operations": [
                {"action": "remove", "numbers": [1, 3, 3]},
