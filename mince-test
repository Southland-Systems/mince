class TestFailure(Exception):
    """An expected integration-test failure."""


def require(condition: bool, message: str) -> None:
    if not condition:
        raise TestFailure(message)


class MockResponsesAPI:
    """Serve a sequence of Responses API payloads on loopback only."""

    def __init__(self, responses: list[Any]) -> None:
        if not responses:
            raise ValueError("at least one mock response is required")
        self.responses = responses
        self.requests: list[dict[str, Any]] = []
        self._lock = threading.Lock()
        self._server: ThreadingHTTPServer | None = None
        self._thread: threading.Thread | None = None
        self.url = ""

    @staticmethod
    def tool_response(*calls: tuple[str, dict[str, Any]]) -> dict[str, Any]:
        return {
            "output_items": [
                {
                    "id": f"fc_offline_{index}",
                    "type": "function_call",
                    "status": "completed",
                    "call_id": f"call_offline_{index}",
                    "name": name,
                    "arguments": json.dumps(arguments, ensure_ascii=False),
                }
                for index, (name, arguments) in enumerate(calls)
            ]
        }

    @staticmethod
    def _payload(value: Any, index: int) -> bytes:
        usage: dict[str, Any] = {}
        output_items = None
        if isinstance(value, str):
            output_text = value
        elif isinstance(value, dict):
            if "output_items" in value:
                output_items = value["output_items"]
                if not isinstance(output_items, list):
                    raise ValueError("mock output_items must be an array")
                output_text = ""
            elif "output_text" in value:
                output_text = value["output_text"]
            elif "output" in value:
                output_text = json.dumps(
                    value["output"],
                    separators=(",", ":"),
                    ensure_ascii=False,
                )
            else:
                raise ValueError("mock response requires output, output_text, or output_items")
            usage = value.get("usage", {})
        else:
            raise ValueError("mock response must be a string or object")
        if not isinstance(output_text, str):
            raise ValueError("mock response output must be text")
        if output_items is None:
            output_items = [
                {
                    "id": f"msg_offline_{index}",
                    "type": "message",
                    "status": "completed",
                    "role": "assistant",
                    "content": [
                        {
                            "type": "output_text",
                            "text": output_text,
                            "annotations": [],
                            "logprobs": [],
                        }
                    ],
                }
            ]
        if not isinstance(usage, dict) or not usage:
            usage = {
                "input_tokens": 8,
                "output_tokens": 4,
                "total_tokens": 12,
                "input_tokens_details": {"cached_tokens": 0},
                "output_tokens_details": {"reasoning_tokens": 0},
            }
        response = {
            "id": f"resp_offline_{index}",
            "object": "response",
            "created_at": 1700000000,
            "status": "completed",
            "background": False,
            "error": None,
            "incomplete_details": None,
            "instructions": None,
            "max_output_tokens": None,
            "max_tool_calls": None,
            "metadata": {},
            "model": "offline-test-model",
            "output": output_items,
            "parallel_tool_calls": True,
            "previous_response_id": None,
            "prompt": None,
            "reasoning": {"effort": None, "summary": None},
            "safety_identifier": None,
            "service_tier": "default",
            "store": False,
            "temperature": 1,
            "text": {"format": {"type": "text"}, "verbosity": "medium"},
            "tool_choice": "auto",
            "tools": [],
            "top_logprobs": 0,
            "top_p": 1,
            "truncation": "disabled",
            "usage": usage,
            "user": None,
        }
        return json.dumps(response, ensure_ascii=False).encode("utf-8")

    def __enter__(self) -> "MockResponsesAPI":
        owner = self

        class Handler(BaseHTTPRequestHandler):
            def do_POST(self) -> None:
                length = int(self.headers.get("Content-Length", "0"))
                body = self.rfile.read(length)
                try:
                    request = json.loads(body.decode("utf-8"))
                except (UnicodeDecodeError, json.JSONDecodeError):
                    request = {"raw": body.decode("utf-8", errors="replace")}
                if not isinstance(request, dict):
                    request = {"value": request}
                with owner._lock:
                    owner.requests.append(request)
                    index = len(owner.requests) - 1
                    if index < len(owner.responses):
                        response_value = owner.responses[index]
                    else:
                        response_value = {
                            "http_status": 400,
                            "error": {
                                "message": "offline mock response sequence exhausted",
                                "type": "invalid_request_error",
                                "code": "mock_exhausted",
                            },
                        }
                status = (
                    response_value.get("http_status", 200)
                    if isinstance(response_value, dict)
                    else 200
                )
                if status != 200:
                    payload = json.dumps(
                        {"error": response_value["error"]},
                        ensure_ascii=False,
                    ).encode("utf-8")
                    self.send_response(status)
                    self.send_header("Content-Type", "application/json")
                    self.send_header("Content-Length", str(len(payload)))
                    self.end_headers()
                    self.wfile.write(payload)
                    return
                response_payload = json.loads(
                    owner._payload(response_value, index).decode("utf-8")
                )
                if request.get("stream") is True:
                    output_text = response_payload["output"][0]["content"][0]["text"]
                    midpoint = max(1, len(output_text) // 2)
                    chunks = [output_text[:midpoint], output_text[midpoint:]]
                    events = [
                        {
                            "type": "response.output_text.delta",
                            "content_index": 0,
                            "delta": chunk,
                            "item_id": f"msg_offline_{index}",
                            "logprobs": [],
                            "obfuscation": "",
                            "output_index": 0,
                            "sequence_number": sequence_number,
                        }
                        for sequence_number, chunk in enumerate(chunks)
                    ]
                    events.append(
                        {
                            "type": "response.completed",
                            "response": response_payload,
                            "sequence_number": len(events),
                        }
                    )
                    self.send_response(200)
                    self.send_header("Content-Type", "text/event-stream")
                    self.send_header("Cache-Control", "no-cache")
                    self.end_headers()
                    for event in events:
                        event_text = (
                            f"event: {event['type']}\n"
                            f"data: {json.dumps(event, ensure_ascii=False)}\n\n"
                        ).encode("utf-8")
                        self.wfile.write(event_text)
                        self.wfile.flush()
                    return
                payload = json.dumps(
                    response_payload, ensure_ascii=False
                ).encode("utf-8")
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(payload)))
                self.end_headers()
                self.wfile.write(payload)

            def log_message(self, format: str, *args: object) -> None:
                return

        self._server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
        self._server.daemon_threads = True
        self._thread = threading.Thread(
            target=self._server.serve_forever,
            name="mince-test-mock",
            daemon=True,
        )
        self._thread.start()
        self.url = f"http://127.0.0.1:{self._server.server_port}/v1"
        return self

    def __exit__(self, exc_type: object, exc_value: object, traceback: object) -> bool:
        if self._server is not None:
            self._server.shutdown()
            self._server.server_close()
        if self._thread is not None:
            self._thread.join(timeout=5)
            if self._thread.is_alive():
                raise TestFailure("offline mock server did not stop")
        return False


class OfflineTests:
    def __init__(self) -> None:
        self._temporary_directory = tempfile.TemporaryDirectory(
            prefix="mince-test-",
        )
        self.root = Path(self._temporary_directory.name)
        self.home = self.root / "home"
        self.work = self.root / "work"
        self.home.mkdir()
        self.work.mkdir()
        self.command = [ 'mince' ]
        cache_name = hashlib.sha1(
            b"https://openaipublic.blob.core.windows.net/encodings/o200k_base.tiktoken"
        ).hexdigest()
        cache_directories = [
            Path.home() / ".local/state/mince/tiktoken",
            Path(tempfile.gettempdir()) / "data-gym-cache",
        ]
        for variable in ("TIKTOKEN_CACHE_DIR", "DATA_GYM_CACHE_DIR"):
            if os.environ.get(variable):
                cache_directories.insert(0, Path(os.environ[variable]))
        self._token_cache_available = False
        for directory in cache_directories:
            source = directory / cache_name
            if source.is_file():
                destination = self.home / ".local/state/mince/tiktoken" / cache_name
                destination.parent.mkdir(parents=True, exist_ok=True)
                shutil.copyfile(source, destination)
                self._token_cache_available = True
                break

    def run(
        self,
        *arguments: object,
        check: bool = True,
        cwd: Path | None = None,
        input_text: str | None = None,
    ) -> subprocess.CompletedProcess[str]:
        environment = os.environ.copy()
        environment.update(
            {
                "HOME": str(self.home),
                "OPENAI_API_KEY": "offline-test-key",
                "NO_PROXY": "127.0.0.1,localhost",
                "no_proxy": "127.0.0.1,localhost",
                "HTTP_PROXY": "",
                "HTTPS_PROXY": "",
                "ALL_PROXY": "",
                "http_proxy": "",
                "https_proxy": "",
                "all_proxy": "",
            }
        )
        tokenizing_options = {
            "--ask", "--ask-file", "--task", "--task-file",
            "--reuse-session", "--tree-task", "--tree-task-file",
        }
        if any(str(argument) in tokenizing_options for argument in arguments):
            require(
                self._token_cache_available,
                "Offline tokenizer cache is missing. Before running mince-test, "
                "prewarm o200k_base using: "
                "TIKTOKEN_CACHE_DIR=\"$HOME/.local/state/mince/tiktoken\" "
                "python3 -c 'import tiktoken; tiktoken.get_encoding(\"o200k_base\")'",
            )
        command = [
            *self.command,
            "--base-url", "http://127.0.0.1:1/v1",
            "--retry", "0",
            *(str(argument) for argument in arguments),
        ]
        completed = subprocess.run(
            command,
            cwd=cwd or ROOT,
            env=environment,
            input=input_text,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=30,
            check=False,
        )
        if check and completed.returncode != 0:
            raise TestFailure(
                f"{command!r} failed\n"
                f"stdout:\n{completed.stdout}\n"
                f"stderr:\n{completed.stderr}"
            )
        return completed

    def shell_session_response(self, session_name: str) -> dict[str, Any]:
        result = self.run(
            "--shell-session-print-json",
            session_name,
        )
        try:
            response = json.loads(result.stdout)
        except json.JSONDecodeError as exc:
            raise TestFailure(
                "shell session JSON response could not be decoded: "
                f"{exc}"
            ) from exc
        require(
            isinstance(response, dict),
            "shell session JSON response was not an object",
        )
        return response

    def state_artifacts(
        self,
        session_name: str,
        *values: object,
    ) -> dict[str, str]:
        result = self.run("--state-print-json", session_name, *values)
        try:
            artifacts = json.loads(result.stdout)
        except json.JSONDecodeError as exc:
            raise TestFailure(
                f"state artifact JSON could not be decoded: {exc}"
            ) from exc
        require(
            isinstance(artifacts, dict)
            and all(isinstance(value, str) for value in artifacts.values()),
            "state artifact JSON was not an object of strings",
        )
        return artifacts

    def test_default_config(self) -> None:
        result = self.run("--print-default-config")
        config = json.loads(result.stdout)
        require(
            config["model"] == "gpt-6-luna",
            "default model is incorrect",
        )
        require(
            bool(config["linenum_system_prompt"]),
            "line-number prompt is missing",
        )
        require(
            config["patch"] == "off",
            "patch mode default is incorrect",
        )
        require(
            config["retry"] == 2
            and config["agent_context_expires"] == "12 6 24"
            and config["shell_networking"] == "off"
            and config["response_json_repair"] == "off"
            and config["explicit_prompt_cache"] == "off",
            "retry, agent expiry, networking, repair, or cache defaults are incorrect",
        )

    def test_inherited_profile_overrides(self) -> None:
        self.run("--inherit-profile", "child")
        inherited = self.run(
            "--profile",
            "child",
            "--get-config",
            "model",
        )
        require(
            inherited.stdout.strip() == "^model=gpt-6-luna",
            "inherited profile did not expose the parent model",
        )
        self.run(
            "--profile",
            "child",
            "--set-config",
            "model=child-model",
        )
        profile_path = self.home / ".local/state/mince/child.json"
        raw_profile = json.loads(profile_path.read_text(encoding="utf-8"))
        require(
            raw_profile.get("_inherit_profile") == "config"
            and raw_profile.get("model") == "child-model",
            "profile override was not stored as a child value",
        )
        overridden = self.run(
            "--profile",
            "child",
            "--get-config",
            "model",
        )
        require(
            overridden.stdout.strip() == "model=child-model",
            "child profile override was not used",
        )
        self.run(
            "--profile",
            "child",
            "--set-config",
            "model=DEFAULT",
        )
        raw_profile = json.loads(profile_path.read_text(encoding="utf-8"))
        require(
            "model" not in raw_profile,
            "DEFAULT did not remove the inherited child override",
        )
        restored = self.run(
            "--profile",
            "child",
            "--get-config",
            "model",
        )
        require(
            restored.stdout.strip() == "^model=gpt-6-luna",
            "parent value was not restored after resetting the child",
        )
        self.run("--remove-profile", "child")
        require(not profile_path.exists(), "temporary child profile was not removed")

    def test_tree_filtering(self) -> None:
        tree = self.work / "tree"
        tree.mkdir()
        keep = tree / "keep.txt"
        skip = tree / "skip.txt"
        keep.write_text("keep\n", encoding="utf-8")
        skip.write_text("skip\n", encoding="utf-8")
        result = self.run(
            "--tree-files",
            tree,
            "--tree-include",
            "*.txt",
            "--tree-exclude",
            "skip*",
            "--tree-show-only",
        )
        require(str(keep) in result.stdout, "included tree file is missing")
        require("skip.txt" not in result.stdout, "excluded tree file was listed")

    def test_tree_api_processing(self) -> None:
        tree = self.work / "api-tree"
        tree.mkdir()
        (tree / "a.py").write_text("alpha\n", encoding="utf-8")
        (tree / "b.txt").write_text("bravo\n", encoding="utf-8")
        with MockResponsesAPI(["tree answer", "tree answer"]) as mock:
            result = self.run(
                "--tree-files",
                tree,
                "--tree-task",
                "Summarize each tree file.",
                "--tree-parallel",
                "1",
                "--model",
                "offline-test-model",
                "--base-url",
                mock.url,
                "--log",
                "off",
                "--no-api-log",
            )
        require(len(mock.requests) == 2, "expected one tree request per file")
        request_inputs = [
            str(request.get("input", ""))
            for request in mock.requests
        ]
        require(
            all("Summarize each tree file." in value for value in request_inputs),
            "tree task was omitted from one or more requests",
        )
        require(
            any("1 alpha" in value for value in request_inputs),
            "tree request omitted numbered file context",
        )
        session_name = session_name_from_result(
            result,
            noninteractive=False,
        )
        combined = (
            self.home / ".local/state/mince/trees" / session_name
            / f"{session_name}.md"
        )
        require(combined.is_file(), "combined tree result was not written")
        combined_text = combined.read_text(encoding="utf-8")
        require(
            "# **api-tree/a.py**" in combined_text
            and "# **api-tree/b.txt**" in combined_text,
            "combined tree result omitted a processed file",
        )
        require(
            combined_text.count("tree answer") == 2,
            "combined tree result did not contain both API responses",
        )

    def test_tree_extension_prompts(self) -> None:
        tree = self.work / "prompted-tree"
        tree.mkdir()
        (tree / "main.py").write_text("python\n", encoding="utf-8")
        (tree / "notes.txt").write_text("text\n", encoding="utf-8")
        task_prompts = self.work / "tree-tasks.txt"
        task_prompts.write_text(
            "*: General tree task\n.py: Python-specific tree task\n",
            encoding="utf-8",
        )
        system_prompts = self.work / "tree-systems.txt"
        system_prompts.write_text(
            "*: General system instruction\n.py: Python-specific system instruction\n",
            encoding="utf-8",
        )
        with MockResponsesAPI(["tree prompt answer", "tree prompt answer"]) as mock:
            self.run(
                "--tree-files",
                tree,
                "--tree-task-file",
                task_prompts,
                "--tree-system-prompt-file",
                system_prompts,
                "--tree-parallel",
                "1",
                "--model",
                "offline-test-model",
                "--base-url",
                mock.url,
                "--log",
                "off",
                "--no-api-log",
            )
        request_inputs = [
            str(request.get("input", "")) for request in mock.requests
        ]
        python_input = next(
            value for value in request_inputs if "1 python" in value
        )
        text_input = next(
            value for value in request_inputs if "1 text" in value
        )
        require(
            "Python-specific tree task" in python_input
            and "General tree task" not in python_input,
            "extension-specific tree task was not selected",
        )
        require(
            "General tree task" in text_input
            and "Python-specific tree task" not in text_input,
            "wildcard tree task was not selected",
        )
        python_instructions = next(
            str(request.get("instructions", ""))
            for request in mock.requests
            if "1 python" in str(request.get("input", ""))
        )
        require(
            "Python-specific system instruction" in python_instructions,
            "extension-specific system prompt was not selected",
        )

    def test_prompt_library(self) -> None:
        self.run("--prompt-edit", "offline", "Offline prompt")
        printed = self.run("--prompt-print-json", "offline")
        prompts = json.loads(printed.stdout)
        require(
            prompts == {"offline": "Offline prompt"},
            "prompt JSON output is incorrect",
        )
        self.run("--profile", "config", "--prompt-assign", "offline", "system")
        configured = self.run("--get-config", "system_prompt")
        require(
            configured.stdout.strip() == "system_prompt=./offline.md|./mce_system.md",
            "prompt assignment did not prepend the library reference",
        )
        detail = self.run("--get-config-detail", "system_prompt")
        require(
            "[Offline prompt You are a concise" in detail.stdout,
            "config detail did not resolve the assigned prompt files",
        )
        self.run("--profile", "config", "--prompt-unassign", "offline", "system")
        restored = self.run("--get-config", "system_prompt")
        require(
            restored.stdout.strip() == "system_prompt=./mce_system.md",
            "prompt unassignment did not retain the default library reference",
        )
        self.run("--prompt-remove", "offline")
        require(
            not (self.home / ".local/state/mince/prompts/offline.md").exists(),
            "removed prompt library entry still exists",
        )

    def test_prompt_expansion(self) -> None:
        self.run("--prompt-edit", "leaf", "Expanded leaf prompt")
        self.run(
            "--prompt-edit",
            "outer",
            "Before ^^leaf^^ after",
        )
        with MockResponsesAPI(["offline prompt expansion"]) as mock:
            result = self.run(
                "--ask",
                "^^outer^^",
                "--prompt-expansion",
                "--model",
                "offline-test-model",
                "--base-url",
                mock.url,
                "--log",
                "off",
                "--no-api-log",
            )
        require(
            "offline prompt expansion" in result.stdout,
            "expanded prompt response was not printed",
        )
        require(len(mock.requests) == 1, "expected one prompt expansion request")
        request_input = str(mock.requests[0].get("input", ""))
        require(
            "Before Expanded leaf prompt after" in request_input,
            "prompt-library reference was not expanded in the request",
        )

    def test_file_list_and_prompt_file_inputs(self) -> None:
        ask_one = self.work / "ask-one.txt"
        ask_two = self.work / "ask-two.txt"
        context_one = self.work / "list-context-one.txt"
        context_two = self.work / "list-context-two.txt"
        task_file = self.work / "task-file.txt"
        files_list = self.work / "context-files.list"
        ask_one.write_text("Ask from first file\n", encoding="utf-8")
        ask_two.write_text("Ask from second file\n", encoding="utf-8")
        context_one.write_text("First context line\n", encoding="utf-8")
        context_two.write_text("Second context line\n", encoding="utf-8")
        task_file.write_text("Task loaded from a file\n", encoding="utf-8")
        files_list.write_text(
            f"{context_one}\n# ignored comment\n\n{context_two}\n",
            encoding="utf-8",
        )
        with MockResponsesAPI(
            ["offline ask-file", "offline task-file"]
        ) as mock:
            ask_result = self.run(
                "--ask-file",
                ask_one,
                ask_two,
                "--model",
                "offline-test-model",
                "--base-url",
                mock.url,
                "--log",
                "off",
                "--no-api-log",
            )
            task_result = self.run(
                "--task-file",
                task_file,
                "--files-list",
                files_list,
                "--model",
                "offline-test-model",
                "--base-url",
                mock.url,
                "--log",
                "off",
                "--no-api-log",
            )
        require(
            "offline ask-file" in ask_result.stdout,
            "ask-file response was not printed",
        )
        ask_input = str(mock.requests[0].get("input", ""))
        require(
            "Ask from first file" in ask_input
            and "Ask from second file" in ask_input,
            "multiple ask prompt files were not combined",
        )
        require(
            "offline task-file" in task_result.stdout,
            "task-file response was not printed",
        )
        task_input = str(mock.requests[1].get("input", ""))
        require(
            "Task loaded from a file" in task_input
            and "1 First context line" in task_input
            and "1 Second context line" in task_input,
            "task or files-list input was not included in the request",
        )
        require(
            "# ignored comment" not in task_input,
            "comments in a files list were treated as context files",
        )

