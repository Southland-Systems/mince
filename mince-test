    def test_api_retry_classification(self) -> None:
        transient = {
            "http_status": 503,
            "error": {"message": "offline transient failure", "type": "server_error"},
        }
        permanent = {
            "http_status": 401,
            "error": {"message": "offline authentication failure", "type": "invalid_request_error"},
        }
        with MockResponsesAPI([transient, "recovered response"]) as mock:
            recovered = self.run(
                "--ask", "Exercise transient retries.",
                "--retry", "2", "--model", "offline-test-model",
                "--base-url", mock.url,
            )
        require(
            recovered.stdout == "recovered response\n" and len(mock.requests) == 2
            and mock.requests[0] == mock.requests[1],
            "transient API failure was not retried exactly once with the same request",
        )
        failure_message = "API request failed (1/2 +0.5s)"
        session_name = session_name_from_result(recovered, noninteractive=False)
        log = self.session_log(session_name)
        require(
            failure_message in recovered.stderr and failure_message in log
            and log.count("<api_retry>\n") == 1
            and all(
                text not in recovered.stderr + log
                for text in ("INFO: Retrying", "succeeded after 1 retry", "retry counter reset")
            ),
            "API retries did not log exactly one failure with its attempt count and delay",
        )
        for response, retry, attempts in (
            (transient, "0", 1), (transient, "1", 1),
            (permanent, "2", 1), (transient, "3", 3),
        ):
            with MockResponsesAPI([response] * attempts) as failed_mock:
                failed = self.run(
                    "--ask", "Exercise terminal API failure.",
                    "--retry", retry, "--model", "offline-test-model",
                    "--base-url", failed_mock.url, "--log", "off",
                    check=False,
                )
            require(
                failed.returncode == 1 and failed.stdout == ""
                and len(failed_mock.requests) == attempts
                and failed.stderr.count("ERROR: API request failed") == attempts
                and all(request == failed_mock.requests[0] for request in failed_mock.requests),
                "disabled retries, permanent failure, or attempt exhaustion used an incorrect request count",
            )

