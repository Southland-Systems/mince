            resumed_name = self.resumed_session_name(
                resumed, source_name, 0, noninteractive=False,
            )
            patch_name = session_name_from_result(patched, noninteractive=True)
            tree_name = session_name_from_result(processed, noninteractive=False)
            for session_name, turn, request in zip(
                (source_name, resumed_name, patch_name, tree_name),
                (0, 1, 0, 0), mock.requests,
            ):
