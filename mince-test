        reasoning_item = MockResponsesAPI.reasoning_item("stream-replay")
        payload = json.loads(MockResponsesAPI._payload({
            "output_text": text, "reasoning_items": [reasoning_item],
        }, 0))
        reasoning_output, message_output = payload["output"]
        completed = {**payload, "output": []}
        delta = {
            "type": "response.output_text.delta", "delta": "Streamed",
            "content_index": 0, "output_index": 1,
            "item_id": message_output["id"], "logprobs": [], "sequence_number": 0,
        }
        events = [
            delta,
            {
                "type": "response.output_item.done", "output_index": 0,
                "item": reasoning_output, "sequence_number": 1,
            },
            {
                "type": "response.output_item.done", "output_index": 1,
                "item": message_output, "sequence_number": 2,
            },
            {
                "type": "response.completed", "response": completed,
                "sequence_number": 3,
            },
        ]
        with MockResponsesAPI([
            {"output_text": text, "stream_events": events},
            "Continued offline stream answer",
        ]) as mock:
            common = (
                "--model", "offline-test-model", "--base-url", mock.url,
                "--explicit-prompt-cache", "--log", "off",
            )
            first = self.run("--task", task, "--files", target, "--stream", *common)
            session_name = session_name_from_result(first, noninteractive=False)
            source_state = self.state_snapshot(session_name)
            resumed = self.run("--resume-session", session_name, "0", *common)
        resumed_name = self.resumed_session_name(
            resumed, session_name, 0, noninteractive=False,
        )
        require(
            first.stdout == text + "\n"
            and resumed.stdout == "Continued offline stream answer\n"
            and len(mock.requests) == 2,
            "completed stream items did not reconstruct the full text exactly once",
        )
        for request in mock.requests:
            require_task_placement(request, task)
            require(
                request.get("include") == ["reasoning.encrypted_content"]
                and request.get("prompt_cache_options") == {"mode": "explicit"}
                and isinstance(request.get("instructions"), str),
                "cached stateful requests omitted reasoning, explicit caching, or separate instructions",
            )
        require(
            isinstance(mock.requests[0]["input"], str)
            and mock.requests[1]["input"] == [
                reasoning_item,
                {"role": "user", "content": request_prompt(mock.requests[1])},
            ],
            "explicit caching changed the user input format or misplaced replayed reasoning",
        )
        original = self.state_artifacts(session_name, "0")
        continued = self.state_artifacts(resumed_name, "1")
        require_state_request(original, mock.requests[0])
        require_state_request(continued, mock.requests[1])
        require(
            original["response"] == text
            and json.loads(original["response_reasoning_encrypted_content"]) == [reasoning_item]
            and "response_reasoning_encrypted_content" not in continued
            and self.state_snapshot(session_name) == source_state,
            "stream completion lost reasoning, retained stale reasoning, or changed source state",
        )
        failures = [
            ("premature", {"output_text": text, "stream_events": [delta]}, "before completion"),
            ("incomplete", {
                "output_text": text,
                "response_fields": {
                    "status": "incomplete",
                    "incomplete_details": {"reason": "max_output_tokens"},
                },
            }, "incomplete: max_output_tokens"),
            ("error", {
                "output_text": "",
                "stream_events": [{
                    "type": "error", "code": "server_error",
                    "message": "Offline stream failure", "param": None,
                    "sequence_number": 0,
                }],
            }, "Offline stream failure"),
        ]
        for name, response, diagnostic in failures:
            with MockResponsesAPI([response]) as failed_mock:
                failed = self.run(
                    "--task", task, "--files", target, "--stream", "--print-reasoning",
                    "--model", "offline-test-model", "--base-url", failed_mock.url,
                    "--log", "off", check=False,
                )
            failed_name = session_name_from_result(failed, noninteractive=False)
            artifacts = self.state_artifacts(failed_name, "0")
            require(
                failed.returncode == 1 and failed.stdout == ""
                and len(failed_mock.requests) == 1 and diagnostic in failed.stderr
                and self.state_turn_numbers(failed_name) == [0],
                f"{name} stream was emitted, retried, or omitted its failure diagnostic",
            )
            require_failed_state_turn(artifacts, diagnostic)
            require_state_request(artifacts, failed_mock.requests[0])

