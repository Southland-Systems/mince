            require(len(mock.requests) == 2, f"{mode} tracing made unexpected API requests")
            session_name = session_name_from_result(result, noninteractive=False)
            turn_dir = self.home / ".local/state/mince/state" / session_name / "0"
            outputs = self.state_artifacts(session_name, "0", "response_shell_output")
            traces = self.state_artifacts(session_name, "0", "response_shell_trace")
            expected_output_names = {
