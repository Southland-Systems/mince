                len(mock.requests) == 1 and result.stdout == "offline redaction answer\n",
                "redaction check made an unexpected request or omitted the response",
            )
            session_name = session_name_from_result(result, noninteractive=False)
            log = self.session_log(session_name)
            require(
                masked in log and secret not in log + result.stdout + result.stderr,
                "session logging exposed the configured API key",
            )
            self.run("--profile", profile_name, "--set-config", "api_key=tiny")
            short_key = self.run("--profile", profile_name, "--get-config", "api_key")
            require(
                short_key.stdout.strip() == "api_key=****",
                "short API keys were not completely masked",
            )
        finally:
            self.run("--remove-profile", profile_name)

