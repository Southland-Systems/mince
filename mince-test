                "--patch-file-apply", manifest_path, "--patch-suffix", ".invalid",
                check=False,
            )
            require(
                failed.returncode != 0 and diagnostic in failed.stderr,
                f"{name} was accepted or its diagnostic was missing: {failed.stderr}",
            )
            require(
                target.read_bytes() == source
                and not target.with_name(target.name + ".invalid").exists(),
                f"{name} modified files despite validation failure",
            )
        target = self.work / "duplicate-path.txt"
