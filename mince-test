            "patch branch removal did not delete the branch",
        )

    def test_patch_rejects_invalid_inputs(self) -> None:
        cases = [
            ("boolean-range", b"one\ntwo\n", "lf", {"start_line": True}, "integer"),
            ("reversed-range", b"one\ntwo\n", "lf", {"start_line": 2}, "greater than"),
            ("embedded-newline", b"one\ntwo\n", "lf",
             {"content_line_array": ["bad\nline"]}, "line endings"),
            ("nonstring-content", b"one\ntwo\n", "lf",
             {"content_line_array": [1]}, "array of strings"),
            ("wrong-eol", b"one\r\ntwo\r\n", "lf", {}, "does not match"),
            ("mixed-eol", b"one\r\ntwo\n", "lf", {}, "mixed line endings"),
            ("empty-range", b"", "lf", {"start_line": 2, "end_line": 2}, "line 1"),
        ]
        for name, source, line_ending, updates, diagnostic in cases:
            target = self.work / f"invalid-{name}.txt"
            target.write_bytes(source)
            patch = self._replacement_patch(["updated"])
            patch.update(updates)
            manifest = self._patch_manifest(target, line_ending=line_ending, patches=[patch])
            manifest_path = self.work / f"invalid-{name}.json"
