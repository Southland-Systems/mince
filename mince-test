class TestFailure(Exception):
    """An expected integration-test failure."""


def require(condition: bool, message: str) -> None:
    if not condition:
        raise TestFailure(message)


class MockResponsesAPI:
    """Serve a sequence of Responses API payloads on loopback only."""

    def __init__(
        self,
        responses: list[Any],
        *,
        tool_responses: dict[str, list[Any]] | None = None,
    ) -> None:
        if not responses:
            raise ValueError("at least one mock response is required")
        self.responses = responses
        self.tool_responses = tool_responses or {}
        self._response_indexes: dict[str, int] = {}
        self.requests: list[dict[str, Any]] = []
        self.authorization_headers: list[str] = []
        self._lock = threading.Lock()
        self._server: ThreadingHTTPServer | None = None
        self._thread: threading.Thread | None = None
        self.url = ""

    @staticmethod
    def tool_response(*calls: tuple[str, dict[str, Any]]) -> dict[str, Any]:
        return {
            "output_items": [
                {
                    "id": f"fc_offline_{index}",
                    "type": "function_call",
                    "status": "completed",
                    "call_id": f"call_offline_{index}",
                    "name": name,
                    "arguments": json.dumps(arguments, ensure_ascii=False),
                }
                for index, (name, arguments) in enumerate(calls)
            ]
        }

    @staticmethod
    def reasoning_item(name: str) -> dict[str, Any]:
        return {
            "id": f"rs_offline_{name}",
            "type": "reasoning",
            "summary": [
                {"type": "summary_text", "text": "Offline reasoning summary"},
            ],
            "encrypted_content": f"offline-encrypted-{name}",
        }

    @staticmethod
    def _payload(value: Any, index: int) -> bytes:
        usage: dict[str, Any] = {}
        output_items = None
        if isinstance(value, str):
            output_text = value
        elif isinstance(value, dict):
            if "output_items" in value:
                output_items = value["output_items"]
                if not isinstance(output_items, list):
                    raise ValueError("mock output_items must be an array")
                output_text = ""
            elif "output_text" in value:
                output_text = value["output_text"]
            elif "output" in value:
                output_text = json.dumps(
                    value["output"],
                    separators=(",", ":"),
                    ensure_ascii=False,
                )
            else:
                raise ValueError("mock response requires output, output_text, or output_items")
            usage = value.get("usage", {})
        else:
            raise ValueError("mock response must be a string or object")
        if not isinstance(output_text, str):
            raise ValueError("mock response output must be text")
        if output_items is None:
            output_items = [
                {
                    "id": f"msg_offline_{index}",
                    "type": "message",
                    "status": "completed",
                    "role": "assistant",
                    "content": [
                        {
                            "type": "output_text",
                            "text": output_text,
                            "annotations": [],
                            "logprobs": [],
                        }
                    ],
                }
            ]
        if isinstance(value, dict):
            reasoning_items = value.get("reasoning_items", [])
            if not isinstance(reasoning_items, list):
                raise ValueError("mock reasoning_items must be an array")
            output_items = [*reasoning_items, *output_items]
        if not isinstance(usage, dict) or not usage:
            usage = {
                "input_tokens": 8,
                "output_tokens": 4,
                "total_tokens": 12,
                "input_tokens_details": {"cached_tokens": 0},
                "output_tokens_details": {"reasoning_tokens": 0},
            }
        response = {
            "id": f"resp_offline_{index}",
            "object": "response",
            "created_at": 1700000000,
            "status": "completed",
            "background": False,
            "error": None,
            "incomplete_details": None,
            "instructions": None,
            "max_output_tokens": None,
            "max_tool_calls": None,
            "metadata": {},
            "model": "offline-test-model",
            "output": output_items,
            "parallel_tool_calls": True,
            "previous_response_id": None,
            "prompt": None,
            "reasoning": {"effort": None, "summary": None},
            "safety_identifier": None,
            "service_tier": "default",
            "store": False,
            "temperature": 1,
            "text": {"format": {"type": "text"}, "verbosity": "medium"},
            "tool_choice": "auto",
            "tools": [],
            "top_logprobs": 0,
            "top_p": 1,
            "truncation": "disabled",
            "usage": usage,
            "user": None,
        }
        if isinstance(value, dict):
            response_fields = value.get("response_fields", {})
            if not isinstance(response_fields, dict):
                raise ValueError("mock response_fields must be an object")
            response.update(response_fields)
        return json.dumps(response, ensure_ascii=False).encode("utf-8")

    def __enter__(self) -> "MockResponsesAPI":
        owner = self

        class Handler(BaseHTTPRequestHandler):
            def do_POST(self) -> None:
                length = int(self.headers.get("Content-Length", "0"))
                body = self.rfile.read(length)
                try:
                    request = json.loads(body.decode("utf-8"))
                except (UnicodeDecodeError, json.JSONDecodeError):
                    request = {"raw": body.decode("utf-8", errors="replace")}
                if not isinstance(request, dict):
                    request = {"value": request}
                with owner._lock:
                    owner.requests.append(request)
                    owner.authorization_headers.append(
                        self.headers.get("Authorization", "")
                    )
                    index = len(owner.requests) - 1
                    route = next((
                        tool["name"]
                        for tool in request.get("tools", [])
                        if isinstance(tool, dict)
                        and tool.get("name") in owner.tool_responses
                    ), "")
                    responses = owner.tool_responses.get(route, owner.responses)
                    response_index = owner._response_indexes.get(route, 0)
                    owner._response_indexes[route] = response_index + 1
                    if response_index < len(responses):
                        response_value = responses[response_index]
                    else:
                        response_value = {
                            "http_status": 400,
                            "error": {
                                "message": "offline mock response sequence exhausted",
                                "type": "invalid_request_error",
                                "code": "mock_exhausted",
                            },
                        }
                status = (
                    response_value.get("http_status", 200)
                    if isinstance(response_value, dict)
                    else 200
                )
                if status != 200:
                    payload = json.dumps(
                        {"error": response_value["error"]},
                        ensure_ascii=False,
                    ).encode("utf-8")
                    self.send_response(status)
                    self.send_header("Content-Type", "application/json")
                    self.send_header("Content-Length", str(len(payload)))
                    self.end_headers()
                    self.wfile.write(payload)
                    return
                response_payload = json.loads(
                    owner._payload(response_value, index).decode("utf-8")
                )
                if request.get("stream") is True:
                    output_text = "".join(
                        content["text"]
                        for item in response_payload["output"]
                        if item.get("type") == "message"
                        for content in item.get("content", [])
                        if content.get("type") == "output_text"
                    )
                    midpoint = max(1, len(output_text) // 2)
                    chunks = [output_text[:midpoint], output_text[midpoint:]]
                    events = [
                        {
                            "type": "response.output_text.delta",
                            "content_index": 0,
                            "delta": chunk,
                            "item_id": f"msg_offline_{index}",
                            "logprobs": [],
                            "obfuscation": "",
                            "output_index": 0,
                            "sequence_number": sequence_number,
                        }
                        for sequence_number, chunk in enumerate(chunks)
                    ]
                    events.append(
                        {
                            "type": f"response.{response_payload['status']}",
                            "response": response_payload,
                            "sequence_number": len(events),
                        }
                    )
                    if isinstance(response_value, dict) and "stream_events" in response_value:
                        events = response_value["stream_events"]
                        if not isinstance(events, list) or any(
                            not isinstance(event, dict) for event in events
                        ):
                            raise ValueError("mock stream_events must be an array of objects")
                    self.send_response(200)
                    self.send_header("Content-Type", "text/event-stream")
                    self.send_header("Cache-Control", "no-cache")
                    self.end_headers()
                    for event in events:
                        event_text = (
                            f"event: {event['type']}\n"
                            f"data: {json.dumps(event, ensure_ascii=False)}\n\n"
                        ).encode("utf-8")
                        self.wfile.write(event_text)
                        self.wfile.flush()
                    return
                payload = json.dumps(
                    response_payload, ensure_ascii=False
                ).encode("utf-8")
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(payload)))
                self.end_headers()
                self.wfile.write(payload)

            def log_message(self, format: str, *args: object) -> None:
                return

        self._server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
        self._server.daemon_threads = True
        self._thread = threading.Thread(
            target=self._server.serve_forever,
            name="mince-test-mock",
            daemon=True,
        )
        self._thread.start()
        self.url = f"http://127.0.0.1:{self._server.server_port}/v1"
        return self

    def __exit__(self, exc_type: object, exc_value: object, traceback: object) -> bool:
        if self._server is not None:
            self._server.shutdown()
            self._server.server_close()
        if self._thread is not None:
            self._thread.join(timeout=5)
            if self._thread.is_alive():
                raise TestFailure("offline mock server did not stop")
        return False


class OfflineTests:
    def __init__(self) -> None:
        self._temporary_directory = tempfile.TemporaryDirectory(
            prefix="mince-test-",
        )
        self.root = Path(self._temporary_directory.name)
        self.home = self.root / "home"
        self.work = self.root / "work"
        self.home.mkdir()
        self.work.mkdir()
        self.contain_bin = self.root / "contain-bin"
        self.contain_bin.mkdir()
        self.systemd_run = self.contain_bin / "systemd-run"
        # Inspect wrapper invocations without starting a real systemd service.
        self.systemd_run.write_text(
            "#!/usr/bin/env python3\n"
            "import json, os, sys\n"
            "from pathlib import Path\n"
            "arguments = sys.argv[1:]\n"
            "capture = os.environ.get('MINCE_TEST_SYSTEMD_CAPTURE')\n"
            "if capture:\n"
            "    Path(capture).write_text(json.dumps({\n"
            "        'arguments': arguments,\n"
            "        'environment': dict(os.environ),\n"
            "    }), encoding='utf-8')\n"
            "if os.environ.get('MINCE_TEST_SYSTEMD_EXECUTE') == '1':\n"
            "    command = arguments[arguments.index('--') + 1:]\n"
            "    os.execvpe(command[0], command, os.environ)\n"
            "raise SystemExit(int(os.environ.get('MINCE_TEST_SYSTEMD_STATUS', '0')))\n",
            encoding="utf-8",
        )
        self.systemd_run.chmod(0o700)
        self.strace = self.contain_bin / "strace"
        # Record tracing arguments and execute the child without real tracing.
        self.strace.write_text(
            "#!/usr/bin/env python3\n"
            "import json, os, sys\n"
            "from pathlib import Path\n"
            "arguments = sys.argv[1:]\n"
            "capture = os.environ.get('MINCE_TEST_STRACE_CAPTURE')\n"
            "if capture:\n"
            "    with Path(capture).open('a', encoding='utf-8') as file:\n"
            "        file.write(json.dumps(arguments) + '\\n')\n"
            "trace_path = Path(arguments[arguments.index('-o') + 1])\n"
            f"trace_path.write_text({OFFLINE_TRACE_TEXT!r}, encoding='utf-8')\n"
            "command = arguments[arguments.index('--') + 1:]\n"
            "os.execvpe(command[0], command, os.environ)\n",
            encoding="utf-8",
        )
        self.strace.chmod(0o700)
        self.test_path = os.pathsep.join(
            (str(self.contain_bin), os.environ.get("PATH", os.defpath))
        )
        cache_name = hashlib.sha1(
            b"https://openaipublic.blob.core.windows.net/encodings/o200k_base.tiktoken"
        ).hexdigest()
        cache_directories = [
            Path.home() / ".local/state/mince/tiktoken",
            Path(tempfile.gettempdir()) / "data-gym-cache",
        ]
        for variable in ("TIKTOKEN_CACHE_DIR", "DATA_GYM_CACHE_DIR"):
            if os.environ.get(variable):
                cache_directories.insert(0, Path(os.environ[variable]))
        self._token_cache_available = False
        for directory in cache_directories:
            source = directory / cache_name
            if source.is_file():
                destination = self.home / ".local/state/mince/tiktoken" / cache_name
                destination.parent.mkdir(parents=True, exist_ok=True)
                shutil.copyfile(source, destination)
                self._token_cache_available = True
                break

    def run(
        self,
        *arguments: object,
        check: bool = True,
        cwd: Path | None = None,
        input_text: str | None = None,
        executable: str = "mince",
        environment_updates: dict[str, str | None] | None = None,
        pass_fds: tuple[int, ...] = (),
    ) -> subprocess.CompletedProcess[str]:
        environment = os.environ.copy()
        environment.update(
            {
                "HOME": str(self.home),
                "OPENAI_API_KEY": "offline-test-key",
                "NO_PROXY": "127.0.0.1,localhost",
                "no_proxy": "127.0.0.1,localhost",
                "HTTP_PROXY": "",
                "HTTPS_PROXY": "",
                "ALL_PROXY": "",
                "http_proxy": "",
                "https_proxy": "",
                "all_proxy": "",
            }
        )
        if executable == "mince-contain":
            environment["PATH"] = self.test_path
        for name, value in (environment_updates or {}).items():
            if value is None:
                environment.pop(name, None)
            else:
                environment[name] = value

        # Resolve both commands through PATH, not a repository path or interpreter.
        command = [executable]
        if executable == "mince":
            tokenizing_options = {
                "--ask", "--ask-file", "--task", "--task-file", "--task-files",
                "--resume-session", "--reuse-session",
                "--tree-task", "--tree-task-file",
                "--tree-reuse-session",
            }
            if any(str(argument) in tokenizing_options for argument in arguments):
                require(
                    self._token_cache_available,
                    "Offline tokenizer cache is missing. Before running mince-test, "
                    "prewarm o200k_base using: "
                    "TIKTOKEN_CACHE_DIR=\"$HOME/.local/state/mince/tiktoken\" "
                    "python3 -c 'import tiktoken; tiktoken.get_encoding(\"o200k_base\")'",
                )
            command.extend(
                [
                    "--base-url", "http://127.0.0.1:1/v1",
                    "--retry", "0", "--api-log", "off",
                ]
            )
        command.extend(str(argument) for argument in arguments)
        completed = subprocess.run(
            command,
            cwd=cwd or self.work,
            env=environment,
            input=input_text,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=30,
            check=False,
            pass_fds=pass_fds,
        )
        if check and completed.returncode != 0:
            raise TestFailure(
                f"{command!r} failed\n"
                f"stdout:\n{completed.stdout}\n"
                f"stderr:\n{completed.stderr}"
            )
        return completed

    def contain_command(
        self,
        *arguments: object,
        cwd: Path | None = None,
        environment_updates: dict[str, str | None] | None = None,
    ) -> list[str]:
        result = self.run(
            "--contain-dry-run", *arguments,
            executable="mince-contain",
            cwd=cwd,
            environment_updates=environment_updates,
        )
        command = shlex.split(result.stdout)
        require(
            bool(command) and "--" in command,
            "containment dry-run did not print a systemd-run command",
        )
        return command

    def shell_session_response(self, session_name: str) -> dict[str, Any]:
        result = self.run(
            "--shell-session-print-json",
            session_name,
        )
        try:
            response = json.loads(result.stdout)
        except json.JSONDecodeError as exc:
            raise TestFailure(
                "shell session JSON response could not be decoded: "
                f"{exc}"
            ) from exc
        require(
            isinstance(response, dict),
            "shell session JSON response was not an object",
        )
        return response

    def state_artifacts(
        self,
        session_name: str,
        *values: object,
    ) -> dict[str, str]:
        result = self.run("--state-print-json", session_name, *values)
        try:
            artifacts = json.loads(result.stdout)
        except json.JSONDecodeError as exc:
            raise TestFailure(
                f"state artifact JSON could not be decoded: {exc}"
            ) from exc
        require(
            isinstance(artifacts, dict)
            and all(isinstance(value, str) for value in artifacts.values()),
            "state artifact JSON was not an object of strings",
        )
        return artifacts

    def update_state_context_summary(
        self,
        session_name: str,
        turn: int,
        **updates: Any,
    ) -> None:
        artifacts = self.state_artifacts(
            session_name, turn,
            "response_agent_context_summary", "response_agent_runtime_state",
        )
        summary = json.loads(artifacts["response_agent_context_summary"])
        summary.update(updates)
        runtime = json.loads(artifacts["response_agent_runtime_state"])
        runtime["context_summary"] = summary
        directory = self.home / ".local/state/mince/state" / session_name / str(turn)
        for name, value in (
            ("response_agent_context_summary", summary),
            ("response_agent_runtime_state", runtime),
        ):
            (directory / name).write_text(
                json.dumps(value, ensure_ascii=False), encoding="utf-8",
            )

    def session_log(self, session_name: str) -> str:
        path = self.home / ".local/state/mince/logs" / f"{session_name}.txt"
        return path.read_text(encoding="utf-8")

    def state_snapshot(self, session_name: str) -> dict[str, bytes]:
        directory = self.home / ".local/state/mince/state" / session_name
        require(directory.is_dir(), f"state session directory is missing: {directory}")
        return {
            path.relative_to(directory).as_posix(): path.read_bytes()
            for path in directory.rglob("*")
            if path.is_file()
        }

    def state_turn_numbers(self, session_name: str) -> list[int]:
        directory = self.home / ".local/state/mince/state" / session_name
        require(directory.is_dir(), f"state session directory is missing: {directory}")
        return sorted(
            int(path.name)
            for path in directory.iterdir()
            if path.is_dir() and path.name.isascii() and path.name.isdigit()
        )

    def resumed_session_name(
        self,
        result: subprocess.CompletedProcess[str],
        source_session_name: str,
        source_turn: int,
        *,
        noninteractive: bool,
        first_local_turn: int | None = None,
    ) -> str:
        session_name = session_name_from_result(
            result, noninteractive=noninteractive,
        )
        require(
            session_name != source_session_name,
            "resuming a session did not allocate a new session name",
        )
        artifacts = self.state_artifacts(
            session_name, "resume_session", "resume_session_turn",
        )
        require(
            artifacts == {
                "resume_session": source_session_name,
                "resume_session_turn": str(source_turn),
            },
            "resumed session did not record its selected source session and turn",
        )
        if first_local_turn is None:
            first_local_turn = source_turn + 1
        turn_numbers = self.state_turn_numbers(session_name)
        require(
            bool(turn_numbers)
            and turn_numbers == list(range(first_local_turn, turn_numbers[-1] + 1)),
            "resumed session did not create the expected contiguous local turns",
        )
        return session_name

    def test_default_config(self) -> None:
        result = self.run("--print-default-config")
        config = json.loads(result.stdout)
        require(
            config["model"] == "gpt-6-luna",
            "default model is incorrect",
        )
        require(
            bool(config["linenum_system_prompt"]),
            "line-number prompt is missing",
        )
        require(
            config["patch"] == "off",
            "patch mode default is incorrect",
        )
        require(
            config["retry"] == 3
            and config["agent_context_expires"] == "24 12 48"
            and config["agent_context_assist"] == 0
            and config["agent_prompt_assist"] == 0
            and config["agent_backup"] == "off"
            and config["agent_backup_interval"] == 12
            and config["chdir"] == ""
            and config["task_files"] == ""
            and config["images"] == ""
            and config["shell_timeout"] == 0
            and config["shell_networking"] == "off"
            and config["shell_trace"] == "off"
            and config["response_json_repair"] == "off"
            and config["stream"] == "off"
            and config["explicit_prompt_cache"] == "off",
            "retry, expiry, assist, backup, input, shell, repair, streaming, or cache defaults are incorrect",
        )
        require(
            not {"system_prompt_with_task", "patch_save", "contain_networking"}.intersection(config),
            "deprecated configuration keys remain in the built-in defaults",
        )
        require(
            all(
                config[f"{name}_prompt" if name == "system" else f"{name}_system_prompt"]
                == f"@{name}"
                for name in ("system", "linenum", "patch", "plan", "shell", "agent")
            ),
            "default system prompts did not use their prompt-library aliases",
        )

    def test_builtin_profiles(self) -> None:
        expected = {
            "ask": {
                "explicit_prompt_cache": "on", "system_prompt": "",
                "line_numbers": "off", "stream": "on", "quiet": "on",
                "prompt_expansion": "on",
            },
            "task": {
                "explicit_prompt_cache": "on", "stream": "on",
                "quiet": "on", "prompt_expansion": "on",
            },
            "tree": {
                "explicit_prompt_cache": "on", "prompt_expansion": "on",
            },
            "patch": {
                "explicit_prompt_cache": "on", "patch": "on",
                "patch_review": "on", "llm_timeout": 1800, "prompt_expansion": "on",
            },
            "planpatch": {
                "explicit_prompt_cache": "on", "plan": "on",
                "patch": "on", "patch_review": "on",
                "llm_timeout": 1800, "prompt_expansion": "on",
            },
            "shell": {
                "explicit_prompt_cache": "on", "shell": "on",
                "shell_timeout": 300, "prompt_expansion": "on",
            },
            "plantask": {
                "explicit_prompt_cache": "on", "plan": "on",
                "stream": "on", "quiet": "on", "prompt_expansion": "on",
            },
            "agent": {
                "explicit_prompt_cache": "on", "agent": "on",
                "shell_timeout": 300, "llm_timeout": 1800, "prompt_expansion": "on",
            },
        }
        internal_names = [f"mce_{name}" for name in expected]
        available = set(self.run("--list-profiles").stdout.splitlines())
        require(
            {"config", *internal_names}.issubset(available)
            and not set(expected).intersection(available),
            "profile listing omitted internal profiles or materialized virtual aliases",
        )
        configs = json.loads(self.run(
            "--print-profiles-json", *internal_names, *expected,
        ).stdout)
        directory = self.home / ".local/state/mince/conf"
        for alias, settings in expected.items():
            internal_name = f"mce_{alias}"
            for name in (alias, internal_name):
                require(
                    configs[name]["model"] == "gpt-6-luna"
                    and all(configs[name][key] == value for key, value in settings.items())
                    and not (directory / f"{name}.json").exists(),
                    f"built-in profile {name} lost its inherited settings or was written to disk",
                )
            require(
                {key: value for key, value in configs[alias].items() if key != "_inherit_profile"}
