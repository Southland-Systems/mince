    @staticmethod
    def _patch_file_entry(
        path: Path,
        *,
        line_ending: str = "lf",
        patches: list[dict[str, Any]],
    ) -> dict[str, Any]:
        return {
            "document": {
                "path": str(path),
                "encoding": "utf-8",
                "line_ending": line_ending,
            },
            "patches": patches,
        }

    def _patch_manifest(
        self,
        path: Path,
        *,
        line_ending: str = "lf",
        patches: list[dict[str, Any]],
    ) -> dict[str, Any]:
        return {
            "files": [
                self._patch_file_entry(
                    path,
                    line_ending=line_ending,
                    patches=patches,
                )
            ],
            "commit_message": "Apply offline test patch",
        }

    @staticmethod
    def _replacement_patch(content: list[str]) -> dict[str, Any]:
        return {
            "patch_id": "offline-p1",
            "block_id": "offline-b1",
            "start_line": 1,
            "end_line": 1,
            "content_line_array": content,
            "summary_message": "Replace the offline fixture",
        }

