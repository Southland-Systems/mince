                "exact indexed state-artifact selection differs from grouped selection",
            )
            invalid = self.run(
                "--state-print-json", session_name, "0", "response_shell_trace_0", check=False,
            )
            require(
                invalid.returncode == 1 and "unknown state artifact type" in invalid.stderr,
