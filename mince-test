            for number, task in enumerate(tasks, start=1)
        ]
        for request_index, diagnostic in (
            (2, f"supports at most {AGENT_TASK_LIST_CAPACITY} tasks"),
            (3, f"task does not exist: {AGENT_TASK_LIST_CAPACITY + 1}"),
        ):
