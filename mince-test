            environment_updates=environment,
        )
        recorded = json.loads(capture.read_text(encoding="utf-8"))
        expected_path = os.pathsep.join(
            (str(self.contain_bin), os.environ.get("PATH", os.defpath))
        )
        require(
            json.loads(result.stdout)["retry"] == 3
            and recorded["arguments"] == command[1:]
            and recorded["environment"]["PATH"] == expected_path
            and recorded["environment"]["HOME"] == str(self.home)
            and recorded["environment"]["OPENAI_API_KEY"] == secret
            and contained_arguments(command) == ["mince", "--print-default-config"],
            "wrapper execution did not preserve arguments and environment or resolve mince through PATH",
        )
        failed = self.run(
            *arguments, executable="mince-contain", cwd=self.work, check=False,
            environment_updates={
                **environment,
                "MINCE_TEST_SYSTEMD_EXECUTE": "0",
                "MINCE_TEST_SYSTEMD_STATUS": "7",
            },
        )
        require(
            failed.returncode == 7 and failed.stdout == "" and failed.stderr == "",
            "wrapper execution did not propagate the systemd-run exit status",
        )

    def close(self) -> None:
        self._temporary_directory.cleanup()


def re_search(pattern: str, text: str) -> str | None:
    match = re.search(pattern, text)
    return match.group(1) if match else None


def request_prompt(request: dict[str, Any]) -> str:
    input_value = request.get("input")
    if isinstance(input_value, str):
        return input_value
    require(isinstance(input_value, list), "request input was neither text nor an item array")
    messages = [
        item for item in input_value
        if isinstance(item, dict) and item.get("role") == "user"
    ]
    require(
        len(messages) == 1 and isinstance(messages[0].get("content"), str),
        "request input did not contain exactly one text user message",
    )
    return str(messages[0]["content"])


def prompt_section(prompt: str, tag: str) -> str:
    section = re_search(
        rf"(?s)<{re.escape(tag)}(?:\s[^>]*)?>\n(.*?)\n</{re.escape(tag)}>",
        prompt,
    )
    require(section is not None, f"request prompt omitted <{tag}>")
    return str(section)


def contained_arguments(command: list[str]) -> list[str]:
    require("--" in command, "systemd-run command omitted its argument separator")
    return command[command.index("--") + 1:]


def systemd_properties(command: list[str]) -> dict[str, str]:
    require("--" in command, "systemd-run command omitted its argument separator")
    properties: dict[str, str] = {}
    for argument in command[:command.index("--")]:
        if not argument.startswith("--property="):
            continue
        name, separator, value = argument[len("--property="):].partition("=")
        require(
            bool(separator) and bool(name) and name not in properties,
            f"invalid or duplicate systemd property: {argument}",
        )
        properties[name] = value
    return properties


def session_name_from_result(
    result: subprocess.CompletedProcess[str],
    *,
    noninteractive: bool,
 ) -> str:
    if noninteractive:
        lines = result.stdout.rstrip().splitlines()
        session_name = re_search(r"^([^=\s]+)$", lines[-1]) if lines else None
    else:
        session_name = re_search(
            r"(?m)^session_name=(\S+)$",
            result.stderr,
        )
    expected_output = (
        "a plain session name"
        if noninteractive
        else "session_name=SESSION"
    )
    require(
        session_name is not None,
        f"{expected_output} was not printed",
    )
    return str(session_name)


