            }
            expected_traces = {
                f"response_shell_trace_{call_index}_{command_index}": OFFLINE_TRACE_TEXT
                for call_index, group in enumerate(command_groups)
                for command_index in range(1, len(group) + 1)
            }
            require(
                set(outputs) == expected_output_names and traces == expected_traces
                and "<stdout>\ntrace-input\n</stdout>" in outputs["response_shell_output_0"]
                and "<exit_status>3</exit_status>" in outputs["response_shell_output_0"]
                and "<stderr>\ntrace-error</stderr>" in outputs["response_shell_output_0"],
                f"{mode} tracing lost indexed output, trace files, standard input, or exit status",
