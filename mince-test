                    "--model", "offline-test-model", "--base-url", mock.url,
                    "--log", "off", check=False,
                    environment_updates={"PATH": str(isolated_bin)},
                )
                require(
                    failed.returncode == 1 and diagnostic in failed.stderr,
                    "invalid shell tracing was accepted or omitted its diagnostic",
                )
