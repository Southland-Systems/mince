    def test_repeated_prompts_and_live_task_files(self) -> None:
        first = self.work / "first live task.txt"
        second = self.work / "second live task.txt"
        configured = self.work / "overridden-task.txt"
        configured.write_text("Overridden configured task\n", encoding="utf-8")
        profile = "live_task_files"
        inline = ("First inline task", "Second inline task")
        initial_task = "\n\n".join((*inline, "First task file", "Second task file"))
        updated_task = "\n\n".join((*inline, "First task file", "Updated second task file"))
        commands = {
            "commands": [{
                "command": (
                    f"printf 'Updated second task file\\n' > {shlex.quote(str(second))}"
                ),
                "reason": "Change a task file before the next request",
            }],
        }
        self.run("--inherit-profile", profile)
        try:
            for mode in ("agent", "shell"):
                first.write_text("First task file\n", encoding="utf-8")
                second.write_text("Second task file\n", encoding="utf-8")
                configured_paths = (
                    shlex.quote(str(configured))
                    if mode == "agent"
                    else "|".join(shlex.quote(str(path)) for path in (first, second))
                )
                self.run(
                    "--profile", profile, "--set-config",
                    f"task_files={configured_paths}",
                )
                options = (
                    ("--task-file", first, "--task-files", second)
                    if mode == "agent"
                    else ()
                )
                responses = (
                    [
                        MockResponsesAPI.tool_response(("shell", commands)),
                        MockResponsesAPI.tool_response(("session", {
                            "action": "end", "reason": "Live agent task files checked",
                        })),
                    ]
                    if mode == "agent"
                    else [
                        {"output": commands},
                        {"output": {
                            "action": "session_end", "commands": [],
                            "reason": "Live shell task files checked",
                        }},
                    ]
                )
                with MockResponsesAPI(responses) as mock:
                    result = self.run(
                        "--profile", profile,
                        "--task", "First", "inline", "task",
                        "-t", inline[1], *options, f"--{mode}",
                        "--model", "offline-test-model", "--base-url", mock.url,
                        "--log", "off", input_text="y\n" if mode == "shell" else None,
                    )
                require(len(mock.requests) == 2, f"{mode} task files made unexpected requests")
                session_name = session_name_from_result(result, noninteractive=False)
                for turn, request, task in zip(
                    (0, 1), mock.requests, (initial_task, updated_task),
                ):
                    require_task_placement(request, task)
                    artifacts = self.state_artifacts(session_name, turn)
                    require_state_request(artifacts, request)
                    require(
                        artifacts["request_task"] == task
                        and "Overridden configured task" not in request_instructions(request),
                        f"{mode} combined repeated tasks and task files in the wrong order or retained stale text",
                    )
                require(
                    prompt_section(request_prompt(mock.requests[0]), "files") == ""
                    and first.read_text(encoding="utf-8") == "First task file\n"
                    and second.read_text(encoding="utf-8") == "Updated second task file\n"
                    and configured.read_text(encoding="utf-8") == "Overridden configured task\n",
                    "task-file inputs were loaded as file context or the live update changed unrelated inputs",
                )
        finally:
            self.run("--remove-profile", profile)
        with MockResponsesAPI(["Combined offline ask answer"]) as mock:
            result = self.run(
                "--ask", "First", "inline", "ask", "-a", "Second inline ask",
                "--model", "offline-test-model", "--base-url", mock.url, "--log", "off",
            )
        require(
            len(mock.requests) == 1
            and request_prompt(mock.requests[0]) == "First inline ask\n\nSecond inline ask"
            and result.stdout == "Combined offline ask answer\n",
            "repeated ask arguments were not combined in order",
        )
        conflicting = self.run(
            "--ask", "Invalid mixed prompts", "--task-files", first, check=False,
        )
        require(
            conflicting.returncode == 2
            and "cannot be combined with --task or --task-file" in conflicting.stderr,
            "the task-files alias bypassed ask/task mutual exclusion",
        )

