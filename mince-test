        self.run("--inherit-profile", profile)
        try:
            self.run(
                "--profile", profile, "--set-config",
                "images=" + "|".join(shlex.quote(str(path)) for path in images),
            )
            with MockResponsesAPI([
                {"output_text": "Offline image answer", "reasoning_items": [reasoning_item]},
