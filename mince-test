                ("session", {"action": "end", "reason": "Leading retention is not executable"}),
            ), "Agent returned no executable tool call"),
            (MockResponsesAPI.tool_response(("unknown_offline_tool", {})),
             "unknown function call: unknown_offline_tool"),
        ]
        for invalid, diagnostic in invalid_cases:
            with MockResponsesAPI([invalid]) as mock:
