            require(
                not request_file_contexts(mock.requests[0])
                and not request_file_contexts(mock.requests[2])
                and set(request_file_contexts(mock.requests[3])) == {str(target)}
                and self.state_artifacts(source_name, "request_files")["request_files"] == ""
                and json.loads(self.state_artifacts(
                    patch_name, "0", "response_schema_patch",
                )["response_schema_patch"]) == manifest
                and not created.exists()
                and self.state_snapshot(source_name) == source_state
                and all(path.read_bytes() == content for path, content in zip(images, contents)),
                "image-only tasks, patch proposals, tree context, or resumed state modified their original inputs",
            )
        finally:
            self.run("--remove-profile", profile)

    @staticmethod
    def _patch_file_entry(
        path: Path,
        *,
        line_ending: str = "lf",
        patches: list[dict[str, Any]],
    ) -> dict[str, Any]:
        return {
            "document": {
                "path": str(path),
                "encoding": "utf-8",
                "line_ending": line_ending,
            },
            "patches": patches,
        }

    def _patch_manifest(
        self,
        path: Path,
        *,
        line_ending: str = "lf",
        patches: list[dict[str, Any]],
    ) -> dict[str, Any]:
        return {
            "files": [
                self._patch_file_entry(
                    path,
                    line_ending=line_ending,
                    patches=patches,
                )
            ],
            "commit_message": "Apply offline test patch",
        }

    @staticmethod
    def _replacement_patch(content: list[str]) -> dict[str, Any]:
        return {
            "patch_id": "offline-p1",
            "block_id": "offline-b1",
            "start_line": 1,
            "end_line": 1,
            "content_line_array": content,
            "summary_message": "Replace the offline fixture",
        }

