    def test_shell_rejects_invalid_followups(self) -> None:
        marker = self.work / "invalid-shell-followup-executed.txt"
        step = {
            "command": f"printf unexpected > {shlex.quote(str(marker))}",
            "reason": "This invalid follow-up proposal must not run",
        }
        initial = {
            "commands": [{
                "command": "printf initial-followup-output",
                "reason": "Produce output before validating the follow-up",
            }],
        }
        ended = {
            "action": "session_end", "commands": [], "reason": "Offline shell work completed",
        }
        cases = [
            ("nonobject", [], "must contain a JSON object"),
            ("unexpected-field", {**ended, "extra": True},
             "must contain only action, commands, and reason"),
            ("unknown-action", {**ended, "action": "continue"},
             "action must be commands or session_end"),
            ("nonarray-commands", {**ended, "commands": {}}, "commands must be an array"),
            ("nonstring-reason", {**ended, "reason": None}, "reason must be a string"),
            ("nonempty-completion", {**ended, "commands": [step]},
             "session_end commands must be empty"),
            ("empty-completion", {**ended, "reason": " "},
             "session_end reason cannot be empty"),
            ("empty-next-commands", {**ended, "action": "commands"}, "non-empty array"),
            ("invalid-next-step", {
                **ended, "action": "commands", "commands": [{**step, "reason": " "}],
            }, "non-empty reason"),
        ]
        for name, proposal, diagnostic in cases:
            with MockResponsesAPI([{"output": initial}, {"output": proposal}]) as mock:
                failed = self.run(
                    "--task", "Reject the invalid offline shell follow-up.", "--shell",
                    "--model", "offline-test-model", "--base-url", mock.url,
                    "--retry", "1", "--log", "off",
                    input_text="y\ny\n", check=False,
                )
            require(
                failed.returncode == 1 and len(mock.requests) == 2
                and diagnostic in failed.stderr and not marker.exists(),
                f"{name} shell follow-up was accepted, executed, retried, or omitted its diagnostic",
            )
            session_name = session_name_from_result(failed, noninteractive=False)
            first_state = self.state_artifacts(session_name, "0")
            rejected_state = self.state_artifacts(session_name, "1")
            output = first_state["response_shell_output_0"]
            require(
                self.state_turn_numbers(session_name) == [0, 1]
                and json.loads(first_state["response"]) == initial
                and "response_error" not in first_state
                and "<exit_status>0</exit_status>" in output
                and "<stdout>\ninitial-followup-output</stdout>" in output
                and output in request_prompt(mock.requests[1])
                and not shell_output_artifacts(rejected_state),
                f"{name} shell follow-up lost the accepted output or recorded execution for an invalid proposal",
            )
            require_failed_state_turn(rejected_state, diagnostic)
            require_state_request(first_state, mock.requests[0])
            require_state_request(rejected_state, mock.requests[1])
            require(
                json.loads(self.state_artifacts(session_name, "response")["response"]) == initial,
                "an invalid shell follow-up was selected as the last completed turn",
            )

