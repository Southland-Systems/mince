    def test_contain_modes_and_shell_selection(self) -> None:
        state = self.home / ".local/state/mince"
        state.mkdir(parents=True, exist_ok=True)
        cases = [
            ("readonly", "persistent", "on", "host", (), "read-only", "persistent"),
            ("private", "temporary", "off", "private",
             ("--contain-allow-namespaces", "--contain-timeout=9"), "tmpfs", "ephemeral"),
            ("inaccessible", "readonly", "off", "off", (), "yes", "read-only"),
            ("off", "persistent", "false", "on", ("--contain-no-private-tmp",), "no", "persistent"),
        ]
        for home, state_mode, private_tmp, network, extra, expected_home, expected_state in cases:
            command = self.contain_command(
                f"--contain-home={home}", "--contain-state", state_mode,
                "--contain-private-tmp", private_tmp, f"--contain-network={network}",
                *extra, "--print-default-config", cwd=self.work,
            )
            properties = systemd_properties(command)
            require(
                properties["ProtectHome"] == expected_home
                and properties["PrivateTmp"] == ("yes" if private_tmp == "on" else "no")
                and properties["PrivateDevices"] == "yes"
                and ("RestrictNamespaces" not in properties)
                == ("--contain-allow-namespaces" in extra),
                "containment visibility, temporary directory, device, or namespace mode was incorrect",
            )
            if network in ("private", "off"):
                require(
                    properties.get("PrivateNetwork") == "yes"
                    and properties.get("RestrictAddressFamilies") == "AF_UNIX",
                    "disabled containment networking omitted its restrictions",
                )
            else:
                require(
                    "PrivateNetwork" not in properties and "RestrictAddressFamilies" not in properties,
                    "host containment networking unexpectedly added restrictions",
                )
            require(
                properties.get("RuntimeMaxSec") == ("9s" if "--contain-timeout=9" in extra else None),
                "containment runtime limit was not applied only when requested",
            )
            writable = shlex.split(properties.get("ReadWritePaths", ""))
            read_only = shlex.split(properties.get("ReadOnlyPaths", ""))
            temporary = shlex.split(properties.get("TemporaryFileSystem", ""))
            if expected_state == "read-only":
                require(
                    str(state) in read_only and str(state) not in writable and not temporary,
                    "read-only state was exposed as writable or ephemeral",
                )
            else:
                require(
                    str(state) in writable and str(state) not in read_only
                    and temporary == ([f"{state}:rw"] if expected_state == "ephemeral" else []),
                    "persistent or ephemeral state grants were incorrect",
                )
                if expected_state == "ephemeral":
                    require(
                        str(state) not in shlex.split(properties.get("BindPaths", "")),
                        "ephemeral state explicitly bound the host state directory",
                    )
        shell_path = shutil.which("sh")
        require(shell_path is not None, "sh is required for shell-selection coverage")
        command = self.contain_command(
            "--contain-use-shell", "--agent", "--task", "Ignored shell-mode arguments",
            cwd=self.work, environment_updates={"SHELL": "sh"},
        )
        require(
            contained_arguments(command) == [str(Path(str(shell_path)).absolute())]
            and systemd_properties(command)["PrivateDevices"] == "yes",
            "shell mode did not resolve SHELL through PATH or ignored arguments changed its command",
        )

