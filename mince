                relative_path = git_relative_path(patch_repo_root, path)
                branch_path = run_git_command(
                    patch_repo_root,
                    [
                        "ls-tree", "--name-only", "-z",
                        patch_branch_name, "--", relative_path,
                    ],
                ).stdout
                if path.exists() or branch_path:
                    raise ValueError(
                        "existing patch branch targets must be included "
                        f"in file context: {path}"
                    )
        return build_patch_changes(original_texts, manifest)

    def request_model_turn(
        request_system_prompt: str,
        request_user_prompt: str,
        *,
        response_format_override: str | None = None,
        json_schema_override: dict[str, Any] | None = None,
        request_tokens: int | None = None,
        stream: bool = False,
    ) -> tuple[str, str]:
        nonlocal state_turn, state_turn_path, response_obj, stream_output_emitted
        nonlocal reasoning_items
        if agent_backup is not None:
            agent_backup.run_if_due()
        current_turn = state_turn if state_enabled else None
        stats_prefix = (
            "request_type=shell" if shell_mode
            else "request_type=patch" if patch_mode
            else "request_type=ask" if ask_mode
            else "request_type=task"
        )
        request = RecordedModelTurn(
            ModelRequestSettings(model_settings, token_limit, token_cost),
            cumulative_stats,
            append_log,
            turn=current_turn,
            prefix=stats_prefix,
        )
        request.prepare(
            request_system_prompt, request_user_prompt,
            request_tokens=request_tokens,
        )
        request.check_token_limit()
        request.log_request()
        if state_enabled:
            request.start_state(
                state_session_dir, state_turn, task, file_paths
            )
        stream_sink = None
        stream_output_emitted = False
        try:
            with request.record():
                if stream and not print_reasoning:
                    def emit_stream_text(delta: str) -> None:
                        nonlocal stream_output_emitted
                        if OUTPUT_FILE is not None:
                            write_output_file(delta)
                        else:
                            sys.stdout.write(delta)
                            sys.stdout.flush()
                        stream_output_emitted = True

                    stream_sink = emit_stream_text

                def request_response() -> tuple[str, Any]:
                    response_obj, response = request.call(
                        image_urls=image_urls,
                        response_format=(
                            response_format
                            if response_format_override is None
                            else response_format_override
                        ),
                        json_schema=(
                            json_schema
                            if response_format_override is None
                            else json_schema_override
                        ),
                        stream=stream,
                        emit=stream_sink,
                        retry=0,
                        report_errors=False,
                        reasoning_items=reasoning_items if state_enabled else None,
                    )
                    if not response.strip():
                        raise ModelResponseError("LLM returned an empty response")
                    return response, response_obj

                response, response_obj = execute_openai_request(
                    request_response,
                    retry=model_settings.retry,
                    operation_name="API request",
                    error_logger=append_log,
                    retry_if=lambda exc: (
                        not stream_output_emitted and _is_openai_temp_error(exc)
                    ),
                )
                if shell_mode:
                    parse_shell_response(
                        response,
                        response_json_repair,
                        followup=json_schema_override is SHELL_FOLLOWUP_SCHEMA,
                    )
                elif patch_mode:
                    build_current_patch_changes(
                        parse_json_response(response, response_json_repair)
                    )
                elif (
                    response_format
                    if response_format_override is None
                    else response_format_override
                ) in ("json", "schema"):
                    parse_json_response(response, response_json_repair)
                reasoning, response_reasoning_items = request.complete(
                    response_obj, response
                )
                if request.turn_dir is not None:
                    state_turn += 1
                reasoning_items = response_reasoning_items
        except Exception as exc:
            request.record_error(exc)
            raise
        finally:
            log_model_response_stats(request.response_stats)
        state_turn_path = request.turn_dir
        return response, reasoning

    if resume_reused_shell_turn:
        result = reused_shell_turn.response
        reasoning = reused_shell_turn.reasoning
        try:
            if agent_backup is not None:
                agent_backup.run_if_due()
            state_turn_path = start_state_turn(
                state_session_dir,
                state_turn,
                full_system_prompt,
                task,
                file_paths=file_paths,
            )
            parse_shell_response(result, response_json_repair, followup=None)
            reused_request = read_optional_state_artifact(
                reused_shell_turn.turn_dir / "request"
            )
            if reused_request is not None:
                write_state_artifact(
                    state_turn_path,
                    "request",
                    reused_request,
                )
            if reused_shell_turn.shell_output is not None:
                write_state_artifact(
                    state_turn_path,
                    "response_shell_output_0",
                    reused_shell_turn.shell_output,
                )
            complete_state_turn(
                state_turn_path, reasoning, result, reasoning_items
            )
            state_turn += 1
        except Exception as exc:
            if state_turn_path is not None:
                append_state_response_error(state_turn_path, exc)
            print(
                f"ERROR: Failed to save resumed shell turn: {exc}",
                file=sys.stderr,
            )
            return 1
        reused_request_characters = (
            len(reused_request) if reused_request is not None else 0
        )
        reused_request_tokens = (
            len(token_encoding_for_model(model).encode(reused_request))
            if reused_request is not None
            else 0
        )
        append_log(
            f"<resumed_shell_turn path={quote_tag_attribute(reused_shell_turn.turn_dir)}>\n"
        )
        if reused_request is not None:
            reused_record = RecordedModelTurn(
                ModelRequestSettings(model_settings, token_limit, None),
                cumulative_stats,
                append_log,
                turn=int(state_turn_path.name),
                prefix="request_type=shell reused=true",
                request_text=reused_request,
                request_tokens=reused_request_tokens,
                request_characters=reused_request_characters,
            )
            reused_record.log_request()
        else:
            append_log(
                "<request_unavailable>Saved shell turn has no request text.</request_unavailable>\n"
            )
        append_log(format_model_response_log(result, reasoning))
        log_model_response_stats(
            format_response_stats(
                request_characters=reused_request_characters,
                request_tokens=reused_request_tokens,
                processing_time=0.0,
                response_text=result,
                cumulative_stats=cumulative_stats,
                turn=int(state_turn_path.name),
                prefix="request_type=shell reused=true",
            )
        )
        append_log("</resumed_shell_turn>\n")
    else:
        try:
            result, reasoning = request_model_turn(
                full_system_prompt,
                user_prompt,
                request_tokens=request_tokens,
                stream=stream_enabled,
            )
        except Exception as exc:
            report_request_error(exc)
            return 1


    shell_turn_history: list[ShellTurn] = []
    archived_shell_turns: list[ShellTurn] = []
    pending_reused_shell_output = (
        reused_shell_turn.shell_output
        if resume_reused_shell_turn and reused_shell_turn is not None
        else None
    )

    def request_shell_revision(
        revision_task: str,
        shell_commands: list[ShellStep],
    ) -> tuple[str, str]:
        nonlocal task, full_system_prompt
        previous_task = task
        if task_file_prompt is None:
            task = expand_prompt_names(revision_task, prompt_expansion_enabled)
        else:
            task_file_prompt.text = revision_task
            task = task_file_prompt.read()
        full_system_prompt, revision_user_prompt = build_request_prompts(
            system_prompt=base_full_system_prompt,
            task=task,
            context=context,
            response_format=response_format,
            json_schema=json_schema,
            additional_prompt=(
                '<shell_revision>\n'
                f'<previous_task>\n{previous_task}\n</previous_task>\n'
                '<previous_commands>\n'
                f'{format_shell_commands(shell_commands, include_reasons=False)}\n'
                '</previous_commands>\n'
                '</shell_revision>'
            ),
            additional_instructions=(
                "Use the `<previous_task>` and `<previous_commands>` with the "
                "provided updated user instructions; keep everything as-is that "
                "was not changed by the updated user instructions."
            ),
        )
        return request_model_turn(
            full_system_prompt,
            revision_user_prompt,
        )

    def request_shell_followup(
        shell_output: str,
        shell_commands: list[ShellStep],
    ) -> tuple[str, str]:
        nonlocal task
        if task_file_prompt is not None:
            task = task_file_prompt.read()
        followup_schema = SHELL_FOLLOWUP_SCHEMA
        shell_turn_history.append(
            ShellTurn(
                commands=tuple(shell_commands),
                output=limit_shell_output_for_context(
                    shell_output,
                    model,
                    token_limit,
                ),
            )
        )

        def build_followup_request(
            history: list[ShellTurn],
        ) -> tuple[str, str, int]:
            followup_system_prompt, followup_user_prompt = build_shell_followup_prompts(
                system_prompt=base_full_system_prompt,
                task=task,
                shell_output=history,
                json_schema=followup_schema,
                shell_command_archive=archived_shell_turns,
            )
            return (
                followup_system_prompt,
                followup_user_prompt,
                estimate_request_tokens(
                    model=model,
                    system_prompt=followup_system_prompt,
                    user_prompt=followup_user_prompt,
                ),
            )

        while True:
            (
                followup_system_prompt, followup_user_prompt,
                followup_request_tokens,
            ) = build_followup_request(shell_turn_history)
            if followup_request_tokens <= token_limit:
                break
            if len(shell_turn_history) > 1:
                removed_turn = shell_turn_history.pop(0)
                if removed_turn.commands:
                    archived_shell_turns.append(removed_turn)
                continue
            if archived_shell_turns:
                archived_shell_turns.pop(0)
                continue
            current_turn = shell_turn_history[-1]

            def estimate_shell_context_tokens(output: str) -> int:
                candidate_history = [
                    *shell_turn_history[:-1],
                    replace(current_turn, output=output),
                ]
                return build_followup_request(candidate_history)[2]

            empty_request_tokens = estimate_shell_context_tokens("")
            if empty_request_tokens > token_limit:
                raise ValueError(
                    f'Estimated shell follow-up input token count '
                    f'({empty_request_tokens}) exceeds token limit '
                    f'({token_limit})'
                )
            shell_turn_history[-1] = replace(
                current_turn,
                output=limit_shell_output_for_context(
                    shell_output,
                    model,
                    token_limit,
                    estimate_context_tokens=estimate_shell_context_tokens,
                ),
            )
        return request_model_turn(
            followup_system_prompt,
            followup_user_prompt,
            response_format_override="schema",
            json_schema_override=followup_schema,
            request_tokens=followup_request_tokens,
        )

    if shell_mode:
        try:
            shell_steps, session_reason = parse_shell_response(
                str(result or ''),
                response_json_repair,
                followup=None if resume_reused_shell_turn else False,
            )
            if session_reason is not None:
                return emit_response_output(
                    session_reason,
                    reasoning=reasoning,
                    print_reasoning=print_reasoning,
                    suppress_response_output=suppress_response_output,
                    output_file_path=args.output_file,
                )
        except Exception as exc:
            print(f'ERROR: Failed to parse shell command manifest: {exc}', file=sys.stderr)
            return 1
        shell_response_reasoning = reasoning
        pending_shell_revision_task = shell_revision_task
        while True:
            pending_revision = pending_shell_revision_task is not None
            if pending_revision:
                review_action = 'edit'
                revision_task = pending_shell_revision_task
                pending_shell_revision_task = None
            else:
                review_action, revision_task = review_shell_commands(
                    shell_steps,
                    accept_noninteractive=resume_reused_shell_turn,
                )
            if review_action == 'edit':
                pending_reused_shell_output = None
                if revision_task is None:
                    try:
                        revision_task = edit_tool_revision_task(
                            format_shell_commands(shell_steps, include_reasons=False),
                            task,
                        )
                    except Exception as exc:
                        print(
                            f'ERROR: Failed to edit shell revision: {exc}',
                            file=sys.stderr,
                        )
                        continue
                if not revision_task and not (
                    pending_revision and task_file_prompt is not None
                ):
                    continue
                try:
                    result, shell_response_reasoning = request_shell_revision(
                        revision_task,
                        shell_steps,
                    )
                except Exception as exc:
                    report_request_error(exc)
                    return 1
                try:
                    shell_steps, _ = parse_shell_response(
                        str(result or ''), response_json_repair
                    )
                except Exception as exc:
                    print(
                        f'ERROR: Failed to parse shell command manifest: {exc}',
                        file=sys.stderr,
                    )
                    return 1
                continue
            if review_action == 'save':
                return emit_response_output(
                    str(result or ''),
                    reasoning=shell_response_reasoning,
                    print_reasoning=print_reasoning,
                    suppress_response_output=suppress_response_output,
                    output_file_path=args.output_file,
                )
            if review_action != 'accept':
                if VERBOSE:
                    print('Aborted.', file=sys.stderr)
                return 0
            shell_output_is_new = pending_reused_shell_output is None
            if shell_output_is_new:
                shell_output = execute_shell_commands(
                    shell_steps,
                    shell_timeout,
                    contain=contain,
                    shell_networking=shell_networking,
                    shell_trace=shell_trace,
                    turn_dir=state_turn_path,
                )
            else:
                shell_output = pending_reused_shell_output
                pending_reused_shell_output = None
            append_log(
                f"<shell_execution reused='{str(not shell_output_is_new).lower()}'>\n"
                f"{shell_output}\n"
                "</shell_execution>\n"
            )
            if shell_output_is_new and state_turn_path is not None:
                try:
                    write_state_artifact(
                        state_turn_path,
                        "response_shell_output_0",
                        shell_output,
                    )
                except Exception as exc:
                    print(f"ERROR: Failed to save shell output: {exc}", file=sys.stderr)
                    return 1

            if VERBOSE:
                print("<shell_execution>", file=sys.stderr)
                print(shell_output, file=sys.stderr)
                print("</shell_execution>", file=sys.stderr)
            if (
                resume_session_name is not None
                and (
                    not resume_reused_shell_turn
                    or complete_reused_shell_turn_after_execution
                )
            ):
                return emit_response_output(
                    "Shell command turn completed.",
                    reasoning=shell_response_reasoning,
                    print_reasoning=print_reasoning,
                    suppress_response_output=suppress_response_output,
                    output_file_path=args.output_file,
                )
            try:
                result, followup_reasoning = request_shell_followup(
                    shell_output,
                    shell_steps,
                )
            except Exception as exc:
                report_request_error(exc)
                return 1
            try:
                next_shell_steps, session_reason = parse_shell_response(
                    result, response_json_repair, followup=True
                )
            except Exception as exc:
                print(f"ERROR: Failed to parse shell follow-up response: {exc}", file=sys.stderr)
                return 1
            if session_reason is None:
                shell_steps = next_shell_steps
                continue
            return emit_response_output(
                session_reason,
                reasoning=followup_reasoning,
                print_reasoning=print_reasoning,
                suppress_response_output=suppress_response_output,
                output_file_path=args.output_file,
            )

    if patch_mode:
        patch_turn_history: list[
            tuple[str, str, tuple[dict[str, Any], ...], Path | None]
        ] = [
            (task, str(result or ""), reasoning_items, state_turn_path)
        ]
        patch_turn_index = 0

        def request_patch_revision(revision_task: str) -> None:
            nonlocal task, result, full_system_prompt
            nonlocal patch_turn_index

            previous_task = task
            task = expand_prompt_names(
                revision_task, prompt_expansion_enabled
            )
            full_system_prompt, revision_user_prompt = build_request_prompts(
                system_prompt=base_full_system_prompt,
                task=task,
                context=context,
                response_format=response_format,
                json_schema=json_schema,
                json_patch_responses=[result],
                json_patch_task=previous_task,
            )
            result, _ = request_model_turn(
                full_system_prompt,
                revision_user_prompt,
            )
            del patch_turn_history[patch_turn_index + 1:]
            patch_turn_history.append(
                (task, str(result or ""), reasoning_items, state_turn_path)
            )
            patch_turn_index += 1

        while True:
            try:
                if not result or not result.strip():
                    print(
                        'ERROR: LLM returned empty response for patch manifest',
                        file=sys.stderr,
                    )
                    return 1

                manifest = parse_json_response(result, response_json_repair)
            except (ValueError, TypeError) as exc:
                print('<invalid_json_patch>')
                print(result)
                print('</invalid_json_patch>')
                print(
                    f'ERROR: Failed to parse patch manifest JSON: {exc}',
                    file=sys.stderr,
                )
                return 1

            try:
                updated_texts, diff_text, changed_items = build_current_patch_changes(
                    manifest
                )
                patch_commit_message = (
                    manifest["commit_message"].strip() if patch_branch_mode else ''
                )
                result = json.dumps(manifest, indent=2, ensure_ascii=False)
            except Exception as exc:
                print(
                    f'ERROR: Failed to apply patch manifest: {exc}',
                    file=sys.stderr,
                )
                return 1

            if state_turn_path is not None:
                try:
                    write_state_patch_artifacts(
                        state_turn_path,
                        result,
                        diff_text,
                    )
                except Exception as exc:
                    print(
                        f'ERROR: Failed to save validated patch artifacts to '
                        f'{state_turn_path}: {exc}',
                        file=sys.stderr,
                    )
                    return 1


            if not changed_items:
                if VERBOSE:
                    print('No changes.', file=sys.stderr)
                return 0
            if args.noninteractive:
                return 0
            if VERBOSE or patch_review:
                print()
                print(diff_text)

            revision_task: str | None = None
            navigate_patch_turn = False
            if patch_review:
                while True:
                    review_action, revision_task, suffix_provided = review_patch_changes(
                        diff_text,
                        suffix_provided,
                        prompt=(
                            'Apply these changes? '
                            '[y/n/p/h/S/</>/e/E <prompt>]: '
                        ),
                        allow_navigation=True,
                        display_text=False,
                    )
                    if review_action in ('<', '>'):
                        next_turn_index = patch_turn_index + (
                            -1 if review_action == '<' else 1
                        )
                        if next_turn_index < 0:
                            print('Already at the first patch turn.')
                            continue
                        if next_turn_index >= len(patch_turn_history):
                            print('No later patch turn is available.')
                            continue
                        patch_turn_index = next_turn_index
                        task, result, reasoning_items, state_turn_path = (
                            patch_turn_history[patch_turn_index]
                        )
                        navigate_patch_turn = True
                        break
                    if review_action == 'edit':
                        if revision_task is None:
                            try:
                                revision_task = edit_tool_revision_task(
                                    diff_text,
                                    task,
                                )
                            except Exception as exc:
                                print(
                                    f'ERROR: Failed to edit patch revision: {exc}',
                                    file=sys.stderr,
                                )
                                continue
                        if not revision_task:
                            continue
                    break
                if navigate_patch_turn:
                    continue
                if review_action == 'reject':
                    if VERBOSE:
                        print('Aborted.', file=sys.stderr)
                    return 0
                if review_action == 'edit':
                    try:
                        request_patch_revision(revision_task)
                    except Exception as exc:
                        report_request_error(exc)
                        return 1
                    continue

            try:
                written_patch_paths = write_patch_changes(
                    changed_items=changed_items,
                    all_paths=[Path(path) for path in updated_texts],
                    patch_review=patch_review,
                    patch_suffix=patch_suffix,
                    suffix_provided=suffix_provided,
                    patch_branch_setting=patch_branch_setting,
                    patch_commit_message=patch_commit_message,
                )
                if state_turn_path is not None:
                    write_state_artifact(
                        state_turn_path,
                        "response_schema_patch_applied",
                        "\n".join(written_patch_paths),
                    )
            except Exception as exc:
                action = (
                    'write and commit patch branch'
                    if patch_branch_mode
                    else 'write patch files'
                )
                print(f'ERROR: Failed to {action}: {exc}', file=sys.stderr)
                return 1


            return 0

    if response_format in ("json", "schema"):
        try:
            result = pretty_json(result, response_json_repair)
        except (ValueError, TypeError) as exc:
            print(result)
            print(f"ERROR: Failed to parse JSON: {exc}", file=sys.stderr)
            return 1

    output_status = emit_response_output(
        result,
        reasoning=reasoning,
        print_reasoning=print_reasoning,
        suppress_response_output=suppress_response_output,
        stream_output_emitted=stream_output_emitted,
        output_file_path=args.output_file,
    )

    if output_status:
        return output_status

    if DEBUG:
        print("<debug_response>", file=sys.stderr)
        print(json.dumps(usage_to_dict(response_obj), indent=2), file=sys.stderr)
        print("</debug_response>", file=sys.stderr)

    return 0


def main() -> int:
    cumulative_stats = CumulativeStats()
    try:
        return run_main(cumulative_stats)
    finally:
        cumulative_stats.emit()


# -------------------------------------------------------------------
# Run
# -------------------------------------------------------------------

rv = 0
err = None
try:
    rv = main()
except KeyboardInterrupt:
    rv = 130
    err = "\nStopped."
except SystemExit as exc:
    if exc.code is None:
        rv = 0
    elif isinstance(exc.code, int):
        rv = exc.code
    else:
        rv = 1
except Exception as e:
    rv = 1
    err = e
finally:
    if OUTPUT_FILE is not None:
        try:
            OUTPUT_FILE.close()
        except Exception:
            pass
    if SESSION_NAME is not None:
        if VERBOSE and not NONINTERACTIVE:
            print(f"session_name={SESSION_NAME}", file=sys.stderr)
        elif NONINTERACTIVE:
            print(f"{SESSION_NAME}")

    if isinstance(err, BaseException):
        report_request_error(err)
    elif err is not None:
        print(f"{err}", file=sys.stderr)
    sys.exit(rv)

