def parse_prompt_file_definitions(value: Any) -> tuple[list[str], str] | None:
    if not isinstance(value, str):
        return None

    prompt = value.strip()
    if not prompt.startswith(("/", "./", "@")):
        return None

    match = re.match(r"^(\S+)(?:\s+(.*))?$", prompt, re.DOTALL)
    if match is None:
        return None

    definitions = match.group(1).split("|")
    if not definitions or any(
        not definition
        or not definition.startswith(("/", "./", "@"))
        for definition in definitions
    ):
        return None
    return definitions, (match.group(2) or "").strip()


def configured_prompt_file_path(value: str) -> Path:
    candidate = value.strip()
    if candidate.startswith("@"):
        return prompt_file_path(candidate[1:])
    if candidate.startswith("./"):
        filename = candidate[2:]
        if (
            not filename
            or filename in (".", "..")
            or Path(filename).name != filename
        ):
            raise ValueError(
                "relative configured prompt files must be filenames"
            )
        return APP_DIR / "prompts" / filename
    return Path(candidate)


def prompt_path_matches(value: str, prompt_path: Path) -> bool:
    candidate = value.strip()
    if candidate == str(prompt_path):
        return True
    if not candidate.startswith(("/", "./", "@")):
        return False
    try:
        return (
            configured_prompt_file_path(candidate).resolve()
            == prompt_path.resolve()
        )
    except Exception:
        return False


def remove_prompt_reference(
    value: Any,
    prompt_path: Path,
 ) -> tuple[Any, bool]:
    if not isinstance(value, str):
        return value, False

    parsed = parse_prompt_file_definitions(value)
    if parsed is None:
        return value, False

    definitions, prompt_text = parsed
    remaining: list[str] = []
    removed = False
    for definition in definitions:
        if prompt_path_matches(definition, prompt_path):
            removed = True
        else:
            remaining.append(definition)
    if not removed:
        return value, False
    if not remaining:
        return prompt_text or None, True

    new_value = "|".join(remaining)
    if prompt_text:
        new_value += f" {prompt_text}"
    return new_value, True


def unassign_prompt_from_config(
    config: dict[str, Any],
    prompt_path: Path,
    keys: tuple[str, ...],
 ) -> bool:
    changed = False
    for key in keys:
        if key not in config:
            continue
        new_value, removed = remove_prompt_reference(config[key], prompt_path)
        if not removed:
            continue
        if new_value is None:
            if INHERIT_PROFILE_CONFIG_KEY in config:
                config.pop(key, None)
            else:
                config[key] = get_default_config_value(key)
        else:
            config[key] = new_value
        changed = True
    return changed


def handle_prompt_edit(values: list[str]) -> int:
    name = values[0]
    try:
        prompt_path = prompt_file_path(name)
        prompt_path.parent.mkdir(parents=True, exist_ok=True)
        if len(values) > 1:
            edited_text = " ".join(values[1:]).strip()
        else:
            initial_text = (
                prompt_path.read_text(encoding="utf-8")
                if prompt_path.exists()
                else ""
            )
            edited_text = edit_text(initial_text, suffix=".md")
        prompt_path.write_text(edited_text, encoding="utf-8")
    except Exception as exc:
        print(f"ERROR: Failed to edit prompt: {exc}", file=sys.stderr)
        return 1
    print(f"prompt_file={prompt_path}")
    return 0

def handle_prompt_print(
    names: list[str] | str | None = None,
    json_output: bool = False,
 ) -> int:
    if isinstance(names, str):
        names = [names]
    try:
        if names:
            prompt_paths = [prompt_file_path(name) for name in names]
            for prompt_path in prompt_paths:
                if not prompt_path.is_file():
                    raise ValueError(
                        f"prompt file does not exist: {prompt_path}"
                    )
        else:
            prompt_dir = APP_DIR / "prompts"
            prompt_paths = sorted(
                (
                    path
                    for path in prompt_dir.glob("*.md")
                    if path.is_file()
                ),
                key=lambda path: path.stem,
            )
        if json_output:
            prompt_structure = {
                path.stem: path.read_text(encoding="utf-8")
                for path in prompt_paths
            }
            print(json.dumps(prompt_structure, indent=2, ensure_ascii=False))
        elif names:
            for prompt_path in prompt_paths:
                sys.stdout.write(
                    prompt_path.read_text(encoding="utf-8")
                )
        else:
            sections = [
                f"[{path.stem}]\n{path.read_text(encoding='utf-8')}"
                for path in prompt_paths
            ]
            prompt_text = "\n\n".join(sections)
            page_or_print(
                prompt_text + ("\n" if prompt_text else "")
            )
    except Exception as exc:
        print(f"ERROR: Failed to print prompt: {exc}", file=sys.stderr)
        return 1
    return 0

def handle_prompt_assign(
    values: list[str],
    profile: str,
    assignment_mode: str = "prepend",
) -> int:
    name, prompt_type = values
    try:
        prompt_path = prompt_file_path(name)
        if not prompt_path.is_file():
            raise ValueError(
                f"prompt file does not exist: {prompt_path}; use --prompt-edit first"
            )
        profile = validate_prompt_profile_name(profile)
        config_key = prompt_type_key(prompt_type)
        profile_path = get_profile_path(profile)
        config = read_config_document(profile_path, missing_ok=True)
        prompt_reference = f"./{prompt_path.name}"
        existing = config.get(config_key)
        if (
            config_key not in config
            and _inherit_profile_name(config, profile_path) is not None
        ):
            existing = merged_config(profile_path).get(config_key)
        if assignment_mode == "string":
            config[config_key] = prompt_path.read_text(
                encoding="utf-8"
            ).strip()
        elif assignment_mode == "replace":
            config[config_key] = prompt_reference
        else:
            parsed = parse_prompt_file_definitions(existing)
            if parsed is None:
                existing_string = (
                    existing.strip()
                    if isinstance(existing, str)
                    else ""
                )
                config[config_key] = (
                    f"{prompt_reference} {existing_string}".strip()
                )
            else:
                references, prompt_text = parsed
                if not any(
                    prompt_path_matches(reference, prompt_path)
                    for reference in references
                ):
                    references.insert(0, prompt_reference)
                config[config_key] = "|".join(references)
                if prompt_text:
                    config[config_key] += f" {prompt_text}"
        write_json_document(profile_path, config)
    except Exception as exc:
        print(f"ERROR: Failed to assign prompt: {exc}", file=sys.stderr)
        return 1
    print(f"prompt_assigned={prompt_path} profile={profile} type={config_key}")
    return 0


def handle_prompt_unassign(
    values: list[str],
    profile: str,
) -> int:
    if len(values) not in (1, 2):
        print(
            "ERROR: --prompt-unassign requires NAME and optional TYPE",
            file=sys.stderr,
        )
        return 1
    name = values[0]
    try:
        prompt_path = prompt_file_path(name)
        profile = validate_prompt_profile_name(profile)
        profile_path = get_profile_path(profile)
        config = read_config_document(profile_path)
        keys = (
            (prompt_type_key(values[1]),)
            if len(values) == 2
            else PROMPT_CONFIG_KEYS
        )
        changed = unassign_prompt_from_config(config, prompt_path, keys)
        if changed:
            write_json_document(profile_path, config)
    except Exception as exc:
        print(f"ERROR: Failed to unassign prompt: {exc}", file=sys.stderr)
        return 1
    print(
        f"prompt_unassigned={prompt_path} profile={profile}"
        + (f" type={keys[0]}" if len(keys) == 1 else "")
    )
    return 0


def handle_prompt_remove(name: str) -> int:
    try:
        prompt_path = prompt_file_path(name)
        if prompt_path.exists() and not prompt_path.is_file():
            raise ValueError(f"prompt path is not a file: {prompt_path}")

        default_prompt = DEFAULT_PROMPT_LIBRARY_ENTRIES.get(prompt_path.stem)
        if default_prompt is not None:
            prompt_path.parent.mkdir(parents=True, exist_ok=True)
            prompt_path.write_text(default_prompt, encoding="utf-8")
        else:
            documents: list[tuple[Path, dict[str, Any]]] = []
            for config_path in sorted(APP_DIR.glob("*.json")):
                documents.append((config_path, read_config_document(config_path)))

            for config_path, config in documents:
                if unassign_prompt_from_config(
                    config, prompt_path, PROMPT_CONFIG_KEYS
                ):
                    write_json_document(config_path, config)

            if prompt_path.exists():
                prompt_path.unlink()
    except Exception as exc:
        print(f"ERROR: Failed to remove prompt: {exc}", file=sys.stderr)
        return 1
    print(f"prompt_removed={prompt_path}")
    return 0


def handle_prompt_reset_default(prompt_types: str = "") -> int:
    try:
        if prompt_types:
            selected_config_keys: list[str] = []
            for raw_type in prompt_types.split(","):
                config_key = prompt_type_key(raw_type)
                if config_key not in selected_config_keys:
                    selected_config_keys.append(config_key)
        else:
            selected_config_keys = list(PROMPT_TYPE_ALIASES.values())

        prompt_names = [
            Path(DEFAULT_PROMPT_LIBRARY_REFERENCES[config_key]).stem
            for config_key in selected_config_keys
        ]
        if not NONINTERACTIVE:
            reset_target = (
                "all default system prompt library entries"
                if not prompt_types
                else (
                    "default system prompt types "
                    + ", ".join(
                        prompt_type
                        for prompt_type, config_key in PROMPT_TYPE_ALIASES.items()
                        if config_key in selected_config_keys
                    )
                )
            )
            while True:
                choice = input(f"Reset {reset_target}? [y/n]: ").strip().lower()
                if choice in ("y", "yes"):
                    break
                if choice in ("n", "no"):
                    print("Aborted.")
                    return 0
                print("Please answer y or n.")
        prompt_paths = [
            (prompt_file_path(name), DEFAULT_PROMPT_LIBRARY_ENTRIES[name])
            for name in prompt_names
        ]
        for prompt_path, _ in prompt_paths:
            if prompt_path.exists() and not prompt_path.is_file():
                raise ValueError(
                    f"prompt path is not a file: {prompt_path}"
                )
        for prompt_path, prompt in prompt_paths:
            prompt_path.parent.mkdir(parents=True, exist_ok=True)
            prompt_path.write_text(prompt, encoding="utf-8")
    except Exception as exc:
        print(
            f"ERROR: Failed to reset default prompts: {exc}",
            file=sys.stderr,
        )
        return 1
    return 0


def handle_prompt_list() -> int:
    prompt_dir = APP_DIR / "prompts"
    try:
        prompt_paths = sorted(
            (
                path
                for path in prompt_dir.glob("*.md")
                if path.is_file()
            ),
            key=lambda path: path.stem,
        )
        config_documents = [
            (
                config_path.stem,
                read_config_document(config_path),
            )
            for config_path in sorted(APP_DIR.glob("*.json"))
        ]
    except Exception as exc:
        print(f"ERROR: Failed to list prompts: {exc}", file=sys.stderr)
        return 1

    for prompt_path in prompt_paths:
        profiles: set[str] = set()
        for profile_name, config in config_documents:
            for key in PROMPT_CONFIG_KEYS:
                parsed = parse_prompt_file_definitions(config.get(key))
                if parsed is not None and any(
                    prompt_path_matches(reference, prompt_path)
                    for reference in parsed[0]
                ):
                    profiles.add(profile_name)
                    break

        output = prompt_path.stem
        if profiles:
            output += f" {' '.join(sorted(profiles))}"
        print(output)
    return 0


AGENT_PROFILE_BUILTIN_SCHEMAS: dict[str, dict[str, Any]] = {
    "patch": PATCH_MANIFEST_SCHEMA["schema"],
    "shell": SHELL_COMMAND_SCHEMA["schema"],
}
AGENT_PROFILE_TYPES = (
    "custom",
    *AGENT_PROFILE_BUILTIN_SCHEMAS,
)
AGENT_PROFILE_LEGACY_TYPE_ALIASES = {"schema": "custom"}
AGENT_PROFILE_DIRECTORY = APP_DIR / "agents"


@dataclass(frozen=True)
class AgentProfile:
    name: str
    profile_type: str
    content: str
    description: str = ""


def agent_tool_call_system_prompt(
    profiles: tuple[AgentProfile, ...] = (),
) -> str:
    if not profiles:
        return AGENT_TOOL_CALL_SYSTEM_PROMPT
    profile_lines: list[str] = []
    for profile in profiles:
        profile_line = (
            f"- Use `{agent_profile_tool_name(profile.name)}` to delegate work "
            f"(response format: `{profile.profile_type}`)."
        )
        if profile.description.strip():
            profile_line += f" {profile.description.strip()}"
        profile_lines.append(profile_line)
    return (
        AGENT_TOOL_CALL_SYSTEM_PROMPT.rstrip()
        + "\n\nSelected worker profile tools:\n"
        + "\n".join(profile_lines)
    )

def validate_agent_profile_name(name: str) -> str:
    name = name.strip()
    if (
        re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name) is None
        or len(f"agent_{name}") > 64
    ):
        raise ValueError(f"invalid agent profile name '{name}'")
    return name


def agent_profile_type_choices() -> str:
    return "|".join(AGENT_PROFILE_TYPES)


def normalize_agent_profile_type(value: str) -> str:
    profile_type = value.strip().lower()
    profile_type = AGENT_PROFILE_LEGACY_TYPE_ALIASES.get(
        profile_type, profile_type
    )
    if profile_type not in AGENT_PROFILE_TYPES:
        raise ValueError(
            "invalid agent profile type "
            f"'{value}'; choose {agent_profile_type_choices()}"
        )
    return profile_type


def agent_profile_path(name: str) -> Path:
    return AGENT_PROFILE_DIRECTORY / (
        f"{validate_agent_profile_name(name)}.json"
    )


def read_agent_profile_with_document(
    name: str,
 ) -> tuple[AgentProfile, dict[str, Any]]:
    valid_name = validate_agent_profile_name(name)
    path = agent_profile_path(valid_name)
    if not path.is_file():
        raise ValueError(f"agent profile does not exist: {path}")
    document = read_json_document(path, "agent profile")
    if not isinstance(document, dict):
        raise ValueError(f"agent profile must contain a JSON object: {path}")
    allowed_fields = {"type", "content", "description"}
    if not set(document).issubset(allowed_fields):
        raise ValueError(
            "agent profile may contain only type, content, and description: "
            f"{path}"
        )
    profile_type_value = document.get("type", "custom")
    content = document.get("content", "")
    description = document.get("description", "")
    if not isinstance(profile_type_value, str):
        raise ValueError(f"agent profile type must be a string: {path}")
    if not isinstance(content, str):
        raise ValueError(f"agent profile content must be a string: {path}")
    if not isinstance(description, str):
        raise ValueError(
            f"agent profile description must be a string: {path}"
        )
    profile_type = normalize_agent_profile_type(profile_type_value)
    if "content" not in document and profile_type == "custom":
        raise ValueError(
            f"custom agent profiles must contain content: {path}"
        )
    return (
        AgentProfile(
            name=valid_name,
            profile_type=profile_type,
            content=content,
            description=description,
        ),
        document,
    )


def read_agent_profile(name: str) -> AgentProfile:
    return read_agent_profile_with_document(name)[0]


def write_agent_profile(
    name: str,
    profile_type: str,
    content: str,
    description: str = "",
) -> Path:
    name = validate_agent_profile_name(name)
    profile_type = normalize_agent_profile_type(profile_type)
    if not isinstance(content, str):
        raise ValueError("agent profile content must be a string")
    if not isinstance(description, str):
        raise ValueError("agent profile description must be a string")
    path = agent_profile_path(name)
    write_json_document(
        path,
        {
            "type": profile_type,
            "content": content,
            "description": description,
        },
    )
    return path


def agent_profile_names() -> list[str]:
    if not AGENT_PROFILE_DIRECTORY.is_dir():
        return []
    return sorted(
        path.stem
        for path in AGENT_PROFILE_DIRECTORY.glob("*.json")
        if path.is_file() and path.stem.isidentifier()
    )


def parse_agent_profile_names(values: list[str] | None) -> list[str]:
    names: list[str] = []
    for value in values or []:
        for raw_name in value.split(","):
            name = validate_agent_profile_name(raw_name)
            if name not in names:
                names.append(name)
    return names


def load_agent_profiles(values: list[str] | None) -> list[AgentProfile]:
    return [
        read_agent_profile(name)
        for name in parse_agent_profile_names(values)
    ]


def resolved_agent_profile_content(profile: AgentProfile) -> str:
    profile_type = normalize_agent_profile_type(profile.profile_type)
    schema = AGENT_PROFILE_BUILTIN_SCHEMAS.get(profile_type)
    if schema is not None:
        return json.dumps(schema, indent=2, ensure_ascii=False)
    return profile.content


def agent_profile_response_schema(
    profile: AgentProfile,
 ) -> dict[str, Any]:
    try:
        response_schema = json.loads(
            resolved_agent_profile_content(profile)
        )
    except (TypeError, json.JSONDecodeError) as exc:
        raise ValueError(
            f"agent profile '{profile.name}' response schema must be valid JSON"
        ) from exc
    if not isinstance(response_schema, dict):
        raise ValueError(
            f"agent profile '{profile.name}' response schema must be a JSON object"
        )
    if response_schema.get("type") == "json_schema":
        response_schema = response_schema.get("schema")
        if not isinstance(response_schema, dict):
            raise ValueError(
                f"agent profile '{profile.name}' response format must contain "
                "a schema object"
            )
    return {
        "type": "json_schema",
        "name": agent_profile_tool_name(profile.name),
        "strict": True,
        "schema": response_schema,
    }


def agent_profile_tool_name(name: str) -> str:
    return f"agent_{validate_agent_profile_name(name)}"


def agent_agent_tool_schema(
    profile: AgentProfile,
    expires_schema: dict[str, Any] | None = None,
 ) -> dict[str, Any]:
    parameters = AGENT_AGENT_CALL_ARGUMENT_SCHEMA
    if expires_schema is not None:
        parameters = agent_tool_argument_schema(parameters, expires_schema)
    description = (
        f"Agent profile '{profile.name}'. "
        f"Response format: {profile.profile_type}."
    )
    if profile.description.strip():
        description += f" {profile.description.strip()}"
    return {
        "type": "function",
        "name": agent_profile_tool_name(profile.name),
        "description": description,
        "parameters": parameters,
        "strict": True,
    }


def agent_tool_schemas(
    profiles: tuple[AgentProfile, ...] = (),
    expires_schema: dict[str, Any] | None = None,
    default_profile: AgentProfile | None = None,
 ) -> list[dict[str, Any]]:
    schemas: list[dict[str, Any]] = []
    for schema in AGENT_TOOL_SCHEMAS:
        if (
            default_profile is not None
            and schema["name"] == AGENT_AGENT_TOOL
        ):
            schema = {
                **agent_agent_tool_schema(default_profile),
                "name": AGENT_AGENT_TOOL,
            }
        if (
            expires_schema is not None
            and schema["name"] != AGENT_META_TASK_LIST_TOOL
        ):
            schema = {
                **schema,
                "parameters": agent_tool_argument_schema(
                    schema["parameters"], expires_schema
                ),
            }
        schemas.append(schema)
    tool_names = {schema["name"] for schema in schemas}
    for profile in profiles:
        schema = agent_agent_tool_schema(profile, expires_schema)
        if schema["name"] in tool_names:
            raise ValueError(
                f"duplicate agent tool name: {schema['name']}"
            )
        schemas.append(schema)
        tool_names.add(schema["name"])
    return schemas


def handle_agent_tool_list(
    values: list[str] | None,
    default_profile_name: str | None = None,
) -> int:
    try:
        profiles = tuple(load_agent_profiles(values))
        default_profile = (
            read_agent_profile(default_profile_name)
            if default_profile_name is not None
            else None
        )
        for schema in agent_tool_schemas(
            profiles, default_profile=default_profile
        ):
            print(f"{schema['name']}     {schema['description']}")
    except Exception as exc:
        print(f"ERROR: Failed to list agent tools: {exc}", file=sys.stderr)
        return 1
    return 0

def load_or_create_agent_profile(name: str) -> AgentProfile:
    name = validate_agent_profile_name(name)
    path = agent_profile_path(name)
    if path.exists():
        return read_agent_profile(name)
    return AgentProfile(name=name, profile_type="custom", content="")


def handle_agent_profile_edit(
    values: list[str],
    edit_description: bool = False,
) -> int:
    try:
        profile = load_or_create_agent_profile(values[0])
        if len(values) > 1:
            edited_text = " ".join(values[1:]).strip()
        else:
            edited_text = edit_text(
                profile.description if edit_description else profile.content,
                suffix=".txt" if edit_description else ".json",
            )
        write_agent_profile(
            profile.name,
            profile.profile_type,
            profile.content if edit_description else edited_text,
            edited_text if edit_description else profile.description,
        )
    except Exception as exc:
        action = (
            "set agent profile description"
            if edit_description
            else "edit agent profile"
        )
        print(f"ERROR: Failed to {action}: {exc}", file=sys.stderr)
        return 1
    if edit_description:
        description_set = "yes" if edited_text.strip() else "no"
        print(f"agent_profile={profile.name} description_set={description_set}")
    else:
        if not profile.description.strip():
            print(
                f"WARNING: Agent profile '{profile.name}' has no description; use ",
                "--agent-profile-description to set one.",
                file=sys.stderr,
            )
        print(f"agent_profile={profile.name} type={profile.profile_type}")
    return 0


def handle_agent_profile_type(values: list[str]) -> int:
    try:
        if len(values) not in (1, 2):
            raise ValueError(
                "--agent-profile-type requires NAME and optional TYPE"
            )
        name = values[0]
        requested_type = values[1] if len(values) == 2 else "custom"
        profile = load_or_create_agent_profile(name)
        profile_type = normalize_agent_profile_type(requested_type)
        write_agent_profile(
            profile.name,
            profile_type,
            profile.content,
            profile.description,
        )
    except Exception as exc:
        print(f"ERROR: Failed to set agent profile type: {exc}", file=sys.stderr)
        return 1
    print(f"agent_profile={profile.name} type={profile_type}")
    return 0


def handle_agent_profile_transfer(
    values: list[str],
    rename: bool = False,
) -> int:
    action = "rename" if rename else "copy"
    try:
        source_name, destination_name = (
            validate_agent_profile_name(value) for value in values
        )
        if source_name == destination_name:
            raise ValueError("source and destination agent profiles must differ")
        profile = read_agent_profile(source_name)
        destination_path = agent_profile_path(destination_name)
        if destination_path.exists():
            raise ValueError(
                f"destination agent profile already exists: {destination_path}"
            )
        if rename:
            agent_profile_path(profile.name).rename(destination_path)
        else:
            write_agent_profile(
                destination_name,
                profile.profile_type,
                profile.content,
                profile.description,
            )
    except Exception as exc:
        print(f"ERROR: Failed to {action} agent profile: {exc}", file=sys.stderr)
        return 1
    status = "renamed" if rename else "copied"
    print(
        f"agent_profile_{status}={source_name} "
        f"new_name={destination_name}"
    )
    return 0


def handle_agent_profile_remove(name: str) -> int:
    try:
        profile = read_agent_profile(name)
        agent_profile_path(profile.name).unlink()
    except Exception as exc:
        print(f"ERROR: Failed to remove agent profile: {exc}", file=sys.stderr)
        return 1
    print(f"agent_profile_removed={profile.name}")
    return 0


def handle_agent_profile_print_json(values: list[str] | None) -> int:
