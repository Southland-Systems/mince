def load_secondary_profile(
    name: str,
    model: str | None = None,
    reasoning: str | None = None,
    *,
    estimate_only: bool = False,
) -> ModelRequestSettings:
    name = validate_profile_name(name)
    path = get_profile_path(name)
    if not config_document_exists(path):
        raise ValueError(f"profile '{name}' does not exist")
    config = CONFIG_STORE.merged(path)
    if model is not None:
        config["model"] = model
        config["token_cost"] = "off"
    if reasoning is not None:
        config["reasoning"] = reasoning
    config = parse_config_values(config)
    return ModelRequestSettings(
        model_settings=model_settings_from_config(
            config, "" if estimate_only else resolve_api_key(config)
        ),
        token_limit=config["token_limit"],
        token_cost=config["token_cost"],
    )


def create_openai_client(settings: ModelSettings) -> OpenAI:
    http_client = (
        DefaultHttpxClient(proxy=settings.openai_proxy)
        if settings.openai_proxy
        else None
    )
    try:
        return OpenAI(
            api_key=settings.api_key,
            base_url=settings.openai_base_url,
            project=settings.openai_project or None,
            organization=settings.openai_organization or None,
            timeout=settings.llm_timeout,
            max_retries=0,
            http_client=http_client,
        )
    except BaseException:
        if http_client is not None:
            http_client.close()
        raise


def call_model(
    settings: ModelSettings,
    system_prompt: str,
    user_prompt: str,
    *,
    response_format: str = "text",
    json_schema: dict[str, Any] | None = None,
    stream: bool = False,
    tools: list[dict[str, Any]] | None = None,
    tool_choice: str | dict[str, Any] | None = None,
    parallel_tool_calls: bool | None = None,
    retry: int | None = None,
    error_logger: Any = None,
    request_logger: Callable[[str], None] | None = None,
    response_logger: Callable[[str, str], None] | None = None,
    request_timer: ModelRequestTimer | None = None,
    reasoning_items: tuple[dict[str, Any], ...] | None = None,
    report_errors: bool = True,
    image_urls: tuple[str, ...] = (),
) -> Any:
    kwargs: dict[str, Any] = {
        "model": settings.model,
        "instructions": system_prompt,
        "input": user_prompt,
        "extra_body": settings.extra_body or {},
        "store": settings.api_log,
    }

    if reasoning_items is not None:
        kwargs["include"] = ["reasoning.encrypted_content"]
    if reasoning_items or image_urls:
        user_content: str | list[dict[str, Any]] = user_prompt
        if image_urls:
            user_content = [{"type": "input_text", "text": user_prompt}]
            user_content.extend(
                {"type": "input_image", "detail": "original", "image_url": image_url}
                for image_url in image_urls
            )
        kwargs["input"] = [
            *(reasoning_items or ()),
            {"role": "user", "content": user_content},
        ]

    if settings.explicit_prompt_cache:
        kwargs["prompt_cache_options"] = {"mode": "explicit"}

    if tools is not None:
        if not tools:
            raise ValueError("tools must be a non-empty array")
        kwargs["tools"] = tools
    if tool_choice is not None:
        if not tools:
            raise ValueError("tool_choice requires tools")
        kwargs["tool_choice"] = tool_choice
    if parallel_tool_calls is not None:
        if not tools:
            raise ValueError("parallel_tool_calls requires tools")
        kwargs["parallel_tool_calls"] = parallel_tool_calls

    if settings.safety_identifier is not None and str(settings.safety_identifier).strip():
        kwargs["safety_identifier"] = str(settings.safety_identifier).strip()
    if settings.temperature is not None:
        kwargs["temperature"] = settings.temperature
    if settings.top_p is not None:
        kwargs["top_p"] = settings.top_p
    if (
        settings.openai_reasoning is not None
        and str(settings.openai_reasoning).strip().lower() != "off"
    ):
        reasoning_payload: dict[str, Any] = {
            "effort": settings.openai_reasoning,
            "summary": "detailed",
        }
        if settings.reasoning_mode is not None:
            reasoning_payload["mode"] = settings.reasoning_mode
        kwargs["reasoning"] = reasoning_payload
    if settings.max_output_tokens is not None:
        kwargs["max_output_tokens"] = settings.max_output_tokens
    if (
        settings.openai_service_tier
        and str(settings.openai_service_tier).lower() != "off"
    ):
        kwargs["service_tier"] = settings.openai_service_tier

    text_payload: dict[str, Any] = {"format": {"type": "text"}}
    if response_format == "json":
        text_payload["format"] = {"type": "json_object"}
    elif response_format == "schema":
        if not json_schema:
            raise ValueError("--response-format schema requires --schema-file")
        text_payload["format"] = json_schema
    if settings.response_verbosity and settings.response_verbosity != "off":
        text_payload["verbosity"] = settings.response_verbosity
    kwargs["text"] = text_payload

    if stream and response_format != "text":
        raise ValueError("Streaming is only supported for text responses")
    if stream:
        kwargs["stream"] = True

    request_tools = kwargs["extra_body"].get("tools", kwargs.get("tools"))
    if request_tools is not None and request_logger is not None:
        request_logger(f"{format_tools_context(request_tools)}\n")

    if DEBUG:
        print("<debug_request>", file=sys.stderr)
        print(json.dumps(kwargs, indent=2), file=sys.stderr)
        print("</debug_request>", file=sys.stderr)

    @contextmanager
    def request_response() -> Iterator[Any]:
        with create_openai_client(settings) as client:
            def create_response() -> Any:
                if request_timer is not None:
                    request_timer.start_attempt()
                response = client.responses.create(**kwargs)
                if not stream:
                    if request_timer is not None:
                        request_timer.record_response(response)
                    if response_logger is not None:
                        response_logger(
                            response_log_text(response),
                            response_reasoning_text(response),
                        )
                    validate_model_response(response)
                return response

            response = execute_openai_request(
                create_response,
                retry=settings.retry if retry is None else retry,
                operation_name="API request",
                error_logger=error_logger,
                report_errors=report_errors,
            )
            try:
                yield response
            finally:
                if stream:
                    response.close()

    if stream:
        def response_events() -> Iterator[Any]:
            with request_response() as response:
                yield from response

        return response_events()

    with request_response() as response:
        return response


def consume_response_stream(
    stream: Any,
    emit: Any = None,
    response_logger: Callable[[str, str], None] | None = None,
    request_timer: ModelRequestTimer | None = None,
) -> tuple[str, Any]:
    chunks: list[str] = []
    completed_response: dict[str, Any] | None = None
    completed_items: dict[int, dict[str, Any]] = {}

    try:
        with closing(stream):
            for event in stream:
                event_type = response_field(event, "type", "")
                if event_type == "response.output_text.delta":
                    delta = response_field(event, "delta", "")
                    if delta:
                        chunks.append(delta)
                        if emit is not None:
                            emit(delta)
                elif event_type == "response.output_item.done":
                    output_index = response_field(event, "output_index")
                    item = usage_to_dict(response_field(event, "item"))
                    if not is_integer(output_index) or item is None:
                        raise ModelResponseError("Invalid completed response output item")
                    completed_items[output_index] = item
                elif event_type in (
                    "response.completed", "response.failed", "response.incomplete",
                ):
                    completed_response = usage_to_dict(
                        response_field(event, "response")
                    )
                    if completed_response is None:
                        raise ModelResponseError(
                            "Response stream ended without a response"
                        )
                    if response_field(completed_response, "status") is None:
                        completed_response["status"] = event_type.removeprefix("response.")
                    if event_type != "response.completed":
                        validate_model_response(completed_response)
                        raise ModelResponseError(
                            f"Response stream ended with {event_type}"
                        )
                    break
                elif event_type == "error":
                    raise model_response_error(event, "Response stream failed")

        if completed_response is None:
            raise ModelResponseError("Response stream ended before completion")
        output_items = response_field(completed_response, "output", [])
        if not isinstance(output_items, (list, tuple)):
            raise ModelResponseError("Model response output must be an array")
        output_items = list(output_items)
        for output_index, item in sorted(completed_items.items()):
            if output_index > len(output_items):
                raise ModelResponseError("Response stream is missing output items")
            if output_index == len(output_items):
                output_items.append(item)
            else:
                output_items[output_index] = item
        completed_response["output"] = output_items
        validate_model_response(completed_response)
        streamed_text = "".join(chunks)
        response_text = response_output_text(completed_response)
        if response_text:
            if emit is not None and response_text != streamed_text:
                if not response_text.startswith(streamed_text):
                    raise ModelResponseError(
                        "Response stream text differs from the completed response"
                    )
                emit(response_text[len(streamed_text):])
            streamed_text = response_text
        return streamed_text, completed_response
    finally:
        if (response_logger is not None or request_timer is not None) and (
            completed_response is not None or completed_items or chunks
        ):
            logged_response = dict(completed_response or {})
            output_items = response_field(logged_response, "output", [])
            logged_items = (
                dict(enumerate(output_items))
                if isinstance(output_items, (list, tuple))
                else {}
            )
            logged_items.update(completed_items)
            logged_response["output"] = [
                item for _, item in sorted(logged_items.items())
            ]
            logged_text = response_log_text(logged_response) or "".join(chunks)
            if request_timer is not None:
                request_timer.record_response(logged_response, logged_text)
            if response_logger is not None:
                response_logger(
                    logged_text,
                    response_reasoning_text(logged_response),
                )



def read_tree_prompt_file(
    path: Path | list[Path],
) -> tuple[dict[str, str], str | None, str | None]:
    prompt_paths = path if isinstance(path, list) else [path]
    lines: list[str] = []
    for prompt_path in prompt_paths:
        try:
            lines.extend(
                prompt_path.read_text(encoding="utf-8").splitlines()
            )
        except Exception as exc:
            raise ValueError(
                f"cannot read tree prompt file {prompt_path} ({exc})"
            ) from exc
    default_key = "__default__"
    prompt_lines: dict[str, list[str]] = {}

    for raw_line in lines:
        line = raw_line.strip()
        if not line:
            continue
        key, separator, value = raw_line.partition(":")
        extension = key.strip().lower()
        if separator and (extension == "*" or extension.startswith(".")):
            prompt_lines.setdefault(extension, []).append(value.strip())
        else:
            prompt_lines.setdefault(default_key, []).append(line)

    prompts = {
        extension: "\n".join(lines_for_prompt).strip()
        for extension, lines_for_prompt in prompt_lines.items()
    }
    exact_prompts = {
        extension: prompt
        for extension, prompt in prompts.items()
        if extension not in (default_key, "*")
    }
    return exact_prompts, prompts.get("*"), prompts.get(default_key)


def expand_tree_prompt_values(
    prompts: tuple[dict[str, str], str | None, str | None],
    enabled: bool,
 ) -> tuple[dict[str, str], str | None, str | None]:
    exact_prompts, wildcard_prompt, default_prompt = prompts
    return (
        {
            extension: expand_prompt_names(prompt, enabled)
            for extension, prompt in exact_prompts.items()
        },
        (
            expand_prompt_names(wildcard_prompt, enabled)
            if wildcard_prompt is not None
            else None
        ),
        (
            expand_prompt_names(default_prompt, enabled)
            if default_prompt is not None
            else None
        ),
    )



def tree_prompt_for_path(
    path: Path,
    prompts: tuple[dict[str, str], str | None, str | None],
    fallback: str,
 ) -> str:
    exact_prompts, wildcard_prompt, default_prompt = prompts
    suffixes = path.suffixes
    extension_candidates: list[str] = []
    if suffixes:
        extension_candidates.append("".join(suffixes).lower())
        extension_candidates.extend(suffix.lower() for suffix in reversed(suffixes))

    selected_prompt: str | None = None
    for extension in extension_candidates:
        if extension in exact_prompts:
            selected_prompt = exact_prompts[extension]
            break

    if selected_prompt is None:
        selected_prompt = wildcard_prompt
    if selected_prompt is None:
        selected_prompt = default_prompt
    if selected_prompt is None:
        return fallback
    if default_prompt is not None and selected_prompt != default_prompt:
        return join_prompt_sections(default_prompt, selected_prompt)
    return selected_prompt




def _tree_path_candidates(path: Path, roots: list[Path]) -> set[str]:
    candidates = {path.as_posix(), path.name}
    cwd = Path.cwd().resolve()
    try:
        candidates.add(path.relative_to(cwd).as_posix())
    except ValueError:
        pass

    for root in roots:
        base = root if root.is_dir() else root.parent
        try:
            relative = path.relative_to(base)
        except ValueError:
            continue
        candidates.add(relative.as_posix())
        candidates.add((Path(base.name) / relative).as_posix())
    return candidates



def _tree_pattern_matches(path: Path, patterns: list[str], roots: list[Path]) -> bool:
    candidates = _tree_path_candidates(path, roots)
    for raw_pattern in patterns:
        pattern = raw_pattern.replace("\\", "/")
        for candidate in candidates:
            if fnmatch.fnmatchcase(candidate, pattern):
                return True
            try:
                if Path(candidate).match(pattern):
                    return True
            except Exception:
                continue
    return False



def expand_tree_file_paths(
    input_names: list[str],
    include_patterns: list[str],
    exclude_patterns: list[str],
    exclude_git: bool = True,
 ) -> tuple[list[Path], list[Path]]:
    roots: list[Path] = []
    candidates: list[Path] = []

    for raw_name in input_names:
        root = Path(raw_name).expanduser().resolve()
        if not root.exists():
            raise ValueError(f"tree input does not exist: {raw_name}")
        roots.append(root)
        if root.is_dir():
            if exclude_git and ".git" in root.parts:
                continue
            for current_root, dir_names, file_names in os.walk(root):
                if exclude_git:
                    dir_names[:] = [
                        name for name in dir_names if name != ".git"
                    ]
                for name in file_names:
                    path = Path(current_root) / name
                    if path.is_file():
                        candidates.append(path)
        elif root.is_file():
            candidates.append(root)
        else:
            raise ValueError(f"tree input is not a file or directory: {raw_name}")

    unique_candidates: dict[Path, None] = {}
    for path in candidates:
        if exclude_git and ".git" in path.parts[:-1]:
            continue
        resolved = path.resolve()
        if resolved in unique_candidates:
            continue
        if exclude_git and ".git" in resolved.parts[:-1]:
            continue
        if exclude_patterns and _tree_pattern_matches(resolved, exclude_patterns, roots):
            continue
        if include_patterns and not _tree_pattern_matches(resolved, include_patterns, roots):
            continue
        unique_candidates[resolved] = None

    return sorted(unique_candidates, key=lambda path: path.as_posix()), roots


def resolve_tree_file_paths(
    args: argparse.Namespace,
    exclude_git: bool,
 ) -> tuple[list[Path], list[Path]]:
    input_names = (
        read_files_list(args.tree_files_list)
        if args.tree_files_list
        else list(args.tree_files or [])
    )
    file_paths, roots = expand_tree_file_paths(
        input_names,
        include_patterns=args.tree_include or [],
        exclude_patterns=args.tree_exclude or [],
        exclude_git=exclude_git,
    )
    if not file_paths:
        raise ValueError("No files matched the tree inputs and filters.")
    return file_paths, roots


def tree_result_relative_path(path: Path, roots: list[Path]) -> Path:
    cwd = Path.cwd().resolve()
    try:
        relative = path.relative_to(cwd)
    except ValueError:
        relative = None
        for root in roots:
            base = root if root.is_dir() else root.parent
            try:
                under_root = path.relative_to(base)
            except ValueError:
                continue
            relative = Path(base.name) / under_root
            break
        if relative is None:
            relative = Path(*path.parts[1:])
    safe_parts = [part for part in relative.parts if part not in ("", ".", "..")]
    if not safe_parts:
        safe_parts = [path.name or "file"]
    return Path(*safe_parts)



def response_reasoning_encrypted_items(
    response_obj: Any,
) -> tuple[dict[str, Any], ...]:
    output_items = response_field(response_obj, "output", [])
    if not isinstance(output_items, (list, tuple)):
        return ()
    reasoning_items: list[dict[str, Any]] = []
    for item in output_items:
        value = usage_to_dict(item)
        if is_completed_encrypted_reasoning_item(value):
            reasoning_items.append({
                key: content
                for key, content in value.items()
                if content is not None
            })
    return tuple(reasoning_items)


def response_reasoning_text(response_obj: Any) -> str:
    output_items = response_field(response_obj, "output", [])
    if not isinstance(output_items, (list, tuple)):
        return ""
    parts: list[str] = []
    for item in output_items:
        if response_field(item, "type") != "reasoning":
            continue
        content = response_text_parts(
            response_field(item, "content", []), "reasoning_text"
        )
        if not content:
            content = response_text_parts(
                response_field(item, "summary", []), "summary_text"
            )
        parts.extend(content)
    return "\n\n".join(parts)


def _is_openai_temp_error(exc: BaseException) -> bool:
    if isinstance(exc, ModelResponseError):
        return exc.retryable
    return isinstance(exc, APIError) and not isinstance(exc, (
        AuthenticationError,
        BadRequestError,
        PermissionDeniedError,
        NotFoundError,
        UnprocessableEntityError,
    ))

def build_tree_request_prompts(
    *,
    file_path: Path,
    task: str,
    tree_task_prompts: tuple[dict[str, str], str | None, str | None],
    tree_system_prompts: tuple[dict[str, str], str | None, str | None],
    system_prompt: str,
    linenum_system_prompt: str,
    add_line_numbers: bool,
    max_file_size_kb: int,
    model: str,
    response_format: str,
    json_schema: dict[str, Any] | None,
) -> tuple[str, str, str]:
    context = "\n".join(
        section
        for _, section in build_context_sections(
            file_paths=[file_path],
            max_file_size_kb=max_file_size_kb,
            add_line_numbers=add_line_numbers,
            model=model,
        )
    )
    selected_task = tree_prompt_for_path(
        file_path, tree_task_prompts, task
    )
    selected_system_prompt = tree_prompt_for_path(
        file_path, tree_system_prompts, system_prompt
    )
    full_system_prompt, user_prompt = build_request_prompts(
        system_prompt=join_prompt_sections(
            selected_system_prompt,
            linenum_system_prompt if add_line_numbers else "",
        ),
        task=selected_task,
        context=context,
        response_format=response_format,
        json_schema=json_schema,
    )
    return selected_task, full_system_prompt, user_prompt


def run_tree_mode(
    *,
    file_paths: list[Path],
    relative_paths: dict[Path, Path],
    task: str,
    tree_task_prompts: tuple[dict[str, str], str | None, str | None],
    tree_system_prompts: tuple[dict[str, str], str | None, str | None],
    system_prompt: str,
    linenum_system_prompt: str,
    add_line_numbers: bool,
    max_file_size_kb: int,
    tree_parallel: int,
    token_limit: int,
    model_settings: ModelSettings,
    response_format: str,
    json_schema: dict[str, Any] | None,
    token_cost: tuple[float, float] | None,
    print_reasoning: bool,
    tree_session_dir: Path,
    state_session_dir: Path,
    combined_tree_path: Path,
    log_enabled: bool,
    log_path: Path | None,
    cumulative_stats: CumulativeStats,
    tree_session_stem: str = "",
    agent_backup: AgentBackup | None = None,
    image_urls: tuple[str, ...] = (),
) -> int:
    retry = max(1, parse_retry_count(model_settings.retry))
    model = model_settings.model
    log_lock = threading.Lock()
    db_lock = threading.Lock()
    state_turn_lock = threading.Lock()
    next_state_turn = next_state_turn_index(state_session_dir)

    def append_tree_log(text: str) -> None:
        with log_lock:
            append_session_log(log_path, text, log_enabled)
    def save_tree_state_turn(
        request: RecordedModelTurn,
        task: str,
        response_obj: Any,
        response: str,
        error: str | None,
    ) -> None:
        nonlocal next_state_turn
        with state_turn_lock:
            turn = next_state_turn
            next_state_turn += 1
            request.start_state(state_session_dir, turn, task, file_paths)
            if error is not None:
                request.record_error(error)
                return
            try:
                request.complete(response_obj, response)
            except Exception as exc:
                request.record_error(exc)
                raise

    state_db_path = str(tree_session_dir / f"{tree_session_stem}.dbm")
    rel_to_path = {
        relative_paths[path].as_posix(): path
        for path in file_paths
    }
    try:
        with db_lock, dbm.open(state_db_path, "c") as state_db:
            for source_dir, _ in state_session_chain(state_session_dir)[1:]:
                source_tree_dir = APP_DIR / "trees" / source_dir.name
                source_db_path = str(
                    source_tree_dir / f"{source_dir.name}.dbm"
                )
                if not dbm.whichdb(source_db_path):
                    continue
                with dbm.open(source_db_path, "r") as source_db:
                    for rel in rel_to_path:
                        key = rel.encode("utf-8")
                        if key in state_db or key not in source_db:
                            continue
                        status = source_db[key]
                        source_output_path = source_tree_dir / rel
                        if source_output_path.is_file():
                            output_path = tree_session_dir / rel
                            output_path.parent.mkdir(
                                parents=True, exist_ok=True
                            )
                            shutil.copyfile(
                                source_output_path, output_path
                            )
                        elif status.startswith(b"complete"):
                            status = b"pending"
                        state_db[key] = status
            for rel in rel_to_path:
                key = rel.encode("utf-8")
                if key not in state_db:
                    state_db[key] = b"pending"
            for key in list(state_db.keys()):
                try:
                    val = state_db[key].decode("utf-8", errors="replace")
                    if val.startswith(("perm", "temp_error_exhausted")):
                        state_db[key] = b"pending"
                except Exception:
                    pass
    except Exception as exc:
        print(f"ERROR: Failed to open tree state db {state_db_path}: {exc}", file=sys.stderr)
        return 1

    def get_statuses() -> dict[str, str]:
        statuses: dict[str, str] = {}
        with db_lock, dbm.open(state_db_path, "c") as state_db:
            for rel in rel_to_path:
                key = rel.encode("utf-8")
                status = "pending"
                if key in state_db:
                    try:
                        status = state_db[key].decode("utf-8", errors="replace")
                    except Exception:
                        pass
                statuses[rel] = status
        return statuses

    def set_status(rel: str, status: str) -> None:
        with db_lock, dbm.open(state_db_path, "c") as state_db:
            state_db[rel.encode("utf-8")] = status.encode("utf-8")

    failed_retries: dict[str, int] = {}

    def schedule_tree_retry(rel: str, error_text: str) -> bool:
        failed_retries[rel] = failed_retries.get(rel, 0) + 1
        failed_attempt = failed_retries[rel]
        failure_message = (
            f"ERROR: Tree file {rel} failed "
            f"(attempt {failed_attempt}/{retry}): {error_text}"
        )
        print(failure_message, file=sys.stderr)
        _log_api_request_event(append_tree_log, failure_message)
        if failed_attempt >= retry:
            set_status(rel, f"temp_error_exhausted:{error_text}")
            return False
        return True

    def process_file(file_path: Path) -> dict[str, Any]:
        relative_path = relative_paths[file_path]
        rel_str = relative_path.as_posix()
        output_path = tree_session_dir / relative_path
        result = ""
        reasoning = ""
        response_obj: Any = None
        error_text: str | None = None
        error_type: str = "none"
        selected_task = task

        def append_file_log(text: str) -> None:
            append_tree_log(
                f"<tree_file path={quote_tag_attribute(file_path)}>\n"
                f"{text}</tree_file>\n"
            )

        def log_response(text: str, response_reasoning: str) -> None:
            nonlocal reasoning
            reasoning = response_reasoning
            append_file_log(format_model_response_log(text, response_reasoning))

        request = RecordedModelTurn(
            ModelRequestSettings(model_settings, token_limit, token_cost),
            cumulative_stats,
            append_file_log,
            prefix=f"request_type=tree tree_file={quote_tag_attribute(file_path)}",
        )
        if agent_backup is not None:
            with state_turn_lock:
                agent_backup.run_if_due()
        with request.record():
            try:
                (
                    selected_task, full_system_prompt, user_prompt,
                ) = build_tree_request_prompts(
                    file_path=file_path,
                    task=task,
                    tree_task_prompts=tree_task_prompts,
                    tree_system_prompts=tree_system_prompts,
                    system_prompt=system_prompt,
                    linenum_system_prompt=linenum_system_prompt,
                    add_line_numbers=add_line_numbers,
                    max_file_size_kb=max_file_size_kb,
                    model=model,
                    response_format=response_format,
                    json_schema=json_schema,
                )
                request.prepare(full_system_prompt, user_prompt)
                request.check_token_limit()
                request.log_request()
                response_obj, result = request.call(
                    image_urls=image_urls,
                    response_format=response_format,
                    json_schema=json_schema,
                    retry=0,
                    report_errors=False,
                    response_logger=log_response,
                )
                if not result.strip():
                    error_text = "LLM returned an empty response"
                    error_type = "temp"
                if response_format in ("json", "schema") and result.strip():
                    try:
                        result = pretty_json(
                            result, model_settings.response_json_repair
                        )
                    except (ValueError, TypeError) as exc:
                        error_text = f"Failed to parse JSON response: {exc}"
                        error_type = "temp"
            except BaseException as exc:
                error_text = format_exception_message(exc, include_type=True)
                error_type = "temp" if _is_openai_temp_error(exc) else "perm"
        statsline = request.response_stats
        stored_result = result
        if not stored_result:
            stored_result = f"ERROR: {error_text}" if error_text else ""
        stored_result = format_response_output(stored_result, reasoning, print_reasoning)
        try:
            output_path.parent.mkdir(parents=True, exist_ok=True)
            output_path.write_text(stored_result, encoding="utf-8")
        except Exception as exc:
            if error_text is None:
                error_text = format_exception_message(exc, include_type=True)
            error_type = "perm"
        save_tree_state_turn(
            request=request,
            task=selected_task,
            response_obj=response_obj,
            response=result,
            error=(
                f"{file_path}: {error_text}"
                if error_text is not None
                else None
            ),
        )
        success = error_text is None
        statsline += f" status={'ok' if success else 'error'}"
        if error_text:
            append_file_log(f"<error>{error_text}</error>\n")
        emit_stats(statsline, append_file_log)
        timestamp = int(time.time())
        append_file_log(
            f"<end_time>{time.ctime(timestamp)} [{timestamp}]</end_time>\n"
        )
        if success:
            set_status(rel_str, "complete")
            error_type = "none"
        else:
            if error_type == "none":
                error_type = "perm"
            set_status(rel_str, f"{error_type}_error:{error_text or 'unknown'}")
        return {
            "success": success,
            "error_type": error_type,
            "error": error_text,
        }

    backoff = 5
    concurrency = max(1, tree_parallel)
    while True:
        pending = [
            (rel, rel_to_path[rel])
            for rel, status in get_statuses().items()
            if not status.startswith(
                ("complete", "perm_error", "temp_error_exhausted")
            )
        ]
        if not pending:
            break
        workers = min(concurrency, len(pending))
        if workers < 1:
            workers = 1
        temp_errors_this_round = 0
        try:
            with ThreadPoolExecutor(max_workers=workers) as executor:
                future_to_rel: dict = {}
                for rel, fp in pending:
                    fut = executor.submit(process_file, fp)
                    future_to_rel[fut] = rel
                for future in as_completed(future_to_rel):
                    rel = future_to_rel[future]
                    try:
                        record = future.result()
                        if record.get("success"):
                            failed_retry_count = failed_retries.pop(rel, 0)
                            if failed_retry_count:
                                reset_message = (
                                    f"INFO: Tree file {rel} succeeded after "
                                    f"{failed_retry_count} "
                                    f"{'retry' if failed_retry_count == 1 else 'retries'}; "
                                    "retry counter reset."
                                )
                                _log_api_request_event(
                                    append_tree_log, reset_message
                                )
                        elif record.get("error_type") == "temp":
                            if schedule_tree_retry(
                                rel,
                                str(record.get("error") or "unknown error"),
                            ):
                                temp_errors_this_round += 1
                        else:
                            failure_message = (
                                f"ERROR: Tree file {rel} failed: "
                                f"{record.get('error') or 'unknown error'}"
                            )
                            print(failure_message, file=sys.stderr)
                            _log_api_request_event(
                                append_tree_log, failure_message
                            )
                    except BaseException as exc:
                        error_text = format_exception_message(exc, include_type=True)
                        set_status(rel, f"temp_error:{error_text}")
                        if schedule_tree_retry(rel, error_text):
                            temp_errors_this_round += 1
        except Exception as exc:
            print(f"ERROR: Failed to run tree workers: {exc}", file=sys.stderr)
            temp_errors_this_round += 1
        if temp_errors_this_round > 0:
            concurrency = max(1, concurrency // 2)
            backoff = min(backoff * 2, API_RETRY_MAX_DELAY_SECONDS)
            time.sleep(backoff)
        else:
            concurrency = min(tree_parallel, concurrency + 1)
            backoff = 1
    all_complete = all(
        status.startswith("complete")
        for status in get_statuses().values()
    )
    combined_parts: list[str] = []
    for rel in sorted(rel_to_path.keys()):
        out_path = tree_session_dir / rel
        try:
            res = out_path.read_text(encoding="utf-8") if out_path.exists() else ""
        except Exception:
            res = f"ERROR: cannot read {out_path}"
        combined_parts.append(
            f"------------------------------------------------------------------------\n"
            f"# **{rel}**\n"
            f"------------------------------------------------------------------------\n"
            f"\n{res.rstrip()}\n\n"
        )
    try:
        combined_tree_path.parent.mkdir(parents=True, exist_ok=True)
        combined_tree_path.write_text("\n".join(combined_parts), encoding="utf-8")
    except Exception as exc:
        print(f"ERROR: Failed to write combined tree result {combined_tree_path}: {exc}", file=sys.stderr)
        return 1
    if VERBOSE:
        print(
            f"tree_output_file={combined_tree_path} "
            f"tree_output_directory={tree_session_dir}",
            file=sys.stderr,
        )
    return 0 if all_complete else 1


