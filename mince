            selected_profiles: list[str] = []
            for profile_name in profile_names:
                if not profile_name.isidentifier():
                    raise ValueError(
                        f"invalid profile name '{profile_name}'"
                    )
                if profile_name not in available_profiles:
                    raise ValueError(
                        f"profile '{profile_name}' does not exist"
                    )
                if profile_name not in selected_profiles:
                    selected_profiles.append(profile_name)
        else:
            selected_profiles = available_profiles

        sections: list[str] = []
        for profile_name in selected_profiles:
            profile_config = merged_config(get_profile_path(profile_name))
            profile_lines = [f"[{profile_name}]"]
