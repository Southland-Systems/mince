    if VERBOSE:
        print(f"request_characters={request_characters} request_tokens_estimate={request_tokens}{request_cost_log} model={model} reasoning={openai_reasoning}", file=sys.stderr)

    state_turn_path: Path | None = None
    if state_enabled:
        state_task = task
        state_turn_path = start_state_turn(
            state_session_dir,
            state_turn,
            full_system_prompt,
            state_task,
            file_paths=file_paths,
        )
        state_turn += 1
    start_time = time.perf_counter()
    stream_file = None
    stream_output_emitted = False
    stream_sink = None

    try:
        if stream_enabled and not print_reasoning:
            if args.output_file:
                args.output_file.parent.mkdir(parents=True, exist_ok=True)
                stream_file = args.output_file.open("w", encoding="utf-8")

            def emit_stream_text(delta: str) -> None:
                if stream_file is not None:
                    stream_file.write(delta)
