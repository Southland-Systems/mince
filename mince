            print("Please answer y, n, p, or e.")
        if log_enabled:
            with open(log_path, "a", encoding="utf-8") as f:
                f.write(f"<plan_review>{'accepted' if accepted else 'rejected'}</plan_review>\n")
        if not accepted:
