        )

    if ask_mode:
        context = ""
        if args.ask is not None:
            user_prompt = expand_prompt_names(
                read_prompt_argument(args.ask),
                prompt_expansion_enabled,
            )
        else:
            user_prompt = expand_prompt_names(
                read_prompt_files(args.ask_file).strip(),
                prompt_expansion_enabled,
