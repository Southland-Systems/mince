def handle_inherit_profile(current_name: str, new_name: str) -> int:
    try:
        current_name = validate_prompt_profile_name(current_name)
        new_name = validate_prompt_profile_name(new_name)
        if new_name == "config":
            raise ValueError("cannot create a child profile named 'config'")
        if current_name == new_name:
            raise ValueError("a profile cannot inherit itself")

        source_path = get_profile_path(current_name)
        destination_path = get_profile_path(new_name)
        if not source_path.exists():
            raise ValueError(
                f"source profile '{current_name}' does not exist"
            )
        if destination_path.exists():
            raise ValueError(
                f"destination profile '{new_name}' already exists"
            )

        # Validate the source profile and its inheritance chain.
        merged_config(source_path)
        write_config_document(
            destination_path,
            {INHERIT_PROFILE_CONFIG_KEY: current_name},
        )
    except Exception as exc:
        print(f"ERROR: Failed to inherit profile: {exc}", file=sys.stderr)
        return 1
    print(f"Profile '{new_name}' inherited from '{current_name}'.")
    return 0


def configuration_profile_names() -> list[str]:
    ensure_config_exists()
    profile_names = sorted(
        path.stem
        for path in APP_DIR.glob("*.json")
        if path.is_file()
    )
    return ["config"] + [
        name for name in profile_names if name != "config"
    ]

def handle_show_profiles(
    profile_names: list[str] | None = None,
    json_output: bool = False,
 ) -> int:
    try:
        available_profiles = configuration_profile_names()
        if profile_names:
            selected_profiles: list[str] = []
            for profile_name in profile_names:
                if not profile_name.isidentifier():
                    raise ValueError(
                        f"invalid profile name '{profile_name}'"
                    )
                if profile_name not in available_profiles:
                    raise ValueError(
                        f"profile '{profile_name}' does not exist"
                    )
                if profile_name not in selected_profiles:
                    selected_profiles.append(profile_name)
        else:
            selected_profiles = available_profiles

        profile_configs: dict[str, dict[str, Any]] = {}
        sections: list[str] = []
        for profile_name in selected_profiles:
            profile_config = merged_config(get_profile_path(profile_name))
            if json_output:
                profile_config["api_key"] = mask_api_key(
                    profile_config.get("api_key", "")
                )
                profile_configs[profile_name] = profile_config
                continue
            profile_lines = [f"[{profile_name}]"]
            profile_lines.extend(format_config_lines(profile_config))
            sections.append("\n".join(profile_lines))
        if json_output:
            print(json.dumps(profile_configs, indent=2, ensure_ascii=False))
        else:
            page_or_print("\n\n".join(sections) + "\n")
    except Exception as exc:
        print(f"ERROR: Failed to show profiles: {exc}", file=sys.stderr)
        return 1
    return 0


