    )
    session_view_group = parser.add_mutually_exclusive_group()
    session_view_group.add_argument(
        "--log-view",
        metavar="SESSION",
        help="Display a saved log session",
    )
    session_view_group.add_argument(
        "--patch-view",
        metavar="SESSION",
        help="Display a saved patch session",
    )
    session_view_group.add_argument(
        "--tree-view",
        metavar="SESSION",
        help="Display a saved combined tree manifest",
    )
    session_view_group.add_argument(
        "--remove-expired-data",
        nargs="?",
        const=60,
        default=None,
        type=int,
        metavar="KEEP_DAYS",
        help="Delete session data older than KEEP_DAYS days (default: 60)",
    )
    return parser.parse_args()

# -------------------------------------------------------------------
# Main
# -------------------------------------------------------------------

def main() -> int:
    tokenizer_padding = 0

    json_schema = None
    json_schema = None
    json_patch_responses: list[str] = []
    json_patch_task: str | None = None

    global CONFIG_FILE
    global VERBOSE
    global DEBUG

    args = parse_args()
    if args.patch_merge is not None:
        try:
            if git_repository_root() is None:
                raise ValueError('not inside a git worktree')
        except (OSError, ValueError) as exc:
            print(f'ERROR: {exc}', file=sys.stderr)
            return 1
        if any(
            value is not None
            for value in (
                args.ask,
                args.ask_file,
                args.task,
                args.task_file,
                args.patch,
            )
        ):
            print(
                'ERROR: --patch-merge cannot be combined with ask, task, or --patch',
                file=sys.stderr,
            )
            return 1
        try:
            merge_branch_name = resolve_patch_branch_name(args.patch_branch)
            merge_commit_message = ' '.join(args.patch_merge).strip()
            if not merge_commit_message:
                raise ValueError('--patch-merge commit message cannot be empty')
        except ValueError as exc:
            print(f'ERROR: {exc}', file=sys.stderr)
            return 1
        return handle_patch_merge(merge_branch_name, merge_commit_message)
    reuse_session_turn: int | None = None
    if isinstance(args.reuse_session, list):
        if len(args.reuse_session) > 2:
            print(
                "ERROR: --reuse-session accepts SESSION_NAME and optional TURN",
                file=sys.stderr,
            )
            return 1
        if len(args.reuse_session) == 2:
            try:
                reuse_session_turn = int(args.reuse_session[1])
            except ValueError:
                print(
                    "ERROR: --reuse-session TURN must be an integer",
                    file=sys.stderr,
                )
                return 1
        args.reuse_session = args.reuse_session[0]
    if reuse_session_turn is not None and reuse_session_turn < 0:
        print(
            "ERROR: --reuse-session TURN must be non-negative",
            file=sys.stderr,
        )
        return 1
    if args.remove_expired_data is not None:
        return handle_remove_expired_data(args.remove_expired_data)

    if args.log_view is not None:
        return handle_session_view("log", args.log_view)
    if args.patch_view is not None:
        return handle_session_view("patch", args.patch_view)
    if args.tree_view is not None:
        return handle_session_view("tree", args.tree_view)

    if args.quiet:
        VERBOSE = 0

    if args.debug:
        DEBUG = 1

    if args.init:
        init_config_interactive()
        return 0

    if args.prompt_list:
        return handle_prompt_list()
    if args.prompt_print is not None:
        return handle_prompt_print(args.prompt_print)
    if args.prompt_edit is not None:
        return handle_prompt_edit(args.prompt_edit)
    if args.prompt_assign is not None:
        return handle_prompt_assign(args.prompt_assign)
    if args.prompt_assign_text is not None:
        return handle_prompt_assign(args.prompt_assign_text, "string")
    if args.prompt_assign_replace is not None:
        return handle_prompt_assign(args.prompt_assign_replace, "replace")
    if args.prompt_unassign is not None:
        return handle_prompt_unassign(args.prompt_unassign)
    if args.prompt_remove is not None:
        return handle_prompt_remove(args.prompt_remove)


    base_profile = args.profile or "config"

    if not base_profile.isidentifier():
        print(f"ERROR: Invalid profile name '{base_profile}'.", file=sys.stderr)
        return 1

    if args.list_profiles:
        ensure_config_exists()
        profiles = sorted(p.stem for p in APP_DIR.glob("*.json"))
        for name in profiles:
            print(name)
        return 0

    if args.print_profiles is not None:
        return handle_show_profiles(args.print_profiles)

    if args.init_profile:
        new_name = args.init_profile
        if not new_name.isidentifier():
            print(f"ERROR: Invalid profile name '{new_name}'.", file=sys.stderr)
            return 1
        CONFIG_FILE = get_profile_path(new_name)
        init_config_interactive()
        return 0

    if args.copy_profile:
        new_name = args.copy_profile
        if new_name == "config":
            print("ERROR: Cannot copy to profile name 'config'.", file=sys.stderr)
            return 1
        if not new_name.isidentifier():
            print(f"ERROR: Invalid profile name '{new_name}'.", file=sys.stderr)
            return 1
        src_path = get_profile_path(base_profile)
        dst_path = get_profile_path(new_name)
        if not src_path.exists():
            print(f"ERROR: Source profile '{base_profile}' does not exist.", file=sys.stderr)
            return 1
        if dst_path.exists():
            print(f"ERROR: Destination profile '{new_name}' already exists.", file=sys.stderr)
            return 1
        try:
            dst_path.write_text(src_path.read_text(encoding="utf-8"), encoding="utf-8")
        except Exception as exc:
            print(f"ERROR: Failed to copy profile: {exc}", file=sys.stderr)
            return 1
        print(f"Profile '{base_profile}' copied to '{new_name}'.")
        return 0

    if args.remove_profile:
        name = args.remove_profile
        if name == "config":
            print("ERROR: Cannot remove the default 'config' profile.", file=sys.stderr)
            return 1
        if not name.isidentifier():
            print(f"ERROR: Invalid profile name '{name}'.", file=sys.stderr)
            return 1
        path = get_profile_path(name)
        if not path.exists():
            print(f"ERROR: Profile '{name}' does not exist.", file=sys.stderr)
            return 1
        try:
            path.unlink()
        except Exception as exc:
            print(f"ERROR: Failed to remove profile: {exc}", file=sys.stderr)
            return 1
        print(f"Profile '{name}' removed.")
        return 0

    CONFIG_FILE = get_profile_path(base_profile)

    if args.set_config_from:
        name, source_profile = args.set_config_from
        try:
            name = name.strip()
            if not name:
                raise ValueError("configuration name cannot be empty")
            source_profile = validate_prompt_profile_name(source_profile)
            source_config = read_config_document(
                get_profile_path(source_profile)
            )
            if name in source_config:
                value = source_config[name]
            else:
                replacement = DEPRECATED_CONFIG_KEYS.get(name)
                if replacement is None or replacement not in source_config:
                    raise ValueError(
                        f"configuration value '{name}' does not exist in "
                        f"profile '{source_profile}'"
                    )
                value = source_config[replacement]

            config = load_config()
            config[name] = value
            replacement = DEPRECATED_CONFIG_KEYS.get(name)
            if replacement is not None:
                config[replacement] = value
            save_config(config)
        except Exception as exc:
            print(
                f"ERROR: Failed to set configuration from profile: {exc}",
                file=sys.stderr,
            )
            return 1
        return 0

    if args.set_config:
        config = load_config()
        try:
            updates = [
                parse_config_assignment(value, config)
                for value in args.set_config
            ]
        except ValueError as exc:
            print(f"ERROR: Invalid config assignment: {exc}", file=sys.stderr)
            return 1

        for name, value in updates:
            config[name] = value
            replacement = DEPRECATED_CONFIG_KEYS.get(name)
            if replacement is not None:
                config[replacement] = value
        save_config(config)
        return 0

    if args.get_config is not None:
        config = load_config()
        name = args.get_config.strip()
        if name:
            if name not in config:
                print(f"ERROR: Configuration value '{name}' does not exist.", file=sys.stderr)
                return 1
            items = ((name, config[name]),)
        else:
            items = config.items()

        for config_name, value in items:
            print(format_config_line(config_name, value))
        return 0

    if args.print_default_config:
        print(json.dumps(DEFAULT_CONFIG, indent=2, ensure_ascii=False))
        return 0

    if args.print_current_config:
        ensure_config_exists()
        try:
            current_config = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
            if not isinstance(current_config, dict):
                raise ValueError("configuration must be a JSON object")
            current_config["api_key"] = mask_api_key(current_config.get("api_key", ""))
            print(json.dumps(current_config, indent=2, ensure_ascii=False))
        except Exception as exc:
            print(f"ERROR: Unable to read config file: {exc}", file=sys.stderr)
            return 1
        return 0


    ask_mode: bool = args.ask is not None or args.ask_file is not None
    state_enabled = not ask_mode
    tree_mode = args.tree_files is not None or args.tree_files_list is not None
    if args.reuse_session is not None:
        if ask_mode:
            print(
                "ERROR: --reuse-session requires --task or --task-file",
                file=sys.stderr,
            )
            return 1
        if not tree_mode and args.task is None and args.task_file is None:
            print(
                "ERROR: --reuse-session requires --task or --task-file",
                file=sys.stderr,
            )
            return 1
    tree_exclude_git = (
        args.tree_exclude_git
        if args.tree_exclude_git is not None
        else True
    )
    tree_option_used = any(
        value is not None
        for value in (
            args.tree_task,
            args.tree_task_file,
            args.tree_system_prompt_file,
            args.tree_exclude,
            args.tree_include,
            args.tree_exclude_git,
            args.tree_parallel,
        )
    ) or args.tree_show_only
    file_names: list[str] = []
    tree_task_prompts: tuple[dict[str, str], str | None, str | None] = ({}, None, None)

    if tree_mode:
        if ask_mode or args.task is not None or args.task_file is not None or args.files is not None or args.files_list is not None:
            print("ERROR: tree mode cannot be combined with regular task, ask, or file options", file=sys.stderr)
            return 1
        if not args.tree_show_only and args.tree_task is None and args.tree_task_file is None:
            print("ERROR: tree mode requires --tree-task or --tree-task-file", file=sys.stderr)
            return 1
        if args.tree_show_only:
            task = ""
        elif args.tree_task is not None:
            task = read_prompt_argument(args.tree_task)
        else:
            try:
                tree_task_prompts = read_tree_prompt_file(args.tree_task_file)
            except ValueError as exc:
                print(f"ERROR: {exc}", file=sys.stderr)
                return 1
            task = ""
    elif tree_option_used:
        print("ERROR: tree options require --tree-files or --tree-files-list", file=sys.stderr)
        return 1
    elif not ask_mode and not args.list_models:
        if args.task:
            task = read_prompt_argument(args.task)
        elif args.task_file:
            task = read_file(args.task_file).strip()
        else:
            print("ERROR: --ask or --task required (--help for help)", file=sys.stderr)
            return 1
        if args.reuse_session is not None and not task:
            print(
                "ERROR: --reuse-session requires a non-empty task",
                file=sys.stderr,
            )
            return 1

        if args.files_list:
            try:
                file_names = read_files_list(args.files_list)
            except ValueError as exc:
                print(f"ERROR: {exc}", file=sys.stderr)
                return 1
        elif args.files:
            file_names = args.files

        if not file_names and args.reuse_session is None:
            print("ERROR: --files or --files-list required (--help for help)", file=sys.stderr)
            return 1
    else:
        task = ""

    if tree_mode and args.tree_show_only:
        try:
            if args.tree_files_list:
                tree_input_names = read_files_list(args.tree_files_list)
            else:
                tree_input_names = list(args.tree_files or [])
            tree_file_paths, _ = expand_tree_file_paths(
                tree_input_names,
                include_patterns=args.tree_include or [],
                exclude_patterns=args.tree_exclude or [],
                exclude_git=tree_exclude_git,
            )
        except ValueError as exc:
            print(f"ERROR: {exc}", file=sys.stderr)
            return 1

        if not tree_file_paths:
            print("ERROR: No files matched the tree inputs and filters.", file=sys.stderr)
            return 1

        for tree_file_path in tree_file_paths:
            print(tree_file_path)
        return 0

    config = load_config()

    prompt_expansion_enabled = (
        args.prompt_expansion
        if args.prompt_expansion is not None
        else coerce_bool(config.get("prompt_expansion", "off"))
    )
    task = expand_prompt_names(task, prompt_expansion_enabled)
    tree_task_prompts = expand_tree_prompt_values(
        tree_task_prompts, prompt_expansion_enabled
    )

    add_line_numbers = (
        args.no_line_numbers
        if args.no_line_numbers is not None
        else coerce_bool(config.get("line_numbers", "on"), True)
    )

    quiet_enabled = (
        args.quiet
        if args.quiet is not None
        else coerce_bool(config.get("quiet", "off"))
    )
    if quiet_enabled:
        VERBOSE = 0

    patch_mode = (
        args.patch
        if args.patch is not None
        else coerce_bool(config.get("patch", "off"))
    )
    try:
        patch_branch_setting = resolve_patch_branch_setting(
            args.patch_branch
            if args.patch_branch is not None
            else config.get('patch_branch', DEFAULT_CONFIG['patch_branch'])
        )
    except ValueError as exc:
        print(f"ERROR: Invalid patch branch value: {exc}", file=sys.stderr)
        return 1
    patch_branch_mode = patch_branch_setting is not None
    patch_save_enabled = (
        args.patch_save
        if args.patch_save is not None
        else coerce_bool(config.get("patch_save", "on"), True)
    )
    patch_review = (
        args.patch_review
        if args.patch_review is not None
        else coerce_bool(config.get("patch_review", "off"))
    )
    plan_mode = (
        args.plan
        if args.plan is not None
        else coerce_bool(config.get("plan", "off"))
    )
    print_reasoning = (
        args.print_reasoning
        if args.print_reasoning is not None
        else coerce_bool(config.get("print_reasoning", "off"))
    )
    configured_patch_suffix = str(config.get("patch_suffix", DEFAULT_CONFIG["patch_suffix"]) or "").strip()
    if args.patch_suffix is not None:
        patch_suffix = args.patch_suffix
        suffix_provided = True
    elif configured_patch_suffix and configured_patch_suffix.lower() != "off":
        patch_suffix = configured_patch_suffix
        suffix_provided = configured_patch_suffix != DEFAULT_CONFIG["patch_suffix"]
    else:
        patch_suffix = DEFAULT_CONFIG["patch_suffix"]
        suffix_provided = False
    if patch_branch_mode:
        patch_suffix = ''
        suffix_provided = False

    if tree_mode and (plan_mode or patch_mode):
        print("ERROR: tree mode cannot be combined with --plan or --patch", file=sys.stderr)
        return 1
    if plan_mode and ask_mode:
        print("ERROR: --plan only supports --task or --task-file", file=sys.stderr)
        return 1
    if patch_mode and not (args.task or args.task_file):
        print("ERROR: --patch requires --task or --task-file", file=sys.stderr)
        return 1
    if patch_mode and (args.ask or args.ask_file):
        print("ERROR: --patch only supports --task or --task-file ", file=sys.stderr)
        return 1
    if patch_branch_mode and not patch_mode:
        print('ERROR: --patch-branch requires --patch', file=sys.stderr)
        return 1
    if patch_branch_mode:
        try:
            if git_repository_root() is None:
                raise ValueError('not inside a git worktree')
        except (OSError, ValueError) as exc:
            print(f'ERROR: {exc}', file=sys.stderr)
            return 1

    llm_timeout = (
        args.llm_timeout
        if args.llm_timeout is not None
        else config.get("llm_timeout", 300)
    )

    model = str(args.model or config.get("model")).strip()
    openai_base_url = str(args.base_url or config.get("base_url")).strip()
    openai_proxy = str(args.proxy_server or config.get("proxy_server", "")).strip()
    openai_organization = str(args.meta_organization or config.get("meta_organization", "")).strip()
    openai_project = str(args.meta_project or config.get("meta_project", "")).strip()
    safety_identifier = config.get("safety_identifier", None)
    api_log = (
        args.no_api_log
        if args.no_api_log is not None
        else coerce_bool(config.get("api_log", True), True)
    )

    if args.list_models:
        api_key = resolve_api_key(config)
        client = OpenAI(
            api_key=api_key,
            base_url=openai_base_url,
        )
        try:
            models = client.models.list()
            modelnames = []
            for m in models:
                modelnames.append(m.id)
            modelnames.sort()
            for m in modelnames:
                print(m)
        except Exception as exc:
            _handle_openai_error(exc)
        return 0

    if args.system_prompt:
        system_prompt = expand_prompt_names(
            str(args.system_prompt).strip(),
            prompt_expansion_enabled,
        )
    elif args.system_prompt_file:
        system_prompt = expand_prompt_names(
            read_file(args.system_prompt_file).strip(),
            prompt_expansion_enabled,
        )
    else:
        configured_system_prompt = resolve_configured_prompt(
            config.get("system_prompt", DEFAULT_SYSTEM_PROMPT),
            DEFAULT_SYSTEM_PROMPT,
        )
        system_prompt = expand_prompt_names(
            configured_system_prompt,
            prompt_expansion_enabled,
        )

