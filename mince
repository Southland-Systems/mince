}

def _shell_step_from_value(value: Any, index: int) -> ShellStep:
    if not isinstance(value, dict):
        raise ValueError(f"shell command {index} must be an object")
    allowed_keys = {"command", "lines", "reason"}
    unexpected = set(value) - allowed_keys
    if unexpected:
        raise ValueError(
            f"shell command {index} has unexpected fields: "
            + ", ".join(sorted(unexpected))
        )
    command_value = value.get("command")
    if not isinstance(command_value, str) or not command_value.strip():
        raise ValueError(f"shell command {index} requires a non-empty command")
    command = command_value.strip()
    if "\x00" in command:
        raise ValueError(f"shell command {index} cannot contain a null byte")
    reason_value = value.get("reason")
    if not isinstance(reason_value, str) or not reason_value.strip():
        raise ValueError(f"shell command {index} requires a non-empty reason")
    reason = reason_value.strip()
    if "lines" not in value:
        return ShellStep(command=command, reason=reason)
    raw_lines = value["lines"]
    if not isinstance(raw_lines, list) or not raw_lines:
        raise ValueError(f"shell script {index} requires a non-empty lines array")
    if any(not isinstance(line, str) for line in raw_lines):
        raise ValueError(f"shell script {index} lines must be strings")
    return ShellStep(
        command=command,
        lines=tuple(raw_lines),
        reason=reason,
    )

def normalize_shell_commands(values: Any) -> list[ShellStep]:
    if not isinstance(values, list) or not values:
        raise ValueError("shell manifest commands must be a non-empty array")
    return [
        _shell_step_from_value(value, index)
        for index, value in enumerate(values, start=1)
    ]


def parse_shell_response(
    raw: Any,
    response_json_repair: bool = False,
    *,
    followup: bool | None = False,
) -> tuple[list[ShellStep], str | None]:
    response = (
        parse_json_response(raw, response_json_repair)
        if isinstance(raw, str)
        else raw
    )
    if followup is None:
        followup = isinstance(response, dict) and "action" in response
    label = "shell follow-up response" if followup else "shell manifest"
    if not isinstance(response, dict):
        raise ValueError(f"{label} must contain a JSON object")
    if not followup:
        if set(response) != {"commands"}:
            raise ValueError("shell manifest must contain only a commands field")
        return normalize_shell_commands(response["commands"]), None
    if set(response) != {"action", "commands", "reason"}:
        raise ValueError("shell follow-up response must contain only action, commands, and reason")
    action = response["action"]
    if action not in ("commands", "session_end"):
        raise ValueError("shell follow-up action must be commands or session_end")
    reason = response["reason"]
    if not isinstance(reason, str):
        raise ValueError("shell follow-up reason must be a string")
    commands_value = response["commands"]
    if not isinstance(commands_value, list):
        raise ValueError("shell follow-up commands must be an array")
    if action == "session_end":
        if not reason.strip():
            raise ValueError("shell follow-up session_end reason cannot be empty")
        if commands_value:
            raise ValueError("shell follow-up session_end commands must be empty")
        return [], reason
    return normalize_shell_commands(commands_value), None


def shell_heredoc_delimiter(lines: tuple[str, ...]) -> str:
    input_lines = set("\n".join(lines).splitlines())
    delimiter = "MINCE_SCRIPT"
    suffix = 1
    while delimiter in input_lines:
        delimiter = f"MINCE_SCRIPT_{suffix}"
        suffix += 1
    return delimiter


def format_shell_commands(
    commands: list[ShellStep],
    include_reasons: bool = True,
 ) -> str:
    blocks: list[str] = []
    for index, step in enumerate(commands, start=1):
        reason_prefix = (
            f"{step.reason}\n"
            if include_reasons and step.reason
            else ""
        )
        if step.lines:
            delimiter = shell_heredoc_delimiter(step.lines)
            block = (
                f"{reason_prefix}[{index}] $ {step.command} <<'{delimiter}'\n"
                + "\n".join(step.lines)
                + f"\n{delimiter}"
            )
        else:
            block = f"{reason_prefix}[{index}] $ {step.command}"
        blocks.append(block)
    return "\n\n".join(blocks)


def format_shell_command_archive(
    archived_turns: list[ShellTurn],
 ) -> str:
    turn_blocks: list[str] = []
    for turn in archived_turns:
        if not turn.commands:
            continue
        turn_blocks.append(
            f"<shell_turn index='{len(turn_blocks) + 1}'>\n"
            f"{format_shell_commands(list(turn.commands), include_reasons=False)}\n"
            "</shell_turn>"
        )
    return "\n".join(turn_blocks)

def process_tool_review_input(
    tool_input: str,
    tool_text: str,
    usage: str = "Usage: [y]es, [n]o, [p]ager, [h]elp, [e]dit, E <prompt>",
 ) -> str | None:
    choice = tool_input.strip()
    normalized_choice = choice.lower()
    if not choice or normalized_choice == "h":
        print(usage)
        return None
    if normalized_choice == "p":
        page_or_print(tool_text)
        return None
    return choice


def review_tool_text(
    tool_text: str,
    prompt: str,
    accept_automatically: bool = False,
    accept_noninteractive: bool = False,
    input_processor: Callable[[str], str | None] | None = None,
    invalid_choice_message: str = (
        'Please answer y, n, p, h, e, or E followed by a prompt.'
    ),
    allow_revision: bool = True,
    additional_actions: tuple[str, ...] = (),
    display_text: bool = True,
) -> tuple[str, str | None]:
    if accept_automatically:
        return 'accept', None
    if NONINTERACTIVE:
        return (
            'accept' if accept_noninteractive else 'save',
            None,
        )
    if display_text:
        print()
        print(tool_text)
    while True:
        review_input = input(prompt)
        choice = (
            process_tool_review_input(review_input, tool_text)
            if input_processor is None
            else input_processor(review_input)
        )
        if choice is None:
            continue
        normalized_choice = choice.lower()
        if normalized_choice in ('y', 'yes'):
            return 'accept', None
        if normalized_choice in ('n', 'no'):
            return 'reject', None
        if choice in additional_actions:
            return choice, None
        if allow_revision and normalized_choice == 'e':
            return 'edit', None
        if (
            allow_revision
            and choice.startswith('E')
            and len(choice) > 1
            and choice[1].isspace()
        ):
            revision_task = choice[1:].strip()
            if not revision_task:
                print('Revision task cannot be empty.')
                continue
            return 'edit', revision_task
        print(invalid_choice_message)


def review_shell_commands(
    commands: list[ShellStep],
    accept_noninteractive: bool = False,
    accept_automatically: bool = False,
) -> tuple[str, str | None]:
    return review_tool_text(
        format_shell_commands(commands),
        'Run these shell commands? [y/n/p/h/e/E <prompt>]: ',
        accept_automatically=accept_automatically,
        accept_noninteractive=accept_noninteractive,
    )

def _shell_text(value: Any) -> str:
    if isinstance(value, bytes):
        return value.decode("utf-8", errors="replace")
    return str(value or "")


def _terminate_shell_process(
    process: Any,
    unit_name: str | None = None,
) -> None:
    if unit_name is not None:
        try:
            subprocess.run(
                [
                    "/usr/bin/systemctl",
                    "--user",
                    "kill",
                    "--signal=SIGKILL",
                    "--kill-whom=all",
                    unit_name,
                ],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=5,
                check=False,
            )
        except Exception:
            pass
    if os.name == "posix":
        try:
            os.killpg(process.pid, signal.SIGKILL)
            return
        except ProcessLookupError:
            return
        except OSError:
            pass
    if process.poll() is None:
        process.kill()


def _contained_shell_command(
    command: list[str],
    paths: tuple[Path, ...],
    shell_networking: bool,
    unit_name: str,
    timeout: int | None = None,
) -> list[str]:
    if sys.platform != "linux":
        raise OSError("shell containment requires Linux")
    arguments = [
        "/usr/bin/systemd-run",
        "--user",
        "--quiet",
        "--wait",
        "--collect",
        f"--unit={unit_name}",
        "--pipe",
        f"--working-directory={Path.cwd()}",
        "--property=Type=exec",
        "--property=ProtectSystem=strict",
        "--property=ProtectHome=read-only",
        "--property=PrivateTmp=yes",
        "--property=PrivateDevices=yes",
        "--property=NoNewPrivileges=yes",
        "--property=ProtectClock=yes",
        "--property=ProtectControlGroups=yes",
        "--property=ProtectHostname=yes",
        "--property=ProtectKernelLogs=yes",
        "--property=ProtectKernelModules=yes",
        "--property=ProtectKernelTunables=yes",
        "--property=LockPersonality=yes",
        "--property=RestrictRealtime=yes",
        "--property=RestrictSUIDSGID=yes",
        "--property=RestrictNamespaces=yes",
        f"--property=RuntimeMaxSec={timeout if timeout is not None else 'infinity'}",
    ]
    arguments.extend(
        f"--setenv={name}={value}"
        for name, value in SHELL_PAGER_ENVIRONMENT.items()
    )
    if paths:
        read_write_paths = " ".join(
            json.dumps(str(path), ensure_ascii=False) for path in paths
        )
        arguments.append(f"--property=ReadWritePaths={read_write_paths}")
    if not shell_networking:
        arguments.extend(
            [
                "--property=PrivateNetwork=yes",
                "--property=RestrictAddressFamilies=AF_UNIX",
            ]
        )
    return [*arguments, "--", *command]


def _shell_address_family_restriction() -> Callable[[], None]:
    if sys.platform != "linux":
        raise OSError("shell networking restrictions require Linux")
    import pyseccomp as seccomp

    seccomp_filter = seccomp.SyscallFilter(defaction=seccomp.ALLOW)
    denied_action = seccomp.ERRNO(errno.EAFNOSUPPORT)
    for syscall in ("socket", "socketpair"):
        seccomp_filter.add_rule(
            denied_action,
            syscall,
            seccomp.Arg(0, seccomp.NE, socket.AF_UNIX),
        )
    return seccomp_filter.load


def execute_shell_commands(
    commands: list[ShellStep],
    timeout: int | None = None,
    contain: tuple[Path, ...] | None = None,
    shell_networking: bool = False,
    print_exit_status: bool = False,
    shell_trace: bool = False,
    turn_dir: Path | None = None,
    tool_call_index: int = 0,
 ) -> str:
    output_blocks: list[str] = []
    command_timeout = int(timeout) if timeout else None
    for index, step in enumerate(commands, start=1):
        script_input = None
        if step.lines:
            script_input = "\n".join(step.lines) + "\n"
        command_start_time = time.perf_counter()
        try:
            command = ["/bin/sh", "-c", step.command]
            paths = contain
            if shell_trace:
                if sys.platform != "linux":
                    raise OSError("shell tracing requires Linux")
                if turn_dir is None:
                    raise ValueError(
                        "shell tracing requires a state turn directory"
                    )
                trace_path = turn_dir.resolve() / (
                    f"response_shell_trace_{tool_call_index}_{index}"
                )
                trace_fd = os.open(
                    trace_path,
                    os.O_WRONLY | os.O_CREAT | os.O_EXCL,
                    0o600,
                )
                os.close(trace_fd)
                command = [
                    "strace",
                    "-f",
                    "-ttt",
                    "-T",
                    "-s",
                    "0",
                    "-v",
                    "-yy",
                    "-e",
                    "trace=all",
                    "-o",
                    str(trace_path),
                    "--",
                    *command,
                ]
                if paths is not None:
                    paths = (*paths, trace_path)
            unit_name: str | None = None
            preexec_fn: Callable[[], None] | None = None
            if paths is not None:
                unit_name = f"mince-shell-{os.getpid()}-{time.time_ns()}.service"
                command = _contained_shell_command(
                    command,
                    paths,
                    shell_networking,
                    unit_name,
                    command_timeout,
                )
            elif not shell_networking:
                preexec_fn = _shell_address_family_restriction()
            use_shell = contain is None and not shell_trace
            process = subprocess.Popen(
                step.command if use_shell else command,
                shell=use_shell,
                stdin=subprocess.PIPE if script_input is not None else subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                encoding="utf-8",
                errors="replace",
                env={**os.environ, **SHELL_PAGER_ENVIRONMENT},
                start_new_session=os.name == "posix",
                preexec_fn=preexec_fn,
            )
            try:
                stdout, stderr = process.communicate(
                    script_input,
                    timeout=command_timeout,
                )
                status = str(process.returncode)
            except subprocess.TimeoutExpired:
                _terminate_shell_process(process, unit_name)
                stdout, stderr = process.communicate()
                status = "timeout"
                stderr = (
                    _shell_text(stderr) + "\n"
                    if stderr
                    else ""
                ) + (
                    f"command exceeded timeout of {command_timeout} seconds"
                )
            except BaseException:
                _terminate_shell_process(process, unit_name)
                try:
                    process.communicate()
                except Exception:
                    pass
                raise
            stdout = _shell_text(stdout)
            stderr = _shell_text(stderr)
        except Exception as exc:
            status = "error"
            stdout = ""
            stderr = f"{type(exc).__name__}: {exc}"

        if VERBOSE and print_exit_status:
            elapsed = time.perf_counter() - command_start_time
            status_text = (
                "timed out" if status == "timeout"
                else "execution error" if status == "error"
                else f"{status}"
            )
            print(
                f"Exit status {index}/{len(commands)}: {status_text} "
                f"({elapsed:.1f}s)",
                file=sys.stderr,
                flush=True,
            )

        stdout = "\n" + stdout if stdout != "" else stdout
        stderr = "\n" + stderr if stderr != "" else stderr
        output_blocks.append(
            f"<shell_command index='{index}'>\n"
            f"<shell>\n{format_shell_commands([step])}\n</shell>\n"
            f"<exit_status>{status}</exit_status>\n"
            f"<stdout>{stdout}</stdout>\n"
            f"<stderr>{stderr}</stderr>\n"
            "</shell_command>"
        )
    return "\n".join(output_blocks)

def build_shell_followup_prompts(
    system_prompt: str,
    task: str,
    shell_output: list[ShellTurn | str] | str,
    json_schema: dict[str, Any] | None = None,
    shell_command_archive: list[ShellTurn] | None = None,
 ) -> tuple[str, str]:
    output_values = (
        [shell_output] if isinstance(shell_output, str) else shell_output
    )
    output_history = [
        value
        if isinstance(value, ShellTurn)
        else ShellTurn(commands=(), output=str(value))
        for value in output_values
    ]
    archive_text = format_shell_command_archive(
        shell_command_archive or []
    )
    archive_block = (
        "<shell_command_context name='archive'>\n"
        f"{archive_text}\n"
        "</shell_command_context>"
        if archive_text
        else ""
    )
    shell_turn_blocks = "\n\n".join(
        f"<shell_turn index='{index}'>\n"
        f"<shell_output>\n{turn.output}\n</shell_output>\n"
        "</shell_turn>"
        for index, turn in enumerate(output_history, start=1)
    )
    return build_request_prompts(
        system_prompt=system_prompt,
        task=task,
        context=None,
        response_format="schema" if json_schema is not None else "text",
        json_schema=json_schema,
        additional_prompt=join_prompt_sections(archive_block, shell_turn_blocks),
        additional_instructions=(
            "The accepted shell commands from each turn have now been executed. "
            "Their actual output is in `<shell_output>`. Decide whether more "
            "commands are needed or end the session. Use action=commands with "
            "a non-empty commands array when more shell work is needed; otherwise "
            "use action=session_end with an empty commands array and a non-empty "
            "reason that completes the session."
        ),
    )

TOOL_REVISION_HEADING = (
    "# Changes made below this line will be ignored; only text above this line will be used as the next task."
)


def edit_tool_revision_task(
    tool_text: str,
    previous_task: str = "",
 ) -> str:
    previous_task = previous_task.strip()
    editor_text = (
        "\n\n"
        + f"{TOOL_REVISION_HEADING}\n\n"
        + (f"{previous_task}\n\n" if previous_task else "")
        + tool_text
    )
    edited_text = edit_text(editor_text)
    task_text, separator, _ = edited_text.partition(TOOL_REVISION_HEADING)
    return (task_text if separator else edited_text).strip()


def normalize_patch_ranges(
    patches: list[dict[str, Any]],
    total_lines: int | None = None,
) -> list[dict[str, Any]]:
    for index, patch in enumerate(patches, start=1):
        if not isinstance(patch, dict):
            raise ValueError(f"patch {index}: patch must be an object")
        patch_id = patch.get("patch_id")
        if not isinstance(patch_id, str) or not patch_id:
            raise ValueError(
                f"patch {index}: patch_id must be a non-empty string"
            )
        for name in ("block_id", "summary_message"):
            value = patch.get(name)
            if not isinstance(value, str) or not value.strip():
                raise ValueError(f"{patch_id}: {name} must be a non-empty string")
        start_line = patch.get("start_line")
        end_line = patch.get("end_line")
        if isinstance(start_line, bool) or not isinstance(start_line, int):
            raise ValueError(f"{patch_id}: start_line must be an integer")
        if isinstance(end_line, bool) or not isinstance(end_line, int):
            raise ValueError(f"{patch_id}: end_line must be an integer")
        if start_line < 1:
            raise ValueError(f'{patch_id}: start_line must be >= 1')
        if end_line < 1:
            raise ValueError(f'{patch_id}: end_line must be >= 1')
        if start_line > end_line:
            raise ValueError(f'{patch_id}: start_line cannot be greater than end_line')
        if total_lines == 0 and start_line != 1:
            raise ValueError(
                f'{patch_id}: empty documents only support line 1 insertion'
            )
        content_lines = patch.get("content_line_array")
        if not isinstance(content_lines, list) or any(
            not isinstance(line, str) for line in content_lines
        ):
            raise ValueError(
                f"{patch_id}: content_line_array must be an array of strings"
            )

    merged: list[dict[str, Any]] = []
    for patch in sorted(
        patches,
        key=lambda patch: (patch["start_line"], patch["end_line"]),
    ):
        if not merged or patch["start_line"] > merged[-1]["end_line"]:
            merged.append(patch)
            continue
        previous = merged[-1]
        if patch["start_line"] != previous["end_line"]:
            raise ValueError(
                'Overlapping or nested blocks detected: '
                f"{previous['patch_id']} [{previous['start_line']}, {previous['end_line']}] "
                f"and {patch['patch_id']} [{patch['start_line']}, {patch['end_line']}]"
            )
        merged[-1] = {
            **previous,
            "end_line": patch["end_line"],
            "content_line_array": (
                previous["content_line_array"] + patch["content_line_array"]
            ),
            "summary_message": join_prompt_sections(
                previous["summary_message"], patch["summary_message"]
            ),
        }
    return merged


def apply_combined_patch_manifest(
    original_texts: dict[str, str],
    manifest: dict[str, Any],
) -> dict[str, str]:
    updated_texts: dict[str, str] = {}

    for path, file_entry in patch_manifest_documents(manifest):
        path_text = str(path)
        if path_text not in original_texts and path.exists():
            raise ValueError(f"patch document original was not loaded: {path}")
        original = original_texts.get(path_text, "")
        updated = apply_file_patch_manifest(original, file_entry)
        updated_texts[path_text] = updated

    for path, text in original_texts.items():
        if path not in updated_texts:
            updated_texts[path] = text

    return updated_texts

def patch_document_line_ending(document: Any) -> str:
    if not isinstance(document, dict):
        raise ValueError("patch document metadata must be an object")
    if document.get("encoding") != "utf-8":
        raise ValueError("patch document encoding must be utf-8")
    line_ending = document.get("line_ending")
    if line_ending not in ("lf", "crlf"):
        raise ValueError("patch document line_ending must be lf or crlf")
    return line_ending


def apply_file_patch_manifest(original_text: str, file_manifest: dict[str, Any]) -> str:
    patches = file_manifest.get("patches")
    if patches is None:
        return original_text
    if not isinstance(patches, list):
        raise ValueError("patch document patches must be an array")
    if not patches:
        return original_text

    line_ending = patch_document_line_ending(file_manifest.get("document"))
    eol = "\r\n" if line_ending == "crlf" else "\n"

    lines = original_text.splitlines(keepends=False)
    total_lines = len(lines)
    if original_text:
        detected_line_ending = detect_line_ending(original_text)
        if detected_line_ending == "mixed":
            raise ValueError(
                "patch document uses mixed line endings, which are unsupported"
            )
        if detected_line_ending != line_ending:
            raise ValueError(
                "patch document line ending does not match source: "
                f"expected {detected_line_ending}, got {line_ending}"
            )

    patches = normalize_patch_ranges(patches, total_lines)
    file_manifest["patches"] = patches

    for patch in reversed(patches):
        start_line = patch["start_line"]
        end_line = patch["end_line"]
        lines[start_line - 1 : end_line] = patch["content_line_array"]
    result = eol.join(lines)
    if lines and original_text.endswith(eol):
        result += eol
    return result

def normalize_patch_manifest(
    manifest: Any,
    *,
    require_files: bool = False,
    require_commit_message: bool = False,
    strict: bool = False,
) -> dict[str, Any]:
    if not isinstance(manifest, dict):
        raise ValueError("patch manifest must contain a JSON object")
    require_files = require_files or strict
    require_commit_message = require_commit_message or strict
    files = manifest.get("files", [])
    if not isinstance(files, list) or require_files and not files:
        requirement = "a non-empty files array" if require_files else "a files array"
        raise ValueError(f"patch manifest must contain {requirement}")
    if require_commit_message:
        commit_message = manifest.get("commit_message")
        if not isinstance(commit_message, str) or not commit_message.strip():
            raise ValueError("patch manifest commit_message cannot be empty")
    for index, file_entry in enumerate(files, start=1):
        label = f"patch files entry {index}"
        if not isinstance(file_entry, dict):
            raise ValueError(f"{label} must be an object")
        if strict and set(file_entry) != {"document", "patches"}:
            raise ValueError(f"{label} requires document and patches")
        document = file_entry.get("document")
        if not isinstance(document, dict) or (
            strict
            and set(document) != {"path", "encoding", "line_ending"}
        ):
            raise ValueError(f"{label} requires document metadata")
        path = document.get("path")
        if not isinstance(path, str) or not path.strip() or "\x00" in path:
            raise ValueError(f"{label} document requires a path")
        patches = file_entry.get("patches")
        if patches is None and not strict:
            continue
        if not isinstance(patches, list) or strict and not patches:
            requirement = (
                "a non-empty patches array" if strict else "a patches array"
            )
            raise ValueError(f"{label} requires {requirement}")
        if not patches:
            continue
        patch_document_line_ending(document)
        file_entry["patches"] = normalize_patch_ranges(patches)
    return manifest


def patch_manifest_documents(
    manifest: dict[str, Any],
) -> list[tuple[Path, dict[str, Any]]]:
    documents: list[tuple[Path, dict[str, Any]]] = []
    seen_paths: set[Path] = set()
    for file_entry in manifest.get("files", []):
        path = Path(str(file_entry["document"]["path"])).expanduser().resolve()
        if path in seen_paths:
            raise ValueError(f"patch contains duplicate document path: {path}")
        seen_paths.add(path)
        documents.append((path, file_entry))
    return documents


def resolve_patch_suffix(
    config: dict[str, Any],
    patch_suffix_argument: str | None,
 ) -> tuple[str, bool]:
    configured_suffix = str(
        config.get('patch_suffix', DEFAULT_CONFIG['patch_suffix']) or ''
    ).strip()
    if patch_suffix_argument is not None:
        return patch_suffix_argument, True
    if configured_suffix and configured_suffix.lower() != 'off':
        return configured_suffix, configured_suffix != DEFAULT_CONFIG['patch_suffix']
    return DEFAULT_CONFIG['patch_suffix'], False


def build_patch_changes(
    original_texts: dict[str, str],
    manifest: dict[str, Any] | list[dict[str, Any]],
 ) -> tuple[dict[str, str], str, list[tuple[str, str]]]:
    manifests = manifest if isinstance(manifest, list) else [manifest]
    for manifest in manifests:
        normalize_patch_manifest(manifest)
        original_texts = load_patch_original_texts(manifest, original_texts)
    updated_texts = original_texts
    for manifest in manifests:
        updated_texts = apply_combined_patch_manifest(
            updated_texts,
            manifest,
        )
    diffs: list[str] = []
    changed_items: list[tuple[str, str]] = []
    for path, updated_text in updated_texts.items():
        original_text = original_texts.get(path, "")
        if path in original_texts and updated_text == original_text:
            continue
        changed_items.append((path, updated_text))
        diff = generate_unified_diff(
            original_text,
            updated_text,
            path,
            original_exists=path in original_texts,
        )
        if diff:
            diffs.append(diff)
    return updated_texts, "\n".join(diffs), changed_items


def load_patch_manifest(path: Path) -> dict[str, Any]:
    if not path.is_file():
        raise ValueError(f"patch JSON file does not exist: {path}")
    return normalize_patch_manifest(
        read_json_document(path, "patch JSON file"),
        require_files=True,
        require_commit_message=True,
    )


def resolve_patch_file_argument(
    value: str,
    turn: int | None = None,
    option_name: str = "--patch-file-apply",
 ) -> list[Path]:
    raw_value = value.strip()
    if not raw_value:
        raise ValueError("patch session or file path cannot be empty")
    try:
        session_name = validate_session_name(raw_value)
    except ValueError as exc:
        if turn is not None:
            raise ValueError(
                f"{option_name} TURN requires a session name"
            ) from exc
        return [Path(raw_value).expanduser()]
    state_session_dir = STATE_DIR / session_name
    if turn is not None or state_session_dir.is_dir():
        if option_name == "--patch-file-apply" and state_session_dir.is_dir():
            for applied_turn, entry in state_turn_directories(state_session_dir):
                if any(
                    path.is_file()
                    for path in state_turn_artifact_paths(
                        entry, "response_schema_patch_applied"
                    )
                ):
                    raise ValueError(
                        "response_schema_patch_applied already exists in "
                        f"patch session {state_session_dir}/{applied_turn}"
                    )
        turn_dir = last_completed_state_turn(
            state_session_dir,
            turn,
            required_file="response_schema_patch",
        )
        if option_name == "--patch-file-apply" and any(
            path.is_file()
            for path in state_turn_artifact_paths(
                turn_dir, "response_schema_patch_applied"
            )
        ):
            raise ValueError(
                "response_schema_patch_applied already exists in "
                f"patch session {turn_dir}"
            )
        return [
            path
            for path in state_turn_artifact_paths(turn_dir, "response_schema_patch")
            if path.is_file() and not path.is_symlink()
        ]
    return [Path(raw_value).expanduser()]


def load_patch_original_texts(
    manifest: dict[str, Any],
    original_texts: dict[str, str] | None = None,
 ) -> dict[str, str]:
    original_texts = {} if original_texts is None else original_texts.copy()
    for path, _ in patch_manifest_documents(manifest):
        path_text = str(path)
        if path_text in original_texts or not path.exists():
            continue
        if not path.is_file():
            raise ValueError(f"patch document path is not a file: {path}")
        try:
            original_texts[path_text] = read_text_preserving_line_endings(path)
        except Exception as exc:
            raise ValueError(f"cannot read patch document {path} ({exc})") from exc
    return original_texts


def write_patch_files(
    changed_items: list[tuple[str, str]],
    target_paths: list[Path],
    created_paths: list[str] | None = None,
) -> list[str]:
    if len(changed_items) != len(target_paths):
        raise ValueError(
            "patch changed items and target paths must have equal lengths"
        )
    written_paths: list[str] = []
    for (_, updated_text), target_path in zip(changed_items, target_paths):
        original_exists = target_path.exists()
        target_path.parent.mkdir(parents=True, exist_ok=True)
        write_text_preserving_line_endings(target_path, updated_text)
        written_paths.append(str(target_path))
        if created_paths is not None and not original_exists:
            created_paths.append(str(target_path))
        if VERBOSE:
            print(f"patch_file_written={target_path}")
    return written_paths


def write_patch_changes(
    changed_items: list[tuple[str, str]],
    all_paths: list[Path],
    patch_review: bool,
    patch_suffix: str,
    suffix_provided: bool,
    patch_branch_setting: str | None,
    patch_commit_message: str,
    created_paths: list[str] | None = None,
) -> list[str]:
    target_paths = [Path(path_text) for path_text, _ in changed_items]
    if patch_branch_setting is not None:
        branch_name = resolve_patch_branch_name(patch_branch_setting)
        repo_root = git_repository_root()
        if git_current_branch(repo_root) is None:
            raise ValueError("patch branch mode requires a checked-out branch")
        prepare_patch_branch(
            repo_root, branch_name, (*all_paths, *target_paths)
        )
        written_paths = write_patch_files(
            changed_items, target_paths, created_paths
        )
        git_commit_patch(
            repo_root,
            target_paths,
            patch_commit_message,
        )
        if VERBOSE:
            print(f"patch_branch={branch_name}")
        return written_paths

    if not patch_review or suffix_provided:
        target_paths = [
            append_suffix_to_path(path, patch_suffix)
            for path in target_paths
        ]
    return write_patch_files(changed_items, target_paths, created_paths)


def handle_patch_file_apply(
    patch_file_argument: str,
    config: dict[str, Any],
    patch_review_argument: bool | None,
    patch_suffix_argument: str | None,
    patch_branch_argument: str | None,
    patch_turn: int | None = None,
 ) -> int:
    try:
        patch_paths = resolve_patch_file_argument(
            patch_file_argument,
            turn=patch_turn,
        )
        manifests = [load_patch_manifest(path) for path in patch_paths]
    except Exception as exc:
        print(f"ERROR: Failed to load patch file: {exc}", file=sys.stderr)
        return 1

    patch_review = not NONINTERACTIVE and resolve_bool_option(
        patch_review_argument,
        config,
        "patch_review",
    )
    patch_suffix, suffix_provided = resolve_patch_suffix(
        config, patch_suffix_argument
    )

    try:
        patch_branch_setting = resolve_optional_string_setting(
            resolve_config_option(
                patch_branch_argument, config, "patch_branch",
                DEFAULT_CONFIG["patch_branch"],
            ),
            "patch_branch",
        )
    except ValueError as exc:
        print(f"ERROR: Invalid patch branch value: {exc}", file=sys.stderr)
        return 1
    if patch_branch_setting is not None:
        patch_suffix = ""
        suffix_provided = False

    patch_commit_message = "\n\n".join(
        str(manifest["commit_message"]).strip() for manifest in manifests
    )
    try:
        updated_texts, diff_text, changed_items = build_patch_changes(
            {},
            manifests,
        )
    except Exception as exc:
        print(f"ERROR: Failed to apply patch manifest: {exc}", file=sys.stderr)
        return 1

    if not changed_items:
        if VERBOSE:
            print("No changes.", file=sys.stderr)
        return 0

    if VERBOSE or patch_review:
        print()
        print(diff_text)

    if patch_review:
        review_action, _, suffix_provided = review_patch_changes(
            diff_text,
            suffix_provided,
            prompt="Apply these changes? [y/n/p/h/S]: ",
            allow_revision=False,
            display_text=False,
        )
        if review_action != "accept":
            if VERBOSE:
                print("Aborted.", file=sys.stderr)
            return 0

    try:
        written_patch_paths = write_patch_changes(
            changed_items=changed_items,
            all_paths=[Path(path) for path in updated_texts],
            patch_review=patch_review,
            patch_suffix=patch_suffix,
            suffix_provided=suffix_provided,
            patch_branch_setting=patch_branch_setting,
            patch_commit_message=patch_commit_message,
        )
        written_by_source = {
            path: written_path
            for (path, _), written_path in zip(changed_items, written_patch_paths)
        }
        for patch_path, manifest in zip(patch_paths, manifests):
            if re.fullmatch(
                r"response_schema_patch(?:_[0-9]+)?", patch_path.name
            ) is None:
                continue
            write_state_artifact(
                patch_path.parent,
                patch_path.name.replace(
                    "response_schema_patch", "response_schema_patch_applied", 1
                ),
                "\n".join(
                    written_by_source[str(path)]
                    for path, _ in patch_manifest_documents(manifest)
                    if str(path) in written_by_source
                ),
            )
    except Exception as exc:
        action = (
            "write and commit patch branch"
            if patch_branch_setting is not None
            else "write patch files"
        )
        print(f"ERROR: Failed to {action}: {exc}", file=sys.stderr)
        return 1
    return 0

def handle_patch_file_print(
    patch_file_argument: str,
    patch_turn: int | None = None,
 ) -> int:
    try:
        patch_paths = resolve_patch_file_argument(
            patch_file_argument,
            turn=patch_turn,
            option_name="--patch-file-print",
        )
        manifests = [load_patch_manifest(path) for path in patch_paths]
        _, diff_text, _ = build_patch_changes(
            {},
            manifests,
        )
    except Exception as exc:
        print(
            f"ERROR: Failed to print patch file: {exc}",
            file=sys.stderr,
        )
        return 1
    sys.stdout.write(diff_text)
    return 0

