        help="Print the stored configuration file (creates it if missing)",
    )
    config_print_group.add_argument(
        "--set-config",
        metavar="NAME=VALUE",
        action="append",
        help="Set a configuration value (use DEFAULT to reset it; may be repeated)",
    )
    config_print_group.add_argument(
        "--set-config-from",
        nargs=2,
        metavar=("NAME", "PROFILE"),
        help="Set a configuration value for NAME from another profile",
    )
    config_print_group.add_argument(
        "--get-config",
        nargs="?",
        const="",
        default=None,
        metavar="NAME",
        help="Get a configuration value, or all values if NAME is omitted",
    )
    parser.add_argument(
        "--log",
        nargs="?",
        const=True,
        default=None,
        type=parse_bool,
        metavar="BOOL",
        help="Log session to HOME/.local/state/mince/logs",
    )
    parser.add_argument(
        "--no-api-log",
        nargs="?",
        const=False,
        default=None,
        type=parse_bool,
        metavar="BOOL",
        help="Do not store requests and responses in the OpenAI API",
    )
    parser.add_argument(
        "--quiet",
        nargs="?",
        const=True,
        default=None,
        type=parse_bool,
        metavar="BOOL",
        help="Suppress printing of extra output (stats, information)",
    )
    parser.add_argument(
        "--debug",
        action="store_true",
        help="Output the request and response objects within tags",
    )
    profile_action_group = parser.add_mutually_exclusive_group()
    profile_action_group.add_argument(
        "--init",
        action="store_true",
        help="Initialize and interactively change the configuration file",
    )
    profile_action_group.add_argument(
        "--init-profile",
        metavar="NAME",
        help="Interactively initialise a new configuration profile",
    )
    profile_action_group.add_argument(
        "--copy-profile",
        metavar="NEW_NAME",
        help="Copy the current configuration profile to a new profile",
    )
    profile_action_group.add_argument(
        "--remove-profile",
        metavar="NAME",
        help="Remove a configuration profile",
    )
    profile_action_group.add_argument(
        "--list-profiles",
        action="store_true",
        help="List available configuration profiles",
    )
    profile_action_group.add_argument(
        "--print-profiles",
        nargs="*",
        metavar="NAME",
        help="Display all configuration profiles or only the named profiles",
    )
    profile_action_group.add_argument(
        "--show-profiles",
        nargs="*",
        metavar="NAME",
        dest="print_profiles",
        help=argparse.SUPPRESS,
        default=argparse.SUPPRESS,
    )
    profile_action_group.add_argument(
        "--prompt-list",
        action="store_true",
        help="List stored prompts and their profile assignments",
    )
    profile_action_group.add_argument(
        "--prompt-edit",
        nargs="+",
        metavar=("NAME", "TEXT"),
        help="Edit or create the prompt NAME or form it from additional TEXT arguments",
    )
    profile_action_group.add_argument(
        "--prompt-assign",
        nargs=3,
        metavar=("NAME", "PROFILE", "TYPE"),
        help="Add prompt NAME to PROFILE prompt TYPE (types: system, linenum, patch, plan)",
    )
    profile_action_group.add_argument(
        "--prompt-assign-text",
        nargs=3,
        metavar=("NAME", "PROFILE", "TYPE"),
        help="Replace PROFILE prompt TYPE with text content of prompt NAME",
    )
    profile_action_group.add_argument(
        "--prompt-assign-replace",
        nargs=3,
        metavar=("NAME", "PROFILE", "TYPE"),
        help="Replace PROFILE prompt TYPE with prompt NAME",
    )
    profile_action_group.add_argument(
        "--prompt-unassign",
        nargs="+",
        metavar=("NAME PROFILE", "TYPE"),
        help="Remove prompt NAME from PROFILE with optional prompt TYPE",
    )
    profile_action_group.add_argument(
        "--prompt-remove",
        metavar="NAME",
        help="Remove prompt NAME from all profiles and delete it",
    )
    profile_action_group.add_argument(
