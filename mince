def number_lines(text: str) -> str:
    lines = text.splitlines(keepends=True)
    if not lines:
        return ""

    return "".join(
        f"{i} {line}" for i, line in enumerate(lines, start=1)
    )


def token_encoding_for_model(model: str) -> Any:
    try:
        return tiktoken.encoding_for_model(model)
    except Exception:
        return tiktoken.get_encoding("o200k_base")


def format_context_entry(
    name: str,
    content: str,
    model: str = "",
    attributes: str = "",
) -> str:
    token_count = len(token_encoding_for_model(model).encode(content))
    return (
        f"<{name}{attributes} token_count='{token_count}'>\n"
        f"{content}</{name}>"
    )


def format_request_text(
    system_prompt: str,
    user_prompt: str,
    tools: list[dict[str, Any]] | None = None,
) -> str:
    request_text = f"SYSTEM:\n{system_prompt}\n\nUSER:\n{user_prompt}"
    if tools:
        request_text += (
            "\n\nTOOLS:\n"
            + json.dumps(tools, ensure_ascii=False, separators=(",", ":"))
        )
    return request_text


def estimate_request_tokens(
    model: str,
    system_prompt: str,
    user_prompt: str,
    tools: list[dict[str, Any]] | None = None,
) -> int:
    encoding = token_encoding_for_model(model)
    return len(
        encoding.encode(format_request_text(system_prompt, user_prompt, tools))
    )

def truncate_text_to_tokens(text: str, model: str, max_tokens: int) -> str:
    if max_tokens <= 0 or not text:
        return ""
    encoding = token_encoding_for_model(model)
    tokens = encoding.encode(text)
    if len(tokens) <= max_tokens:
        return text

    marker = "\n[... shell output truncated ...]"
    lower = 0
    upper = min(len(tokens), max_tokens)
    best: str | None = None
    while lower <= upper:
        midpoint = (lower + upper) // 2
        candidate = encoding.decode(tokens[:midpoint]) + marker
        if len(encoding.encode(candidate)) <= max_tokens:
            best = candidate
            lower = midpoint + 1
        else:
            upper = midpoint - 1
    if best is not None:
        return best
    return encoding.decode(tokens[:max_tokens])

def limit_shell_output_for_context(
    shell_output: str,
    model: str,
    token_limit: int,
 ) -> str:
    max_output_tokens = max(
        0, int(token_limit * SHELL_OUTPUT_TOKEN_FRACTION)
    )
    return truncate_text_to_tokens(
        shell_output,
        model,
        max_output_tokens,
    )

def parse_token_cost(value: Any) -> tuple[float, float] | None:
    raw = str(value).strip()
    if raw.lower() == "off":
        return None
    parts = raw.split(":")
    if len(parts) != 2:
        raise ValueError("expected input_float:output_float or 'off' (ex: 0.27:2.27)")
    try:
        input_cost = float(parts[0].strip())
        output_cost = float(parts[1].strip())
    except ValueError as exc:
        raise ValueError("expected input_float:output_float or 'off' (ex: 0.27:2.27)") from exc
    if not all(math.isfinite(cost) and cost >= 0 for cost in (input_cost, output_cost)):
        raise ValueError("token costs must be finite non-negative floats")
    return input_cost, output_cost


def request_cost_estimate_log(
    token_cost: tuple[float, float] | None,
    request_tokens: int,
) -> str:
    if token_cost is None:
        return ""
    return (
        " request_cost_estimate="
        f"{request_tokens * token_cost[0] / 1_000_000:.4f}"
    )


def response_cost_amounts(
    token_cost: tuple[float, float] | None,
    usage: dict[str, Any] | None,
 ) -> tuple[float, float, float] | None:
    if token_cost is None or not usage:
        return None
    try:
        input_tokens = int(usage["input_tokens"])
        output_tokens = int(usage["output_tokens"])
    except (KeyError, TypeError, ValueError):
        return None

    input_cost = input_tokens * token_cost[0] / 1_000_000
    output_cost = output_tokens * token_cost[1] / 1_000_000
    total_cost = input_cost + output_cost
    return input_cost, output_cost, total_cost

def response_cost_line(
    token_cost: tuple[float, float] | None,
    usage: dict[str, Any] | None,
 ) -> str | None:
    costs = response_cost_amounts(token_cost, usage)
    if costs is None:
        return None
    input_cost, output_cost, total_cost = costs
    return f"response_cost={input_cost:.4f}:{output_cost:.4f}:{total_cost:.4f}"

def usage_to_dict(usage: Any) -> dict[str, Any] | None:
    if usage is None:
        return None
    if isinstance(usage, dict):
        return usage
    if hasattr(usage, "model_dump"):
        return usage.model_dump()
    if hasattr(usage, "dict"):
        return usage.dict()
    return {"raw": str(usage)}


@dataclass
class ModelRequestTimer:
    start_time: float | None = None
    initial_start_time: float | None = None

    def reset(self) -> None:
        self.start_time = time.perf_counter()
        if self.initial_start_time is None:
            self.initial_start_time = self.start_time

    def elapsed(self, total: bool = False) -> float:
        start_time = self.initial_start_time if total else self.start_time
        if start_time is None:
            return 0.0
        return time.perf_counter() - start_time


RESPONSE_TOKEN_KEYS = ("input_tokens", "output_tokens", "total_tokens")


def print_stats(
    *,
    request_characters: int,
    request_tokens: int,
    processing_time: float = 0.0,
    response_text: str,
    usage: dict[str, Any] | None = None,
    response_cost: str | None = None,
    turn: int | None = None,
 ) -> str:
    stats: list[str] = [f"turn={turn}"] if turn is not None else []
    stats.extend([
        f"processing_time={int(processing_time)}s",
        f"request_characters={request_characters}",
        f"request_tokens_estimate={request_tokens}",
        f"response_characters={len(response_text)}",
    ])
    if usage:
        for key in RESPONSE_TOKEN_KEYS:
            if key in usage:
                stats.append(f"response_{key}={usage[key]}")
    if response_cost is not None:
        stats.append(response_cost)
    return " ".join(stats)


@dataclass
class CumulativeStats:
    processing_time: float = 0.0
    usage: dict[str, int] = field(default_factory=dict)
    enabled: bool = False
    token_cost: tuple[float, float] | None = None
    log_path: Path | None = None
    log_enabled: bool = False

    def add(
        self,
        processing_time: float,
        usage: dict[str, Any] | None,
    ) -> None:
        self.processing_time += processing_time
        usage = usage or {}
        for key in RESPONSE_TOKEN_KEYS:
            self.usage[key] = (
                self.usage.get(key, 0) + coerce_int(usage.get(key), 0)
            )

    def emit(self) -> None:
        if not self.enabled:
            return
        usage = {key: self.usage.get(key, 0) for key in RESPONSE_TOKEN_KEYS}
        stats = [f"total_processing_time={int(self.processing_time)}s"]
        stats.extend(
            f"total_response_{key}={usage[key]}"
            for key in RESPONSE_TOKEN_KEYS
        )
        response_cost = response_cost_line(self.token_cost, usage)
        if response_cost is not None:
            stats.append(f"total_{response_cost}")
        statsline = " ".join(stats)
        append_session_log(
            self.log_path,
            f"<cumulative_stats>\n{statsline}\n</cumulative_stats>\n",
            self.log_enabled,
        )
        if VERBOSE:
            print(statsline, file=sys.stderr)

def coerce_bool(value: Any, default: bool = False) -> bool:
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        try:
            return parse_bool(value)
        except argparse.ArgumentTypeError:
            pass
    return default

def resolve_config_option(
    override: Any,
    config: dict[str, Any],
    key: str,
    default: Any = None,
 ) -> Any:
    if override is not None:
        return override
    return config.get(key, default)


def resolve_bool_option(
    override: bool | None,
    config: dict[str, Any],
    key: str,
    default: bool = False,
 ) -> bool:
    return coerce_bool(
        resolve_config_option(override, config, key, default),
        default,
    )

def parse_bool(value: str) -> bool:
    normalized = value.strip().lower()
    if normalized in ("on", "true", "yes", "1"):
        return True
    if normalized in ("off", "false", "no", "0"):
        return False
    raise argparse.ArgumentTypeError("expected a boolean value (true/false)")


def parse_optional_float(value: Any) -> float | None:
    if isinstance(value, str):
        return None if value.lower() == "off" else float(value)
    return value


def coerce_int(value: Any, default: int) -> int:
    try:
        return int(value)
    except (TypeError, ValueError):
        return default


def parse_retry_count(value: Any) -> int:
    if isinstance(value, bool):
        raise ValueError("retry count must be a non-negative integer")
    if isinstance(value, int):
        retry_count = value
    elif isinstance(value, str) and re.fullmatch(r"\d+", value.strip()):
        retry_count = int(value.strip())
    else:
        raise ValueError("retry count must be a non-negative integer")
    if retry_count < 0:
        raise ValueError("retry count must be a non-negative integer")
    return retry_count

def read_file(path: Path) -> str:
    try:
        return read_text_preserving_line_endings(path)
    except UnicodeDecodeError:
        return path.read_bytes().decode("utf-8", errors="replace")
    except Exception as exc:
        return f"ERROR: cannot read file {path} ({exc})"

def edit_text(text: str, suffix: str = ".txt") -> str:
    editor = os.environ.get("EDITOR", "").strip() or "vi"
    editor_command = shlex.split(editor)
    if not editor_command:
        editor_command = ["vi"]

    temporary_path: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            suffix=suffix,
            delete=False,
        ) as temporary_file:
            temporary_path = Path(temporary_file.name)
            temporary_file.write(text)

        subprocess.run(
            [*editor_command, str(temporary_path)],
            check=True,
        )
        return temporary_path.read_text(encoding="utf-8")
    finally:
        if temporary_path is not None:
            try:
                temporary_path.unlink()
            except FileNotFoundError:
                pass


def read_prompt_argument(value: str | list[str]) -> str:
    if isinstance(value, list):
        if len(value) == 1:
            value = value[0]
        else:
            value = " ".join(value)
    if value == "e":
        edited_text = edit_text("").strip()
        if not edited_text:
            raise ValueError("Aborted")
        return edited_text
    if value == "-":
        return sys.stdin.read().strip()
    return value.strip()



def read_prompt_files(
    paths: Path | list[Path],
) -> str:
    prompt_paths = paths if isinstance(paths, list) else [paths]
    prompt_parts = [
        read_file(prompt_path).strip()
        for prompt_path in prompt_paths
    ]
    return "\n\n".join(
        part for part in prompt_parts if part
    ).strip()


PROMPT_EXPANSION_PATTERN = re.compile(r"\^\^([^^\r\n\s]+?)\^\^")


def expand_prompt_names(value: str, enabled: bool = False) -> str:
    if not enabled:
        return value

    def expand(text: str, active_names: frozenset[str]) -> str:
        def replace(match: re.Match[str]) -> str:
            display_name = match.group(1).strip()
            try:
                prompt_path = prompt_file_path(display_name)
                name = prompt_path.stem
                if name in active_names:
                    raise ValueError("recursive prompt expansion")
                if not prompt_path.is_file():
                    raise FileNotFoundError(
                        f"prompt library entry does not exist: {prompt_path}"
                    )
                prompt_text = prompt_path.read_text(encoding="utf-8").strip()
                return expand(prompt_text, active_names | {name})
            except Exception as exc:
                print(
                    f"WARNING: Could not expand prompt name "
                    f"'{display_name}': {exc}",
                    file=sys.stderr,
                )
                return match.group(0)

        return PROMPT_EXPANSION_PATTERN.sub(replace, text)

    return expand(value, frozenset())

def resolve_configured_prompt(value: Any, default: str) -> str:
    prompt = str(value if value is not None else default).strip()
    parsed = parse_prompt_file_definitions(prompt)
    if parsed is None:
        return prompt

    file_definitions, prompt_text = parsed
    try:
        prompt_parts = [
            read_file(
                configured_prompt_file_path(prompt_file)
            ).strip()
            for prompt_file in file_definitions
        ]
        if prompt_text:
            prompt_parts.append(prompt_text)
        return "\n".join(part for part in prompt_parts if part).strip()
    except Exception as exc:
        raise ValueError(f"cannot read configured system prompt file {value} ({exc})") from exc


def resolve_prompt_setting(
    explicit_value: str | None,
    prompt_file: Path | None,
    config: dict[str, Any],
    config_key: str,
    default: str,
    prompt_expansion_enabled: bool,
    strip_configured_result: bool = False,
 ) -> str:
    if explicit_value is not None:
        prompt = str(explicit_value).strip()
    elif prompt_file is not None:
        prompt = read_file(prompt_file).strip()
    else:
        prompt = resolve_configured_prompt(
            config.get(config_key, default),
            default,
        )

    expanded = expand_prompt_names(prompt, prompt_expansion_enabled)
    if strip_configured_result and explicit_value is None and prompt_file is None:
        return expanded.strip()
    return expanded

def format_config_detail_line(
    config_name: str,
    value: Any,
    config: dict[str, Any],
    inherited: bool = False,
) -> str:
    if config_name not in PROMPT_CONFIG_KEYS:
        return format_config_line(config_name, value, inherited)

    expanded_prompt = resolve_prompt_setting(
        explicit_value=None,
        prompt_file=None,
        config=config,
        config_key=config_name,
        default=get_default_config_value(config_name),
        prompt_expansion_enabled=coerce_bool(
            config.get("prompt_expansion", "off")
        ),
        strip_configured_result=True,
    )
    one_line_expanded_prompt = " ".join(expanded_prompt.splitlines())
    return (
        f"{format_config_line(config_name, value, inherited)} "
        f"[{one_line_expanded_prompt}]"
    )


def parse_config_files(value: Any) -> list[str]:
    if value is None:
        return []
    if not isinstance(value, str):
        raise ValueError("config files must be a pipe-separated string")
    raw_value = value.strip()
    if not raw_value:
        return []
    files = [path.strip() for path in raw_value.split("|")]
    if any(not path for path in files):
        raise ValueError("config files must not contain empty paths")
    return files

def read_files_list(
    paths: Path | list[Path],
) -> list[str]:
    list_paths = paths if isinstance(paths, list) else [paths]
    files: list[str] = []
    for list_path in list_paths:
        try:
            lines = list_path.read_text(encoding="utf-8").splitlines()
        except Exception as exc:
            raise ValueError(
                f"cannot read files list {list_path} ({exc})"
            ) from exc

        for raw_line in lines:
            line = raw_line.strip()
            if not line or line.startswith("#"):
                continue
            files.append(line)
    return files

def resolve_context_file_paths(file_names: list[str]) -> list[Path]:
    return [
        Path(file_name) if file_name == "-" else Path(file_name).resolve()
        for file_name in file_names
    ]


def build_context_sections(
    file_paths: list[Path],
    max_file_size_kb: int,
    add_line_numbers: bool = True,
    stdin_content: str | None = None,
    include_last_modified_time: bool = False,
    include_last_refreshed_time: bool = False,
    missing_file_expires_in_turns: int | None = None,
    model: str = "",
    token_limit: int | None = None,
    current_token_estimate: int = 0,
) -> list[tuple[str, str]]:
    sections: list[tuple[str, str]] = []
    encoding = (
        token_encoding_for_model(model)
        if token_limit is not None
        else None
    )
    max_bytes = max_file_size_kb * 1024
    last_refreshed_time = (
        int(time.time()) if include_last_refreshed_time else None
    )

    for path in file_paths:
        context_path = "/proc/self/stdin" if path == Path("-") else str(path)
        last_modified_time: int | None = None
        error = ""
        if (
            path == Path("-") and stdin_content is None
            or path != Path("-") and not path.exists()
        ):
            error = f"MISSING FILE: {context_path}"
            if missing_file_expires_in_turns is None:
                sections.append((context_path, f"[{error}]"))
                continue
            content = ""
        elif path == Path("-"):
            stdin_size = len(stdin_content.encode("utf-8"))
            if stdin_size > max_bytes:
                sections.append(
                    (
                        context_path,
                        f"[SKIPPED LARGE FILE: {context_path} ({stdin_size} bytes)]",
                    )
                )
                continue
            content = stdin_content
        else:
            file_stat = path.stat()
            if file_stat.st_size > max_bytes:
                sections.append(
                    (
                        context_path,
                        f"[SKIPPED LARGE FILE: {context_path} ({file_stat.st_size} bytes)]",
                    )
                )
                continue

            content = read_file(path)
            if include_last_modified_time:
                last_modified_time = int(file_stat.st_mtime)
        content_line_ending = detect_line_ending(content)
        content_total_lines = len(content.splitlines())
        if add_line_numbers:
            numbered_content = number_lines(content)
        else:
            numbered_content = content

        def build_section() -> str:
            context_ending = (
                ""
                if error or numbered_content.endswith(("\r", "\n"))
                else "\n"
            )
            last_refreshed_time_attribute = (
                f" last_refreshed_time='{last_refreshed_time}'"
                if last_refreshed_time is not None
                else ""
            )
            last_modified_time_attribute = (
                f" last_modified_time='{last_modified_time}'"
                if last_modified_time is not None
                else ""
            )
            error_attribute = f" error='{error}'" if error else ""
            if error and missing_file_expires_in_turns is not None:
                error_attribute += (
                    f" expires_in_turns='{missing_file_expires_in_turns}'"
                )
            return format_context_entry(
                "file",
                f"{numbered_content}{context_ending}",
                model=model,
                attributes=(
                    f"{last_refreshed_time_attribute}{last_modified_time_attribute}"
                    f"{error_attribute} path='{context_path}' encoding='utf-8' "
                    f"line_ending='{content_line_ending}' "
                    f"total_lines='{content_total_lines}'"
                ),
            )

        section = build_section()
        if encoding is not None and token_limit is not None:
            section_tokens = len(encoding.encode(section))
            if (
                not error
                and current_token_estimate + section_tokens > token_limit
            ):
                error = (
                    "TOKEN LIMIT EXCEEDED: file could not be loaded"
                )
                numbered_content = ""
                section = build_section()
                section_tokens = len(encoding.encode(section))
            current_token_estimate += section_tokens
        sections.append((context_path, section))

    return sections


def build_context(
    file_paths: list[Path],
    max_file_size_kb: int,
    add_line_numbers: bool = True,
    stdin_content: str | None = None,
    model: str = "",
) -> str:
    return "\n".join(
        section
        for _, section in build_context_sections(
            file_paths=file_paths,
            max_file_size_kb=max_file_size_kb,
            add_line_numbers=add_line_numbers,
            stdin_content=stdin_content,
            model=model,
        )
    )

def load_json_schema(path: Path) -> dict[str, Any]:
    try:
        raw = read_json_document(path, "schema file")
        if not isinstance(raw, dict):
            raise ValueError("Schema file must contain a JSON object")
        return raw
    except Exception as exc:
        print(f"ERROR: Failed to load JSON schema: {path}\n{exc}", file=sys.stderr)
        raise SystemExit(1)


def clean_json_response(raw: str) -> str:
    return re.sub(r'^(?:<\|[^|]+\|>).+(?:<\|message\|>)', '', raw).strip()


def parse_json_response(
    raw: str,
    response_json_repair: bool = False,
) -> Any:
    cleaned = clean_json_response(raw)
    if response_json_repair:
        return json_repair.loads(cleaned)
    return json.loads(cleaned)

def pretty_json(raw: Any) -> str:
    try:
        value = json.loads(raw) if isinstance(raw, str) else raw
        return json.dumps(value, indent=2, ensure_ascii=False)
    except Exception:
        return str(raw)


def parse_extra_body(s: str) -> dict[str, Any]:
    result: dict[str, Any] = {}
    if not s:
        return result
    for pair in s.split(","):
        if not pair:
            continue
        if "=" not in pair:
            continue
        key, value = pair.split("=", 1)
        key = key.strip()
        value = value.strip()
        low = value.lower()
        if low == "true":
            result[key] = True
        elif low == "false":
            result[key] = False
        else:
            try:
                result[key] = int(value)
            except ValueError:
                try:
                    result[key] = float(value)
                except ValueError:
                    result[key] = value
    return result


