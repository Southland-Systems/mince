            processing_time=plan_elapsed,
            response_text=plan_result,
            usage=plan_usage,
            response_cost=plan_response_cost,
        )
        if log_enabled:
            with open(log_path, "a", encoding="utf-8") as f:
                f.write(f"<plan_response>\n{plan_result}\n</plan_response>\n")
                f.write(f"<plan_response_stats>\n{plan_statsline}\n</plan_response_stats>\n")
        while True:
            print()
            print(plan_result)
            print()
            plan_choice = input("Use this plan? [y/n/p/e]: ").strip().lower()
            if plan_choice == "p":
                pydoc.pager(plan_result)
                continue
            if plan_choice in ("e", "edit"):
                try:
                    plan_result = edit_text(plan_result).strip()
                except Exception as exc:
                    print(f"ERROR: Failed to edit plan: {exc}", file=sys.stderr)
