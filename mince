def agent_tool_call_system_prompt(
    profiles: tuple[AgentProfile, ...] = (),
    prompt_overrides: dict[str, str] | None = None,
) -> str:
    prompt_overrides = prompt_overrides or {}
    tool_call_prompt = "\n\n".join(
        prompt_overrides.get(name, prompt)
        for name, prompt in AGENT_TOOL_CALL_SYSTEM_PROMPTS.items()
    )
    if not profiles:
        return tool_call_prompt
    profile_lines: list[str] = []
    for profile in profiles:
        profile_line = (
            f"- Use `{agent_profile_tool_name(profile.name)}` to delegate work "
            f"(response format: `{profile.profile_type}`)."
        )
        description = prompt_overrides.get(
            f"agent_profile_{profile.name}", profile.description
        ).strip()
        if description:
            profile_line += f" {description}"
        profile_lines.append(profile_line)
    return (
        tool_call_prompt.rstrip()
        + "\n\nSelected worker profile tools:\n"
        + "\n".join(profile_lines)
    )


def agent_tool_schemas(
    profiles: tuple[AgentProfile, ...] = (),
    expires_schema: dict[str, Any] | None = None,
    default_profile: AgentProfile | None = None,
    prompt_overrides: dict[str, str] | None = None,
) -> list[dict[str, Any]]:
    schemas: dict[str, dict[str, Any]] = {
        schema["name"]: schema
        for schema in AGENT_TOOL_SCHEMAS
    }
    profile_tools = [
        (agent_profile_tool_name(profile.name), profile)
        for profile in profiles
    ]
    if default_profile is not None:
        profile_tools.insert(0, (AGENT_AGENT_TOOL, default_profile))
    for tool_name, profile in profile_tools:
        agent_profile_response_schema(profile)
        if tool_name in schemas and tool_name != AGENT_AGENT_TOOL:
            raise ValueError(f"duplicate agent tool name: {tool_name}")
        description = (
            f"Agent profile '{profile.name}'. "
            f"Response format: {profile.profile_type}."
        )
        profile_description = (prompt_overrides or {}).get(
            f"agent_profile_{profile.name}", profile.description
        ).strip()
        if profile_description:
            description += f" {profile_description}"
        schemas[tool_name] = {
            "type": "function",
            "name": tool_name,
            "description": description,
            "parameters": AGENT_AGENT_CALL_ARGUMENT_SCHEMA,
            "strict": True,
        }
    return [
        {
            **schema,
            "parameters": agent_tool_argument_schema(
                schema["parameters"], expires_schema
            ),
        }
        if (
            expires_schema is not None
            and tool_name != AGENT_META_TASK_LIST_TOOL
        )
        else schema
        for tool_name, schema in schemas.items()
    ]


