def validate_prompt_name(name: str) -> str:
    name = name.strip()
    if (
        not name
        or name in (".", "..")
        or any(character in name for character in ("/", "\\", "|"))
        or any(ord(character) < 32 for character in name)
    ):
        raise ValueError("invalid prompt name")
    return name


