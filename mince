def handle_prompt_print(
    names: list[str] | str | None = None,
    json_output: bool = False,
 ) -> int:
    if isinstance(names, str):
        names = [names]
    try:
        if names:
            prompt_paths = [prompt_file_path(name) for name in names]
            for prompt_path in prompt_paths:
                if not prompt_path.is_file():
                    raise ValueError(
                        f"prompt file does not exist: {prompt_path}"
                    )
        else:
            prompt_dir = APP_DIR / "prompts"
            prompt_paths = sorted(
                (
                    path
                    for path in prompt_dir.glob("*.md")
                    if path.is_file()
                ),
                key=lambda path: path.stem,
            )
        if json_output:
            prompt_structure = {
                path.stem: path.read_text(encoding="utf-8")
                for path in prompt_paths
            }
            print(json.dumps(prompt_structure, indent=2, ensure_ascii=False))
        elif names:
            for prompt_path in prompt_paths:
                sys.stdout.write(
                    prompt_path.read_text(encoding="utf-8")
                )
        else:
            sections = [
                f"[{path.stem}]\n{path.read_text(encoding='utf-8')}"
                for path in prompt_paths
            ]
            prompt_text = "\n\n".join(sections)
            page_or_print(
                prompt_text + ("\n" if prompt_text else "")
            )
    except Exception as exc:
        print(f"ERROR: Failed to print prompt: {exc}", file=sys.stderr)
        return 1
    return 0

def handle_prompt_assign(
    values: list[str],
    assignment_mode: str = "prepend",
) -> int:
    name, profile, prompt_type = values
    try:
        prompt_path = prompt_file_path(name)
        if not prompt_path.is_file():
            raise ValueError(
                f"prompt file does not exist: {prompt_path}; use --prompt-edit first"
            )
        profile = validate_prompt_profile_name(profile)
        config_key = prompt_type_key(prompt_type)
        profile_path = get_profile_path(profile)
        config = read_config_document(profile_path, missing_ok=True)
        prompt_reference = f"./{prompt_path.name}"
        existing = config.get(config_key)
        if assignment_mode == "string":
            config[config_key] = prompt_path.read_text(
                encoding="utf-8"
            ).strip()
        elif assignment_mode == "replace":
            config[config_key] = prompt_reference
        else:
            parsed = parse_prompt_file_definitions(existing)
            if parsed is None:
                existing_string = (
                    existing.strip()
                    if isinstance(existing, str)
                    else ""
                )
                config[config_key] = (
                    f"{prompt_reference} {existing_string}".strip()
                )
            else:
                references, prompt_text = parsed
                if not any(
                    prompt_path_matches(reference, prompt_path)
                    for reference in references
                ):
                    references.insert(0, prompt_reference)
                config[config_key] = "|".join(references)
                if prompt_text:
                    config[config_key] += f" {prompt_text}"
        write_config_document(profile_path, config)
    except Exception as exc:
        print(f"ERROR: Failed to assign prompt: {exc}", file=sys.stderr)
        return 1
    print(f"prompt_assigned={prompt_path} profile={profile} type={config_key}")
    return 0


def handle_prompt_unassign(values: list[str]) -> int:
    if len(values) not in (2, 3):
        print(
            "ERROR: --prompt-unassign requires NAME PROFILE and optional TYPE",
            file=sys.stderr,
        )
        return 1
    name, profile = values[:2]
    try:
        prompt_path = prompt_file_path(name)
        profile = validate_prompt_profile_name(profile)
        profile_path = get_profile_path(profile)
        config = read_config_document(profile_path)
        keys = (
            (prompt_type_key(values[2]),)
            if len(values) == 3
            else PROMPT_CONFIG_KEYS
        )
        changed = unassign_prompt_from_config(config, prompt_path, keys)
        if changed:
            write_config_document(profile_path, config)
    except Exception as exc:
        print(f"ERROR: Failed to unassign prompt: {exc}", file=sys.stderr)
        return 1
    print(
        f"prompt_unassigned={prompt_path} profile={profile}"
        + (f" type={keys[0]}" if len(keys) == 1 else "")
    )
    return 0


def handle_prompt_remove(name: str) -> int:
    try:
        prompt_path = prompt_file_path(name)
        if prompt_path.exists() and not prompt_path.is_file():
            raise ValueError(f"prompt path is not a file: {prompt_path}")

        documents: list[tuple[Path, dict[str, Any]]] = []
        for config_path in sorted(APP_DIR.glob("*.json")):
            documents.append((config_path, read_config_document(config_path)))

        for config_path, config in documents:
            if unassign_prompt_from_config(
                config, prompt_path, PROMPT_CONFIG_KEYS
            ):
                write_config_document(config_path, config)

        if prompt_path.exists():
            prompt_path.unlink()
    except Exception as exc:
        print(f"ERROR: Failed to remove prompt: {exc}", file=sys.stderr)
        return 1
    print(f"prompt_removed={prompt_path}")
    return 0


def handle_prompt_list() -> int:
    prompt_dir = APP_DIR / "prompts"
    try:
        prompt_paths = sorted(
            (
                path
                for path in prompt_dir.glob("*.md")
                if path.is_file()
            ),
            key=lambda path: path.stem,
        )
        config_documents = [
            (
                config_path.stem,
                read_config_document(config_path),
            )
            for config_path in sorted(APP_DIR.glob("*.json"))
        ]
    except Exception as exc:
        print(f"ERROR: Failed to list prompts: {exc}", file=sys.stderr)
        return 1

    for prompt_path in prompt_paths:
        profiles: set[str] = set()
        for profile_name, config in config_documents:
            for key in PROMPT_CONFIG_KEYS:
                parsed = parse_prompt_file_definitions(config.get(key))
                if parsed is not None and any(
                    prompt_path_matches(reference, prompt_path)
                    for reference in parsed[0]
                ):
                    profiles.add(profile_name)
                    break

        output = prompt_path.stem
        if profiles:
            output += f" {' '.join(sorted(profiles))}"
        print(output)
    return 0


def get_default_config_value(name: str) -> Any:
    if name not in DEFAULT_CONFIG:
        raise ValueError(f"{name} has no built-in default value")
    return DEFAULT_CONFIG[name]


def parse_patch_branch_value(value: Any) -> bool | str:
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        raw_value = value.strip()
        normalized = raw_value.lower()
        if normalized in ("true", "yes", "on", "1"):
            return True
        if normalized in ("false", "no", "off", "0"):
            return False
        if raw_value:
            return raw_value
    raise ValueError('patch_branch must be a boolean or branch name')


def resolve_patch_branch_setting(value: Any) -> str | None:
    if value == "":
        return ""
    parsed = parse_patch_branch_value(value)
    if isinstance(parsed, bool):
        return "" if parsed else None
    return parsed


def parse_config_assignment(value: str, config: dict[str, Any]) -> tuple[str, Any]:
    if "=" not in value:
        raise ValueError("expected NAME=VALUE")

    name, raw_value = value.split("=", 1)
    name = name.strip()
    if not name:
        raise ValueError("configuration name cannot be empty")
    raw_value = raw_value.strip()

    if name in DEPRECATED_CONFIG_KEYS and name not in config:
        raise ValueError(
            f"{name} is deprecated and is not present in the config"
        )

    canonical_name = DEPRECATED_CONFIG_KEYS.get(name, name)
    if canonical_name == INHERIT_PROFILE_CONFIG_KEY:
        raise ValueError(
            f"{INHERIT_PROFILE_CONFIG_KEY} is managed by --inherit-profile"
        )
    if raw_value == "DEFAULT":
        return name, get_default_config_value(canonical_name)

    if canonical_name == "patch_branch":
        return name, parse_patch_branch_value(raw_value)
    expected = (
        DEFAULT_CONFIG[canonical_name]
        if canonical_name in DEFAULT_CONFIG
        else config.get(name)
    )
    if isinstance(expected, int) and not isinstance(expected, bool):
        try:
            return name, int(raw_value)
        except ValueError as exc:
            raise ValueError(f"{name} must be an integer") from exc
    if isinstance(expected, float):
        try:
            return name, float(raw_value)
        except ValueError as exc:
            raise ValueError(f"{name} must be a number") from exc
    if isinstance(expected, bool):
        normalized = raw_value.lower()
        if normalized in ("true", "yes", "on", "1"):
            return name, True
        if normalized in ("false", "no", "off", "0"):
            return name, False
        raise ValueError(f"{name} must be a boolean")
    return name, raw_value


def format_config_value(value: Any) -> str:
    if isinstance(value, (dict, list)):
        return json.dumps(value, ensure_ascii=False, separators=(",", ":"))
    if value is None:
        return ""
    return str(value)


def mask_api_key(value: Any) -> str:
    key = "" if value is None else str(value)
    if not key:
        return ""
    if len(key) > 8:
        return f"{key[:4]}{'*' * (len(key) - 8)}{key[-4:]}"
    return "*" * len(key)

def format_config_line(config_name: str, value: Any) -> str:
    output_value = (
        mask_api_key(value)
        if config_name == "api_key"
        else format_config_value(value)
    )
    return f"{config_name}={output_value}"

def format_config_lines(config: dict[str, Any]) -> list[str]:
    return [
        format_config_line(config_name, value)
        for config_name, value in config.items()
    ]


def prompt_config_value(
    config: dict[str, Any],
    key: str,
    label: str,
    cast: type | None = None,
    mask: bool = False,
) -> None:
    current = config.get(key)

    if mask and isinstance(current, str) and current:
        if len(current) > 8:
            # Show first 4, asterisks for the middle, last 4.
            masked = f"{current[:4]}{'*' * (len(current) - 8)}{current[-4:]}"
        else:
            # Very short keys – just hide everything.
            masked = "*" * len(current)
    else:
        masked = current
    value = input(f"{label} [{masked}]: ").strip()

    if not value:
        return

    try:
        if value == "DEFAULT":
            parent_name = _inherit_profile_name(config, CONFIG_FILE)
            if parent_name is None:
                config[key] = get_default_config_value(key)
            else:
                inherited_config = merged_config(get_profile_path(parent_name))
                if key in inherited_config:
                    config[key] = inherited_config[key]
                else:
                    config.pop(key, None)
        elif value == "-" and key in PROMPT_CONFIG_KEYS:
            config[key] = ""
        else:
            config[key] = cast(value) if cast else value
    except Exception:
        print(f"WARNING: Invalid value for {key}; keeping existing value.")


