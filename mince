def parse_agent_context_expires(value: Any) -> tuple[int, int, int]:
    parts = value.split() if isinstance(value, str) else value
    if not isinstance(parts, (list, tuple)) or not 1 <= len(parts) <= 3:
        raise ValueError(
            "agent_context_expires requires DEFAULT [MIN] [MAX]"
        )
    numbers: list[int] = []
    for part in parts:
        if isinstance(part, bool) or not (
            isinstance(part, int)
            or isinstance(part, str) and re.fullmatch(r"[0-9]+", part)
        ):
            raise ValueError(
                "agent_context_expires values must be non-negative integers"
            )
        numbers.append(int(part))
    default = numbers[0]
    minimum = (
        numbers[1] if len(numbers) > 1 else DEFAULT_AGENT_CONTEXT_EXPIRES[1]
    )
    maximum = (
        numbers[2] if len(numbers) > 2 else DEFAULT_AGENT_CONTEXT_EXPIRES[2]
    )
    if not minimum <= default <= maximum:
        raise ValueError(
            "agent_context_expires requires MIN <= DEFAULT <= MAX"
        )
    return default, minimum, maximum


def normalize_agent_context_expires(value: Any) -> str:
    return " ".join(str(number) for number in parse_agent_context_expires(value))


def parse_agent_expires_in_turns(
    value: Any,
    expires_schema: dict[str, Any] = AGENT_EXPIRES_IN_TURNS_SCHEMA,
 ) -> int:
    if isinstance(value, bool) or not isinstance(value, int):
        value = expires_schema["default"]
    minimum = expires_schema["minimum"]
    maximum = expires_schema["maximum"]
    if value < minimum:
        return minimum
    if value > maximum:
        return maximum
    return value


def normalize_agent_meta_task_status(
    value: Any,
    label: str,
) -> str:
    statuses = META_TASK_STATUS_SCHEMA["enum"]
    if not isinstance(value, str) or value not in statuses:
        raise ValueError(
            f"{label} status must be "
            + ", ".join(statuses[:-1])
            + f", or {statuses[-1]}"
        )
    return value


def normalize_agent_meta_task_item(
    value: Any,
    label: str,
) -> dict[str, Any]:
    expected_fields = {"task", "status"}
    if not isinstance(value, dict) or set(value) != expected_fields:
        raise ValueError(
            f"{label} must contain only "
            + ", ".join(sorted(expected_fields))
            + " fields"
        )
    task = value["task"]
    if not isinstance(task, str) or not task.strip():
        raise ValueError(f"{label} task must be a non-empty string")
    return {
        "task": task.strip(),
        "status": normalize_agent_meta_task_status(value["status"], label),
    }


def normalize_agent_meta_task_list(
    value: Any,
 ) -> list[dict[str, Any]]:
    if not isinstance(value, list):
        raise ValueError("meta_task_list tasks must be an array")
    return [
        normalize_agent_meta_task_item(
            task,
            f"meta_task_list task {index}",
        )
        for index, task in enumerate(value, start=1)
    ]


def normalize_agent_meta_task_number(value: Any) -> int:
    if (
        isinstance(value, bool)
        or not isinstance(value, int)
        or value < 1
    ):
        raise ValueError(
            "meta_task_list number must be a positive task number"
        )
    return value


def normalize_agent_meta_task_operations(
    value: Any,
 ) -> list[dict[str, Any]]:
    if not isinstance(value, list) or not value:
        raise ValueError("meta_task_list operations must be a non-empty array")
    operations: list[dict[str, Any]] = []
    for index, operation in enumerate(value, start=1):
        label = f"meta_task_list operation {index}"
        if not isinstance(operation, dict):
            raise ValueError(f"{label} must be an object")
        action = operation.get("action")
        if action in ("add", "change"):
            entry_field = "tasks"
            expected_fields = {"action", "tasks"}
        elif action == "remove":
            entry_field = "numbers"
            expected_fields = {"action", "numbers"}
        else:
            raise ValueError(f"{label} action must be add, change, or remove")
        if set(operation) != expected_fields:
            raise ValueError(
                f"{label} must contain only "
                + ", ".join(sorted(expected_fields))
                + " fields"
            )
        entries = operation[entry_field]
        if not isinstance(entries, list) or not entries:
            raise ValueError(f"{label} {entry_field} must be a non-empty array")
        normalized: dict[str, Any] = {"action": action}
        if action == "add":
            entries = normalize_agent_meta_task_list(entries)
        elif action == "change":
            changes: list[dict[str, Any]] = []
            for change in entries:
                expected_change_fields = {"number", "status"}
                if (
                    not isinstance(change, dict)
                    or set(change) != expected_change_fields
                ):
                    raise ValueError(
                        f"{label} changes must contain number and status"
                    )
                number = normalize_agent_meta_task_number(change["number"])
                status = normalize_agent_meta_task_status(
                    change["status"], label
                )
                changes.append({"number": number, "status": status})
            entries = changes
        else:
            entries = [
                normalize_agent_meta_task_number(number)
                for number in entries
            ]
        normalized[entry_field] = entries
        operations.append(normalized)
    return operations


def limit_agent_meta_task_list(
    task_list: list[dict[str, Any]],
) -> list[dict[str, Any]]:
    excess = len(task_list) - META_TASK_LIST_MAX_TASKS
    if excess <= 0:
        return task_list
    removable_indexes = [
        index
        for index, task in enumerate(task_list)
        if task["status"] in ("done", "skip")
    ][:excess]
    if len(removable_indexes) < excess:
        raise ValueError(
            f"meta_task_list supports at most {META_TASK_LIST_MAX_TASKS} tasks; "
            "remove tasks or mark them done or skip to make room"
        )
    removed_indexes = set(removable_indexes)
    return [
        task for index, task in enumerate(task_list)
        if index not in removed_indexes
    ]


def apply_agent_meta_task_operations(
    task_list: list[dict[str, Any]],
    operations: list[dict[str, Any]],
    *,
    limit_tasks: bool = True,
) -> list[dict[str, Any]]:
    updated_tasks = normalize_agent_meta_task_list(task_list)
    operations = normalize_agent_meta_task_operations(operations)

    for operation in operations:
        action = operation["action"]
        if action == "add":
            updated_tasks.extend(operation["tasks"])
        elif action == "change":
            for change in operation["tasks"]:
                task_index = change["number"] - 1
                if task_index >= len(updated_tasks):
                    raise ValueError(
                        "meta_task_list task does not exist: "
                        f"{change['number']}"
                    )
                updated_tasks[task_index]["status"] = change["status"]
        else:
            numbers = set(operation["numbers"])
            for number in numbers:
                if number > len(updated_tasks):
                    raise ValueError(
                        f"meta_task_list task does not exist: {number}"
                    )
            for number in sorted(numbers, reverse=True):
                del updated_tasks[number - 1]
    if limit_tasks:
        return limit_agent_meta_task_list(updated_tasks)
    return updated_tasks


def _parse_agent_tool_arguments_value(
    tool: str,
    value: Any,
    agent_profiles: tuple[AgentProfile, ...] = (),
    expires_schema: dict[str, Any] = AGENT_EXPIRES_IN_TURNS_SCHEMA,
    response_json_repair: bool = False,
 ) -> AgentToolCall | None:
    profile_name = next(
        (
            profile.name
            for profile in agent_profiles
            if tool == agent_profile_tool_name(profile.name)
        ),
        None,
    )
    if profile_name is not None:
        return parse_agent_profile_tool_call(
            profile_name,
            value,
            expires_schema,
            response_json_repair,
        )
    if not isinstance(tool, str) or tool not in AGENT_TOOL_ARGUMENT_SCHEMAS:
        return None
    if isinstance(value, str):
        value = parse_agent_response_json(
            value, f"agent {tool} arguments", response_json_repair
        )
    if (
        isinstance(value, dict)
        and tool != AGENT_META_TASK_LIST_TOOL
        and "expires_in_turns" not in value
    ):
        value = {**value, "expires_in_turns": expires_schema["default"]}
    if not isinstance(value, dict):
        raise ValueError(f"agent {tool} arguments must be a JSON object")
    expected_fields = set(AGENT_TOOL_ARGUMENT_SCHEMAS[tool]["properties"])
    actual_fields = set(value)
    if actual_fields != expected_fields:
        missing_fields = sorted(expected_fields - actual_fields)
        unexpected_fields = sorted(actual_fields - expected_fields)
        details: list[str] = []
        if missing_fields:
            details.append("missing " + ", ".join(missing_fields))
        if unexpected_fields:
            details.append("unexpected " + ", ".join(unexpected_fields))
        raise ValueError(
            f"agent {tool} arguments must contain exactly the tool schema "
            "fields (" + "; ".join(details) + ")"
        )
    if tool == AGENT_PATCH_TOOL:
        expires_in_turns = parse_agent_expires_in_turns(
            value["expires_in_turns"], expires_schema
        )
        if not isinstance(value["files"], list) or not value["files"]:
            raise ValueError(
                "agent patch arguments require a non-empty files array"
            )
        commit_message = value["commit_message"]
        if (
            not isinstance(commit_message, str)
            or not commit_message.strip()
        ):
            raise ValueError(
                "agent patch arguments require a non-empty commit_message"
            )
        tool_call = AgentToolCall(
            tool=tool,
            expires_in_turns=expires_in_turns,
            arguments={
                "files": value["files"],
                "commit_message": commit_message,
            },
        )
        agent_patch_readfile_paths(tool_call)
        return tool_call
 
    if tool == AGENT_SHELL_TOOL:
        expires_in_turns = parse_agent_expires_in_turns(
            value["expires_in_turns"], expires_schema
        )
        try:
            _parse_shell_manifest_value({"commands": value["commands"]})
        except ValueError as exc:
            raise ValueError(f"agent shell arguments are invalid: {exc}") from exc
        return AgentToolCall(
            tool=tool,
            expires_in_turns=expires_in_turns,
            arguments={"commands": value["commands"]},
        )

    if tool == AGENT_META_TASK_LIST_TOOL:
        try:
            operations = normalize_agent_meta_task_operations(value["operations"])
        except ValueError as exc:
            raise ValueError(
                f"agent meta_task_list arguments are invalid: {exc}"
            ) from exc
        return AgentToolCall(
            tool=tool,
            arguments={"operations": operations},
        )
 
    if tool == AGENT_READFILE_TOOL:
        expires_in_turns = parse_agent_expires_in_turns(
            value["expires_in_turns"], expires_schema
        )
        paths = value["paths"]
        if not isinstance(paths, list) or not paths:
            raise ValueError(
                "agent readfile arguments require a non-empty paths array"
            )
        normalized_paths: list[str] = []
        for index, path in enumerate(paths, start=1):
            if not isinstance(path, str) or not path.strip():
                raise ValueError(
                    f"agent readfile paths entry {index} must be a non-empty string"
                )
            if "\x00" in path:
                raise ValueError(
                    f"agent readfile paths entry {index} cannot contain a null byte"
                )
            normalized_paths.append(path.strip())
        return AgentToolCall(
            tool=tool,
            expires_in_turns=expires_in_turns,
            arguments={"paths": normalized_paths},
        )
 
    expires_in_turns = parse_agent_expires_in_turns(
        value["expires_in_turns"], expires_schema
    )
    for name in expected_fields:
        if name == "expires_in_turns":
            continue
        if not isinstance(value[name], str):
            raise ValueError(f"agent {tool} field {name} must be a string")

    tool_call = AgentToolCall(
        tool=tool,
        reason=value.get("reason", "").strip(),
        task=value.get("task", "").strip(),
        context=value.get("context", "").strip(),
        context_id=value.get("context_id", "").strip(),
        action=value.get("action", "").strip(),
        expires_in_turns=expires_in_turns,
    )
    if tool == AGENT_AGENT_TOOL:
        if not tool_call.task:
            raise ValueError("agent agent tool requires a non-empty task")
    elif tool == AGENT_SESSION_TOOL:
        if tool_call.action != "end":
            raise ValueError("agent session tool requires action=end")
        if not tool_call.reason:
            raise ValueError("agent session tool requires a non-empty reason")
    elif tool == AGENT_META_CONTEXT_CONTROL_TOOL:
        if tool_call.action not in ("pin", "set_expires_in_turns", "summary"):
            raise ValueError(
                "agent meta_context_control tool requires action=pin, "
                "action=set_expires_in_turns, or action=summary"
            )
        if not tool_call.context_id:
            raise ValueError(
                "agent meta_context_control tool requires a non-empty context_id"
            )
        if tool_call.action == "summary":
            if tool_call.context_id != "all":
                raise ValueError("agent context summary requires context_id=all")
            if not tool_call.reason:
                raise ValueError("agent context summary requires non-empty Markdown in reason")
    return tool_call


def parse_agent_tool_arguments(
    tool: str,
    value: Any,
    agent_profiles: tuple[AgentProfile, ...] = (),
    expires_schema: dict[str, Any] = AGENT_EXPIRES_IN_TURNS_SCHEMA,
    response_json_repair: bool = False,
) -> AgentToolCall | None:
    try:
        return _parse_agent_tool_arguments_value(
            tool,
            value,
            agent_profiles=agent_profiles,
            expires_schema=expires_schema,
            response_json_repair=response_json_repair,
        )
    except AgentControllerResponseError:
        raise
    except (ValueError, TypeError, KeyError) as exc:
        raise AgentControllerResponseError(str(exc)) from exc


def parse_agent_profile_tool_call(
    profile_name: str,
    value: Any,
    expires_schema: dict[str, Any] = AGENT_EXPIRES_IN_TURNS_SCHEMA,
    response_json_repair: bool = False,
) -> AgentToolCall | None:
    tool_call = parse_agent_tool_arguments(
        AGENT_AGENT_TOOL,
        value,
        expires_schema=expires_schema,
        response_json_repair=response_json_repair,
    )
    if tool_call is None:
        return None
    return replace(tool_call, profile_name=profile_name)


def normalize_agent_tool_calls(
    tool_calls: list[AgentToolCall],
) -> list[AgentToolCall]:
    if not tool_calls:
        raise AgentControllerResponseError(
            "agent responses require at least one tool call"
        )
    return tool_calls


def normalize_agent_controller_tool_calls(
    tool_calls: list[AgentToolCall],
) -> list[AgentToolCall]:
    has_summary_call = any(
        tool_call.tool == AGENT_META_CONTEXT_CONTROL_TOOL
        and tool_call.action == "summary"
        for tool_call in tool_calls
    )
    if has_summary_call and len(tool_calls) != 1:
        raise AgentControllerResponseError(
            "agent context summary responses must contain exactly one tool call"
        )
    if not tool_calls or (
        tool_calls[0].tool == AGENT_META_CONTEXT_CONTROL_TOOL
        and not has_summary_call
    ):
        raise AgentControllerResponseError(
            AGENT_CONTROLLER_NO_EXECUTABLE_TOOL_CALL_ERROR
        )
    if len(tool_calls) != 1 and any(
        tool_call.tool == AGENT_SESSION_TOOL
        for tool_call in tool_calls
    ):
        raise AgentControllerResponseError(
            "agent session end responses must contain exactly one tool call"
        )
    return tool_calls


def agent_patch_readfile_paths(tool_call: AgentToolCall) -> list[str]:
    arguments = tool_call.arguments
    if not isinstance(arguments, dict):
        raise ValueError("agent patch tool received no manifest")
    files = arguments.get("files")
    if not isinstance(files, list) or not files:
        raise ValueError(
            "agent patch arguments require a non-empty files array"
        )
    paths: list[str] = []
    for index, file_entry in enumerate(files, start=1):
        if not isinstance(file_entry, dict):
            raise ValueError(
                f"agent patch files entry {index} must be an object"
            )
        if set(file_entry) != {"document", "patches"}:
            raise ValueError(
                f"agent patch files entry {index} requires document and patches"
            )
        document = file_entry["document"]
        if not isinstance(document, dict) or set(document) != {
            "path", "encoding", "line_ending"
        }:
            raise ValueError(
                f"agent patch files entry {index} requires document metadata"
            )
        path = document["path"]
        if not isinstance(path, str) or not path.strip() or "\x00" in path:
            raise ValueError(
                f"agent patch files entry {index} document requires a path"
            )
        if document["encoding"] != "utf-8":
            raise ValueError("agent patch document encoding must be utf-8")
        if document["line_ending"] not in ("lf", "crlf"):
            raise ValueError("agent patch document line_ending must be lf or crlf")
        patches = file_entry["patches"]
        if not isinstance(patches, list) or not patches:
            raise ValueError(
                f"agent patch files entry {index} requires a non-empty patches array"
            )
        validate_patch_ranges(patches)
        for patch_index, patch in enumerate(patches, start=1):
            label = f"agent patch files entry {index} patch {patch_index}"
            for field in ("block_id", "summary_message"):
                field_value = patch.get(field)
                if not isinstance(field_value, str) or not field_value.strip():
                    raise ValueError(f"{label} requires a non-empty {field}")
        paths.append(path.strip())
    return paths


def append_agent_patch_readfile_tool_calls(
    tool_calls: list[AgentToolCall],
) -> list[AgentToolCall]:
    appended_tool_calls: list[AgentToolCall] = []
    for index, tool_call in enumerate(tool_calls, start=1):
        appended_tool_calls.append(tool_call)
        if tool_call.tool != AGENT_PATCH_TOOL:
            continue
        try:
            paths = agent_patch_readfile_paths(tool_call)
            manifest = tool_call.arguments
            if manifest is not None:
                for _, file_entry in patch_manifest_documents(manifest):
                    validate_patch_contents(file_entry["patches"])
        except ValueError as exc:
            raise AgentControllerResponseError(
                f"agent tool call {index}: {exc}"
            ) from exc
        appended_tool_calls.append(
            AgentToolCall(
                tool=AGENT_READFILE_TOOL,
                expires_in_turns=tool_call.expires_in_turns,
                arguments={"paths": paths},
            )
        )
    return appended_tool_calls

def is_agent_patch_readfile_companion(
    patch_tool_call: AgentToolCall | None,
    readfile_tool_call: AgentToolCall,
) -> bool:
    if (
        patch_tool_call is None
        or patch_tool_call.tool != AGENT_PATCH_TOOL
        or readfile_tool_call.tool != AGENT_READFILE_TOOL
    ):
        return False
    try:
        return readfile_tool_call.arguments == {
            "paths": agent_patch_readfile_paths(patch_tool_call),
        }
    except ValueError:
        return False

class ModelResponseError(ValueError):
    def __init__(self, message: str, *, retryable: bool = False) -> None:
        super().__init__(message)
        self.retryable = retryable


def response_field(value: Any, name: str, default: Any = None) -> Any:
    return (
        value.get(name, default)
        if isinstance(value, dict)
        else getattr(value, name, default)
    )


def model_response_error(error: Any, fallback: str) -> ModelResponseError:
    code = response_field(error, "code")
    message = response_field(error, "message") or fallback
    return ModelResponseError(
        f"{code}: {message}" if code else str(message),
        retryable=code in (
            "server_error", "rate_limit_exceeded", "vector_store_timeout",
        ),
    )


def validate_model_response(response_obj: Any) -> None:
    if response_obj is None:
        raise ModelResponseError("Model returned no response", retryable=True)
    error = response_field(response_obj, "error")
    if error is not None:
        raise model_response_error(error, "Model response failed")
    status = response_field(response_obj, "status")
    incomplete_details = response_field(response_obj, "incomplete_details")
    if status == "incomplete" or incomplete_details is not None:
        reason = response_field(incomplete_details, "reason") or "unknown"
        raise ModelResponseError(f"Model response is incomplete: {reason}")
    if status not in (None, "completed"):
        raise ModelResponseError(
            f"Model response did not complete (status={status})",
            retryable=status == "failed",
        )
    output_items = response_field(response_obj, "output", [])
    if not isinstance(output_items, (list, tuple)):
        raise ModelResponseError("Model response output must be an array")
    for item in output_items:
        if response_field(item, "type") != "message":
            continue
        if response_field(item, "status") not in (None, "completed"):
            raise ModelResponseError("Model response contains an unfinished message")
        for content in response_field(item, "content", []) or ():
            if response_field(content, "type") == "refusal":
                refusal = response_field(content, "refusal", "")
                raise ModelResponseError(
                    f"Model refused the request: {refusal}"
                    if refusal
                    else "Model refused the request"
                )


def response_text_parts(content: Any, content_type: str) -> list[str]:
    if not isinstance(content, (list, tuple)):
        return []
    texts: list[str] = []
    for part in content:
        if response_field(part, "type") != content_type:
            continue
        text = response_field(part, "text")
        if isinstance(text, str) and text:
            texts.append(text)
    return texts


def response_output_text(response_obj: Any) -> str:
    output_text = response_field(response_obj, "output_text")
    if isinstance(output_text, str) and output_text:
        return output_text
    output_items = response_field(response_obj, "output", [])
    if not isinstance(output_items, (list, tuple)):
        return ""
    return "".join(
        text
        for item in output_items
        if response_field(item, "type") == "message"
        for text in response_text_parts(
            response_field(item, "content", []), "output_text"
        )
    )


def parse_agent_response_json(
    raw: str,
    label: str,
    response_json_repair: bool = False,
) -> Any:
    try:
        value = parse_json_response(raw, response_json_repair)
        json.dumps(value, ensure_ascii=False, allow_nan=False).encode("utf-8")
    except (TypeError, ValueError, UnicodeError, RecursionError, OverflowError) as exc:
        raise AgentControllerResponseError(
            f"{label} must be valid JSON: {exc}"
        ) from exc
    return value


def normalize_agent_json_response(
    raw: str,
    json_schema: dict[str, Any] | None = None,
    response_json_repair: bool = False,
) -> str:
    if not isinstance(raw, str):
        raise AgentControllerResponseError("agent JSON response must be text")
    response = clean_json_response(raw)
    if not response:
        raise AgentControllerResponseError(
            "agent JSON response cannot be empty"
        )
    value = parse_agent_response_json(
        response, "agent JSON response", response_json_repair
    )
    if json_schema is not None:
        schema = json_schema.get("schema")
        expected_type = schema.get("type") if isinstance(schema, dict) else None
        expected_types: dict[str, Any] = {
            "object": dict,
            "array": list,
            "string": str,
            "boolean": bool,
            "integer": int,
            "number": (int, float),
            "null": type(None),
        }
        if isinstance(expected_type, str) and expected_type in expected_types:
            if (
                not isinstance(value, expected_types[expected_type])
                or expected_type in ("integer", "number")
                and isinstance(value, bool)
            ):
                raise AgentControllerResponseError(
                    f"agent JSON response must contain a JSON {expected_type}"
                )
    if response_json_repair:
        return json.dumps(value, ensure_ascii=False, allow_nan=False)
    return response


def response_agent_tool_calls(
    response_obj: Any,
    agent_profiles: tuple[AgentProfile, ...] = (),
    expires_schema: dict[str, Any] = AGENT_EXPIRES_IN_TURNS_SCHEMA,
    response_json_repair: bool = False,
    default_profile: AgentProfile | None = None,
) -> list[AgentToolCall]:
    validate_model_response(response_obj)
    if default_profile is not None:
        agent_profiles = (*agent_profiles, default_profile)
    output_text = response_output_text(response_obj)
    if output_text.strip():
        raise AgentControllerResponseError(
            AGENT_CONTROLLER_NO_EXECUTABLE_TOOL_CALL_ERROR
        )
    output_items = response_field(response_obj, "output", [])
    tool_calls: list[AgentToolCall] = []
    for item in output_items:
        item_type = response_field(item, "type")
        if item_type in ("reasoning", "message"):
            continue
        if item_type != "function_call":
            raise AgentControllerResponseError(
                f"Agent returned an unsupported output item: {item_type}"
            )
        if response_field(item, "status") not in (None, "completed"):
            raise AgentControllerResponseError(
                "Agent returned an unfinished function call"
            )
        tool = response_field(item, "name")
        if tool == AGENT_AGENT_TOOL and default_profile is not None:
            tool = agent_profile_tool_name(default_profile.name)
        arguments = response_field(item, "arguments")
        try:
            tool_call = parse_agent_tool_arguments(
                tool,
                arguments,
                agent_profiles=agent_profiles,
                expires_schema=expires_schema,
                response_json_repair=response_json_repair,
            )
        except AgentControllerResponseError as exc:
            raise AgentControllerResponseError(
                f"Failed to parse agent {tool} arguments: {exc}"
            ) from exc
        if tool_call is None:
            raise AgentControllerResponseError(
                f"Agent returned an unknown function call: {tool}"
            )
        tool_calls.append(tool_call)
    return append_agent_patch_readfile_tool_calls(
        normalize_agent_controller_tool_calls(tool_calls)
    )


def format_agent_tool_call(tool_call: AgentToolCall) -> str:
    return json.dumps(tool_call.as_dict(), indent=2, ensure_ascii=False)


def format_agent_meta_task_list(
    task_list: list[dict[str, Any]] | None,
    task_number_start: int = 1,
 ) -> str:
    if not task_list:
        return "No tasks."

    return "\n".join(
        f"{task_index}. [{task['status']}] {task['task']}"
        for task_index, task in enumerate(
            task_list,
            start=task_number_start,
        )
    )


def format_agent_meta_task_operations(
    operations: list[dict[str, Any]],
    task_list: list[dict[str, Any]] | None = None,
) -> str:
    try:
        original_task_list = normalize_agent_meta_task_list(
            task_list if task_list is not None else []
        )
    except ValueError:
        original_task_list = None

    def format_task_reference(
        number: int,
        status: str | None = None,
    ) -> str:
        if (
            original_task_list is not None
            and 1 <= number <= len(original_task_list)
        ):
            task = original_task_list[number - 1]
            if status is not None:
                task = {**task, "status": status}
            return format_agent_meta_task_list([task], number)
        if status is not None:
            return f"- {number}: [{status}]"
        return f"- {number}"

    blocks: list[str] = []
    for operation in operations:
        action = operation["action"]
        if action == "add":
            heading = "Add tasks:"
            if original_task_list is None:
                task_lines = [
                    f"  - [{task['status']}] {task['task']}"
                    for task in operation["tasks"]
                ]
            else:
                task_lines = [
                    f"  {line}"
                    for line in format_agent_meta_task_list(
                        operation["tasks"],
                        len(original_task_list) + 1,
                    ).splitlines()
                ]
        elif action == "change":
            heading = "Change task statuses:"
            task_lines = [
                f"  {line}"
                for change in operation["tasks"]
                for line in format_task_reference(
                    change["number"], change["status"]
                ).splitlines()
            ]
        else:
            heading = "Remove tasks:"
            task_lines = [
                f"  {line}"
                for number in operation["numbers"]
                for line in format_task_reference(number).splitlines()
            ]
        blocks.append(heading + "\n" + "\n".join(task_lines))
        if original_task_list is not None:
            try:
                # Batch capacity pruning must not change intermediate numbering.
                original_task_list = apply_agent_meta_task_operations(
                    original_task_list,
                    [operation],
                    limit_tasks=False,
                )
            except ValueError:
                original_task_list = None
    return "\n\n".join(blocks)


def format_agent_patch_manifest(manifest: dict[str, Any]) -> str:
    file_blocks: list[str] = []
    for file_index, file_entry in enumerate(manifest["files"], start=1):
        document = file_entry["document"]
        patch_blocks: list[str] = []
        for patch_index, patch in enumerate(
            file_entry["patches"],
            start=1,
        ):
            patch_blocks.append(
                f"  Change {patch_index}: lines {patch['start_line']}-"
                f"{patch['end_line']}\n"
                "  Summary: "
                f"{patch['summary_message']}\n"
            )
        file_blocks.append(
            f"[{file_index}] {document['path']}\n"
            + "\n".join(patch_blocks)
        )
    return (
        "\n\n".join(file_blocks) +
        f"Patch summary: {manifest['commit_message']}\n"
    )


def format_agent_tool_call_for_output(
    tool_call: AgentToolCall,
    meta_task_list: list[dict[str, Any]] | None = None,
) -> str:
    call = tool_call.as_dict()
    tool_name = str(call.pop("tool"))
    if (
        tool_call.tool == AGENT_PATCH_TOOL
        and tool_call.arguments is not None
    ):
        return (
            f"Tool: {tool_name}\n"
            f"{format_agent_patch_manifest(tool_call.arguments)}"
        )
    if (
        tool_call.tool == AGENT_SHELL_TOOL
        and tool_call.arguments is not None
    ):
        commands = _parse_shell_manifest_value(tool_call.arguments)
        return f"Tool: {tool_name}\nCommands:\n{format_shell_commands(commands)}"
    if (
        tool_call.tool == AGENT_META_TASK_LIST_TOOL
        and tool_call.arguments is not None
    ):
        operations = tool_call.arguments.get("operations")
        if isinstance(operations, list):
            return (
                f"Tool: {tool_name}\n"
                f"Task list updates:\n"
                f"{format_agent_meta_task_operations(operations, meta_task_list)}"
            )
    if (
        tool_call.tool == AGENT_META_CONTEXT_CONTROL_TOOL
        and tool_call.action == "summary"
    ):
        return (
            f"Tool: {tool_name}\n"
            "Action: summary\n"
            f"Summary:\n{tool_call.reason}"
        )
    if tool_call.tool == AGENT_READFILE_TOOL:
        paths = call["paths"]
        path_text = "\n".join(
            f"[{index}] {path}"
            for index, path in enumerate(paths, start=1)
        )
        return f"Tool: {tool_name}\nPaths:\n{path_text}"
    if tool_call.tool == AGENT_SESSION_TOOL:
        return (
            f"Tool: {tool_name}\n"
            f"Action: {call['action']}\n"
            f"Reason:\n{call['reason']}"
        )
    if tool_call.tool == AGENT_AGENT_TOOL:
        sections = [
            f"Tool: {tool_name}",
            f"Task:\n{call['task']}",
        ]
        if call["context"]:
            sections.append(f"Context:\n{call['context']}")
        if call["reason"]:
            sections.append(f"Reason:\n{call['reason']}")
        return "\n".join(sections)
    return (
        f"Tool: {tool_name}\n"
        "Arguments:\n"
        f"{json.dumps(call, indent=2, ensure_ascii=False)}"
    )


def format_agent_tool_call_report(
    tool_calls: list[AgentToolCall],
    current_turn: int | None = None,
    meta_task_list: list[dict[str, Any]] | None = None,
) -> str:
    normalized_tool_calls = normalize_agent_tool_calls(tool_calls)
    if current_turn is not None and len(normalized_tool_calls) == 1:
        return (
            f"-- [{current_turn}] {'-' * 72}\n"
            f"{format_agent_tool_call_for_output(normalized_tool_calls[0], meta_task_list)}"
        )
    tool_blocks: list[str] = []
    for index, tool_call in enumerate(normalized_tool_calls, start=1):
        tool_blocks.append(
            f"[{index}] {format_agent_tool_call_for_output(tool_call, meta_task_list)}"
        )
        if (
            tool_call.tool == AGENT_META_TASK_LIST_TOOL
            and isinstance(tool_call.arguments, dict)
        ):
            try:
                meta_task_list = apply_agent_meta_task_operations(
                    meta_task_list if meta_task_list is not None else [],
                    tool_call.arguments.get("operations"),
                )
            except ValueError:
                # Rejected batches leave the task list unchanged.
                pass
    tool_text = "\n\n".join(tool_blocks)
    if current_turn is not None:
        return f"-- [{current_turn}] {'-' * 72}\n{tool_text}"
    return "Agent tool calls:\n" + tool_text


def format_agent_tool_calls(tool_calls: list[AgentToolCall]) -> str:
    normalized_tool_calls = normalize_agent_tool_calls(tool_calls)
    if len(normalized_tool_calls) == 1:
        return format_agent_tool_call(normalized_tool_calls[0])
    return json.dumps(
        {
            "tool_calls": [
                tool_call.as_dict()
                for tool_call in normalized_tool_calls
            ],
        },
        indent=2,
        ensure_ascii=False,
    )

def format_agent_tool_outputs(
    tool_calls: list[AgentToolCall],
    tool_outputs: list[str],
) -> str:
    normalized_tool_calls = normalize_agent_tool_calls(tool_calls)
    if len(normalized_tool_calls) != len(tool_outputs):
        raise ValueError("agent tool calls and outputs must have equal lengths")
    if len(tool_outputs) == 1:
        return tool_outputs[0]
    return json.dumps(
        {"tool_outputs": tool_outputs},
        indent=2,
        ensure_ascii=False,
    )


def record_agent_tool_history(
    turns: list[AgentTurn],
    task: str,
    context: str,
    tool_call: AgentToolCall,
    output: str,
    turn_unix_time: int | None = None,
    readfile_contexts: tuple[tuple[str, str], ...] | None = None,
    *,
    preceding_patch_tool_call: AgentToolCall | None = None,
    state_turn: int | None = None,
    tool_call_index: int = 0,
 ) -> None:
    if readfile_contexts is not None:
        remove_duplicate_agent_history_context_files(
            turns,
            readfile_contexts,
        )
    if preceding_patch_tool_call is not None:
        if readfile_contexts is not None:
            if (
                not turns
                or turns[-1].tool_call != preceding_patch_tool_call
            ):
                raise ValueError(
                    "agent patch readfile call has no preceding patch turn"
                )
            turns[-1] = replace(
                turns[-1],
                readfile_contexts=readfile_contexts,
            )
        return
    turns.append(
        AgentTurn(
            task=task,
            context=context,
            tool_call=tool_call,
            output=output,
            turn_unix_time=turn_unix_time,
            readfile_contexts=readfile_contexts,
            expires_in_turns=tool_call.expires_in_turns,
            state_turn=state_turn,
            tool_call_index=tool_call_index,
        )
    )



def agent_history_tool_content(turn: AgentTurn) -> str:
    if turn.tool_call.tool == AGENT_META_TASK_LIST_TOOL:
        if turn.output.startswith("ERROR:"):
            return turn.output
        if not turn.output:
            return "Task list update was not executed."
        return "Task list loaded into `<meta_task_list>` tag."
    if turn.tool_call.tool.startswith("meta_"):
        return ""
    if (
        turn.tool_call.tool == AGENT_READFILE_TOOL
        and turn.readfile_contexts is not None
    ):
        return "`readfile` content loaded into the `<files>` tag."
    return turn.output

AGENT_INITIAL_FILE_CONTEXT_TURN = 0


def agent_file_context_section(
    section: str,
    expires_in_turns: int,
    turn: int = AGENT_INITIAL_FILE_CONTEXT_TURN,
    model: str = "",
) -> str:
    attributes = agent_file_context_attributes(section)
    if attributes is None:
        return section
    attribute_text = " ".join(
        f"{name}='{value}'"
        for name, value in attributes.items()
        if name not in ("turn", "expires_in_turns", "token_count")
    )
    return format_context_entry(
        "file",
        section.split("\n", 1)[1].removesuffix("</file>"),
        model=model,
        attributes=(
            f" turn='{turn}' expires_in_turns='{expires_in_turns}' "
            f"{attribute_text}"
        ),
    )


def format_agent_readfile_contexts(
    turns: list[AgentTurn],
    turn_numbers: list[int],
    visible_turn_numbers: set[int],
    model: str = "",
) -> str:
    sections: list[str] = []
    for turn_number, turn in zip(turn_numbers, turns):
        if turn_number not in visible_turn_numbers:
            continue
        readfile_contexts = list(turn.readfile_contexts or ())
        file_expires_in_turns = agent_file_context_expirations(
            readfile_contexts, turn.expires_in_turns
        )
        for path, section in readfile_contexts:
            sections.append(
                agent_file_context_section(
                    section,
                    file_expires_in_turns[path],
                    turn_number,
                    model=model,
                )
            )
    return "\n".join(sections)


def build_agent_files_context(
    file_contexts: list[tuple[str, str]],
    file_expires_in_turns: dict[str, int],
    visible_file_indexes: set[int],
    turns: list[AgentTurn],
    turn_numbers: list[int],
    visible_turn_numbers: set[int],
    model: str = "",
) -> str:
    refreshed_paths = {
        path
        for turn_number, turn in zip(turn_numbers, turns)
        if turn_number in visible_turn_numbers
        for path, _ in (turn.readfile_contexts or ())
    }
    initial_sections = [
        agent_file_context_section(
            file_contexts[index][1],
            file_expires_in_turns[file_contexts[index][0]],
            model=model,
        )
        for index in sorted(visible_file_indexes)
        if file_contexts[index][0] not in refreshed_paths
    ]
    readfile_context = format_agent_readfile_contexts(
        turns,
        turn_numbers,
        visible_turn_numbers,
        model=model,
    )
    return "\n".join(
        value for value in (*initial_sections, readfile_context) if value
    )


def remove_duplicate_agent_history_context_files(
    turns: list[AgentTurn],
    context_sections: tuple[tuple[str, str], ...],
) -> None:
    duplicate_paths = {path for path, _ in context_sections}
    if not duplicate_paths:
        return
    for turn_index, turn in enumerate(turns):
        if turn.readfile_contexts is None:
            continue
        remaining_context_sections = tuple(
            context_section
            for context_section in turn.readfile_contexts
            if context_section[0] not in duplicate_paths
        )
        if remaining_context_sections == turn.readfile_contexts:
            continue
        turns[turn_index] = replace(
            turn,
            readfile_contexts=remaining_context_sections,
        )


AGENT_HISTORY_PURGE_IN_TURNS = 1
AGENT_HISTORY_EXPIRATION_REMOVAL_REASON = (
    "This agent turn was removed from the controller context because its "
    "expires_in_turns limit was reached."
 )


def remove_agent_history_turn(
    turns: list[AgentTurn],
    turn_index: int,
    reason: str,
 ) -> None:
    turn = turns[turn_index]
    if turn.purge_in_turns is not None:
        return
    turns[turn_index] = replace(
        turn,
        purge_in_turns=AGENT_HISTORY_PURGE_IN_TURNS,
        removal_reason=reason,
    )


def advance_agent_readfile_context_expirations(
    turn: AgentTurn,
    turn_number: int,
    pinned: bool,
) -> AgentTurn:
    contexts = list(turn.readfile_contexts or ())
    expiring_contexts = [
        context
        for context in contexts
        if "expires_in_turns" in (
            agent_file_context_attributes(context[1]) or {}
        )
    ]
    if not expiring_contexts:
        return turn
    file_expires_in_turns = agent_file_context_expirations(
        expiring_contexts, turn.expires_in_turns
    )
    advance_agent_file_context_expirations(
        contexts,
        file_expires_in_turns,
        set(file_expires_in_turns) if pinned else set(),
    )
    return replace(
        turn,
        readfile_contexts=tuple(
            (
                path,
                agent_file_context_section(
                    section, file_expires_in_turns[path], turn_number
                ),
            )
            if path in file_expires_in_turns
            else (path, section)
            for path, section in contexts
        ),
    )


def advance_agent_history_purges(
    turns: list[AgentTurn],
    pinned_turn_numbers: set[int] | None = None,
 ) -> None:
    pinned_turn_numbers = pinned_turn_numbers or set()
    for turn_index, turn in enumerate(turns):
        if turn.purge_in_turns is not None:
            if turn.purge_in_turns > 0:
                turns[turn_index] = replace(
                    turn,
                    purge_in_turns=turn.purge_in_turns - 1,
                )
            continue
        turn = advance_agent_readfile_context_expirations(
            turn,
            turn_index,
            turn_index in pinned_turn_numbers,
        )
        turns[turn_index] = turn
        if turn.expires_in_turns > 0:
            turns[turn_index] = replace(
                turn,
                expires_in_turns=turn.expires_in_turns - 1,
            )
            continue
        if turn_index not in pinned_turn_numbers:
            remove_agent_history_turn(
                turns,
                turn_index,
                AGENT_HISTORY_EXPIRATION_REMOVAL_REASON,
            )


def agent_history_turn_numbers(
    turns: list[AgentTurn],
    turn_numbers: list[int] | None = None,
 ) -> list[int]:
    if turn_numbers is None:
        turn_numbers = list(range(len(turns)))
    if len(turn_numbers) != len(turns):
        raise ValueError("agent turn numbers must match agent turns")
    return [
        turn_number
        for turn_number, turn in zip(turn_numbers, turns)
        if turn.purge_in_turns is None
    ]



def format_agent_history(
    turns: list[AgentTurn],
    turn_numbers: list[int] | None = None,
    pinned_turn_numbers: set[int] | None = None,
    visible_turn_numbers: set[int] | None = None,
    model: str = "",
 ) -> str:
    if turn_numbers is None:
        turn_numbers = list(range(len(turns)))
    if pinned_turn_numbers is None:
        pinned_turn_numbers = set()
    if len(turn_numbers) != len(turns):
        raise ValueError("agent turn numbers must match agent turns")
    if visible_turn_numbers is None:
        visible_turn_numbers = set(
            agent_history_turn_numbers(
                turns,
                turn_numbers,
            )
        )
    blocks: list[str] = []
    for turn_number, turn in reversed(list(zip(turn_numbers, turns))):
        purge_in_turns = turn.purge_in_turns
        if purge_in_turns is not None:
            if purge_in_turns <= 0:
                continue
            tool_content = turn.removal_reason
            purge_attribute = f" purge_in_turns='{purge_in_turns}'"
        else:
            if turn_number not in visible_turn_numbers:
                continue
            tool_content = agent_history_tool_content(turn)
            purge_attribute = ""
        turn_unix_time_attribute = (
            f" turn_unix_time='{turn.turn_unix_time}'"
            if turn.turn_unix_time is not None
            else ""
        )
        pinned_attribute = (
            " pinned" if turn_number in pinned_turn_numbers else ""
        )
        if purge_in_turns is not None or turn.tool_call.tool.startswith("meta_"):
            tool_call_content = turn.tool_call.tool
        elif turn.tool_call.tool == AGENT_PATCH_TOOL:
            tool_call_content = format_agent_tool_call_for_output(turn.tool_call)
        else:
            tool_call_content = format_agent_tool_call(turn.tool_call)
        blocks.append(
            format_context_entry(
                "agent_turn",
                f"<tool_call>\n{tool_call_content}\n</tool_call>\n"
                f"<tool_content>\n{tool_content}\n</tool_content>\n",
                model=model,
                attributes=(
                    f"{turn_unix_time_attribute}{pinned_attribute} index='{turn_number}' "
                    f"expires_in_turns='{turn.expires_in_turns}'{purge_attribute}"
                ),
            )
        )
    return "\n\n".join(blocks)


def agent_context_file_sections(
    settings: AgentRunSettings,
) -> list[tuple[str, str]]:
    if settings.context_sections is not None:
        return settings.context_sections
    if not settings.context:
        return []
    return [("<files>", settings.context)]


def agent_file_context_expirations(
    file_contexts: list[tuple[str, str]],
    default: int = AGENT_EXPIRES_IN_TURNS_DEFAULT,
 ) -> dict[str, int]:
    return {
        path: coerce_int(
            (agent_file_context_attributes(section) or {}).get("expires_in_turns"),
            default,
        )
        for path, section in file_contexts
    }


def advance_agent_file_context_expirations(
    file_contexts: list[tuple[str, str]],
    file_expires_in_turns: dict[str, int],
    pinned_paths: set[str],
) -> None:
    expired_paths: set[str] = set()
    for path, expires_in_turns in list(file_expires_in_turns.items()):
        if expires_in_turns > 0:
            file_expires_in_turns[path] = expires_in_turns - 1
        elif path not in pinned_paths:
            expired_paths.add(path)
    if not expired_paths:
        return
    file_contexts[:] = [
        context for context in file_contexts
        if context[0] not in expired_paths
    ]
    for path in expired_paths:
        file_expires_in_turns.pop(path, None)

def agent_context_path_matches(context_id: str, path: str) -> bool:
    if context_id == path:
        return True
    if path == "/proc/self/stdin":
        return False
    try:
        candidate = Path(context_id).expanduser()
        if not candidate.is_absolute():
            candidate = Path.cwd() / candidate
        return candidate.resolve() == Path(path).expanduser().resolve()
    except (OSError, RuntimeError):
        return False


def resolve_agent_context_pin(
    context_id: str,
    file_contexts: list[tuple[str, str]],
    turns: list[AgentTurn],
    available_turn_numbers: set[int] | None = None,
    turn_number_base: int = 0,
) -> tuple[str, str | int]:
    for path, _ in file_contexts:
        if agent_context_path_matches(context_id, path):
            return "file", path

    turn_match = re.fullmatch(
        r"(?:turn(?:\s*:\s*|\s+))?(\d+)",
        context_id,
        flags=re.IGNORECASE,
    )
    if turn_match is not None:
        turn_number = int(turn_match.group(1)) - turn_number_base
        if available_turn_numbers is None:
            available_turn_numbers = set(range(len(turns)))
        if turn_number in available_turn_numbers:
            return "turn", turn_number
        if 0 <= turn_number < len(turns):
            raise ValueError(f"agent turn has expired: turn:{turn_number}")
        raise ValueError(f"agent turn does not exist: turn:{turn_number}")

    raise ValueError(
        "context_id must name an available context file or prior agent turn"
    )


def apply_agent_context_control(
    tool_call: AgentToolCall,
    file_contexts: list[tuple[str, str]],
    turns: list[AgentTurn],
    file_expires_in_turns: dict[str, int],
    pinned_paths: set[str],
    pinned_turn_numbers: set[int],
    turn_number_base: int = 0,
) -> None:
    target_type, target = resolve_agent_context_pin(
        tool_call.context_id,
        file_contexts,
        turns,
        set(agent_history_turn_numbers(turns)),
        turn_number_base=turn_number_base,
    )
    if tool_call.action == "pin":
        if target_type == "file":
            pinned_paths.add(str(target))
        else:
            pinned_turn_numbers.add(int(target))
    elif tool_call.action == "set_expires_in_turns":
        if target_type == "file":
            file_expires_in_turns[str(target)] = tool_call.expires_in_turns
        else:
            turn_index = int(target)
            turns[turn_index] = replace(
                turns[turn_index],
                expires_in_turns=tool_call.expires_in_turns,
            )


@dataclass(frozen=True)
class ReusedAgentHistory:
    turns: tuple[AgentTurn, ...]
    active_task: str
    active_context: str
    meta_task_list: tuple[dict[str, Any], ...] = ()
    context_summary: AgentContextSummary | None = None
    turn_metadata: dict[str, Any] | None = None


def agent_file_context_attributes(section: str) -> dict[str, str] | None:
    header, separator, _ = section.partition("\n")
    if (
        not separator
        or not header.startswith("<file ")
        or not header.endswith(">")
    ):
        return None
    try:
        values = shlex.split(header[1:-1])
    except ValueError:
        return None
    if not values or values[0] != "file":
        return None
    attributes: dict[str, str] = {}
    for value in values[1:]:
        name, equals, attribute_value = value.partition("=")
        if not equals or not name or name in attributes:
            return None
        attributes[name] = attribute_value
    return attributes


def agent_file_context_path(section: str) -> str | None:
    attributes = agent_file_context_attributes(section)
    if attributes is None:
        return None
    path = attributes.get("path")
    total_lines = attributes.get("total_lines")
    if (
        not path
        or attributes.get("encoding") != "utf-8"
        or not attributes.get("line_ending")
        or total_lines is None
        or not total_lines.isascii()
        or not total_lines.isdigit()
    ):
        return None
    return path


def agent_file_context_matches_turn(
    section: str,
    turn: int,
) -> bool:
    attributes = agent_file_context_attributes(section)
    return (
        attributes is not None
        and attributes.get("turn") == str(turn)
    )


def normalize_agent_context_summary(
    raw: str,
    allow_legacy_json: bool = False,
) -> str:
    if not isinstance(raw, str) or not raw.strip():
        raise ValueError("agent context summary requires non-empty Markdown")
    content = raw.strip()
    if not allow_legacy_json:
        return content
    try:
        value = json.loads(content)
    except json.JSONDecodeError:
        return content
    if not isinstance(value, dict) or set(value) != {"summary", "files"}:
        return content
    if not isinstance(value["summary"], str) or not value["summary"].strip():
        raise ValueError("agent context summary requires a non-empty summary")
    if not isinstance(value["files"], list):
        raise ValueError("agent context summary files must be an array")
    file_lines: list[str] = []
    for index, entry in enumerate(value["files"], start=1):
        if not isinstance(entry, dict) or set(entry) != {"path", "description"}:
            raise ValueError(
                f"agent context summary file {index} requires path and description"
            )
        for name in ("path", "description"):
            if not isinstance(entry[name], str) or not entry[name].strip():
                raise ValueError(
                    f"agent context summary file {index} requires a non-empty {name}"
                )
        file_lines.append(f"- `{entry['path']}`: {entry['description']}")
    parts = [value["summary"].strip()]
    if file_lines:
        parts.append("## Relevant files\n" + "\n".join(file_lines))
    return "\n\n".join(parts)


def validate_agent_context_summary(
    raw: str,
    model: str,
    token_budget: int = AGENT_CONTEXT_SUMMARY_MAX_TOKENS,
) -> str:
    try:
        content = normalize_agent_context_summary(raw)
    except ValueError as exc:
        raise AgentControllerResponseError(str(exc)) from exc
    summary_tokens = len(token_encoding_for_model(model).encode(content))
    if summary_tokens > token_budget:
        raise AgentControllerResponseError(
            f"agent context summary exceeds its {token_budget}-token budget"
        )
    return content


def saved_agent_turn_number_base(snapshot: dict[str, Any]) -> int:
    value = snapshot.get("turn_number_base", 1)
    if (
        isinstance(value, bool)
        or not isinstance(value, int)
        or value not in (0, 1)
    ):
        raise ValueError("saved agent turn number base must be 0 or 1")
    return value


def load_state_agent_context_summary(
    turn_dir: Path,
    default_expires_in_turns: int = AGENT_EXPIRES_IN_TURNS_DEFAULT,
) -> AgentContextSummary | None:
    artifact_text: str | None = None
    for artifact_name in (
        "response_agent_context_summary",
        "request_agent_context_summary",
    ):
        artifact_path = turn_dir / artifact_name
        artifact_text = read_optional_state_artifact(artifact_path)
        if artifact_text is not None:
            break
    if artifact_text is None:
        return None
    try:
        value = json.loads(artifact_text)
    except json.JSONDecodeError as exc:
        raise ValueError(
            f"agent context summary must contain JSON: {artifact_path}"
        ) from exc
    expected_fields = {
        "content", "removed_file_paths", "removed_turn_numbers",
        "active_context_checksum",
    }
    if not isinstance(value, dict) or not (
        expected_fields <= set(value)
        <= expected_fields | {"expires_in_turns", "turn_number_base"}
    ):
        raise ValueError(f"invalid agent context summary snapshot: {artifact_path}")
    turn_number_base = saved_agent_turn_number_base(value)
    content = value["content"]
    if not isinstance(content, str):
        raise ValueError("saved agent context summary content must be a string")
    if content.strip():
        content = normalize_agent_context_summary(content, allow_legacy_json=True)
    else:
        content = ""
    file_paths = value["removed_file_paths"]
    if not isinstance(file_paths, list) or any(
        not isinstance(path, str) or not path
        for path in file_paths
    ):
        raise ValueError("saved agent context summary file paths must be strings")
    turn_numbers = value["removed_turn_numbers"]
    if not isinstance(turn_numbers, list) or any(
        isinstance(number, bool)
        or not isinstance(number, int)
        or number < turn_number_base
        for number in turn_numbers
    ):
        raise ValueError("saved agent context summary turn numbers must be non-negative integers")
    checksum = value["active_context_checksum"]
    if not isinstance(checksum, str) or (
        checksum and re.fullmatch(r"[0-9a-f]{64}", checksum) is None
    ):
        raise ValueError("saved agent context summary has an invalid context checksum")
    expires_in_turns = value.get("expires_in_turns", default_expires_in_turns)
    if (
        isinstance(expires_in_turns, bool)
        or not isinstance(expires_in_turns, int)
        or expires_in_turns < 0
    ):
        raise ValueError("saved agent context summary expiry must be a non-negative integer")
    return AgentContextSummary(
        content=content,
        removed_file_paths=tuple(file_paths),
        removed_turn_numbers=tuple(
            number - turn_number_base for number in turn_numbers
        ),
        active_context_checksum=checksum,
        expires_in_turns=expires_in_turns,
    )



def parse_agent_readfile_contexts(
    output: str,
 ) -> tuple[tuple[str, str], ...] | None:
    contexts: list[tuple[str, str]] = []
    position = 0
    while position < len(output):
        closing_position = output.find("\n</file>", position)
        while closing_position != -1:
            after_closing = closing_position + len("\n</file>")
            if (
                after_closing == len(output)
                or output.startswith("\n<file ", after_closing)
            ):
                section = output[position:after_closing]
                path = agent_file_context_path(section)
                if path is None:
                    return None
                contexts.append((path, section))
                if after_closing == len(output):
                    return tuple(contexts)
                position = after_closing + 1
                break
            closing_position = output.find(
                "\n</file>",
                closing_position + 1,
            )
        else:
            return None
    return tuple(contexts) or None


def load_state_agent_file_contexts(
    turn_dir: Path,
 ) -> tuple[tuple[str, str], ...] | None:
    artifact_path = turn_dir / "response_agent_file_contexts"
    artifact_text = read_optional_state_artifact(artifact_path)
    if artifact_text is None:
        return None
    try:
        entries = json.loads(artifact_text)
    except json.JSONDecodeError as exc:
        raise ValueError(
            f"agent file contexts must contain JSON: {artifact_path}"
        ) from exc
    if not isinstance(entries, list):
        raise ValueError(
            f"agent file contexts must contain an array: {artifact_path}"
        )
    contexts: list[tuple[str, str]] = []
    for index, entry in enumerate(entries, start=1):
        if not isinstance(entry, dict) or set(entry) != {"path", "section"}:
            raise ValueError(
                "agent file context entry "
                f"{index} must contain path and section fields"
            )
        path = entry["path"]
        section = entry["section"]
        if not isinstance(path, str) or not path:
            raise ValueError(
                f"agent file context entry {index} path must be a non-empty string"
            )
        if not isinstance(section, str):
            raise ValueError(
                f"agent file context entry {index} section must be a string"
            )
        contexts.append((path, section))
    return tuple(contexts)


def load_reused_agent_readfile_contexts(
    turn_dir: Path,
    output: str,
) -> tuple[tuple[str, str], ...] | None:
    contexts = parse_agent_readfile_contexts(output)
    if contexts is not None:
        return contexts
    return load_state_agent_file_contexts(turn_dir)


def parse_reused_agent_tool_call_value(
    value: Any,
    expires_schema: dict[str, Any] = AGENT_EXPIRES_IN_TURNS_SCHEMA,
 ) -> AgentToolCall | None:
    if not isinstance(value, dict):
        raise ValueError("reused agent response must contain a JSON object")
    tool_name = value.get("tool")
    if not isinstance(tool_name, str) or not tool_name:
        raise ValueError("reused agent response must contain a tool name")
    arguments = {
        key: argument
        for key, argument in value.items()
        if key != "tool"
    }
    if (
        tool_name == AGENT_READFILE_TOOL
        and set(arguments) == {"path"}
    ):
        arguments = {"paths": [arguments["path"]]}
    if tool_name.startswith("agent_"):
        try:
            profile_name = validate_agent_profile_name(
                tool_name[len("agent_"):]
            )
        except ValueError as exc:
            raise ValueError(
                f"reused agent profile tool has an invalid name: {tool_name}"
            ) from exc
        return parse_agent_profile_tool_call(
            profile_name, arguments, expires_schema
        )
    return parse_agent_tool_arguments(
        tool_name, arguments, expires_schema=expires_schema
    )


def parse_reused_agent_tool_calls(
    response: str,
    expires_schema: dict[str, Any] = AGENT_EXPIRES_IN_TURNS_SCHEMA,
    response_json_repair: bool = False,
) -> list[AgentToolCall | None]:
    try:
        value = parse_json_response(response, response_json_repair)
    except (ValueError, TypeError) as exc:
        raise ValueError(
            "reused agent response must contain a JSON tool call"
        ) from exc
    if isinstance(value, dict) and "tool_calls" in value:
        if set(value) != {"tool_calls"}:
            raise ValueError(
                "reused agent response tool_calls must be the only field"
            )
        tool_call_values = value["tool_calls"]
        if not isinstance(tool_call_values, list) or not tool_call_values:
            raise ValueError(
                "reused agent response tool_calls must be a non-empty array"
            )
    else:
        tool_call_values = [value]
    # Keep ignored calls in place so saved tool outputs remain aligned.
    return [
        parse_reused_agent_tool_call_value(tool_call_value, expires_schema)
        for tool_call_value in tool_call_values
    ]


def parse_reused_agent_tool_outputs(
    output: str,
    tool_call_count: int,
) -> list[str]:
    if tool_call_count < 1:
        raise ValueError("reused agent tool call count must be positive")
    if tool_call_count == 1:
        return [output]
    if not output:
        return [""] * tool_call_count
    try:
        value = json.loads(output)
    except json.JSONDecodeError as exc:
        raise ValueError(
            "reused agent tool outputs must contain a JSON object"
        ) from exc
    if not isinstance(value, dict) or set(value) != {"tool_outputs"}:
        raise ValueError(
            "reused agent tool outputs must contain only tool_outputs"
        )
    tool_outputs = value["tool_outputs"]
    if (
        not isinstance(tool_outputs, list)
        or len(tool_outputs) != tool_call_count
        or any(not isinstance(tool_output, str) for tool_output in tool_outputs)
    ):
        raise ValueError(
            "reused agent tool outputs must match the tool call count"
        )
    return tool_outputs


def parse_reused_agent_meta_task_list(
    output: str,
    task_list: list[dict[str, Any]] | None = None,
    operations: list[dict[str, Any]] | None = None,
) -> list[dict[str, Any]]:
    try:
        value = json.loads(output)
    except json.JSONDecodeError:
        # Legacy tool outputs contain the complete formatted task list.
        # Replay is safe only when it reproduces that saved snapshot.
        if task_list is not None and operations is not None:
            try:
                updated_tasks = apply_agent_meta_task_operations(
                    task_list, operations
                )
            except ValueError:
                pass
            else:
                if format_agent_meta_task_list(updated_tasks) == output:
                    return updated_tasks
        if output == "No tasks.":
            return []
        tasks: list[dict[str, Any]] = []
        for line in output.split("\n"):
            match = re.fullmatch(
                r"([1-9][0-9]*)\. \[("
                + "|".join(META_TASK_STATUS_SCHEMA["enum"])
                + r")\] (.*)",
                line,
            )
            if match is not None and int(match.group(1)) == len(tasks) + 1:
                tasks.append({
                    "task": match.group(3),
                    "status": match.group(2),
                })
            elif tasks:
                tasks[-1]["task"] += "\n" + line
            else:
                raise ValueError(
                    "saved meta_task_list output must contain a task list"
                )
        task_list = normalize_agent_meta_task_list(tasks)
        if format_agent_meta_task_list(task_list) != output:
            raise ValueError(
                "saved meta_task_list output has an invalid task list"
            )
        return limit_agent_meta_task_list(task_list)
    return limit_agent_meta_task_list(
        normalize_agent_meta_task_list(value)
    )


def build_agent_turn_metadata(
    turns: list[AgentTurn],
    file_expires_in_turns: dict[str, int],
    pinned_paths: set[str],
    pinned_turn_numbers: set[int],
    active_task: str,
    active_context: str,
    meta_task_list: list[dict[str, Any]],
) -> dict[str, Any]:
    entries: list[dict[str, Any]] = []
    for number, turn in enumerate(turns):
        if turn.purge_in_turns is not None and turn.purge_in_turns <= 0:
            continue
        readfile_contexts: dict[str, int | None] | None = None
        if turn.readfile_contexts is not None:
            readfile_contexts = {}
            for path, section in turn.readfile_contexts:
                attributes = agent_file_context_attributes(section) or {}
                expiry = attributes.get("expires_in_turns")
                readfile_contexts[path] = (
                    coerce_int(expiry, turn.expires_in_turns)
                    if expiry is not None
                    else None
                )
        entries.append({
            "number": number,
            "state_turn": turn.state_turn,
            "tool_call_index": turn.tool_call_index,
            "context": turn.context,
            "turn_unix_time": turn.turn_unix_time,
            "expires_in_turns": turn.expires_in_turns,
            "purge_in_turns": turn.purge_in_turns,
            "removal_reason": turn.removal_reason,
            "readfile_contexts": readfile_contexts,
        })
    return {
        "turn_number_base": 0,
        "turn_range": (
            [entries[0]["number"], entries[-1]["number"]]
            if entries
            else []
        ),
        "turn_count": len(turns),
        "turns": entries,
        "file_expires_in_turns": file_expires_in_turns.copy(),
        "pinned_file_paths": sorted(pinned_paths),
        "pinned_turn_numbers": sorted(pinned_turn_numbers),
        "active_task": active_task,
        "active_context": active_context,
        "meta_task_list": [task.copy() for task in meta_task_list],
    }


def load_reused_agent_turn_metadata(
    state_session_dir: Path,
    selected_turn_dir: Path,
    expires_schema: dict[str, Any],
    response_json_repair: bool,
) -> ReusedAgentHistory | None:
    artifact_text: str | None = None
    for artifact_name in (
        "response_agent_turn_metadata",
        "request_agent_turn_metadata",
    ):
        artifact_path = selected_turn_dir / artifact_name
        artifact_text = read_optional_state_artifact(artifact_path)
        if artifact_text is not None:
            break
    if artifact_text is None:
        return None
    invalid_metadata = f"invalid saved agent turn metadata: {artifact_path}"
    try:
        metadata = json.loads(artifact_text)
    except json.JSONDecodeError as exc:
        raise ValueError(invalid_metadata) from exc

    def is_integer(value: Any, minimum: int = 0) -> bool:
        return (
            isinstance(value, int)
            and not isinstance(value, bool)
            and value >= minimum
        )

    if isinstance(metadata, dict):
        metadata.pop("meta_notepad", None)
    expected_fields = {
        "turn_range", "turn_count", "turns", "file_expires_in_turns",
        "pinned_file_paths", "pinned_turn_numbers", "active_task",
        "active_context", "meta_task_list",
    }
    if not isinstance(metadata, dict) or not (
        expected_fields <= set(metadata)
        <= expected_fields | {"turn_number_base"}
    ):
        raise ValueError(invalid_metadata)
    turn_number_base = saved_agent_turn_number_base(metadata)
    if (
        not is_integer(metadata["turn_count"])
        or not isinstance(metadata["turns"], list)
        or not isinstance(metadata["active_task"], str)
        or not isinstance(metadata["active_context"], str)
    ):
        raise ValueError(invalid_metadata)
    file_expirations = metadata["file_expires_in_turns"]
    if not isinstance(file_expirations, dict) or any(
        not isinstance(path, str) or not path or not is_integer(expiry)
        for path, expiry in file_expirations.items()
    ):
        raise ValueError(invalid_metadata)
    pinned_paths = metadata["pinned_file_paths"]
    if not isinstance(pinned_paths, list) or any(
        not isinstance(path, str) or not path
        for path in pinned_paths
    ):
        raise ValueError(invalid_metadata)
    selected_turn = int(selected_turn_dir.name)
    entry_fields = {
        "number", "state_turn", "tool_call_index", "context",
        "turn_unix_time", "expires_in_turns", "purge_in_turns",
        "removal_reason", "readfile_contexts",
    }
    numbers: list[int] = []
    for entry in metadata["turns"]:
        if not isinstance(entry, dict) or set(entry) != entry_fields:
            raise ValueError(invalid_metadata)
        if (
            not is_integer(entry["number"], turn_number_base)
            or entry["number"] >= metadata["turn_count"] + turn_number_base
            or not is_integer(entry["state_turn"])
            or entry["state_turn"] > selected_turn
            or not is_integer(entry["tool_call_index"])
            or not is_integer(entry["expires_in_turns"])
            or entry["purge_in_turns"] is not None
            and not is_integer(entry["purge_in_turns"], 1)
            or entry["turn_unix_time"] is not None
            and not is_integer(entry["turn_unix_time"])
            or not isinstance(entry["context"], str)
            or not isinstance(entry["removal_reason"], str)
        ):
            raise ValueError(invalid_metadata)
        contexts = entry["readfile_contexts"]
        if contexts is not None and (
            not isinstance(contexts, dict)
            or any(
                not isinstance(path, str) or not path
                or expiry is not None and not is_integer(expiry)
                for path, expiry in contexts.items()
            )
        ):
            raise ValueError(invalid_metadata)
        numbers.append(entry["number"])
    if numbers != sorted(set(numbers)):
        raise ValueError(invalid_metadata)
    turn_range = metadata["turn_range"]
    if (
        not isinstance(turn_range, list)
        or any(not is_integer(number, turn_number_base) for number in turn_range)
        or turn_range != ([numbers[0], numbers[-1]] if numbers else [])
    ):
        raise ValueError(invalid_metadata)
    pinned_numbers = metadata["pinned_turn_numbers"]
    if not isinstance(pinned_numbers, list) or any(
        not is_integer(number, turn_number_base) or number not in numbers
        for number in pinned_numbers
    ):
        raise ValueError(invalid_metadata)
    for entry in metadata["turns"]:
        entry["number"] -= turn_number_base
    metadata["turn_range"] = [
        number - turn_number_base for number in metadata["turn_range"]
    ]
    metadata["pinned_turn_numbers"] = [
        number - turn_number_base
        for number in metadata["pinned_turn_numbers"]
    ]
    metadata["turn_number_base"] = 0
    task_list = limit_agent_meta_task_list(
        normalize_agent_meta_task_list(metadata["meta_task_list"])
    )
    removed_turn = AgentTurn(
        task="",
        context="",
        tool_call=AgentToolCall(tool=AGENT_AGENT_TOOL),
        output="",
        purge_in_turns=0,
    )
    turns = [removed_turn] * metadata["turn_count"]
    sources: dict[
        int, tuple[str, list[AgentToolCall | None], list[str]]
    ] = {}
    for entry in metadata["turns"]:
        source_turn = entry["state_turn"]
        source_dir = last_completed_state_turn(state_session_dir, source_turn)
        if source_turn not in sources:
            tool_calls = parse_reused_agent_tool_calls(
                read_state_artifact(source_dir / "response"),
                expires_schema,
                response_json_repair,
            )
            tool_outputs = parse_reused_agent_tool_outputs(
                read_optional_state_artifact(
                    source_dir / "response_agent_tool_output"
                ) or "",
                len(tool_calls),
            )
            sources[source_turn] = (
                read_state_artifact(source_dir / "request_task"),
                tool_calls,
                tool_outputs,
            )
        task, tool_calls, tool_outputs = sources[source_turn]
        call_index = entry["tool_call_index"]
        if call_index >= len(tool_calls):
            raise ValueError(invalid_metadata)
        tool_call = tool_calls[call_index]
        if tool_call is None:
            metadata["pinned_turn_numbers"] = [
                number for number in metadata["pinned_turn_numbers"]
                if number != entry["number"]
            ]
            continue
        contexts = entry["readfile_contexts"]
        readfile_contexts: tuple[tuple[str, str], ...] | None = None
        if contexts is not None:
            restored_contexts: list[tuple[str, str]] = []
            if contexts:
                context_index = call_index
                if (
                    call_index + 1 < len(tool_calls)
                    and tool_calls[call_index + 1] is not None
                    and is_agent_patch_readfile_companion(
                        tool_call, tool_calls[call_index + 1]
                    )
                ):
                    context_index += 1
                source_contexts = dict(load_reused_agent_readfile_contexts(
                    source_dir, tool_outputs[context_index]
                ) or ())
                for path, expiry in contexts.items():
                    if path not in source_contexts:
                        raise ValueError(invalid_metadata)
                    section = source_contexts[path]
                    if expiry is not None:
                        section = agent_file_context_section(
                            section, expiry, entry["number"]
                        )
                    restored_contexts.append((path, section))
            readfile_contexts = tuple(restored_contexts)
        turns[entry["number"]] = AgentTurn(
            task=task,
            context=entry["context"],
            tool_call=tool_call,
            output=tool_outputs[call_index],
            turn_unix_time=entry["turn_unix_time"],
            expires_in_turns=entry["expires_in_turns"],
            purge_in_turns=entry["purge_in_turns"],
            removal_reason=entry["removal_reason"],
            readfile_contexts=readfile_contexts,
            state_turn=source_turn,
            tool_call_index=call_index,
        )
    return ReusedAgentHistory(
        turns=tuple(turns),
        active_task=metadata["active_task"],
        active_context=metadata["active_context"],
        meta_task_list=tuple(task_list),
        context_summary=load_state_agent_context_summary(
            selected_turn_dir, expires_schema["default"]
        ),
        turn_metadata=metadata,
    )


def load_reused_session_agent_history(
    state_session_dir: Path,
    turn: int | None = None,
    expires_schema: dict[str, Any] = AGENT_EXPIRES_IN_TURNS_SCHEMA,
    response_json_repair: bool = False,
) -> ReusedAgentHistory:
    selected_turn_dir = last_completed_state_turn(
        state_session_dir, turn
    )
    reused_history = load_reused_agent_turn_metadata(
        state_session_dir,
        selected_turn_dir,
        expires_schema,
        response_json_repair,
    )
    if reused_history is not None:
        return reused_history
    selected_turn = int(selected_turn_dir.name)
    turn_directories = completed_state_turn_directories(
        state_session_dir,
        selected_turn,
    )
    turns: list[AgentTurn] = []
    active_task = ""
    active_context = ""
    task_list: list[dict[str, Any]] = []
    context_summary: AgentContextSummary | None = None
    has_summary_turn = False

    for turn_number, turn_dir in turn_directories:
        saved_task_list_text = read_optional_state_artifact(
            turn_dir / "response_agent_meta_task_list"
        )
        if saved_task_list_text is not None:
            try:
                task_list = parse_reused_agent_meta_task_list(
                    saved_task_list_text
                )
            except ValueError as exc:
                raise ValueError(
                    f"invalid saved meta_task_list snapshot: {turn_dir} ({exc})"
                ) from exc
        response_path = turn_dir / "response"
        response = read_state_artifact(response_path)
        turn_unix_time = state_artifact_last_modified_time(response_path)
        saved_summary = load_state_agent_context_summary(
            turn_dir, expires_schema["default"]
        )
        try:
            tool_calls = parse_reused_agent_tool_calls(
                response,
                expires_schema,
                response_json_repair,
            )
        except ValueError as exc:
            # Controller-managed summaries have Markdown responses, not tool calls.
            if (
                saved_summary is not None
                and saved_summary.content
                and response.strip() == saved_summary.content
                and (turn_dir / "response_agent_context_summary").is_file()
            ):
                context_summary = saved_summary
                active_task = read_state_artifact(turn_dir / "request_task")
                if (
                    agent_context_checksum(active_context)
                    == saved_summary.active_context_checksum
                ):
                    active_context = ""
                has_summary_turn = True
                continue
            if turn_number == selected_turn:
                raise ValueError(
                    "selected session turn is not an agent controller turn: "
                    f"{turn_dir} ({exc})"
                ) from exc
            continue
        if not any(tool_call is not None for tool_call in tool_calls):
            continue
        task = read_state_artifact(turn_dir / "request_task")
        output = read_optional_state_artifact(
            turn_dir / "response_agent_tool_output"
        ) or ""
        try:
            tool_outputs = parse_reused_agent_tool_outputs(
                output,
                len(tool_calls),
            )
        except ValueError as exc:
            if turn_number == selected_turn:
                raise ValueError(
                    "selected session turn has invalid agent tool output: "
                    f"{turn_dir} ({exc})"
                ) from exc
            continue
        if saved_summary is not None:
            context_summary = saved_summary
            if (
                agent_context_checksum(active_context)
                == saved_summary.active_context_checksum
            ):
                active_context = ""
        active_task = task
        for tool_call_index, (tool_call, tool_output) in enumerate(
            zip(tool_calls, tool_outputs)
        ):
            if tool_call is None:
                continue
            tool_context = "\n\n".join(
                value for value in (active_context, tool_call.context) if value
            )
            patch_readfile_companion = (
                tool_call_index > 0
                and is_agent_patch_readfile_companion(
                    tool_calls[tool_call_index - 1],
                    tool_call,
                )
            )
            readfile_contexts = (
                load_reused_agent_readfile_contexts(
                    turn_dir,
                    tool_output,
                )
                if tool_call.tool == AGENT_READFILE_TOOL
                else None
            )
            record_agent_tool_history(
                turns,
                task,
                tool_context,
                tool_call,
                tool_output,
                turn_unix_time=turn_unix_time,
                state_turn=turn_number,
                tool_call_index=tool_call_index,
                readfile_contexts=readfile_contexts,
                preceding_patch_tool_call=(
                    tool_calls[tool_call_index - 1]
                    if patch_readfile_companion
                    else None
                ),
            )
            if patch_readfile_companion:
                continue
            if (
                tool_call.tool == AGENT_META_TASK_LIST_TOOL
                and saved_task_list_text is None
                and tool_output
                and not tool_output.startswith("ERROR:")
                and isinstance(tool_call.arguments, dict)
            ):
                try:
                    task_list = parse_reused_agent_meta_task_list(
                        tool_output,
                        task_list,
                        tool_call.arguments.get("operations"),
                    )
                except ValueError as exc:
                    raise ValueError(
                        f"invalid saved meta_task_list output: {turn_dir} ({exc})"
                    ) from exc
            if (
                tool_call.tool == AGENT_AGENT_TOOL
                and not tool_call.profile_name
            ):
                active_task = tool_call.task
                active_context = tool_call.context
                if context_summary is not None:
                    context_summary.active_context_checksum = ""

    if not turns and not has_summary_turn:
        raise ValueError(
            "selected session turn is not an agent controller turn: "
            f"{selected_turn_dir}"
        )
    return ReusedAgentHistory(
        turns=tuple(turns),
        active_task=active_task,
        active_context=active_context,
        meta_task_list=tuple(task_list),
        context_summary=context_summary,
    )

def reused_agent_context_pins(
    file_contexts: list[tuple[str, str]],
    turns: list[AgentTurn],
    file_expires_in_turns: dict[str, int] | None = None,
    initial_pinned_paths: set[str] | None = None,
    turn_number_base: int = 0,
) -> tuple[set[str], set[int]]:
    if file_expires_in_turns is None:
        file_expires_in_turns = agent_file_context_expirations(
            file_contexts
        )
    pinned_paths = set(initial_pinned_paths or ())
    pinned_turn_numbers: set[int] = set()
    replayed_turns: list[AgentTurn] = []
    for turn in turns:
        advance_agent_history_purges(
            replayed_turns,
            pinned_turn_numbers,
        )
        advance_agent_file_context_expirations(
            file_contexts,
            file_expires_in_turns,
            pinned_paths,
        )
        if (
            turn.tool_call.tool == AGENT_META_CONTEXT_CONTROL_TOOL
            and turn.tool_call.action != "summary"
            and turn.output
            and not turn.output.startswith("ERROR:")
        ):
            try:
                apply_agent_context_control(
                    turn.tool_call,
                    file_contexts,
                    replayed_turns,
                    file_expires_in_turns,
                    pinned_paths,
                    pinned_turn_numbers,
                    turn_number_base=turn_number_base,
                )
            except ValueError:
                pass
        replayed_turns.append(turn)
    turns[:] = replayed_turns
    return pinned_paths, pinned_turn_numbers


def agent_context_checksum(context: str) -> str:
    return hashlib.sha256(context.encode("utf-8")).hexdigest() if context else ""


def format_agent_context_summary(
    summary: AgentContextSummary | None,
    model: str = "",
) -> str:
    if summary is None or not summary.content:
        return ""
    return format_context_entry(
        "agent_context_summary",
        f"{summary.content}\n",
        model=model,
        attributes=f" expires_in_turns='{summary.expires_in_turns}'",
    )


def apply_agent_context_summary(
    summary: AgentContextSummary,
    file_contexts: list[tuple[str, str]],
    turns: list[AgentTurn],
    file_expires_in_turns: dict[str, int],
    pinned_paths: set[str],
    pinned_turn_numbers: set[int],
) -> None:
    removed_paths = set(summary.removed_file_paths)
    file_contexts[:] = [
        context for context in file_contexts
        if context[0] not in removed_paths
    ]
    for path in removed_paths:
        file_expires_in_turns.pop(path, None)
    pinned_paths.difference_update(removed_paths)
    for turn_number in summary.removed_turn_numbers:
        if not 0 <= turn_number < len(turns):
            raise ValueError(f"summarized agent turn does not exist: turn:{turn_number}")
        turn_index = turn_number
        # Keep tombstones so context-control turn IDs remain stable.
        turns[turn_index] = replace(
            turns[turn_index],
            task="",
            context="",
            output="",
            readfile_contexts=(),
            purge_in_turns=0,
            removal_reason="This agent turn was removed by context management.",
        )
    pinned_turn_numbers.difference_update(summary.removed_turn_numbers)


def agent_context_removal_candidates(
    file_contexts: list[tuple[str, str]],
    turns: list[AgentTurn],
    file_expires_in_turns: dict[str, int],
    pinned_paths: set[str],
    pinned_turn_numbers: set[int],
    active_context: str,
) -> Iterator[tuple[str, int]]:
    candidates = [
        (
            number in pinned_turn_numbers, 0,
            turns[number].expires_in_turns, number, "turn", number,
        )
        for number in agent_history_turn_numbers(turns)
    ] + [
        (
            path in pinned_paths, 1,
            file_expires_in_turns[path], index, "file", index,
        )
        for index, (path, _) in enumerate(file_contexts)
    ]
    if active_context:
        candidates.append((True, 2, 0, 0, "active", 0))
    for _, _, _, _, kind, index in sorted(candidates):
        yield kind, index


def update_agent_context_summary(
    summary: AgentContextSummary,
    content: str,
    active_context: str,
    file_contexts: list[tuple[str, str]],
    turns: list[AgentTurn],
    file_expires_in_turns: dict[str, int],
    pinned_paths: set[str],
    pinned_turn_numbers: set[int],
    *,
    model: str,
    token_limit: int,
    expires_in_turns: int = AGENT_EXPIRES_IN_TURNS_DEFAULT,
    compact_context: bool = True,
) -> str:
    summary.content = normalize_agent_context_summary(content)
    summary.expires_in_turns = expires_in_turns
    if not compact_context:
        return active_context
    if agent_context_checksum(active_context) == summary.active_context_checksum:
        active_context = ""
    remaining_tokens = int(
        token_limit * AGENT_CONTEXT_COMPACTION_TOKEN_FRACTION
    )
    encoding = token_encoding_for_model(model)
    removed_file_paths = set(summary.removed_file_paths)
    removed_turn_numbers = set(summary.removed_turn_numbers)
    for kind, index in agent_context_removal_candidates(
        file_contexts,
        turns,
        file_expires_in_turns,
        pinned_paths,
        pinned_turn_numbers,
        active_context,
    ):
        if remaining_tokens <= 0:
            break
        if kind == "turn":
            turn = turns[index]
            context = "\n".join(
                value for value in (
                    format_agent_history(
                        [turn], [index], pinned_turn_numbers, model=model
                    ),
                    format_agent_readfile_contexts(
                        [turn], [index], {index}, model=model
                    ),
                ) if value
            )
            removed_turn_numbers.add(index)
        elif kind == "file":
            path, section = file_contexts[index]
            context = agent_file_context_section(
                section, file_expires_in_turns[path], model=model
            )
            removed_file_paths.add(path)
        else:
            context = format_context_entry(
                "agent_context", f"{active_context}\n", model=model
            )
            summary.active_context_checksum = agent_context_checksum(active_context)
            active_context = ""
        remaining_tokens -= len(encoding.encode(context))
    summary.removed_file_paths = tuple(sorted(removed_file_paths))
    summary.removed_turn_numbers = tuple(sorted(removed_turn_numbers))
    apply_agent_context_summary(
        summary,
        file_contexts,
        turns,
        file_expires_in_turns,
        pinned_paths,
        pinned_turn_numbers,
    )
    return active_context


AGENT_PRIOR_TOKEN_ESTIMATES_MAX_TURNS = 18


def format_agent_token_estimate_context(
    current_token_estimate: int,
    token_limit: int,
    prior_token_estimates: list[tuple[int, int]] | None = None,
    current_turn: int | None = None,
) -> str:
    token_estimates = (prior_token_estimates or [])[
        -AGENT_PRIOR_TOKEN_ESTIMATES_MAX_TURNS:
    ]
    prior_lines = "\n".join(
        f"{turn} {token_estimate}"
        for turn, token_estimate in sorted(token_estimates, reverse=True)
    )
    if current_turn is None:
        current_turn = token_estimates[-1][0] + 1 if token_estimates else 0
    return (
        f"<current_token_estimate token_estimate='{current_token_estimate}' "
        f"token_limit='{token_limit}' turn='{current_turn}'/>\n"
        "<prior_token_estimates>\n"
        f"{prior_lines}\n"
        "</prior_token_estimates>"
    )


def build_agent_context_window_prompt(
    *,
    model: str,
    token_limit: int,
    system_prompt: str,
    task: str,
    file_contexts: list[tuple[str, str]],
    turns: list[AgentTurn],
    active_context: str,
    pinned_paths: set[str],
    pinned_turn_numbers: set[int],
    file_expires_in_turns: dict[str, int] | None = None,
    revision_instruction: str = "",
    controller_tools: list[dict[str, Any]] | None = None,
    hook_contents: tuple[str, ...] = (),
    meta_task_list: list[dict[str, Any]] | None = None,
    prior_token_estimates: list[tuple[int, int]] | None = None,
    include_task: bool = True,
    context_summary: AgentContextSummary | None = None,
    advance_expirations: bool = True,
    refresh_summary: bool = False,
    current_turn: int | None = None,
) -> tuple[str, int | None, bool]:
    if file_expires_in_turns is None:
        file_expires_in_turns = agent_file_context_expirations(
            file_contexts
        )
    if context_summary is None:
        context_summary = AgentContextSummary()
    if advance_expirations:
        advance_agent_history_purges(turns, pinned_turn_numbers)
        advance_agent_file_context_expirations(
            file_contexts,
            file_expires_in_turns,
            pinned_paths,
        )
    visible_turn_numbers = set(agent_history_turn_numbers(turns))
    turn_numbers = list(range(len(turns)))
    visible_file_indexes = set(range(len(file_contexts)))
    active_context_checksum = agent_context_checksum(active_context)
    visible_active_context = (
        ""
        if active_context_checksum == context_summary.active_context_checksum
        else active_context
    )
    visible_summary = context_summary
    summary_token_budget: int | None = None
    current_unix_time = int(time.time())

    def build_visible_prompt(
        current_token_estimate: int,
    ) -> tuple[str, int]:
        visible_context = build_agent_files_context(
            file_contexts,
            file_expires_in_turns,
            visible_file_indexes,
            turns,
            turn_numbers,
            visible_turn_numbers,
            model=model,
        )
        user_prompt = build_agent_followup_prompt(
            task=task,
            context=visible_context,
            turns=turns,
            turn_numbers=turn_numbers,
            visible_turn_numbers=visible_turn_numbers,
            pinned_turn_numbers=pinned_turn_numbers,
            active_context=visible_active_context,
            context_summary=visible_summary,
            revision_instruction=revision_instruction,
            controller_tools=controller_tools,
            hook_contents=hook_contents,
            meta_task_list=meta_task_list,
            current_token_estimate=current_token_estimate,
            token_limit=token_limit,
            prior_token_estimates=prior_token_estimates,
            include_task=include_task,
            current_unix_time=current_unix_time,
            current_turn=current_turn,
            model=model,
        )
        return (
            user_prompt,
            estimate_request_tokens(
                model=model,
                system_prompt=system_prompt,
                user_prompt=user_prompt,
                tools=(
                    AGENT_TOOL_SCHEMAS
                    if controller_tools is None
                    else controller_tools
                ),
            ),
        )

    def build_visible_prompt_with_token_estimate() -> tuple[str, int]:
        current_token_estimate = 0
        for _ in range(8):
            user_prompt, request_tokens = build_visible_prompt(
                current_token_estimate
            )
            if request_tokens == current_token_estimate:
                return user_prompt, request_tokens
            current_token_estimate = request_tokens
        raise ValueError(
            "Unable to calculate a stable agent input token estimate"
        )

    candidates = agent_context_removal_candidates(
        file_contexts,
        turns,
        file_expires_in_turns,
        pinned_paths,
        pinned_turn_numbers,
        visible_active_context,
    )
    removed_turn_numbers: set[int] = set()
    removed_file_paths: set[str] = set()
    removed_active_context = False

    def fit_visible_prompt() -> tuple[str, int]:
        nonlocal visible_active_context, removed_active_context
        while True:
            user_prompt, request_tokens = build_visible_prompt_with_token_estimate()
            if request_tokens < token_limit:
                return user_prompt, request_tokens
            try:
                kind, index = next(candidates)
            except StopIteration:
                raise ValueError(
                    f"Estimated agent input token count ({request_tokens}) cannot "
                    f"be reduced below token limit ({token_limit}); reduce the task "
                    "or persistent context, or increase the token limit"
                ) from None
            if kind == "turn":
                visible_turn_numbers.remove(index)
                removed_turn_numbers.add(index)
            elif kind == "file":
                visible_file_indexes.remove(index)
                removed_file_paths.add(file_contexts[index][0])
            else:
                visible_active_context = ""
                removed_active_context = True

    user_prompt, request_tokens = fit_visible_prompt()
    has_context_to_summarize = bool(
        visible_file_indexes
        or visible_active_context
        or any(
            not turns[number].tool_call.tool.startswith("meta_")
            for number in visible_turn_numbers
        )
    )
    compact_context = (
        token_limit - request_tokens <= AGENT_CONTEXT_SUMMARY_TOKEN_RESERVE
        and has_context_to_summarize
    )
    if compact_context or refresh_summary:
        saved_visibility = (
            visible_turn_numbers, visible_file_indexes,
            visible_active_context, visible_summary,
        )
        visible_summary = None
        _, minimum_request_tokens = build_visible_prompt_with_token_estimate()
        if compact_context:
            visible_turn_numbers = set()
            visible_file_indexes = set()
            visible_active_context = ""
            _, empty_request_tokens = build_visible_prompt_with_token_estimate()
            minimum_request_tokens = max(
                empty_request_tokens,
                minimum_request_tokens - int(
                    token_limit * AGENT_CONTEXT_COMPACTION_TOKEN_FRACTION
                ),
            )
        (
            visible_turn_numbers, visible_file_indexes,
            visible_active_context, visible_summary,
        ) = saved_visibility
        summary_token_budget = min(
            AGENT_CONTEXT_SUMMARY_MAX_TOKENS,
            (token_limit - minimum_request_tokens) // 2,
        )
        if summary_token_budget < 1024:
            raise ValueError(
                "Token limit is too small for an agent context summary turn"
            )
    if removed_file_paths or removed_turn_numbers or removed_active_context:
        context_summary.removed_file_paths = tuple(sorted(
            set(context_summary.removed_file_paths).union(removed_file_paths)
        ))
        context_summary.removed_turn_numbers = tuple(sorted(
            set(context_summary.removed_turn_numbers).union(removed_turn_numbers)
        ))
        if removed_active_context:
            context_summary.active_context_checksum = active_context_checksum
        apply_agent_context_summary(
            context_summary,
            file_contexts,
            turns,
            file_expires_in_turns,
            pinned_paths,
            pinned_turn_numbers,
        )
    return user_prompt, summary_token_budget, compact_context

def format_agent_tool_schema_context(
    controller_tools: list[dict[str, Any]] | None = None,
 ) -> str:
    schemas = (
        AGENT_TOOL_SCHEMAS
        if controller_tools is None
        else controller_tools
    )
    return (
        "<agent_tool_json_schemas>\n"
        f"{json.dumps(schemas, indent=2, ensure_ascii=False)}\n"
        "</agent_tool_json_schemas>"
    )


def build_agent_followup_prompt(
    task: str,
    context: str,
    turns: list[AgentTurn],
    active_context: str,
    revision_instruction: str = "",
    turn_numbers: list[int] | None = None,
    visible_turn_numbers: set[int] | None = None,
    pinned_turn_numbers: set[int] | None = None,
    controller_tools: list[dict[str, Any]] | None = None,
    hook_contents: tuple[str, ...] = (),
    meta_task_list: list[dict[str, Any]] | None = None,
    current_token_estimate: int | None = None,
    token_limit: int | None = None,
    prior_token_estimates: list[tuple[int, int]] | None = None,
    include_task: bool = True,
    current_unix_time: int | None = None,
    context_summary: AgentContextSummary | None = None,
    current_turn: int | None = None,
    model: str = "",
) -> str:
    if current_unix_time is None:
        current_unix_time = int(time.time())
    schemas, schema_instructions = split_schema_instructions(
        AGENT_TOOL_SCHEMAS if controller_tools is None else controller_tools,
        "agent_tool_json_schemas",
    )
    instruction_parts = [
        *schema_instructions,
        "The `<meta_task_list>` uses `TASK_NUMBER. [TASK_STATUS] TASK` "
        "for each task, or `No tasks.` when empty.",
        format_context_entry(
            "meta_task_list",
            f"{format_agent_meta_task_list(meta_task_list)}\n",
            model=model,
        ),
    ]
    additional_parts: list[str] = [
        format_agent_tool_schema_context(schemas),
    ]
    if current_token_estimate is not None and token_limit is not None:
        instruction_parts.append(
            "Each line in `<prior_token_estimates>` has the format "
            "`TURN TOKENS`; entries are ordered newest to oldest."
        )
        additional_parts.append(
            format_agent_token_estimate_context(
                current_token_estimate,
                token_limit,
                prior_token_estimates,
                current_turn=current_turn,
            )
        )

    for hook_content in hook_contents:
        additional_parts.append(
            format_context_entry(
                "hook_context", hook_content, model=model
            )
        )

    summary_context = format_agent_context_summary(context_summary, model=model)
    if summary_context:
        instruction_parts.append(summary_context)

    if active_context:
        additional_parts.append(
            format_context_entry(
                "agent_context", f"{active_context}\n", model=model
            )
        )
    history = format_agent_history(
        turns,
        turn_numbers,
        pinned_turn_numbers,
        visible_turn_numbers,
        model=model,
    )

    if history:
        additional_parts.append(
            "<agent_history>\n"
            f"{history}\n</agent_history>"
        )
    if revision_instruction:
        instruction_parts.append(
            "Replace the previous tool call with one that follows this user "
            "revision:\n"
            f"{revision_instruction}"
        )

    return build_user_prompt(
        task=task,
        context=context,
        response_format="text",
        additional_prompt="\n\n".join(additional_parts),
        additional_instructions="\n\n".join(instruction_parts),
        include_task=include_task,
        current_unix_time=current_unix_time,
    )


def run_agent_hook_context_scripts(
    scripts: tuple[str, ...],
) -> tuple[str, ...]:
    hook_contents: list[str] = []
    for script in scripts:
        try:
            completed = subprocess.run(
                [script],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                check=False,
            )
        except Exception:
            continue
        if completed.returncode == 0:
            hook_contents.append(completed.stdout)
    return tuple(hook_contents)



