                f.write(f"<system_prompt>\n{plan_full_system_prompt}\n</system_prompt>\n")
                f.write(f"<user_prompt>\n{plan_user_prompt}\n</user_prompt>\n")
                f.write("</plan_request>\n")
        if VERBOSE:
            print(f"request_characters={plan_request_characters} request_tokens_estimate={plan_request_tokens}{plan_request_cost_log} model={model} reasoning={openai_reasoning}", file=sys.stderr)
        plan_start_time = time.perf_counter()
        plan_response_obj: Any = None
