def append_suffix_to_path(original_path: Path, suffix: str) -> Path:
    return original_path.with_name(original_path.name + suffix)

def git_repository_root(cwd: Path | None = None) -> Path | None:
    working_directory = cwd or Path.cwd()
    try:
        completed = subprocess.run(
            ['git', 'rev-parse', '--show-toplevel'],
            cwd=working_directory,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except FileNotFoundError as exc:
        raise ValueError('git executable was not found') from exc
    if completed.returncode != 0:
        return None
    output = completed.stdout.strip()
    return Path(output).resolve() if output else None

def run_git_command(
    repo_root: Path,
    arguments: list[str],
    input_text: str | None = None,
    check: bool = True,
 ) -> Any:
    try:
        completed = subprocess.run(
            ['git', *arguments],
            cwd=repo_root,
            input=input_text,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except FileNotFoundError as exc:
        raise ValueError('git executable was not found') from exc
    if check and completed.returncode != 0:
        detail = (completed.stderr or completed.stdout).strip()
        if not detail:
            detail = f'exit status {completed.returncode}'
        command = 'git ' + ' '.join(arguments)
        raise ValueError(f'{command} failed: {detail}')
    return completed

def validate_git_branch_name(repo_root: Path, branch_name: str) -> str:
    branch_name = branch_name.strip()
    if not branch_name:
        raise ValueError('git branch name cannot be empty')
    if branch_name in ('.', '..', 'HEAD') or branch_name.startswith('-'):
        raise ValueError(f'invalid git branch name: {branch_name}')
    check = run_git_command(
        repo_root,
        ['check-ref-format', f'refs/heads/{branch_name}'],
        check=False,
    )
    if check.returncode != 0:
        detail = (check.stderr or check.stdout).strip()
        raise ValueError(
            f'invalid git branch name {branch_name!r}'
            + (f': {detail}' if detail else '')
        )
    return branch_name

PATCH_BRANCH_DEFAULT_NAME = 'mcebranch'

def resolve_patch_branch_name(branch_argument: str | None) -> str:
    branch_name = str(branch_argument or '').strip()
    return branch_name or PATCH_BRANCH_DEFAULT_NAME

def git_worktree_is_clean(repo_root: Path) -> None:
    status = run_git_command(
        repo_root,
        ['status', '--porcelain=v1', '--untracked-files=no'],
    ).stdout.strip()
    if status:
        raise ValueError(
            'git worktree must be clean before using a patch branch; '
            'commit or stash existing changes first'
        )

def git_branch_exists(repo_root: Path, branch_name: str) -> bool:
    result = run_git_command(
        repo_root,
        ['show-ref', '--verify', '--quiet', f'refs/heads/{branch_name}'],
        check=False,
    )
    if result.returncode not in (0, 1):
        detail = (result.stderr or result.stdout).strip()
        raise ValueError(f'git show-ref failed: {detail}')
    return result.returncode == 0

def git_current_branch(repo_root: Path) -> str | None:
    result = run_git_command(
        repo_root,
        ['symbolic-ref', '--quiet', '--short', 'HEAD'],
        check=False,
    )
    if result.returncode != 0:
        return None
    branch_name = result.stdout.strip()
    return branch_name or None


def git_relative_path(repo_root: Path, path: Path) -> str:
    resolved_path = path.resolve()
    try:
        relative_path = resolved_path.relative_to(repo_root)
    except ValueError as exc:
        raise ValueError(
            f'patch path is outside the git repository: {path}'
        ) from exc
    if not relative_path.parts or '.git' in relative_path.parts:
        raise ValueError(f'patch path is not a worktree file: {path}')
    return relative_path.as_posix()

def prepare_patch_branch(repo_root: Path, branch_name: str) -> None:
    branch_name = validate_git_branch_name(repo_root, branch_name)
    git_worktree_is_clean(repo_root)
    if git_branch_exists(repo_root, branch_name):
        if git_current_branch(repo_root) != branch_name:
            run_git_command(repo_root, ['switch', '--', branch_name])
        return
    run_git_command(repo_root, ['switch', '--create', branch_name])

def git_commit_patch(
    repo_root: Path,
    paths: list[Path],
    commit_message: str,
 ) -> None:
    if not commit_message.strip():
        raise ValueError('patch commit message cannot be empty')
    relative_paths: list[str] = []
    for path in paths:
        relative_path = git_relative_path(repo_root, path)
        if relative_path not in relative_paths:
            relative_paths.append(relative_path)
    if not relative_paths:
        raise ValueError('patch did not contain any files to commit')
    run_git_command(repo_root, ['add', '--', *relative_paths])
    staged = run_git_command(
        repo_root,
        ['diff', '--cached', '--name-only'],
    ).stdout.strip()
    if not staged:
        raise ValueError(
            'git did not stage any patch files; the files may be ignored'
        )
    run_git_command(
        repo_root,
        ['commit', '--file=-'],
        input_text=commit_message.rstrip() + chr(10),
    )


def handle_patch_merge(branch_name: str, commit_message: str) -> int:
    try:
        repo_root = git_repository_root()
        if repo_root is None:
            raise ValueError('not inside a git worktree')
        branch_name = validate_git_branch_name(repo_root, branch_name)
        if not git_branch_exists(repo_root, branch_name):
            raise ValueError(f'git branch does not exist: {branch_name}')
        current_branch = git_current_branch(repo_root)
        if current_branch is None:
            raise ValueError('patch merge requires a checked-out branch')
        git_worktree_is_clean(repo_root)
        if current_branch == branch_name:
            run_git_command(repo_root, ['switch', '-'])
            current_branch = git_current_branch(repo_root)
            if current_branch is None:
                raise ValueError(
                    'git switch - did not leave a checked-out branch'
                )
            if current_branch == branch_name:
                raise ValueError(
                    'git switch - did not switch away from patch branch'
                )
        run_git_command(repo_root, ['merge', '--squash', branch_name])
        staged_result = run_git_command(
            repo_root,
            ['diff', '--cached', '--quiet'],
            check=False,
        )
        if staged_result.returncode == 0:
            raise ValueError(
                'squash merge produced no changes; the patch branch was not deleted'
            )
        if staged_result.returncode != 1:
            detail = (staged_result.stderr or staged_result.stdout).strip()
            raise ValueError(f'could not inspect squash merge: {detail}')
        run_git_command(
            repo_root,
            ['commit', '--file=-'],
            input_text=commit_message.rstrip() + chr(10),
        )
        run_git_command(
            repo_root,
            ['branch', '-D', '--', branch_name],
        )
    except (OSError, ValueError) as exc:
        print(f'ERROR: Failed to merge patch branch: {exc}', file=sys.stderr)
        return 1
    print(f'patch_branch_merged={branch_name}')
    return 0

def generate_unified_diff(original: str, updated: str, path: str) -> str:
    original_lines = original.splitlines(keepends=True)
    updated_lines = updated.splitlines(keepends=True)

    fromfile = path if original else "/dev/null"
    tofile = path

    diff_lines = list(
        difflib.unified_diff(
            original_lines,
            updated_lines,
            fromfile=fromfile,
            tofile=tofile,
        )
    )
    if not diff_lines:
        return ""
    return "".join(diff_lines) + "\n"

def detect_line_ending(text: str) -> str:
    return "crlf" if "\r\n" in text else "lf"


def eol_for(line_ending: str) -> str:
    return "\r\n" if line_ending == "crlf" else "\n"


PATCH_REVISION_HEADING = (
    "# Changes made below this line will be ignored; only text above this line will be used as the next task."
)


def build_patch_revision_editor_text(
    diff_text: str,
    previous_task: str = "",
) -> str:
    previous_task = previous_task.strip()
    return (
        ("\n" * 2)
        + f"{PATCH_REVISION_HEADING}\n\n"
        + (f"{previous_task}\n\n" if previous_task else "")
        + diff_text
    )


def extract_patch_revision_task(edited_text: str) -> str:
    task_text, separator, _ = edited_text.partition(PATCH_REVISION_HEADING)
    return (task_text if separator else edited_text).strip()

def normalize_line_for_write(text: str) -> str:
    if "\n" in text or "\r" in text:
        raise ValueError("content_line_array entries must be single logical lines without embedded newlines.")
    return text

def prefix_line_numbers(text: str) -> str:
    lines = text.splitlines(keepends=True)
    return "".join(f"{i} {line}" for i, line in enumerate(lines, start=1))

@dataclass(frozen=True)
class PatchRange:
    patch_id: str
    start_line: int
    end_line: int


def validate_patch_ranges(patches: list[dict[str, Any]], total_lines: int) -> list[PatchRange]:
    ranges: list[PatchRange] = []

    for patch in patches:
        patch_id = str(patch["patch_id"])
        start_line = int(patch["start_line"])
        end_line = int(patch["end_line"])

        if start_line < 1:
            raise ValueError(f"{patch_id}: start_line must be >= 1")
        if end_line < 1:
            raise ValueError(f"{patch_id}: end_line must be >= 1")
        if start_line > end_line:
            raise ValueError(f"{patch_id}: start_line cannot be greater than end_line")

        ranges.append(PatchRange(patch_id=patch_id, start_line=start_line, end_line=end_line))

    ranges_sorted = sorted(ranges, key=lambda r: (r.start_line, r.end_line, r.patch_id))
    prev = ranges_sorted[0]
    for current in ranges_sorted[1:]:
        if current.start_line <= prev.end_line:
            raise ValueError(
                f"Overlapping or nested blocks detected: "
                f"{prev.patch_id} [{prev.start_line}, {prev.end_line}] and "
                f"{current.patch_id} [{current.start_line}, {current.end_line}]"
            )
        prev = current

    return ranges

def apply_combined_patch_manifest(
    original_texts: dict[str, str],
    manifest: dict[str, Any],
) -> dict[str, str]:
    updated_texts: dict[str, str] = {}

    for file_entry in manifest.get("files", []):
        document = file_entry["document"]
        path = document["path"]
        if path not in original_texts:
            original = ""
        else:
            original = original_texts[path]

        updated = apply_file_patch_manifest(original, file_entry)
        updated_texts[path] = updated

    for path, text in original_texts.items():
        if path not in updated_texts:
            updated_texts[path] = text

    return updated_texts

def apply_file_patch_manifest(original_text: str, file_manifest: dict[str, Any]) -> str:
    if not file_manifest.get("patches"):
        return original_text

    document = file_manifest["document"]
    line_ending = document["line_ending"]
    eol = eol_for(line_ending)

    lines = original_text.splitlines(keepends=False)
    total_lines = len(lines)

    validate_patch_ranges(file_manifest["patches"], total_lines)

    # Apply patches in reverse order so earlier line numbers stay valid
    patches = sorted(
        file_manifest["patches"],
        key=lambda p: int(p["start_line"]),
        reverse=True,
    )

    for patch in patches:
        start_line = int(patch["start_line"])
        end_line = int(patch["end_line"])

        removed = lines[start_line - 1 : end_line]

        replacement = [
            normalize_line_for_write(line)
            for line in patch["content_line_array"]
        ]

        # Perform the slice replacement
        lines[start_line - 1 : end_line] = replacement

    result = eol.join(lines)
    if original_text.endswith(eol):
        result += eol
    return result


