def load_reused_session_shell_command_turn(
    state_session_dir: Path,
    turn: int | None = None,
    response_json_repair: bool = False,
) -> ReusedShellTurn:
    selected_turn_dir = last_completed_state_turn(
        state_session_dir,
        turn,
    )
    candidate_turns = iter_completed_state_turn_directories(
        state_session_dir,
        int(selected_turn_dir.name),
        reverse=True,
    )

    for candidate_turn, _ in candidate_turns:
        try:
            shell_turn = load_reused_session_shell_turn(
                state_session_dir,
                candidate_turn,
            )
            commands, _ = parse_shell_response(
                shell_turn.response, response_json_repair, followup=None
            )
        except ValueError:
            continue
        if commands:
            return shell_turn

    raise ValueError(
        "completed shell session has no reusable command turn: "
        f"{state_session_dir}"
    )


def start_state_turn(
    state_session_dir: Path,
    turn: int,
    system_prompt: str,
    task: str,
    file_paths: list[Path],
    skip_missing_files: bool = False,
    request_text: str | None = None,
 ) -> Path:
    turn_dir = state_session_dir / str(turn)
    turn_dir.mkdir(parents=True, exist_ok=True)
    state_files = (
        ("request_system_prompt", system_prompt),
        ("request_task", task),
    )
    for filename, content in state_files:
        write_state_artifact(turn_dir, filename, content)
    if request_text is not None:
        write_state_artifact(turn_dir, "request", request_text)
    request_files_path = state_session_dir / "request_files"
    if not request_files_path.exists():
        request_file_lines: list[str] = []
        for path in file_paths:
            if path == Path("-") or skip_missing_files and not path.exists():
                continue
            resolved_path = Path(path).resolve()
            request_file_lines.append(
                f"{resolved_path} {file_checksum(resolved_path)}"
            )
        try:
            with request_files_path.open("x", encoding="utf-8") as request_files:
                request_files.write("\n".join(request_file_lines))
        except FileExistsError:
            pass
    return turn_dir

def write_state_artifact(
    state_directory: Path,
    artifact_name: str,
    content: str,
) -> None:
    temporary_path = state_directory / f".{artifact_name}"
    try:
        temporary_path.write_text(content, encoding="utf-8")
        temporary_path.replace(state_directory / artifact_name)
    finally:
        temporary_path.unlink(missing_ok=True)


