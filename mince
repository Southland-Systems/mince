def session_timestamp_from_name(name: str) -> int | None:
    name_parts = name.split("-")
    if len(name_parts) < 3:
        return None
    try:
        timestamp = int(name_parts[-2])
    except ValueError:
        return None
    return timestamp


def handle_remove_expired_data(keep_days: int) -> int:
    if keep_days < 0:
        print("ERROR: KEEP_DAYS must be non-negative.", file=sys.stderr)
        return 1

    cutoff_timestamp = time.time() - keep_days * 24 * 60 * 60
    removed_count = 0
    errors: list[str] = []

    for directory_name in ("logs", "patches", "trees", "state"):
        data_directory = APP_DIR / directory_name
        if not data_directory.is_dir():
            continue
        try:
            entries = sorted(data_directory.iterdir(), key=lambda path: path.name)
        except OSError as exc:
            errors.append(f"{data_directory}: {exc}")
            continue

        for entry in entries:
            timestamp = session_timestamp_from_name(entry.name)
            if timestamp is None or timestamp >= cutoff_timestamp:
                continue
            try:
                if entry.is_dir() and not entry.is_symlink():
                    shutil.rmtree(entry)
                else:
                    entry.unlink()
                removed_count += 1
            except OSError as exc:
                errors.append(f"{entry}: {exc}")

    if errors:
        for error in errors:
            print(f"ERROR: Failed to remove expired data {error}", file=sys.stderr)
        return 1

    print(f"expired_data_removed={removed_count} keep_days={keep_days}")
    return 0


