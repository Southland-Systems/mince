def reused_agent_runtime_history(
    history: ReusedAgentHistory,
    runtime_state: dict[str, Any] | None,
    *,
    turn_dir: Path | None = None,
    default_expires_in_turns: int = AGENT_EXPIRES_IN_TURNS_DEFAULT,
) -> ReusedAgentHistory:
    if runtime_state is None:
        if turn_dir is None:
            return history
        summary, require_compaction, skip_next_interval = (
            load_state_agent_context_assist(turn_dir)
        )
        return replace(
            history,
            context_summary=(
                history.context_summary
                if history.context_summary is not None
                else load_state_agent_context_summary(
                    turn_dir, default_expires_in_turns
                )
            ),
            context_assist_summary=summary,
            context_assist_require_compaction=require_compaction,
            context_assist_skip_next_interval=skip_next_interval,
        )
    summary = runtime_state["context_summary"]
    return replace(
        history,
        context_summary=(
            parse_state_agent_context_summary(summary, Path("agent_runtime_state"))
            if summary is not None
            else None
        ),
        context_assist_summary=runtime_state["context_assist_summary"],
        context_assist_require_compaction=runtime_state["context_assist_require_compaction"],
        context_assist_skip_next_interval=runtime_state["context_assist_skip_next_interval"],
        runtime_state=runtime_state,
    )


def agent_file_context_attributes(section: str) -> dict[str, str] | None:
    header, separator, _ = section.partition("\n")
    if (
        not separator
        or not header.startswith("<file ")
        or not header.endswith(">")
    ):
        return None
    attribute_text = header[len("<file "):-1].strip()
    pattern = re.compile(
        r"""([A-Za-z_][A-Za-z0-9_]*)=("(?:[^"\\]|\\.)*"|'[^']*'|[^\s'"]+)(?:\s+|$)"""
    )
    attributes: dict[str, str] = {}
    position = 0
    while position < len(attribute_text):
        match = pattern.match(attribute_text, position)
        if match is None:
            return None
        name, attribute_value = match.groups()
        if name in attributes:
            return None
        try:
            if attribute_value.startswith('"'):
                attribute_value = json.loads(attribute_value)
            elif attribute_value.startswith("'"):
                attribute_value = attribute_value[1:-1]
        except ValueError:
            return None
        attributes[name] = attribute_value
        position = match.end()
    return attributes


def agent_file_context_path(section: str) -> str | None:
    attributes = agent_file_context_attributes(section)
    if attributes is None:
        return None
    path = attributes.get("path")
    total_lines = attributes.get("total_lines")
    if (
        not path
        or attributes.get("encoding") != "utf-8"
        or not attributes.get("line_ending")
        or total_lines is None
        or not total_lines.isascii()
        or not total_lines.isdigit()
    ):
        return None
    return path


def normalize_agent_context_summary(
    raw: str,
    allow_legacy_json: bool = False,
) -> str:
    if not isinstance(raw, str) or not raw.strip():
        raise ValueError("agent context summary requires non-empty Markdown")
    content = raw.strip()
    if not allow_legacy_json:
        return content
    try:
        value = json.loads(content)
    except json.JSONDecodeError:
        return content
    if not isinstance(value, dict) or set(value) != {"summary", "files"}:
        return content
    if not isinstance(value["summary"], str) or not value["summary"].strip():
        raise ValueError("agent context summary requires a non-empty summary")
    if not isinstance(value["files"], list):
        raise ValueError("agent context summary files must be an array")
    file_lines: list[str] = []
    for index, entry in enumerate(value["files"], start=1):
        if not isinstance(entry, dict) or set(entry) != {"path", "description"}:
            raise ValueError(
                f"agent context summary file {index} requires path and description"
            )
        for name in ("path", "description"):
            if not isinstance(entry[name], str) or not entry[name].strip():
                raise ValueError(
                    f"agent context summary file {index} requires a non-empty {name}"
                )
        file_lines.append(f"- `{entry['path']}`: {entry['description']}")
    parts = [value["summary"].strip()]
    if file_lines:
        parts.append("## Relevant files\n" + "\n".join(file_lines))
    return "\n\n".join(parts)


def validate_agent_context_summary(
    raw: str,
    model: str,
    token_budget: int = AGENT_CONTEXT_SUMMARY_MAX_TOKENS,
) -> str:
    try:
        content = normalize_agent_context_summary(raw)
    except ValueError as exc:
        raise AgentControllerResponseError(str(exc)) from exc
    summary_tokens = len(token_encoding_for_model(model).encode(content))
    if summary_tokens > token_budget:
        raise AgentControllerResponseError(
            f"agent context summary exceeds its {token_budget}-token budget"
        )
    return content


def saved_agent_turn_number_base(snapshot: dict[str, Any]) -> int:
    value = snapshot.get("turn_number_base", 1)
    if not is_integer(value) or value not in (0, 1):
        raise ValueError("saved agent turn number base must be 0 or 1")
    return value


def load_state_agent_context_summary(
    turn_dir: Path,
    default_expires_in_turns: int = AGENT_EXPIRES_IN_TURNS_DEFAULT,
) -> AgentContextSummary | None:
    artifact = read_first_present_state_json_artifact(
        tuple(
            turn_dir / f"{prefix}_agent_context_summary"
            for prefix in ("response", "request")
        ),
        "agent context summary must contain JSON",
    )
    if artifact is None:
        return None
    artifact_path, value = artifact
    return parse_state_agent_context_summary(
        value, artifact_path, default_expires_in_turns
    )


def parse_state_agent_context_summary(
    value: Any,
    artifact_path: Path,
    default_expires_in_turns: int = AGENT_EXPIRES_IN_TURNS_DEFAULT,
) -> AgentContextSummary:
    expected_fields = {
        "content", "removed_file_paths", "removed_turn_numbers",
        "active_context_checksum",
    }
    if not isinstance(value, dict) or not (
        expected_fields <= set(value)
        <= expected_fields | {
            "expires_in_turns", "turn_number_base", "generated_turn",
        }
    ):
        raise ValueError(f"invalid agent context summary snapshot: {artifact_path}")
    turn_number_base = saved_agent_turn_number_base(value)
    content = value["content"]
    if not isinstance(content, str):
        raise ValueError("saved agent context summary content must be a string")
    if content.strip():
        content = normalize_agent_context_summary(content, allow_legacy_json=True)
    else:
        content = ""
    file_paths = value["removed_file_paths"]
    if not isinstance(file_paths, list) or any(
        not isinstance(path, str) or not path
        for path in file_paths
    ):
        raise ValueError("saved agent context summary file paths must be strings")
    turn_numbers = value["removed_turn_numbers"]
    if not isinstance(turn_numbers, list) or any(
        not is_integer(number, turn_number_base)
        for number in turn_numbers
    ):
        raise ValueError("saved agent context summary turn numbers must be non-negative integers")
    checksum = value["active_context_checksum"]
    if not isinstance(checksum, str) or (
        checksum and re.fullmatch(r"[0-9a-f]{64}", checksum) is None
    ):
        raise ValueError("saved agent context summary has an invalid context checksum")
    expires_in_turns = value.get("expires_in_turns", default_expires_in_turns)
    if not is_integer(expires_in_turns):
        raise ValueError("saved agent context summary expiry must be a non-negative integer")
    generated_turn = value.get("generated_turn")
    if generated_turn is not None and not is_integer(generated_turn):
        raise ValueError(
            "saved agent context summary generation turn must be "
            "a non-negative integer"
        )
    return AgentContextSummary(
        content=content,
        removed_file_paths=tuple(file_paths),
        removed_turn_numbers=tuple(
            number - turn_number_base for number in turn_numbers
        ),
        active_context_checksum=checksum,
        expires_in_turns=expires_in_turns,
        generated_turn=generated_turn,
    )



def load_state_agent_context_assist(turn_dir: Path) -> tuple[str, bool, bool]:
    artifact = read_first_present_state_artifact(tuple(
        turn_dir / f"{prefix}_agent_context_assist_summary"
        for prefix in ("response", "request")
    ))
    if artifact is None:
        return "", False, False
    summary_path, summary = artifact
    artifact_prefix = summary_path.name.split("_", 1)[0]
    flags: dict[str, bool] = {}
    for name, label in (
        ("require_compaction", "compaction"),
        ("skip_next_interval", "skip interval"),
    ):
        flag_path = turn_dir / (
            f"{artifact_prefix}_agent_context_assist_{name}"
        )
        invalid_flag = f"invalid saved agent context assist {label} flag"
        flag_artifact = read_first_present_state_json_artifact(
            (flag_path,), invalid_flag
        )
        value = flag_artifact[1] if flag_artifact is not None else False
        if not isinstance(value, bool):
            raise ValueError(f"{invalid_flag}: {flag_path}")
        flags[name] = value
    return (
        summary.strip(),
        flags["require_compaction"],
        flags["skip_next_interval"],
    )


def parse_agent_readfile_contexts(
    output: str,
 ) -> tuple[tuple[str, str], ...] | None:
    contexts: list[tuple[str, str]] = []
    position = 0
    while position < len(output):
        closing_position = output.find("\n</file>", position)
        while closing_position != -1:
            after_closing = closing_position + len("\n</file>")
            if (
                after_closing == len(output)
                or output.startswith("\n<file ", after_closing)
            ):
                section = output[position:after_closing]
                path = agent_file_context_path(section)
                if path is None:
                    return None
                contexts.append((path, section))
                if after_closing == len(output):
                    return tuple(contexts)
                position = after_closing + 1
                break
            closing_position = output.find(
                "\n</file>",
                closing_position + 1,
            )
        else:
            return None
    return tuple(contexts) or None


def load_state_agent_file_contexts(
    turn_dir: Path,
) -> tuple[tuple[str, str], ...] | None:
    artifact = read_first_present_state_json_artifact(
        (turn_dir / "response_agent_file_contexts",),
        "agent file contexts must contain JSON",
    )
    if artifact is None:
        return None
    return normalize_state_agent_file_contexts(artifact[1])


def normalize_state_agent_file_contexts(
    entries: Any,
) -> tuple[tuple[str, str], ...]:
    if not isinstance(entries, list):
        raise ValueError("agent file contexts must contain an array")
    contexts: list[tuple[str, str]] = []
    for index, entry in enumerate(entries, start=1):
        if not isinstance(entry, dict) or set(entry) != {"path", "section"}:
            raise ValueError(
                "agent file context entry "
                f"{index} must contain path and section fields"
            )
        path = entry["path"]
        section = entry["section"]
        if not isinstance(path, str) or not path:
            raise ValueError(
                f"agent file context entry {index} path must be a non-empty string"
            )
        if not isinstance(section, str):
            raise ValueError(
                f"agent file context entry {index} section must be a string"
            )
        contexts.append((path, section))
    return tuple(contexts)


def load_reused_agent_readfile_contexts(
    turn_dir: Path,
    output: str,
) -> tuple[tuple[str, str], ...] | None:
    contexts = parse_agent_readfile_contexts(output)
    if contexts is not None:
        return contexts
    return load_state_agent_file_contexts(turn_dir)


def parse_reused_agent_tool_call_value(
    value: Any,
    expires_schema: dict[str, Any] = AGENT_EXPIRES_IN_TURNS_SCHEMA,
 ) -> AgentToolCall | None:
    if not isinstance(value, dict):
        raise ValueError("reused agent response must contain a JSON object")
    tool_name = value.get("tool")
    if not isinstance(tool_name, str) or not tool_name:
        raise ValueError("reused agent response must contain a tool name")
    arguments = {
        key: argument
        for key, argument in value.items()
        if key != "tool"
    }
    if (
        tool_name == AGENT_META_CONTEXT_CONTROL_TOOL
        and arguments.get("action") == "summary"
    ):
        return None
    if tool_name == "readfile":
        tool_name = AGENT_LOAD_FILE_FROM_STORAGE_TOOL
    if (
        tool_name == AGENT_LOAD_FILE_FROM_STORAGE_TOOL
        and set(arguments) == {"path"}
    ):
        arguments = {"paths": [arguments["path"]]}
    profile_name = ""
    if tool_name.startswith("agent_"):
        try:
            profile_name = validate_agent_profile_name(
                tool_name[len("agent_"):]
            )
        except ValueError as exc:
            raise ValueError(
                f"reused agent profile tool has an invalid name: {tool_name}"
            ) from exc
        tool_name = AGENT_AGENT_TOOL
    tool_call = parse_agent_tool_arguments(
        tool_name, arguments, expires_schema=expires_schema
    )
    if tool_call is not None and profile_name:
        return replace(tool_call, profile_name=profile_name)
    return tool_call


def parse_reused_agent_tool_calls(
    response: str,
    expires_schema: dict[str, Any] = AGENT_EXPIRES_IN_TURNS_SCHEMA,
    response_json_repair: bool = False,
) -> list[AgentToolCall | None]:
    try:
        value = parse_json_response(response, response_json_repair)
    except (ValueError, TypeError) as exc:
        raise ValueError(
            "reused agent response must contain a JSON tool call"
        ) from exc
    if isinstance(value, dict) and "tool_calls" in value:
        if set(value) != {"tool_calls"}:
            raise ValueError(
                "reused agent response tool_calls must be the only field"
            )
        tool_call_values = value["tool_calls"]
        if not isinstance(tool_call_values, list) or not tool_call_values:
            raise ValueError(
                "reused agent response tool_calls must be a non-empty array"
            )
    else:
        tool_call_values = [value]
    # Keep ignored calls in place so saved tool outputs remain aligned.
    return [
        parse_reused_agent_tool_call_value(tool_call_value, expires_schema)
        for tool_call_value in tool_call_values
    ]


def parse_reused_agent_tool_outputs(
    output: str,
    tool_call_count: int,
) -> list[str]:
    if tool_call_count < 1:
        raise ValueError("reused agent tool call count must be positive")
    if tool_call_count == 1:
        return [output]
    if not output:
        return [""] * tool_call_count
    try:
        value = json.loads(output)
    except json.JSONDecodeError as exc:
        raise ValueError(
            "reused agent tool outputs must contain a JSON object"
        ) from exc
    if not isinstance(value, dict) or set(value) != {"tool_outputs"}:
        raise ValueError(
            "reused agent tool outputs must contain only tool_outputs"
        )
    tool_outputs = value["tool_outputs"]
    if (
        not isinstance(tool_outputs, list)
        or len(tool_outputs) != tool_call_count
        or any(not isinstance(tool_output, str) for tool_output in tool_outputs)
    ):
        raise ValueError(
            "reused agent tool outputs must match the tool call count"
        )
    return tool_outputs


def parse_reused_agent_meta_task_list(
    output: str,
    task_list: list[dict[str, Any]] | None = None,
    operations: list[dict[str, Any]] | None = None,
) -> list[dict[str, Any]]:
    try:
        value = json.loads(output)
    except json.JSONDecodeError:
        # Legacy tool outputs contain the complete formatted task list.
        # Replay is safe only when it reproduces that saved snapshot.
        if task_list is not None and operations is not None:
            try:
                updated_tasks = apply_agent_meta_task_operations(
                    task_list, operations
                )
            except ValueError:
                pass
            else:
                if format_agent_meta_task_list(updated_tasks) == output:
                    return updated_tasks
        if output == "No tasks.":
            return []
        tasks: list[dict[str, Any]] = []
        for line in output.split("\n"):
            match = re.fullmatch(
                r"([1-9][0-9]*)\. \[("
                + "|".join(META_TASK_STATUS_SCHEMA["enum"])
                + r")\] (.*)",
                line,
            )
            if match is not None and int(match.group(1)) == len(tasks) + 1:
                tasks.append({
                    "task": match.group(3),
                    "status": match.group(2),
                })
            elif tasks:
                tasks[-1]["task"] += "\n" + line
            else:
                raise ValueError(
                    "saved meta_task_list output must contain a task list"
                )
        task_list = normalize_agent_meta_task_list(tasks)
        if format_agent_meta_task_list(task_list) != output:
            raise ValueError(
                "saved meta_task_list output has an invalid task list"
            )
        return limit_agent_meta_task_list(task_list)
    return limit_agent_meta_task_list(
        normalize_agent_meta_task_list(value)
    )

def reused_agent_tool_execution(
    turn_dir: Path,
    tool_call: AgentToolCall,
    output: str,
    task_list: list[dict[str, Any]],
    meta_task_list_snapshot: tuple[dict[str, Any], ...] | None = None,
) -> AgentToolExecution:
    contexts = None
    snapshot = None
    if output and output != AGENT_TOOL_NOT_EXECUTED_OUTPUT:
        if tool_call.tool == AGENT_LOAD_FILE_FROM_STORAGE_TOOL:
            if not output.startswith("ERROR:"):
                contexts = load_reused_agent_readfile_contexts(turn_dir, output)
        elif tool_call.tool == AGENT_PATCH_TOOL:
            contexts = load_state_agent_file_contexts(turn_dir)
        elif (
            tool_call.tool == AGENT_META_TASK_LIST_TOOL
            and not output.startswith("ERROR:")
            and isinstance(tool_call.arguments, dict)
        ):
            if meta_task_list_snapshot is not None:
                snapshot = meta_task_list_snapshot
            else:
                try:
                    snapshot = tuple(parse_reused_agent_meta_task_list(
                        output, task_list, tool_call.arguments.get("operations")
                    ))
                except ValueError as exc:
                    raise ValueError(
                        f"invalid saved meta_task_list output: {turn_dir} ({exc})"
                    ) from exc
    return AgentToolExecution(
        output, readfile_contexts=contexts, meta_task_list=snapshot
    )


def apply_agent_tool_result(
    state: AgentResultState,
    tool_call: AgentToolCall,
    execution: AgentToolExecution,
    *,
    state_turn: int,
    tool_call_index: int,
    turn_unix_time: int | None = None,
    preceding_patch_tool_call: AgentToolCall | None = None,
) -> AgentToolExecution:
    successful = (
        execution.output != AGENT_TOOL_NOT_EXECUTED_OUTPUT
        and not execution.output.startswith("ERROR:")
    )
    if (
        successful
        and tool_call.tool == AGENT_META_CONTEXT_CONTROL_TOOL
        and state.file_contexts is not None
    ):
        try:
            apply_agent_context_control(
                tool_call, state.file_contexts, state.turns,
                state.file_expires_in_turns, state.pinned_paths,
                state.pinned_turn_numbers,
            )
        except ValueError as exc:
            execution = replace(
                execution, output=f"ERROR: Failed to pin context: {exc}"
            )
            successful = False
    if execution.readfile_contexts is not None and state.file_contexts is not None:
        remove_agent_initial_file_contexts(
            state.file_contexts, state.file_expires_in_turns,
            state.pinned_paths,
            {path for path, _ in execution.readfile_contexts},
        )
    record_agent_tool_history(
        state.turns,
        state.active_task,
        "\n\n".join(
            value for value in (state.active_context, tool_call.context) if value
        ),
        tool_call,
        execution.output,
        turn_unix_time=turn_unix_time,
        readfile_contexts=execution.readfile_contexts,
        preceding_patch_tool_call=preceding_patch_tool_call,
        state_turn=state_turn,
        tool_call_index=tool_call_index,
    )
    if preceding_patch_tool_call is not None:
        return execution
    if successful and tool_call.tool == AGENT_META_TASK_LIST_TOOL:
        if execution.meta_task_list is not None:
            state.meta_task_list = limit_agent_meta_task_list(
                normalize_agent_meta_task_list(list(execution.meta_task_list))
            )
    if (
        successful and execution.output
        and tool_call.tool == AGENT_AGENT_TOOL
        and not tool_call.profile_name
    ):
        state.active_task = tool_call.task
        state.active_context = tool_call.context
        if state.context_summary is not None:
            state.context_summary.active_context_checksum = ""
    return execution


def build_agent_turn_metadata(
    state: AgentResultState,
    *,
    include_file_contexts: bool = True,
) -> dict[str, Any]:
    entries: list[dict[str, Any]] = []
    for number, turn in enumerate(state.turns):
        if turn.purge_in_turns is not None and turn.purge_in_turns <= 0:
            continue
        readfile_contexts: dict[str, int | None] | None = None
        if turn.readfile_contexts is not None:
            readfile_contexts = {}
            for path, section in turn.readfile_contexts:
                attributes = agent_file_context_attributes(section) or {}
                expiry = attributes.get("expires_in_turns")
                readfile_contexts[path] = (
                    coerce_int(expiry, turn.expires_in_turns)
                    if expiry is not None
                    else None
                )
        entries.append({
            "number": number,
            "state_turn": turn.state_turn,
            "tool_call_index": turn.tool_call_index,
            "context": turn.context,
            "turn_unix_time": turn.turn_unix_time,
            "expires_in_turns": turn.expires_in_turns,
            "purge_in_turns": turn.purge_in_turns,
            "removal_reason": turn.removal_reason,
            "readfile_contexts": readfile_contexts,
        })
    return {
        "turn_number_base": 0,
        "turn_range": (
            [entries[0]["number"], entries[-1]["number"]]
            if entries
            else []
        ),
        "turn_count": len(state.turns),
        "turns": entries,
        "file_expires_in_turns": state.file_expires_in_turns.copy(),
        "pinned_file_paths": sorted(state.pinned_paths),
        "pinned_turn_numbers": sorted(state.pinned_turn_numbers),
        "active_task": state.active_task,
        "active_context": state.active_context,
        "meta_task_list": [task.copy() for task in state.meta_task_list],
        "file_contexts": (
            [
                {"path": path, "section": section}
                for path, section in state.file_contexts
            ]
            if include_file_contexts and state.file_contexts is not None
            else None
        ),
    }


def load_reused_agent_turn_metadata(
    state_session_dir: Path,
    selected_turn_dir: Path,
    expires_schema: dict[str, Any],
    response_json_repair: bool,
    runtime_state: dict[str, Any] | None = None,
) -> ReusedAgentHistory | None:
    artifact_path = selected_turn_dir / "response_agent_runtime_state"
    metadata = (
        runtime_state["turn_metadata"]
        if runtime_state is not None
        else None
    )
    if metadata is None:
        artifact = read_first_present_state_json_artifact(
            tuple(
                selected_turn_dir / f"{prefix}_agent_turn_metadata"
                for prefix in ("response", "request")
            ),
            "invalid saved agent turn metadata",
        )
        if artifact is None:
            return None
        artifact_path, metadata = artifact
    invalid_metadata = f"invalid saved agent turn metadata: {artifact_path}"

    if isinstance(metadata, dict):
        metadata.pop("meta_notepad", None)
    expected_fields = {
        "turn_range", "turn_count", "turns", "file_expires_in_turns",
        "pinned_file_paths", "pinned_turn_numbers", "active_task",
        "active_context", "meta_task_list",
    }
    if not isinstance(metadata, dict) or not (
        expected_fields <= set(metadata)
        <= expected_fields | {"turn_number_base", "file_contexts"}
    ):
        raise ValueError(invalid_metadata)
    turn_number_base = saved_agent_turn_number_base(metadata)
    if (
        not is_integer(metadata["turn_count"])
        or not isinstance(metadata["turns"], list)
        or not isinstance(metadata["active_task"], str)
        or not isinstance(metadata["active_context"], str)
    ):
        raise ValueError(invalid_metadata)
    file_expirations = metadata["file_expires_in_turns"]
    if not isinstance(file_expirations, dict) or any(
        not isinstance(path, str) or not path or not is_integer(expiry)
        for path, expiry in file_expirations.items()
    ):
        raise ValueError(invalid_metadata)
    if metadata.get("file_contexts") is not None:
        saved_contexts = normalize_state_agent_file_contexts(metadata["file_contexts"])
        saved_paths = [path for path, _ in saved_contexts]
        if (
            len(set(saved_paths)) != len(saved_paths)
            or set(saved_paths) != set(file_expirations)
        ):
            raise ValueError(invalid_metadata)
    pinned_paths = metadata["pinned_file_paths"]
    if not isinstance(pinned_paths, list) or any(
        not isinstance(path, str) or not path
        for path in pinned_paths
    ):
        raise ValueError(invalid_metadata)
    selected_turn = int(selected_turn_dir.name)
    entry_fields = {
        "number", "state_turn", "tool_call_index", "context",
        "turn_unix_time", "expires_in_turns", "purge_in_turns",
        "removal_reason", "readfile_contexts",
    }
    numbers: list[int] = []
    for entry in metadata["turns"]:
        if not isinstance(entry, dict) or set(entry) != entry_fields:
            raise ValueError(invalid_metadata)
        if (
            not is_integer(entry["number"], turn_number_base)
            or entry["number"] >= metadata["turn_count"] + turn_number_base
            or not is_integer(entry["state_turn"])
            or entry["state_turn"] > selected_turn
            or not is_integer(entry["tool_call_index"])
            or not is_integer(entry["expires_in_turns"])
            or entry["purge_in_turns"] is not None
            and not is_integer(entry["purge_in_turns"], 1)
            or entry["turn_unix_time"] is not None
            and not is_integer(entry["turn_unix_time"])
            or not isinstance(entry["context"], str)
            or not isinstance(entry["removal_reason"], str)
        ):
            raise ValueError(invalid_metadata)
        contexts = entry["readfile_contexts"]
        if contexts is not None and (
            not isinstance(contexts, dict)
            or any(
                not isinstance(path, str) or not path
                or expiry is not None and not is_integer(expiry)
                for path, expiry in contexts.items()
            )
        ):
            raise ValueError(invalid_metadata)
        numbers.append(entry["number"])
    if numbers != sorted(set(numbers)):
        raise ValueError(invalid_metadata)
    turn_range = metadata["turn_range"]
    if (
        not isinstance(turn_range, list)
        or any(not is_integer(number, turn_number_base) for number in turn_range)
        or turn_range != ([numbers[0], numbers[-1]] if numbers else [])
    ):
        raise ValueError(invalid_metadata)
    pinned_numbers = metadata["pinned_turn_numbers"]
    if not isinstance(pinned_numbers, list) or any(
        not is_integer(number, turn_number_base) or number not in numbers
        for number in pinned_numbers
    ):
        raise ValueError(invalid_metadata)
    for entry in metadata["turns"]:
        entry["number"] -= turn_number_base
    metadata["turn_range"] = [
        number - turn_number_base for number in metadata["turn_range"]
    ]
    metadata["pinned_turn_numbers"] = [
        number - turn_number_base
        for number in metadata["pinned_turn_numbers"]
    ]
    metadata["turn_number_base"] = 0
    task_list = limit_agent_meta_task_list(
        normalize_agent_meta_task_list(metadata["meta_task_list"])
    )
    removed_turn = AgentTurn(
        task="",
        context="",
        tool_call=AgentToolCall(tool=AGENT_AGENT_TOOL),
        output="",
        purge_in_turns=0,
    )
    turns = [removed_turn] * metadata["turn_count"]
    sources: dict[
        int, tuple[str, list[AgentToolCall | None], list[str]]
    ] = {}
    for entry in metadata["turns"]:
        source_turn = entry["state_turn"]
        source_dir = last_completed_state_turn(state_session_dir, source_turn)
        if source_turn not in sources:
            tool_calls = parse_reused_agent_tool_calls(
                read_state_artifact(source_dir / "response"),
                expires_schema,
                response_json_repair,
            )
            tool_outputs = parse_reused_agent_tool_outputs(
                read_optional_state_artifact(
                    source_dir / "response_agent_tool_output"
                ) or "",
                len(tool_calls),
            )
            sources[source_turn] = (
                read_state_artifact(source_dir / "request_task"),
                tool_calls,
                tool_outputs,
            )
        task, tool_calls, tool_outputs = sources[source_turn]
        call_index = entry["tool_call_index"]
        if call_index >= len(tool_calls):
            raise ValueError(invalid_metadata)
        tool_call = tool_calls[call_index]
        if tool_call is None:
            metadata["pinned_turn_numbers"] = [
                number for number in metadata["pinned_turn_numbers"]
                if number != entry["number"]
            ]
            continue
        output = tool_outputs[call_index]
        context_index = call_index
        if (
            call_index + 1 < len(tool_calls)
            and tool_calls[call_index + 1] is not None
            and is_agent_patch_readfile_companion(
                tool_call, tool_calls[call_index + 1]
            )
        ):
            context_index += 1
            output = join_prompt_sections(
                output,
                agent_readfile_error_output(tool_outputs[context_index]),
            )
        contexts = entry["readfile_contexts"]
        readfile_contexts: tuple[tuple[str, str], ...] | None = None
        if contexts is not None:
            restored_contexts: list[tuple[str, str]] = []
            if contexts:
                source_contexts = dict(load_reused_agent_readfile_contexts(
                    source_dir, tool_outputs[context_index]
                ) or ())
                if any(path not in source_contexts for path in contexts):
                    source_contexts.update(
                        load_state_agent_file_contexts(source_dir) or ()
                    )
                for path, expiry in contexts.items():
                    if path not in source_contexts:
                        raise ValueError(invalid_metadata)
                    section = source_contexts[path]
                    if expiry is not None:
                        section = agent_file_context_section(section, expiry)
                    restored_contexts.append((path, section))
            readfile_contexts = tuple(restored_contexts)
        turns[entry["number"]] = AgentTurn(
            task=task,
            context=entry["context"],
            tool_call=tool_call,
            output=output,
            turn_unix_time=entry["turn_unix_time"],
            expires_in_turns=entry["expires_in_turns"],
            purge_in_turns=entry["purge_in_turns"],
            removal_reason=entry["removal_reason"],
            readfile_contexts=readfile_contexts,
            state_turn=source_turn,
            tool_call_index=call_index,
        )
    return reused_agent_runtime_history(
        ReusedAgentHistory(
            turns=tuple(turns),
            active_task=metadata["active_task"],
            active_context=metadata["active_context"],
            meta_task_list=tuple(task_list),
            turn_metadata=metadata,
        ),
        runtime_state,
        turn_dir=selected_turn_dir,
        default_expires_in_turns=expires_schema["default"],
    )


def load_completed_agent_tool_outputs(
    turn_dir: Path,
    tool_call_count: int,
) -> list[str]:
    output = read_optional_state_artifact(turn_dir / "response_agent_tool_output")
    if output is None:
        return []
    outputs = parse_reused_agent_tool_outputs(output, tool_call_count)
    for index, value in enumerate(outputs):
        if value == AGENT_TOOL_NOT_EXECUTED_OUTPUT:
            return outputs[:index]
    return outputs


def resume_reused_agent_turn(
    history: ReusedAgentHistory,
    turn_dir: Path,
    expires_schema: dict[str, Any],
    response_json_repair: bool,
) -> ReusedAgentHistory:
    selected_turn = int(turn_dir.name)
    response = read_optional_state_artifact(turn_dir / "response")
    if response is None:
        return replace(history, next_state_turn=selected_turn)
    try:
        calls = parse_reused_agent_tool_calls(
            response, expires_schema, response_json_repair
        )
    except ValueError:
        summary = history.context_summary
        summary_saved = (
            summary is not None
            and summary.generated_turn == selected_turn
            and summary.content == response.strip()
        )
        return replace(
            history,
            next_state_turn=selected_turn + 1 if summary_saved else selected_turn,
        )
    if any(call is None for call in calls):
        return replace(history, next_state_turn=selected_turn + 1)
    tool_calls = [call for call in calls if call is not None]
    saved_outputs = load_completed_agent_tool_outputs(turn_dir, len(tool_calls))
    recorded_turns = {
        turn.tool_call_index: turn
        for turn in history.turns
        if turn.state_turn == selected_turn
    }
    processed_count = max(recorded_turns, default=-1) + 1
    if processed_count > len(tool_calls):
        raise ValueError(f"saved agent tool progress exceeds the response: {turn_dir}")
    completed_count = max(processed_count, len(saved_outputs))
    completed_outputs = saved_outputs + [
        recorded_turns[index].output if index in recorded_turns else ""
        for index in range(len(saved_outputs), completed_count)
    ]

    if completed_count > processed_count:
        metadata = history.turn_metadata or {}
        saved_contexts = metadata.get("file_contexts")
        state = AgentResultState(
            turns=list(history.turns),
            active_task=history.active_task,
            active_context=history.active_context,
            meta_task_list=list(history.meta_task_list),
            context_summary=history.context_summary,
            file_contexts=list(
                normalize_state_agent_file_contexts(saved_contexts)
                if saved_contexts is not None else ()
            ),
            file_expires_in_turns=metadata.get("file_expires_in_turns", {}).copy(),
            pinned_paths=set(metadata.get("pinned_file_paths", ())),
            pinned_turn_numbers=set(metadata.get("pinned_turn_numbers", ())),
        )
        turn_unix_time = state_artifact_last_modified_time(turn_dir / "response")
        for index in range(processed_count, completed_count):
            tool_call = tool_calls[index]
            execution = reused_agent_tool_execution(
                turn_dir, tool_call, completed_outputs[index], state.meta_task_list
            )
            preceding_patch_tool_call = (
                tool_calls[index - 1]
                if index > 0 and is_agent_patch_readfile_companion(
                    tool_calls[index - 1], tool_call
                )
                else None
            )
            apply_agent_tool_result(
                state, tool_call, execution,
                state_turn=selected_turn,
                tool_call_index=index,
                turn_unix_time=turn_unix_time,
                preceding_patch_tool_call=preceding_patch_tool_call,
            )
        history = replace(
            history,
            turns=tuple(state.turns),
            active_task=state.active_task,
            active_context=state.active_context,
            meta_task_list=tuple(state.meta_task_list),
            turn_metadata=build_agent_turn_metadata(
                state, include_file_contexts=saved_contexts is not None
            ),
        )

    pending_result = None
    if completed_count < len(tool_calls):
        pending_result = AgentModelResult(
            response=format_agent_tool_calls(tool_calls),
            reasoning=read_optional_state_artifact(turn_dir / "response_reasoning") or "",
            turn_dir=turn_dir,
            turn_unix_time=state_artifact_last_modified_time(turn_dir / "response"),
            tool_calls=tuple(tool_calls),
            reasoning_items=load_state_reasoning_items(turn_dir),
        )
    return replace(
        history,
        next_state_turn=selected_turn + 1,
        pending_model_result=pending_result,
        completed_tool_outputs=(
            tuple(completed_outputs) if pending_result is not None else ()
        ),
    )


def load_reused_session_agent_history(
    state_session_dir: Path,
    turn: int | None = None,
    expires_schema: dict[str, Any] = AGENT_EXPIRES_IN_TURNS_SCHEMA,
    response_json_repair: bool = False,
) -> ReusedAgentHistory:
    selected_turn_dir = last_completed_state_turn(
        state_session_dir, turn,
        required_file=STATE_RESUMABLE_AGENT_TURN_ARTIFACTS,
    )
    runtime_state = load_state_agent_runtime_state(selected_turn_dir)
    reused_history = load_reused_agent_turn_metadata(
        state_session_dir,
        selected_turn_dir,
        expires_schema,
        response_json_repair,
        runtime_state=runtime_state,
    )
    if reused_history is not None:
        return resume_reused_agent_turn(
            reused_history, selected_turn_dir, expires_schema, response_json_repair
        )
    selected_turn = int(selected_turn_dir.name)
    turn_directories = iter_completed_state_turn_directories(
        state_session_dir,
        selected_turn,
    )
    turns: list[AgentTurn] = []
    active_task = ""
    active_context = ""
    task_list: list[dict[str, Any]] = []
    context_summary: AgentContextSummary | None = None
    has_summary_turn = False
    selected_controller_turn = False
    runtime_history = reused_agent_runtime_history(
        ReusedAgentHistory((), "", ""), runtime_state
    )

    for turn_number, turn_dir in turn_directories:
        saved_task_list_text = read_optional_state_artifact(
            turn_dir / "response_agent_meta_task_list"
        )
        if saved_task_list_text is not None:
            try:
                task_list = parse_reused_agent_meta_task_list(
                    saved_task_list_text
                )
            except ValueError as exc:
                raise ValueError(
                    f"invalid saved meta_task_list snapshot: {turn_dir} ({exc})"
                ) from exc
        response_path = turn_dir / "response"
        response = read_state_artifact(response_path)
        turn_unix_time = state_artifact_last_modified_time(response_path)
        saved_summary = (
            runtime_history.context_summary
            if turn_number == selected_turn and runtime_state is not None
            else load_state_agent_context_summary(
                turn_dir, expires_schema["default"]
            )
        )
        try:
            tool_calls = parse_reused_agent_tool_calls(
                response,
                expires_schema,
                response_json_repair,
            )
        except ValueError as exc:
            if (
                saved_summary is not None
                and saved_summary.content
                and response.strip() == saved_summary.content
                and (
                    saved_summary.generated_turn == turn_number
                    or (turn_dir / "response_agent_context_summary").is_file()
                )
            ):
                tool_calls = []
            elif turn_number == selected_turn:
                raise ValueError(
                    "selected session turn is not an agent controller turn: "
                    f"{turn_dir} ({exc})"
                ) from exc
            else:
                continue
        tool_outputs: list[str] = []
        if any(tool_call is not None for tool_call in tool_calls):
            output = read_optional_state_artifact(
                turn_dir / "response_agent_tool_output"
            ) or ""
            try:
                tool_outputs = parse_reused_agent_tool_outputs(
                    output,
                    len(tool_calls),
                )
                if turn_number == selected_turn:
                    selected_controller_turn = True
                    tool_outputs = load_completed_agent_tool_outputs(
                        turn_dir, len(tool_calls)
                    )
            except ValueError as exc:
                if turn_number == selected_turn:
                    raise ValueError(
                        "selected session turn has invalid agent tool output: "
                        f"{turn_dir} ({exc})"
                    ) from exc
                continue
        elif saved_summary is not None and saved_summary.content:
            has_summary_turn = True
        else:
            continue
        if saved_summary is not None:
            context_summary = saved_summary
            if (
                agent_context_checksum(active_context)
                == saved_summary.active_context_checksum
            ):
                active_context = ""
        state = AgentResultState(
            turns=turns,
            active_task=read_state_artifact(turn_dir / "request_task"),
            active_context=active_context,
            meta_task_list=task_list,
            context_summary=context_summary,
        )
        task_list_snapshot = (
            tuple(task_list) if saved_task_list_text is not None else None
        )
        for tool_call_index, (tool_call, tool_output) in enumerate(
            zip(tool_calls, tool_outputs)
        ):
            if tool_call is None:
                continue
            execution = reused_agent_tool_execution(
                turn_dir, tool_call, tool_output, state.meta_task_list,
                task_list_snapshot,
            )
            preceding_patch_tool_call = (
                tool_calls[tool_call_index - 1]
                if tool_call_index > 0 and is_agent_patch_readfile_companion(
                    tool_calls[tool_call_index - 1], tool_call
                )
                else None
            )
            apply_agent_tool_result(
                state, tool_call, execution,
                state_turn=turn_number,
                tool_call_index=tool_call_index,
                turn_unix_time=turn_unix_time,
                preceding_patch_tool_call=preceding_patch_tool_call,
            )
        active_task = state.active_task
        active_context = state.active_context
        task_list = state.meta_task_list

    if not turns and not has_summary_turn and not selected_controller_turn:
        raise ValueError(
            "selected session turn is not an agent controller turn: "
            f"{selected_turn_dir}"
        )
    history = replace(
        runtime_history,
        turns=tuple(turns),
        active_task=active_task,
        active_context=active_context,
        meta_task_list=tuple(task_list),
        context_summary=(
            runtime_history.context_summary
            if runtime_state is not None
            else context_summary
        ),
    )
    if runtime_state is None:
        history = reused_agent_runtime_history(
            history, None,
            turn_dir=selected_turn_dir,
            default_expires_in_turns=expires_schema["default"],
        )
    return resume_reused_agent_turn(
        history, selected_turn_dir, expires_schema, response_json_repair
    )

def reused_agent_context_pins(
    file_contexts: list[tuple[str, str]],
    turns: list[AgentTurn],
    file_expires_in_turns: dict[str, int] | None = None,
    initial_pinned_paths: set[str] | None = None,
    turn_number_base: int = 0,
) -> tuple[set[str], set[int]]:
    if file_expires_in_turns is None:
        file_expires_in_turns = agent_file_context_expirations(
            file_contexts
        )
    pinned_paths = set(initial_pinned_paths or ())
    pinned_turn_numbers: set[int] = set()
    replayed_turns: list[AgentTurn] = []
    previous_state_turn: int | None = None
    for turn in turns:
        if (
            turn.state_turn is None
            or turn.state_turn != previous_state_turn
        ):
            advance_agent_history_purges(
                replayed_turns,
                pinned_turn_numbers,
            )
            advance_agent_file_context_expirations(
                file_contexts,
                file_expires_in_turns,
                pinned_paths,
            )
        if (
            turn.tool_call.tool == AGENT_META_CONTEXT_CONTROL_TOOL
            and turn.output != AGENT_TOOL_NOT_EXECUTED_OUTPUT
            and not turn.output.startswith("ERROR:")
        ):
            try:
                apply_agent_context_control(
                    turn.tool_call,
                    file_contexts,
                    replayed_turns,
                    file_expires_in_turns,
                    pinned_paths,
                    pinned_turn_numbers,
                    turn_number_base=turn_number_base,
                    turn_numbers=(
                        list(range(len(replayed_turns)))
                        if turn_number_base
                        else None
                    ),
                )
            except ValueError:
                pass
        replayed_turns.append(turn)
        previous_state_turn = turn.state_turn
    turns[:] = replayed_turns
    return pinned_paths, pinned_turn_numbers


def agent_context_checksum(context: str) -> str:
    return hashlib.sha256(context.encode("utf-8")).hexdigest() if context else ""


def format_agent_context_summary(
    summary: AgentContextSummary | None,
    model: str = "",
) -> str:
    if summary is None or not summary.content:
        return ""
    return format_context_entry(
        "agent_context_summary",
        f"{summary.content}\n",
        model=model,
        attributes=f" expires_in_turns='{summary.expires_in_turns}'",
    )


def apply_agent_context_summary(
    summary: AgentContextSummary,
    file_contexts: list[tuple[str, str]],
    turns: list[AgentTurn],
    file_expires_in_turns: dict[str, int],
    pinned_paths: set[str],
    pinned_turn_numbers: set[int],
) -> None:
    remove_agent_initial_file_contexts(
        file_contexts, file_expires_in_turns, pinned_paths,
        set(summary.removed_file_paths),
    )
    for turn_number in summary.removed_turn_numbers:
        if not 0 <= turn_number < len(turns):
            raise ValueError(f"summarized agent turn does not exist: turn:{turn_number}")
        turn_index = turn_number
        # Keep tombstones so context-control turn IDs remain stable.
        turns[turn_index] = replace(
            turns[turn_index],
            task="",
            context="",
            output="",
            readfile_contexts=(),
            purge_in_turns=0,
            removal_reason="This agent turn was removed by context management.",
        )
    pinned_turn_numbers.difference_update(summary.removed_turn_numbers)


def apply_agent_context_assist_removals(
    remove_turn_ids: list[int],
    remove_file_ids: list[int],
    reviewed_context: str,
    reviewed_turn: int,
    *,
    file_context_ids: dict[str, int],
    file_contexts: list[tuple[str, str]],
    turns: list[AgentTurn],
    file_expires_in_turns: dict[str, int],
    pinned_paths: set[str],
    pinned_turn_numbers: set[int],
) -> tuple[list[int], list[int]]:
    reviewed_files: dict[int, tuple[str, str]] = {}
    for path, section in parse_agent_readfile_contexts(reviewed_context) or ():
        attributes = agent_file_context_attributes(section) or {}
        identifier = attributes.get("ID", "")
        if identifier.isascii() and identifier.isdigit():
            reviewed_files[int(identifier)] = (path, section)
    current_files = dict(file_contexts)
    newer_paths: set[str] = set()
    for turn in turns:
        if turn.purge_in_turns is not None:
            continue
        current_files.update(turn.readfile_contexts or ())
        if turn.state_turn is not None and turn.state_turn >= reviewed_turn:
            newer_paths.update(path for path, _ in turn.readfile_contexts or ())

    def file_content(section: str) -> tuple[str, ...]:
        attributes = agent_file_context_attributes(section) or {}
        return (
            attributes.get("error", ""),
            attributes.get("encoding", ""),
            attributes.get("line_ending", ""),
            attributes.get("total_lines", ""),
            section.partition("\n")[2],
        )

    removed_paths: set[str] = set()
    removed_file_ids: list[int] = []
    for identifier in dict.fromkeys(remove_file_ids):
        reviewed_file = reviewed_files.get(identifier)
        if reviewed_file is None:
            continue
        path, section = reviewed_file
        if (
            file_context_ids.get(path) != identifier
            or path not in current_files
            or path in newer_paths
            or file_content(current_files[path]) != file_content(section)
        ):
            continue
        removed_paths.add(path)
        removed_file_ids.append(identifier)
    if removed_paths:
        remove_agent_initial_file_contexts(
            file_contexts, file_expires_in_turns, pinned_paths, removed_paths
        )
        remove_agent_history_file_contexts(turns, removed_paths)

    available_turn_ids = set(agent_history_turn_numbers(turns))
    retained_files = dict(file_contexts)
    removed_turn_ids: list[int] = []
    for identifier in dict.fromkeys(remove_turn_ids):
        if identifier not in available_turn_ids:
            continue
        turn = turns[identifier]
        if turn.state_turn is not None and turn.state_turn >= reviewed_turn:
            continue
        contexts = list(turn.readfile_contexts or ())
        expirations = agent_file_context_expirations(
            contexts, turn.expires_in_turns
        )
        for path, section in contexts:
            retained_files[path] = section
            file_expires_in_turns[path] = expirations[path]
            if identifier in pinned_turn_numbers:
                pinned_paths.add(path)
        remove_agent_history_turn(
            turns, identifier, "This agent turn was removed by context assist."
        )
        turns[identifier] = replace(turns[identifier], readfile_contexts=())
        pinned_turn_numbers.discard(identifier)
        removed_turn_ids.append(identifier)
    file_contexts[:] = list(retained_files.items())
    return removed_turn_ids, removed_file_ids


def agent_context_removal_candidates(
    file_contexts: list[tuple[str, str]],
    turns: list[AgentTurn],
    file_expires_in_turns: dict[str, int],
    pinned_paths: set[str],
    pinned_turn_numbers: set[int],
    active_context: str,
) -> Iterator[tuple[str, int]]:
    candidates = [
        (
            number in pinned_turn_numbers, 0,
            turns[number].expires_in_turns, number, "turn", number,
        )
        for number in agent_history_turn_numbers(turns)
    ] + [
        (
            path in pinned_paths, 1,
            file_expires_in_turns[path], index, "file", index,
        )
        for index, (path, _) in enumerate(file_contexts)
    ]
    if active_context:
        candidates.append((True, 2, 0, 0, "active", 0))
    for _, _, _, _, kind, index in sorted(candidates):
        yield kind, index


def update_agent_context_summary(
    summary: AgentContextSummary,
    content: str,
    active_context: str,
    file_contexts: list[tuple[str, str]],
    turns: list[AgentTurn],
    file_expires_in_turns: dict[str, int],
    pinned_paths: set[str],
    pinned_turn_numbers: set[int],
    *,
    current_turn: int,
    expires_in_turns: int = AGENT_EXPIRES_IN_TURNS_DEFAULT,
    compaction: AgentContextCompaction | None = None,
) -> str:
    summary.content = normalize_agent_context_summary(content)
    summary.expires_in_turns = expires_in_turns
    summary.generated_turn = current_turn
    if compaction is None:
        return active_context
    summary.removed_file_paths = tuple(sorted(
        set(summary.removed_file_paths).union(compaction.removed_file_paths)
    ))
    summary.removed_turn_numbers = tuple(sorted(
        set(summary.removed_turn_numbers).union(compaction.removed_turn_numbers)
    ))
    if compaction.active_context_checksum:
        summary.active_context_checksum = compaction.active_context_checksum
    apply_agent_context_summary(
        summary,
        file_contexts,
        turns,
        file_expires_in_turns,
        pinned_paths,
        pinned_turn_numbers,
    )
    if agent_context_checksum(active_context) == summary.active_context_checksum:
        return ""
    return active_context


AGENT_PRIOR_TOKEN_ESTIMATES_MAX_TURNS = 18


def format_agent_token_estimate_context(
    current_token_estimate: int,
    token_limit: int,
    prior_token_estimates: list[tuple[int, int]] | None = None,
    current_turn: int | None = None,
) -> str:
    token_estimates = (prior_token_estimates or [])[
        -AGENT_PRIOR_TOKEN_ESTIMATES_MAX_TURNS:
    ]
    prior_lines = "\n".join(
        f"{turn} {token_estimate}"
        for turn, token_estimate in sorted(token_estimates, reverse=True)
    )
    if current_turn is None:
        current_turn = token_estimates[-1][0] + 1 if token_estimates else 0
    return (
        f"<current_token_estimate token_estimate='{current_token_estimate}' "
        f"token_limit='{token_limit}' turn='{current_turn}'/>\n"
        "<prior_token_estimates>\n"
        f"{prior_lines}\n"
        "</prior_token_estimates>"
    )


def build_agent_context_window_prompts(
    *,
    model: str,
    token_limit: int,
    system_prompt: str,
    task: str,
    file_contexts: list[tuple[str, str]],
    turns: list[AgentTurn],
    active_context: str,
    pinned_paths: set[str],
    pinned_turn_numbers: set[int],
    file_expires_in_turns: dict[str, int] | None = None,
    file_context_ids: dict[str, int] | None = None,
    revision_instruction: str = "",
    controller_tools: list[dict[str, Any]] | None = None,
    hook_contents: tuple[str, ...] = (),
    meta_task_list: list[dict[str, Any]] | None = None,
    prior_token_estimates: list[tuple[int, int]] | None = None,
    context_summary: AgentContextSummary | None = None,
    context_assist_summary: str = "",
    require_compaction: bool = False,
    advance_expirations: bool = True,
    refresh_summary: bool = False,
    limit_context: bool = True,
    current_turn: int | None = None,
    tool_call_instructions: str = AGENT_TOOL_CALL_SYSTEM_PROMPT,
    task_priority_system_prompt: str = AGENT_TASK_PRIORITY_SYSTEM_PROMPT,
    summary_system_prompt: str = AGENT_SUMMARY_INSTRUCTIONS,
) -> tuple[str, str, int | None, AgentContextCompaction | None]:
    if controller_tools is None:
        controller_tools = AGENT_TOOL_SCHEMAS
    if file_expires_in_turns is None:
        file_expires_in_turns = agent_file_context_expirations(
            file_contexts
        )
    if file_context_ids is None:
        file_context_ids = {}
    if context_summary is None:
        context_summary = AgentContextSummary()
    if advance_expirations:
        advance_agent_history_purges(turns, pinned_turn_numbers)
        advance_agent_file_context_expirations(
            file_contexts,
            file_expires_in_turns,
            pinned_paths,
        )
    context_turns = [
        limit_agent_shell_turn_for_context(turn, model, token_limit)
        if limit_context else turn
        for turn in turns
    ]
    controller_context_turns = context_turns.copy()
    visible_turn_numbers = set(agent_history_turn_numbers(turns))
    turn_numbers = list(range(len(turns)))
    visible_file_indexes = set(range(len(file_contexts)))
    active_context_checksum = agent_context_checksum(active_context)
    visible_active_context = (
        ""
        if active_context_checksum == context_summary.active_context_checksum
        else active_context
    )
    visible_summary = context_summary
    summary_token_budget: int | None = None
    current_unix_time = int(time.time())
    summary_request = False

    def build_visible_prompts(
        current_token_estimate: int,
    ) -> tuple[str, str, int]:
        visible_context = build_agent_files_context(
            file_contexts,
            file_expires_in_turns,
            visible_file_indexes,
            context_turns,
            turn_numbers,
            visible_turn_numbers,
            model=model,
            file_context_ids=file_context_ids,
        )
        full_system_prompt, user_prompt = build_agent_followup_prompts(
            system_prompt=system_prompt,
            task=task,
            context=visible_context,
            turns=context_turns,
            turn_numbers=turn_numbers,
            visible_turn_numbers=visible_turn_numbers,
            pinned_turn_numbers=pinned_turn_numbers,
            active_context=visible_active_context,
            context_summary=visible_summary,
            context_assist_summary=context_assist_summary,
            revision_instruction=revision_instruction,
            hook_contents=hook_contents,
            meta_task_list=meta_task_list,
            current_token_estimate=current_token_estimate,
            token_limit=token_limit,
            prior_token_estimates=prior_token_estimates,
            current_unix_time=current_unix_time,
            current_turn=current_turn,
            summary_request=summary_request,
            model=model,
            tool_call_instructions=tool_call_instructions,
            task_priority_system_prompt=task_priority_system_prompt,
            summary_system_prompt=summary_system_prompt
        )
        return (
            full_system_prompt,
            user_prompt,
            estimate_request_tokens(
                model=model,
                system_prompt=full_system_prompt,
                user_prompt=user_prompt,
                tools=(
                    [AGENT_CONTEXT_SUMMARY_TOOL_SCHEMA]
                    if summary_request
                    else controller_tools
                ),
            ),
        )

    def build_visible_prompts_with_token_estimate() -> tuple[str, str, int]:
        current_token_estimate = 0
        for _ in range(8):
            (
                full_system_prompt, user_prompt, request_tokens,
            ) = build_visible_prompts(current_token_estimate)
            if request_tokens == current_token_estimate:
                return full_system_prompt, user_prompt, request_tokens
            current_token_estimate = request_tokens
        return full_system_prompt, user_prompt, request_tokens

    (
        request_system_prompt, user_prompt, request_tokens,
    ) = build_visible_prompts_with_token_estimate()
    if not limit_context:
        return request_system_prompt, user_prompt, None, None
    candidates = list(agent_context_removal_candidates(
        file_contexts,
        turns,
        file_expires_in_turns,
        pinned_paths,
        pinned_turn_numbers,
        visible_active_context,
    ))
    compact_context = bool(candidates) and (
        require_compaction
        or token_limit - request_tokens <= AGENT_CONTEXT_SUMMARY_TOKEN_RESERVE
    )
    refresh_summary = refresh_summary or (
        request_tokens > token_limit and bool(context_summary.content)
    )
    if not compact_context and not refresh_summary:
        if request_tokens > token_limit:
            raise ValueError(
                f"Estimated agent input token count ({request_tokens}) cannot "
                f"be reduced below token limit ({token_limit}); reduce the task "
                "or persistent context, or increase the token limit"
            )
        return request_system_prompt, user_prompt, None, None

    all_visible_turn_numbers = visible_turn_numbers.copy()
    all_visible_file_indexes = visible_file_indexes.copy()
    all_visible_active_context = visible_active_context
    visible_summary = None
    _, _, retained_request_tokens = build_visible_prompts_with_token_estimate()
    if compact_context:
        visible_turn_numbers = set()
        visible_file_indexes = set()
        visible_active_context = ""
        _, _, minimum_request_tokens = build_visible_prompts_with_token_estimate()
    else:
        minimum_request_tokens = retained_request_tokens
    visible_turn_numbers = all_visible_turn_numbers.copy()
    visible_file_indexes = all_visible_file_indexes.copy()
    visible_active_context = all_visible_active_context
    visible_summary = context_summary
    summary_token_budget = min(
        AGENT_CONTEXT_SUMMARY_MAX_TOKENS,
        (token_limit - minimum_request_tokens) // 2,
    )
    if summary_token_budget < 1024:
        raise ValueError(
            "Token limit is too small for an agent context summary turn"
        )

    summary_request = True
    candidates_to_hide = iter(reversed(candidates))
    while True:
        (
            request_system_prompt, user_prompt, request_tokens,
        ) = build_visible_prompts_with_token_estimate()
        if request_tokens <= token_limit:
            break
        try:
            kind, index = next(candidates_to_hide)
        except StopIteration:
            raise ValueError(
                f"Estimated agent context summary input token count "
                f"({request_tokens}) cannot be reduced below token limit "
                f"({token_limit}); reduce the task or persistent context, "
                "or increase the token limit"
            ) from None
        if kind == "turn":
            turn = context_turns[index]
            if turn.tool_call.tool == AGENT_SHELL_TOOL and turn.output:
                def estimate_shell_context_tokens(output: str) -> int:
                    context_turns[index] = replace(turn, output=output)
                    return build_visible_prompts_with_token_estimate()[2]

                if estimate_shell_context_tokens("") <= token_limit:
                    limited_output = limit_shell_output_for_context(
                        turn.output,
                        model,
                        token_limit,
                        estimate_context_tokens=estimate_shell_context_tokens,
                    )
                    context_turns[index] = replace(turn, output=limited_output)
                    continue
                context_turns[index] = turn
            visible_turn_numbers.remove(index)
        elif kind == "file":
            visible_file_indexes.remove(index)
        else:
            visible_active_context = ""

    compaction = None
    if compact_context:
        summarized_candidates = [
            (kind, index)
            for kind, index in candidates
            if (
                kind == "turn" and index in visible_turn_numbers
                or kind == "file" and index in visible_file_indexes
                or kind == "active" and bool(visible_active_context)
            )
        ]
        if not summarized_candidates:
            raise ValueError(
                "Available agent context entries cannot fit in a context "
                "summary request; reduce the task or file sizes, or increase "
                "the token limit"
            )
        context_turns = controller_context_turns
        visible_turn_numbers = all_visible_turn_numbers.copy()
        visible_file_indexes = all_visible_file_indexes.copy()
        visible_active_context = all_visible_active_context
        visible_summary = None
        summary_request = False
        summary_token_reserve = summary_token_budget + len(
            token_encoding_for_model(model).encode(
                format_agent_context_summary(
                    AgentContextSummary(
                        content="summary",
                        expires_in_turns=context_summary.expires_in_turns,
                    ),
                    model=model,
                )
            )
        )
        target_tokens = max(
            minimum_request_tokens,
            min(
                retained_request_tokens - int(
                    token_limit * AGENT_CONTEXT_COMPACTION_TOKEN_FRACTION
                ),
                token_limit - summary_token_reserve
                - AGENT_CONTEXT_SUMMARY_TOKEN_RESERVE,
            ),
        )
        removed_file_paths: list[str] = []
        removed_turn_numbers: list[int] = []
        removed_active_context_checksum = ""
        for kind, index in summarized_candidates:
            if retained_request_tokens <= target_tokens and (
                removed_file_paths or removed_turn_numbers
                or removed_active_context_checksum
            ):
                break
            if kind == "turn":
                visible_turn_numbers.remove(index)
                removed_turn_numbers.append(index)
            elif kind == "file":
                visible_file_indexes.remove(index)
                removed_file_paths.append(file_contexts[index][0])
            else:
                visible_active_context = ""
                removed_active_context_checksum = active_context_checksum
            _, _, retained_request_tokens = build_visible_prompts_with_token_estimate()
        compaction = AgentContextCompaction(
            removed_file_paths=tuple(sorted(removed_file_paths)),
            removed_turn_numbers=tuple(sorted(removed_turn_numbers)),
            active_context_checksum=removed_active_context_checksum,
        )
    return (
        request_system_prompt, user_prompt, summary_token_budget, compaction,
    )


def build_agent_followup_prompts(
    system_prompt: str,
    task: str,
    context: str,
    turns: list[AgentTurn],
    active_context: str,
    revision_instruction: str = "",
    turn_numbers: list[int] | None = None,
    visible_turn_numbers: set[int] | None = None,
    pinned_turn_numbers: set[int] | None = None,
    hook_contents: tuple[str, ...] = (),
    meta_task_list: list[dict[str, Any]] | None = None,
    current_token_estimate: int | None = None,
    token_limit: int | None = None,
    prior_token_estimates: list[tuple[int, int]] | None = None,
    current_unix_time: int | None = None,
    context_summary: AgentContextSummary | None = None,
    context_assist_summary: str = "",
    current_turn: int | None = None,
    summary_request: bool = False,
    model: str = "",
    tool_call_instructions: str = AGENT_TOOL_CALL_SYSTEM_PROMPT,
    task_priority_system_prompt: str = AGENT_TASK_PRIORITY_SYSTEM_PROMPT,
    summary_system_prompt: str = AGENT_SUMMARY_INSTRUCTIONS,
) -> tuple[str, str]:
    if current_unix_time is None:
        current_unix_time = int(time.time())
    instruction_parts = [
        tool_call_instructions,
        "The `<meta_task_list>` uses `TASK_NUMBER. [TASK_STATUS] TASK` "
        "for each task, or `No tasks.` when empty.",
    ]
    additional_parts: list[str] = []
    if current_token_estimate is not None and token_limit is not None:
        instruction_parts.append(
            "Each line in `<prior_token_estimates>` has the format "
            "`TURN TOKENS`; entries are ordered newest to oldest."
        )
        additional_parts.append(
            format_agent_token_estimate_context(
                current_token_estimate,
                token_limit,
                prior_token_estimates,
                current_turn=current_turn,
            )
        )

    for hook_content in hook_contents:
        additional_parts.append(
            format_context_entry(
                "hook_script_output", hook_content, model=model
            )
        )

    summary_context = format_agent_context_summary(context_summary, model=model)
    assist_context = format_instruction_section(
        "agent_context_assist_summary", context_assist_summary
    )
    task_list_context = format_context_entry(
        "meta_task_list",
        f"{format_agent_meta_task_list(meta_task_list)}\n",
        model=model,
        include_token_count=False,
    )

    if active_context:
        additional_parts.append(
            format_context_entry(
                "agent_context", f"{active_context}\n", model=model
            )
        )
    history = format_agent_history(
        turns,
        turn_numbers,
        pinned_turn_numbers,
        visible_turn_numbers,
        model=model,
    )

    if history:
        additional_parts.append(
            "<agent_history>\n"
            f"{history}\n</agent_history>"
        )
    if revision_instruction:
        instruction_parts.append(
            "Replace the previous tool call with one that follows this user "
            "revision:\n"
            f"{revision_instruction}"
        )

    if summary_request:
        additional_parts.append(task_list_context)

    return build_request_prompts(
        system_prompt=(
            summary_system_prompt
            if summary_request
            else join_prompt_sections(
                system_prompt,
                task_priority_system_prompt,
            )
        ),
        task="" if summary_request else task,
        context=context,
        response_format="text",
        additional_prompt=join_prompt_sections(*additional_parts),
        additional_instructions=(
            "" if summary_request else join_prompt_sections(*instruction_parts)
        ),
        current_unix_time=current_unix_time,
        instruction_prefix="" if summary_request else assist_context,
        instruction_suffix="" if summary_request else task_list_context,
        context_prefix=summary_context,
        agent_mode=True,
    )


def run_agent_hook_context_scripts(
    scripts: tuple[str, ...],
) -> tuple[str, ...]:
    hook_contents: list[str] = []
    for script in scripts:
        try:
            completed = subprocess.run(
                [script],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                env={**os.environ, **SHELL_PAGER_ENVIRONMENT},
                check=False,
            )
        except Exception:
            continue
        if completed.returncode == 0:
            hook_contents.append(completed.stdout)
    return tuple(hook_contents)


def emit_agent_output(
    settings: AgentRunSettings,
    output_text: str,
) -> None:
    if OUTPUT_FILE is not None:
        write_output_file(output_text, append=True)
    elif not settings.suppress_response_output:
        print(output_text, flush=True)


def review_patch_changes(
    diff_text: str,
    suffix_provided: bool,
    accept_automatically: bool = False,
    *,
    prompt: str = "Apply these changes? [y/n/p/h/S/e/E <prompt>]: ",
    allow_revision: bool = True,
    allow_navigation: bool = False,
    display_text: bool = True,
 ) -> tuple[str, str | None, bool]:
    options = (
        "[y]es, [n]o, [p]ager, [h]elp, "
        "[S] toggle patch suffix"
    )
    if allow_navigation:
        options += ", [<]prevturn, [>]nextturn"
    if allow_revision:
        options += ", [e]dit, E <prompt>"
    usage = f"Usage: {options}"

    def process_input(patch_input: str) -> str | None:
        nonlocal suffix_provided
        choice = process_tool_review_input(
            patch_input,
            diff_text,
            usage,
        )
        if choice is not None and choice.lower() == "s":
            suffix_provided = not suffix_provided
            state = "enabled" if suffix_provided else "disabled"
            print(f"Patch suffix {state}.")
            return None
        return choice

    review_action, revision_task = review_tool_text(
        diff_text,
        prompt,
        accept_automatically=accept_automatically,
        input_processor=process_input,
        invalid_choice_message=usage,
        allow_revision=allow_revision,
        additional_actions=("<", ">") if allow_navigation else (),
        display_text=display_text,
    )
    return review_action, revision_task, suffix_provided


def append_session_log(
    log_path: Path | None,
    text: str,
    enabled: bool = True,
) -> None:
    if not enabled or log_path is None:
        return
    log_path.parent.mkdir(parents=True, exist_ok=True)
    with log_path.open("a", encoding="utf-8") as log_file:
        log_file.write(text)


def format_model_response_log(
    response_text: str,
    reasoning: str,
    response_tag: str = "response",
) -> str:
    reasoning_tag = (
        "reasoning"
        if response_tag == "response"
        else f"{response_tag}_reasoning"
    )
    reasoning_block = (
        f"<{reasoning_tag}>\n{reasoning}\n</{reasoning_tag}>\n"
        if reasoning
        else ""
    )
    return (
        f"{reasoning_block}"
        f"<{response_tag}>\n{response_text}\n</{response_tag}>\n"
    )


@dataclass
class RecordedModelTurn:
    settings: ModelRequestSettings
    cumulative_stats: CumulativeStats
    logger: Callable[[str], None]
    turn: int | None = None
    prefix: str = ""
    response_tag: str = "response"
    session_stats: CumulativeStats | None = None
    system_prompt: str = ""
    user_prompt: str = ""
    tools: list[dict[str, Any]] | None = None
    timer: ModelRequestTimer = field(default_factory=ModelRequestTimer)
    request_text: str = ""
    request_tokens: int = 0
    request_characters: int = 0
    turn_dir: Path | None = None
    response_stats: str = ""

    def prepare(
        self,
        system_prompt: str,
        user_prompt: str,
        *,
        tools: list[dict[str, Any]] | None = None,
        request_tokens: int | None = None,
    ) -> None:
        self.system_prompt = system_prompt
        self.user_prompt = user_prompt
        self.tools = tools
        self.request_text = format_request_text(
            system_prompt, user_prompt, tools=tools
        )
        self.request_tokens = (
            len(
                token_encoding_for_model(self.settings.model_settings.model).encode(
                    self.request_text
                )
            )
            if request_tokens is None
            else request_tokens
        )
        self.request_characters = len(self.request_text)

    def check_token_limit(self, label: str = "input") -> None:
        if self.request_tokens > self.settings.token_limit:
            raise ValueError(
                f"Estimated {label} token count ({self.request_tokens}) exceeds "
                f"token limit ({self.settings.token_limit})"
            )

    def log_request(self, stats_tag: str = "request_stats") -> None:
        emit_stats(
            format_request_stats(
                request_characters=self.request_characters,
                request_tokens=self.request_tokens,
                token_cost=self.settings.token_cost,
                model_settings=self.settings.model_settings,
                turn=self.turn,
                prefix=self.prefix,
            ),
            self.logger,
            stats_tag,
        )
        self.logger(f"<request>\n{self.request_text}\n</request>\n")

    def log_response(self, response_text: str, reasoning: str) -> None:
        self.logger(format_model_response_log(
            response_text, reasoning, self.response_tag
        ))

    def start_state(
        self,
        state_session_dir: Path,
        turn: int,
        task: str,
        file_paths: list[Path],
        *,
        skip_missing_files: bool = False,
    ) -> Path:
        self.turn_dir = start_state_turn(
            state_session_dir, turn, self.system_prompt, task, file_paths,
            skip_missing_files=skip_missing_files,
            request_text=(
                self.request_text or format_request_text(
                    self.system_prompt, self.user_prompt, tools=self.tools
                )
            ),
        )
        return self.turn_dir

    @contextmanager
    def record(self) -> Iterator[None]:
        try:
            yield
        finally:
            self.response_stats = record_response_stats(
                self.timer, self.cumulative_stats,
                request_characters=self.request_characters,
                request_tokens=self.request_tokens,
                token_cost=self.settings.token_cost,
                session_stats=self.session_stats,
                turn=self.turn,
                prefix=self.prefix,
            )

    def call(
        self,
        *,
        stream: bool = False,
        emit: Callable[[str], None] | None = None,
        **options: Any,
    ) -> tuple[Any, str]:
        options.setdefault("request_logger", self.logger)
        options.setdefault("response_logger", self.log_response)
        response_obj = call_model(
            self.settings.model_settings,
            self.system_prompt, self.user_prompt,
            stream=stream,
            tools=self.tools,
            request_timer=self.timer,
            **options,
        )
        if stream:
            response, response_obj = consume_response_stream(
                response_obj,
                emit,
                response_logger=options["response_logger"],
                request_timer=self.timer,
            )
        else:
            response = response_output_text(response_obj)
        return response_obj, response

    def complete(
        self,
        response_obj: Any,
        response: str,
    ) -> tuple[str, tuple[dict[str, Any], ...]]:
        reasoning = response_reasoning_text(response_obj)
        reasoning_items = response_reasoning_encrypted_items(response_obj)
        if self.turn_dir is not None:
            complete_state_turn(
                self.turn_dir, reasoning, response, reasoning_items
            )
        return reasoning, reasoning_items

    def record_error(self, error: BaseException | str) -> None:
        if self.turn_dir is not None:
            append_state_response_error(self.turn_dir, error)
        detail = format_exception_message(error)
        self.logger(
            f"<{self.response_tag}_error>\n{detail}\n"
            f"</{self.response_tag}_error>\n"
        )


def request_agent_model(
    settings: AgentRunSettings,
    system_prompt: str,
    user_prompt: str,
    task: str,
    json_schema: dict[str, Any] | None = None,
    tools: list[dict[str, Any]] | None = None,
    record_state: bool = True,
    summary_token_budget: int | None = None,
    reasoning_items: tuple[dict[str, Any], ...] = (),
    turn_metadata: dict[str, Any] | None = None,
    assist_type: str = "",
) -> AgentModelResult:
    response_tool_schema = AGENT_ASSIST_TOOL_SCHEMAS.get(assist_type)
    if assist_type and response_tool_schema is None:
        raise ValueError(f"unknown agent assist type: {assist_type}")
    request_name = f"agent_{assist_type}_assist" if assist_type else "agent"
    if summary_token_budget is not None:
        if assist_type or json_schema is not None:
            raise ValueError(
                "agent context summary requests cannot use assist tools "
                "or a JSON schema"
            )
        response_tool_schema = AGENT_CONTEXT_SUMMARY_TOOL_SCHEMA
    if response_tool_schema is not None:
        tools = [response_tool_schema]

    append_log = partial(
        append_session_log, settings.log_path, enabled=settings.log_enabled
    )

    model_settings = settings.model_settings
    if summary_token_budget is not None:
        model_settings = replace(
            model_settings,
            extra_body={
                name: value
                for name, value in (model_settings.extra_body or {}).items()
                if name not in ("tools", "tool_choice", "parallel_tool_calls")
            },
        )
    current_turn = (
        settings.state_turn
        if record_state
        else max(0, settings.state_turn - 1)
    )
    request = RecordedModelTurn(
        ModelRequestSettings(model_settings, settings.token_limit, settings.token_cost),
        settings.cumulative_stats,
        append_log,
        turn=current_turn,
        prefix=f"request_type={request_name}",
        response_tag=f"{request_name}_response",
        session_stats=settings.session_stats,
    )
    request.prepare(system_prompt, user_prompt, tools=tools)
    request.check_token_limit("agent input")
    turn_dir: Path | None = None
    if record_state:
        turn_dir = request.start_state(
            settings.state_session_dir, settings.state_turn, task,
            settings.file_paths, skip_missing_files=True,
        )
        write_state_reasoning_items(turn_dir, reasoning_items)
        write_state_agent_runtime_state(
            turn_dir, settings, "request", turn_metadata
        )
    append_log(f"<{request_name}_request>\n")
    request.log_request()
    append_log(f"</{request_name}_request>\n")
    log_tool_schema = True

    def request_response() -> tuple[Any, str, tuple[AgentToolCall, ...]]:
        nonlocal log_tool_schema
        try:
            response_obj, response = request.call(
                image_urls=settings.image_urls,
                response_format=("schema" if json_schema is not None else "text"),
                json_schema=json_schema,
                retry=0,
                report_errors=False,
                request_logger=append_log if log_tool_schema else None,
                tool_choice="required" if tools else None,
                parallel_tool_calls=(
                    False if response_tool_schema is not None
                    else True if tools else None
                ),
                reasoning_items=reasoning_items,
            )
        finally:
            log_tool_schema = False
        parsed_tool_calls: tuple[AgentToolCall, ...] = ()
        if response_tool_schema is not None:
            arguments = parse_agent_assist_response(
                response_obj,
                model_settings.model,
                response_tool_schema,
                model_settings.response_json_repair,
                available_prompts=(
                    agent_system_prompts(settings)
                    if assist_type == "prompt"
                    else None
                ),
                token_budget=(
                    AGENT_CONTEXT_ASSIST_MAX_TOKENS
                    if summary_token_budget is None
                    else summary_token_budget
                ),
            )
            response = (
                json.dumps(arguments, ensure_ascii=False)
                if assist_type
                else arguments["summary"]
            )
        elif tools:
            parsed_tool_calls = tuple(response_agent_tool_calls(
                response_obj,
                settings.agent_profiles,
                agent_expires_in_turns_schema(settings.agent_context_expires),
                response_json_repair=model_settings.response_json_repair,
                default_profile=settings.agent_profile_default,
            ))
            for tool_call in parsed_tool_calls:
                if tool_call.tool == AGENT_PATCH_TOOL:
                    try:
                        manifest = tool_call.arguments
                        if manifest is None:
                            raise ValueError("agent patch tool received no manifest")
                        build_patch_changes({}, manifest)
                    except ValueError as exc:
                        raise AgentControllerResponseError(
                            f"agent patch arguments are invalid: {exc}"
                        ) from exc
            try:
                response = format_agent_tool_calls(list(parsed_tool_calls))
            except (TypeError, ValueError, KeyError, UnicodeError, RecursionError, OverflowError) as exc:
                raise AgentControllerResponseError(
                    f"agent tool calls could not be serialized: {exc}"
                ) from exc
            parse_agent_response_json(response, "agent tool calls")
        elif json_schema is not None:
            response = normalize_agent_json_response(
                response, json_schema, model_settings.response_json_repair
            )
        return response_obj, response, parsed_tool_calls

    try:
        try:
            with request.record():
                response_obj, response, parsed_tool_calls = execute_openai_request(
                    request_response,
                    retry=model_settings.retry,
                    operation_name=(
                        f"Agent {assist_type} assist request"
                        if assist_type
                        else "Agent request"
                    ),
                    report_errors=not assist_type,
                    error_logger=append_log,
                    retry_if=lambda exc: (
                        isinstance(exc, AgentControllerResponseError)
                        or _is_openai_temp_error(exc)
                    ),
                )
            if turn_dir is not None and not assist_type:
                settings.prior_token_estimates.append(
                    (current_turn, request.request_tokens)
                )
                del settings.prior_token_estimates[
                    :-AGENT_PRIOR_TOKEN_ESTIMATES_MAX_TURNS
                ]
        finally:
            emit_stats(
                request.response_stats, append_log,
                f"{request_name}_response_stats",
            )
            if turn_dir is not None:
                write_state_agent_runtime_state(
                    turn_dir, settings, turn_metadata=turn_metadata
                )
            elif settings.runtime_state_checkpoint is not None:
                settings.runtime_state_checkpoint()
        reasoning, response_reasoning_items = request.complete(response_obj, response)
        if turn_dir is not None:
            settings.state_turn += 1
            turn_unix_time = state_artifact_last_modified_time(turn_dir / "response")
        else:
            turn_unix_time = None
    except Exception as exc:
        request.record_error(exc)
        raise
    return AgentModelResult(
        response=response,
        reasoning=reasoning,
        turn_dir=turn_dir,
        turn_unix_time=turn_unix_time,
        tool_calls=parsed_tool_calls,
        reasoning_items=response_reasoning_items,
    )


@dataclass
class AgentAssist:
    settings: AgentRunSettings
    assist_type: str
    executor: ThreadPoolExecutor | None = None
    future: Future[AgentModelResult] | None = None
    request_settings: AgentRunSettings | None = None
    request_turn: int = 0
    request_summary: AgentContextSummary | None = None
    context_removal_handler: Callable[
        [list[int], list[int], str, int],
        tuple[list[int], list[int]],
    ] | None = field(default=None, repr=False)


    def restore_pending(self) -> None:
        pending = self.settings.pending_assists.get(self.assist_type)
        if pending is None:
            return
        self.request_turn = pending["turn"]
        session_dir = STATE_DIR / pending["session_name"]
        assist_dir = session_dir / f"{self.assist_type}_assist"
        turn_dir = assist_dir / str(self.request_turn)
        self.request_settings = replace(
            self.settings,
            state_session_dir=assist_dir,
            state_turn=self.request_turn,
            context="",
            file_context_ids=self.settings.file_context_ids.copy(),
            log_path=turn_dir / "log" if self.settings.log_enabled else None,
            cumulative_stats=CumulativeStats(),
            session_stats=self.settings.session_stats or self.settings.cumulative_stats,
            runtime_state_checkpoint=None,
        )
        self.settings.cumulative_stats.track_pending(
            self.request_settings.cumulative_stats
        )
        self.request_summary = AgentContextSummary()
        future: Future[AgentModelResult] = Future()
        self.future = future
        try:
            if any(path.is_symlink() for path in (session_dir, assist_dir, turn_dir)):
                raise ValueError("saved assist directories cannot be symbolic links")
            runtime_state = load_state_agent_runtime_state(turn_dir)
            if runtime_state is not None:
                self.request_settings.cumulative_stats.restore(
                    runtime_state["cumulative_stats"]
                )
                self.request_settings.file_context_ids = runtime_state["file_context_ids"].copy()
                metadata = runtime_state["turn_metadata"] or {}
                reviewed_context = metadata.get("reviewed_file_context", "")
                if isinstance(reviewed_context, str):
                    self.request_settings.context = reviewed_context
                request_history = reused_agent_runtime_history(
                    ReusedAgentHistory((), "", ""), runtime_state
                )
                self.request_summary = (
                    request_history.context_summary or AgentContextSummary()
                )
            else:
                self.request_summary = (
                    load_state_agent_context_summary(turn_dir)
                    or AgentContextSummary()
                )
            response = read_optional_state_artifact(turn_dir / "response")
            if response is None:
                raise ValueError("interrupted assist request has no saved response")
            future.set_result(
                AgentModelResult(
                    response=response,
                    reasoning=read_optional_state_artifact(
                        turn_dir / "response_reasoning"
                    ) or "",
                    turn_dir=turn_dir,
                )
            )
        except Exception as exc:
            future.set_exception(exc)

    def is_due(self) -> bool:
        interval = getattr(self.settings, f"agent_{self.assist_type}_assist")
        current_turn = self.settings.state_turn
        last_turn = self.settings.assist_last_turns.get(self.assist_type, 0)
        retry_turn = self.settings.assist_retry_turns.get(self.assist_type)
        return (
            interval is not None
            and interval > 0
            and current_turn > 0
            and (
                current_turn >= retry_turn
                if retry_turn is not None
                else (current_turn - last_turn) % interval == 0
            )
            and current_turn > last_turn
        )

    def start_if_due(
        self,
        system_prompt: str,
        user_prompt: str,
        tools: list[dict[str, Any]] | None,
        task: str,
    ) -> None:
        self.collect()
        if not self.is_due():
            return
        interval = getattr(self.settings, f"agent_{self.assist_type}_assist")
        current_turn = self.settings.state_turn
        last_compaction_turn = self.settings.last_compaction_turn
        recently_compacted = (
            last_compaction_turn is not None
            and 0 <= current_turn - last_compaction_turn <= interval
        )
        if self.assist_type == "context" and (
            recently_compacted
            or (
                self.settings.context_assist_skip_next_interval
                and self.assist_type not in self.settings.assist_retry_turns
            )
        ):
            self.settings.context_assist_skip_next_interval = False
            self.settings.assist_retry_turns.pop(self.assist_type, None)
            self.settings.assist_last_turns[self.assist_type] = current_turn
            if self.settings.runtime_state_checkpoint is not None:
                self.settings.runtime_state_checkpoint()
            return
        summary = self.settings.context_summary
        request_summary = (
            replace(summary) if summary is not None else AgentContextSummary()
        )
        request_text = format_request_text(
            system_prompt, user_prompt, tools=tools
        )
        prompts = agent_system_prompts(self.settings)
        prompt_inventory = (
            format_agent_system_prompt_inventory(self.settings)
            if self.assist_type == "prompt"
            else ""
        )
        assist_system_prompt = join_prompt_sections(
            prompts[f"{self.assist_type}_assist_system_prompt"],
            f"The configured {self.assist_type} assist interval is {interval} "
            f"agent turns. This review is for turn {current_turn}.",
        )
        assist_tools = [AGENT_ASSIST_TOOL_SCHEMAS[self.assist_type]]
        request_profile = (
            getattr(self.settings, f"agent_{self.assist_type}_assist_settings")
            or ModelRequestSettings(
                model_settings=self.settings.model_settings,
                token_limit=self.settings.token_limit,
                token_cost=self.settings.token_cost,
            )
        )

        def fits_assist_context(request: str) -> bool:
            return estimate_request_tokens(
                model=request_profile.model_settings.model,
                system_prompt=assist_system_prompt,
                user_prompt=join_prompt_sections(request, prompt_inventory),
                tools=assist_tools,
            ) <= request_profile.token_limit

        request_text = truncate_text_to_tokens(
            request_text,
            request_profile.model_settings.model,
            request_profile.token_limit,
            fits_context=fits_assist_context,
            marker="\n[... agent request truncated to fit the assist token limit ...]\n",
        )
        if not request_text:
            self.settings.assist_retry_turns[self.assist_type] = current_turn + 1
            if self.settings.runtime_state_checkpoint is not None:
                self.settings.runtime_state_checkpoint()
            print(
                f"WARNING: Agent {self.assist_type} assist request cannot fit "
                f"within its token limit ({request_profile.token_limit}).",
                file=sys.stderr,
            )
            return
        request_text = join_prompt_sections(request_text, prompt_inventory)
        state_session_dir = (
            self.settings.state_session_dir / f"{self.assist_type}_assist"
        )
        request_settings = replace(
            self.settings,
            model_settings=request_profile.model_settings,
            token_limit=request_profile.token_limit,
            token_cost=request_profile.token_cost,
            state_session_dir=state_session_dir,
            state_turn=current_turn,
            file_paths=[],
            log_path=(
                state_session_dir / str(current_turn) / "log"
                if self.settings.log_enabled
                else None
            ),
            context_summary=replace(request_summary),
            file_context_ids=self.settings.file_context_ids.copy(),
            system_prompt_overrides=self.settings.system_prompt_overrides.copy(),
            previous_system_prompts=self.settings.previous_system_prompts.copy(),
            original_system_prompts=self.settings.original_system_prompts.copy(),
            session_stats=self.settings.session_stats or self.settings.cumulative_stats,
            context_assist_summary="",
            context_assist_require_compaction=False,
            context_assist_skip_next_interval=False,
            prior_token_estimates=[],
            pending_revision_instruction="",
            advance_expirations=True,
            assist_last_turns={},
            assist_retry_turns={},
            pending_assists={},
            runtime_state_checkpoint=None,
            cumulative_stats=CumulativeStats(token_cost=request_profile.token_cost),
        )
        self.settings.cumulative_stats.track_pending(request_settings.cumulative_stats)
        if self.executor is None:
            self.executor = ThreadPoolExecutor(max_workers=1)
        self.request_settings = request_settings
        self.request_turn = current_turn
        self.request_summary = request_summary
        self.settings.assist_last_turns[self.assist_type] = current_turn
        self.settings.pending_assists[self.assist_type] = {
            "session_name": self.settings.state_session_dir.name,
            "turn": current_turn,
        }
        if self.settings.runtime_state_checkpoint is not None:
            self.settings.runtime_state_checkpoint()
        self.future = self.executor.submit(
            request_agent_model,
            request_settings,
            assist_system_prompt,
            request_text,
            task,
            assist_type=self.assist_type,
            turn_metadata=(
                {"reviewed_file_context": request_settings.context}
                if self.assist_type == "context"
                else None
            ),
        )

    def collect(self) -> None:
        if self.future is None:
            self.restore_pending()
        if self.future is None or self.request_settings is None:
            return
        future = self.future
        request_settings = self.request_settings
        request_summary = self.request_summary or AgentContextSummary()
        try:
            result = future.result()
            assist = json.loads(result.response)
            if self.assist_type == "context":
                self.apply_context_result(
                    assist, request_summary, request_settings.context
                )
            else:
                prompts = agent_system_prompts(self.settings)
                updates = normalize_agent_prompt_assist_updates(
                    assist["prompts"], prompts
                )
                changed_prompts = {
                    update["name"]: update["content"]
                    for update in updates
                    if prompts[update["name"]] != update["content"]
                }
                self.settings.previous_system_prompts.update({
                    name: prompts[name] for name in changed_prompts
                })
                self.settings.system_prompt_overrides.update(changed_prompts)
                updated_prompt_text = ", ".join(changed_prompts) or "none"
                emit_agent_output(
                    self.settings,
                    format_agent_turn_report(
                        "Prompt assist:\n"
                        f"Updated prompts: {updated_prompt_text}\n"
                        f"Summary:\n{assist['summary']}",
                        self.request_turn,
                    ),
                )
        except Exception as exc:
            self.settings.assist_retry_turns[self.assist_type] = self.request_turn + 1
            print(
                f"WARNING: Agent {self.assist_type} assist failed: "
                f"{format_exception_message(exc)}",
                file=sys.stderr,
            )
        else:
            self.settings.assist_retry_turns.pop(self.assist_type, None)
        finally:
            self.settings.pending_assists.pop(self.assist_type, None)
            self.settings.cumulative_stats.merge_pending(
                request_settings.cumulative_stats
            )
            self.future = None
            self.request_settings = None
            self.request_summary = None
            if self.settings.runtime_state_checkpoint is not None:
                self.settings.runtime_state_checkpoint()
        if request_settings.log_path is not None:
            try:
                log_text = read_optional_state_artifact(request_settings.log_path)
                if log_text is not None:
                    append_session_log(
                        self.settings.log_path,
                        log_text,
                        self.settings.log_enabled,
                    )
            except Exception as exc:
                print(
                    f"WARNING: Failed to append agent {self.assist_type} assist log: {exc}",
                    file=sys.stderr,
                )

    def apply_context_result(
        self,
        assist: dict[str, Any],
        request_summary: AgentContextSummary,
        reviewed_context: str = "",
    ) -> None:
        remove_turn_ids = normalize_agent_context_assist_ids(
            assist.get("remove_turn_ids", []), "remove_turn_ids"
        )
        remove_file_ids = normalize_agent_context_assist_ids(
            assist.get("remove_file_ids", []), "remove_file_ids"
        )
        clear_stale_summary = assist["clear_stale_summary"]
        summary = self.settings.context_summary
        summary_updated = bool(
            summary is not None
            and summary.generated_turn is not None
            and summary.generated_turn >= self.request_turn
        )
        summary_compacted = bool(
            summary_updated
            and summary is not None
            and (
                summary.removed_file_paths,
                summary.removed_turn_numbers,
                summary.active_context_checksum,
            ) != (
                request_summary.removed_file_paths,
                request_summary.removed_turn_numbers,
                request_summary.active_context_checksum,
            )
        )
        self.settings.context_assist_summary = assist["summary"]
        self.settings.context_assist_require_compaction = (
            not clear_stale_summary
            and (
                self.settings.context_assist_require_compaction
                or (assist["require_compaction"] and not summary_compacted)
            )
        )
        self.settings.context_assist_skip_next_interval = (
            self.settings.context_assist_skip_next_interval
            or assist["skip_next_context_assist_interval"]
        )
        summary_cleared = bool(
            clear_stale_summary
            and not summary_updated
            and summary is not None
            and summary.content
            and summary.content == request_summary.content
        )
        if summary_cleared:
            summary.content = ""
            summary.expires_in_turns = self.settings.agent_context_expires[0]
            summary.generated_turn = None
        removed_turn_ids: list[int] = []
        removed_file_ids: list[int] = []
        if self.context_removal_handler is not None and (
            remove_turn_ids or remove_file_ids
        ):
            removed_turn_ids, removed_file_ids = self.context_removal_handler(
                remove_turn_ids, remove_file_ids, reviewed_context, self.request_turn
            )
        emit_agent_output(
            self.settings,
            format_agent_context_assist_report(
                assist["summary"],
                self.settings.context_assist_require_compaction,
                self.request_turn,
                clear_stale_summary=summary_cleared,
                skip_next_context_assist_interval=(
                    self.settings.context_assist_skip_next_interval
                ),
                removed_turn_ids=removed_turn_ids,
                removed_file_ids=removed_file_ids,
            ),
        )

    def close(self) -> None:
        try:
            self.collect()
        finally:
            if self.executor is not None:
                self.executor.shutdown(wait=True)


def run_agent_profile_tool(
    settings: AgentRunSettings,
    profile_name: str,
    task: str,
    context: str,
    reasoning_items: tuple[dict[str, Any], ...] = (),
 ) -> AgentToolExecution:
    profiles = settings.agent_profiles
    if settings.agent_profile_default is not None:
        profiles += (settings.agent_profile_default,)
    try:
        profile = next(
            profile
            for profile in profiles
            if profile.name == profile_name
        )
    except StopIteration:
        return AgentToolExecution(
            f"ERROR: Agent profile does not exist: {profile_name}"
        )

    try:
        profile_type = normalize_agent_profile_type(profile.profile_type)
        response_schema = agent_profile_response_schema(profile)
        prompts = agent_system_prompts(settings)
        worker_prompt_parts = [prompts["worker_system_prompt"]]
        if settings.add_line_numbers:
            worker_prompt_parts.append(prompts["linenum_system_prompt"])
        if profile_type == "patch":
            worker_prompt_parts.append(prompts["patch_system_prompt"])
        elif profile_type == "shell":
            worker_prompt_parts.append(prompts["shell_system_prompt"])
        worker_context = (
            format_context_entry(
                "agent_context",
                f"{context}\n",
                model=settings.model_settings.model,
            )
            if context
            else ""
        )
        worker_system_prompt, worker_user_prompt = build_request_prompts(
            system_prompt=join_prompt_sections(*worker_prompt_parts),
            task=task,
            context=settings.context,
            response_format="schema",
            json_schema=response_schema,
            additional_prompt=worker_context,
            additional_instructions=prompts[f"agent_profile_{profile.name}"].strip(),
            context_prefix=format_agent_context_summary(
                settings.context_summary,
                model=settings.model_settings.model,
            ),
            current_unix_time=int(time.time()),
            agent_mode=True,
        )
        result = request_agent_model(
            settings,
            worker_system_prompt,
            worker_user_prompt,
            task,
            json_schema=response_schema,
            record_state=False,
            reasoning_items=reasoning_items,
        )
    except Exception as exc:
        return AgentToolExecution(
            f"ERROR: Agent profile tool failed: {exc}"
        )
    return AgentToolExecution(
        result.response,
        reasoning_items=result.reasoning_items,
    )



def run_agent_load_file_from_storage_tool(
    settings: AgentRunSettings,
    path_texts: list[str],
    current_token_estimate: int = 0,
    estimate_context_tokens: Callable[
        [tuple[tuple[str, str], ...], str], int
    ] | None = None,
) -> AgentToolExecution:
    if (
        not isinstance(path_texts, list)
        or not path_texts
        or any(not isinstance(path, str) for path in path_texts)
    ):
        return AgentToolExecution(
            f"ERROR: {AGENT_LOAD_FILE_FROM_STORAGE_TOOL} tool "
            "received invalid paths."
        )

    def estimate_file_context_tokens(
        contexts: tuple[tuple[str, str], ...],
    ) -> int:
        if estimate_context_tokens is None:
            return 0
        return estimate_context_tokens(
            contexts, "\n".join(section for _, section in contexts)
        )

    try:
        file_paths = list(
            dict.fromkeys(resolve_context_file_paths(path_texts))
        )
        sections = build_context_sections(
            file_paths=file_paths,
            max_file_size_kb=settings.max_file_size_kb,
            add_line_numbers=True,
            missing_file_expires_in_turns=settings.agent_context_expires[1],
            model=settings.model_settings.model,
            token_limit=max(
                0, settings.token_limit - AGENT_FILE_CONTEXT_TOKEN_RESERVE
            ),
            current_token_estimate=current_token_estimate,
            existing_context_sections=(
                parse_agent_readfile_contexts(settings.context) or ()
            ),
            file_context_ids=settings.file_context_ids,
            estimate_context_tokens=(
                estimate_file_context_tokens
                if estimate_context_tokens is not None
                else None
            ),
        )
    except Exception as exc:
        return AgentToolExecution(
            f"ERROR: {AGENT_LOAD_FILE_FROM_STORAGE_TOOL} tool failed: {exc}"
        )
    return AgentToolExecution(
        "\n".join(section for _, section in sections),
        readfile_contexts=tuple(sections),
    )


def run_agent_meta_task_list_tool(
    settings: AgentRunSettings,
    task_list: list[dict[str, Any]],
    operations: list[dict[str, Any]],
) -> AgentToolExecution:
    try:
        task_list = apply_agent_meta_task_operations(
            task_list,
            operations,
            current_turn=max(0, settings.state_turn - 1),
        )
        write_state_meta_task_list(settings.state_session_dir, task_list)
    except Exception as exc:
        return AgentToolExecution(
            f"ERROR: Failed to update task list: {exc}"
        )
    # Return the snapshot for per-turn persistence by the controller.
    return AgentToolExecution(
        format_agent_meta_task_list(task_list),
        meta_task_list=tuple(task_list),
    )

def run_agent_shell_tool(
    settings: AgentRunSettings,
    commands: list[ShellStep],
    turn_dir: Path,
    previous_task: str,
    tool_call_index: int = 0,
) -> AgentToolExecution:
    review_action, revision_task = review_shell_commands(
        commands,
        accept_automatically=settings.agent_auto,
    )
    if review_action == "edit":
        if revision_task is None:
            try:
                revision_task = edit_tool_revision_task(
                    format_shell_commands(commands, include_reasons=False),
                    previous_task,
                )
            except Exception as exc:
                return AgentToolExecution(
                    f"ERROR: Failed to edit shell tool task: {exc}"
                )
        if revision_task:
            return AgentToolExecution(
                "Shell command revision was requested.",
                revision_task,
            )
        return AgentToolExecution("Shell command revision was abandoned.")
    if review_action == "save":
        return AgentToolExecution(
            "Shell commands were saved without execution.\n"
            f"<shell_commands>\n{format_shell_commands(commands, include_reasons=False)}\n"
            "</shell_commands>"
        )
    if review_action != "accept":
        return AgentToolExecution(
            "Shell commands were rejected and were not run."
        )
    shell_output = execute_shell_commands(
        commands,
        settings.shell_timeout,
        contain=settings.contain,
        shell_networking=settings.shell_networking,
        print_exit_status=True,
        shell_trace=settings.shell_trace,
        turn_dir=turn_dir,
        tool_call_index=tool_call_index,
    )
    try:
        write_state_artifact(
            turn_dir,
            f"response_shell_output_{tool_call_index}",
            shell_output,
        )
    except Exception as exc:
        return AgentToolExecution(
            f"ERROR: Failed to save shell tool output: {exc}"
        )
    return AgentToolExecution(shell_output)
 
 
def run_agent_patch_tool(
    settings: AgentRunSettings,
    manifest: dict[str, Any],
    turn_dir: Path,
    previous_task: str,
    tool_call_index: int = 0,
    current_token_estimate: int = 0,
    estimate_context_tokens: Callable[
        [tuple[tuple[str, str], ...], str], int
    ] | None = None,
) -> AgentToolExecution:
    suffix_provided = settings.suffix_provided
    patch_suffix = settings.patch_suffix
    if settings.agent_auto and not settings.patch_suffix_argument_provided:
        patch_suffix = ""
        suffix_provided = False
    try:
        updated_texts, diff_text, changed_items = build_patch_changes(
            {},
            manifest,
        )
        manifest_text = json.dumps(manifest, indent=2, ensure_ascii=False)
        write_state_patch_artifacts(
            turn_dir,
            manifest_text,
            diff_text,
            tool_call_index=tool_call_index,
        )
    except Exception as exc:
        return AgentToolExecution(f"ERROR: Patch tool failed: {exc}")

    review_action, revision_task, suffix_provided = review_patch_changes(
        diff_text,
        suffix_provided,
        settings.agent_auto,
        prompt="Apply this agent patch? [y/n/p/h/S/e/E <prompt>]: ",
    )
    if review_action == "edit":
        if revision_task is None:
            try:
                revision_task = edit_tool_revision_task(
                    diff_text,
                    previous_task,
                )
            except Exception as exc:
                return AgentToolExecution(
                    f"ERROR: Failed to edit patch tool task: {exc}"
                )
        if revision_task:
            return AgentToolExecution(
                "Patch revision was requested.",
                revision_task,
            )
        return AgentToolExecution("Patch tool revision was abandoned.")
    if review_action == "save":
        return AgentToolExecution(
            "Patch manifest was saved in the session without writing files."
        )
    if review_action != "accept":
        return AgentToolExecution(
            "Patch changes were rejected and were not written."
        )
    created_paths: list[str] = []
    try:
        written_paths = write_patch_changes(
            changed_items=changed_items,
            all_paths=[Path(path) for path in updated_texts],
            patch_review=settings.patch_review,
            patch_suffix=patch_suffix,
            suffix_provided=suffix_provided,
            patch_branch_setting=None,
            patch_commit_message=str(
                manifest.get("commit_message", "Agent patch")
            ).strip() or "Agent patch",
            created_paths=created_paths,
        )
        write_state_artifact(
            turn_dir,
            f"response_schema_patch_applied_{tool_call_index}",
            "\n".join(written_paths),
        )
    except Exception as exc:
        output = f"ERROR: Failed to write patch tool changes: {exc}"
    else:
        written_paths_text = "\n".join(written_paths)
        output = (
            "Patch changes were written.\n"
            f"<written_paths>\n{written_paths_text}\n</written_paths>"
        )
    if not created_paths:
        return AgentToolExecution(output)

    def estimate_created_context_tokens(
        contexts: tuple[tuple[str, str], ...],
        context_output: str,
    ) -> int:
        if estimate_context_tokens is None:
            return 0
        return estimate_context_tokens(
            contexts,
            join_prompt_sections(
                output,
                agent_readfile_error_output(context_output, contexts),
            ),
        )

    execution = run_agent_load_file_from_storage_tool(
        settings,
        created_paths,
        current_token_estimate=current_token_estimate,
        estimate_context_tokens=(
            estimate_created_context_tokens
            if estimate_context_tokens is not None
            else None
        ),
    )
    return AgentToolExecution(
        join_prompt_sections(
            output,
            agent_readfile_error_output(
                execution.output, execution.readfile_contexts
            ),
        ),
        readfile_contexts=execution.readfile_contexts,
    )


def prepare_agent_context(
    settings: AgentRunSettings,
) -> AgentResultState:
    turns: list[AgentTurn] = list(settings.initial_turns)
    file_contexts = list(agent_context_file_sections(settings))
    file_expires_in_turns = agent_file_context_expirations(
        file_contexts, settings.agent_context_expires[0]
    )
    if settings.initial_turn_metadata is None:
        pinned_paths, pinned_turn_numbers = reused_agent_context_pins(
            file_contexts,
            turns,
            file_expires_in_turns,
            initial_pinned_paths=set(settings.pinned_file_paths),
            turn_number_base=settings.initial_turn_number_base,
        )
    else:
        metadata = settings.initial_turn_metadata
        if not settings.refresh_initial_file_contexts:
            if metadata.get("file_contexts") is not None:
                file_contexts = list(
                    normalize_state_agent_file_contexts(metadata["file_contexts"])
                )
            saved_expirations = metadata["file_expires_in_turns"]
            file_contexts[:] = [
                context for context in file_contexts
                if context[0] in saved_expirations
            ]
            file_expires_in_turns = {
                path: saved_expirations[path]
                for path, _ in file_contexts
            }
        pinned_paths = set(metadata["pinned_file_paths"]).intersection(
            file_expires_in_turns
        )
        pinned_paths.update(settings.pinned_file_paths)
        pinned_turn_numbers = set(metadata["pinned_turn_numbers"])
    context_summary = (
        replace(settings.context_summary)
        if settings.context_summary is not None
        else AgentContextSummary(
            expires_in_turns=settings.agent_context_expires[0]
        )
    )
    settings.context_summary = context_summary
    apply_agent_context_summary(
        context_summary,
        file_contexts,
        turns,
        file_expires_in_turns,
        pinned_paths,
        pinned_turn_numbers,
    )
    meta_task_list = limit_agent_meta_task_list(
        normalize_agent_meta_task_list(
            list(settings.initial_meta_task_list),
        )
    )
    return AgentResultState(
        turns=turns,
        active_task=settings.task,
        active_context=settings.initial_active_context,
        meta_task_list=meta_task_list,
        context_summary=context_summary,
        file_contexts=file_contexts,
        file_expires_in_turns=file_expires_in_turns,
        pinned_paths=pinned_paths,
        pinned_turn_numbers=pinned_turn_numbers,
    )


def prepare_agent_context_summary_request(
    settings: AgentRunSettings,
) -> bool:
    summary = settings.context_summary
    return (
        summary is not None
        and bool(summary.content)
        and summary.expires_in_turns <= 0
        and summary.generated_turn != settings.state_turn - 1
    )


@dataclass(frozen=True)
class AgentControllerRequest:
    system_prompt: str
    user_prompt: str
    tools: list[dict[str, Any]]
    request_tokens: int
    summary_token_budget: int | None
    compaction: AgentContextCompaction | None


def build_agent_controller_request(
    settings: AgentRunSettings,
    state: AgentResultState,
    *,
    hook_contents: tuple[str, ...] = (),
    advance_expirations: bool = False,
    refresh_summary: bool = False,
    limit_context: bool = True,
    file_context_ids: dict[str, int] | None = None,
) -> AgentControllerRequest:
    controller_tools = agent_tool_schemas(
        settings.agent_profiles,
        agent_expires_in_turns_schema(settings.agent_context_expires),
        default_profile=settings.agent_profile_default,
        prompt_overrides=settings.system_prompt_overrides,
    )
    prompts = agent_system_prompts(settings)
    system_prompt, user_prompt, summary_token_budget, compaction = (
        build_agent_context_window_prompts(
            model=settings.model_settings.model,
            token_limit=settings.token_limit,
            system_prompt=prompts["agent_system_prompt"],
            task=state.active_task,
            file_contexts=(
                state.file_contexts if state.file_contexts is not None else []
            ),
            turns=state.turns,
            active_context=state.active_context,
            pinned_paths=state.pinned_paths,
            pinned_turn_numbers=state.pinned_turn_numbers,
            file_expires_in_turns=state.file_expires_in_turns,
            file_context_ids=(
                settings.file_context_ids
                if file_context_ids is None
                else file_context_ids
            ),
            revision_instruction=settings.pending_revision_instruction,
            controller_tools=controller_tools,
            hook_contents=hook_contents,
            meta_task_list=state.meta_task_list,
            prior_token_estimates=settings.prior_token_estimates,
            context_summary=state.context_summary,
            context_assist_summary=settings.context_assist_summary,
            require_compaction=settings.context_assist_require_compaction,
            advance_expirations=advance_expirations,
            refresh_summary=refresh_summary,
            limit_context=limit_context,
            current_turn=settings.state_turn,
            tool_call_instructions=agent_controller_tool_call_instructions(settings),
            task_priority_system_prompt=prompts["task_priority_system_prompt"],
            summary_system_prompt=prompts["context_summary_system_prompt"],
        )
    )
    tools = (
        [AGENT_CONTEXT_SUMMARY_TOOL_SCHEMA]
        if summary_token_budget is not None
        else controller_tools
    )
    return AgentControllerRequest(
        system_prompt=system_prompt,
        user_prompt=user_prompt,
        tools=tools,
        request_tokens=estimate_request_tokens(
            settings.model_settings.model, system_prompt, user_prompt, tools=tools
        ),
        summary_token_budget=summary_token_budget,
        compaction=compaction,
    )


def estimate_agent_request_tokens(settings: AgentRunSettings) -> int:
    settings = replace(settings, file_context_ids=settings.file_context_ids.copy())
    state = prepare_agent_context(settings)
    refresh_agent_file_contexts(
        settings, state.file_contexts, state.turns, state.file_expires_in_turns
    )
    if settings.task_file_prompt is not None:
        state.active_task = settings.task_file_prompt.read()
    refresh_summary = prepare_agent_context_summary_request(settings)
    return build_agent_controller_request(
        settings, state,
        advance_expirations=settings.advance_expirations and not refresh_summary,
        refresh_summary=refresh_summary,
    ).request_tokens


def copy_resumed_agent_turn(
    settings: AgentRunSettings,
    result: AgentModelResult,
) -> AgentModelResult:
    source_dir = result.turn_dir
    if source_dir is None:
        raise ValueError("resumed agent response has no state turn")
    if source_dir.parent.resolve() == settings.state_session_dir.resolve():
        return result
    turn_dir = start_state_turn(
        settings.state_session_dir,
        int(source_dir.name),
        read_state_artifact(source_dir / "request_system_prompt"),
        read_state_artifact(source_dir / "request_task"),
        settings.file_paths,
        skip_missing_files=True,
    )
    for path in source_dir.iterdir():
        if path.is_file() and not path.is_symlink() and not path.name.startswith("."):
            shutil.copy2(path, turn_dir / path.name)
    return replace(result, turn_dir=turn_dir)


def run_agent_mode(settings: AgentRunSettings) -> int:
    if not settings.original_system_prompts:
        settings.original_system_prompts = agent_system_prompts(settings)
    context_assist = AgentAssist(settings, assist_type="context")
    prompt_assist = AgentAssist(settings, assist_type="prompt")
    try:
        with closing(prompt_assist), closing(context_assist):
            return run_agent_controller(settings, context_assist, prompt_assist)
    finally:
        try:
            if settings.runtime_state_checkpoint is not None:
                settings.runtime_state_checkpoint()
        finally:
            settings.runtime_state_checkpoint = None


def run_agent_controller(
    settings: AgentRunSettings,
    context_assist: AgentAssist,
    prompt_assist: AgentAssist,
) -> int:
    state = prepare_agent_context(settings)
    turns = state.turns
    file_contexts = state.file_contexts
    file_expires_in_turns = state.file_expires_in_turns
    pinned_paths = state.pinned_paths
    pinned_turn_numbers = state.pinned_turn_numbers
    context_summary = state.context_summary
    write_state_meta_task_list(settings.state_session_dir, state.meta_task_list)
    reasoning_items = settings.initial_reasoning_items
    model_result = settings.initial_model_result
    pending_tool_outputs = list(settings.initial_tool_outputs)
    if model_result is not None:
        model_result = copy_resumed_agent_turn(settings, model_result)
        settings.state_turn = max(
            settings.state_turn, int(model_result.turn_dir.name) + 1
        )
    checkpoint_turn_dir = model_result.turn_dir if model_result is not None else None
    hook_contents: tuple[str, ...] = ()

    def current_file_context() -> str:
        return build_agent_files_context(
            file_contexts,
            file_expires_in_turns,
            set(range(len(file_contexts))),
            turns,
            list(range(len(turns))),
            set(agent_history_turn_numbers(turns)),
            model=settings.model_settings.model,
            file_context_ids=settings.file_context_ids,
        )

    def remove_stale_context(
        remove_turn_ids: list[int],
        remove_file_ids: list[int],
        reviewed_context: str,
        reviewed_turn: int,
    ) -> tuple[list[int], list[int]]:
        if remove_file_ids:
            refresh_agent_file_contexts(
                settings, file_contexts, turns, file_expires_in_turns
            )
        removed_ids = apply_agent_context_assist_removals(
            remove_turn_ids,
            remove_file_ids,
            reviewed_context,
            reviewed_turn,
            file_context_ids=settings.file_context_ids,
            file_contexts=file_contexts,
            turns=turns,
            file_expires_in_turns=file_expires_in_turns,
            pinned_paths=pinned_paths,
            pinned_turn_numbers=pinned_turn_numbers,
        )
        settings.context = current_file_context()
        return removed_ids

    context_assist.context_removal_handler = remove_stale_context

    def save_turn_metadata(
        turn_dir: Path,
        artifact_prefix: str = "response",
    ) -> None:
        write_state_agent_runtime_state(
            turn_dir, settings, artifact_prefix, build_agent_turn_metadata(state)
        )

    def checkpoint_runtime_state() -> None:
        if checkpoint_turn_dir is not None:
            save_turn_metadata(checkpoint_turn_dir)

    settings.runtime_state_checkpoint = checkpoint_runtime_state

    def request_next(
        revision_instruction: str = "",
    ) -> AgentModelResult:
        nonlocal reasoning_items, checkpoint_turn_dir, hook_contents
        if revision_instruction:
            settings.pending_revision_instruction = revision_instruction
        advance_expirations = settings.advance_expirations
        while True:
            checkpoint_turn_dir = start_state_turn(
                settings.state_session_dir,
                settings.state_turn,
                agent_system_prompts(settings)["agent_system_prompt"],
                state.active_task,
                settings.file_paths,
                skip_missing_files=True,
            )
            write_state_reasoning_items(checkpoint_turn_dir, reasoning_items)
            save_turn_metadata(checkpoint_turn_dir, "request")
            context_assist.collect()
            prompt_assist.collect()
            refresh_summary = prepare_agent_context_summary_request(settings)
            if settings.agent_backup is not None:
                settings.agent_backup.run_if_due()
            hook_contents = run_agent_hook_context_scripts(
                settings.agent_hook_context_scripts
            )
            if settings.task_file_prompt is not None:
                state.active_task = settings.task_file_prompt.read()
            refresh_agent_file_contexts(
                settings, file_contexts, turns, file_expires_in_turns
            )
            try:
                request = build_agent_controller_request(
                    settings, state,
                    hook_contents=hook_contents,
                    advance_expirations=advance_expirations and not refresh_summary,
                    refresh_summary=refresh_summary,
                )
            finally:
                if advance_expirations and not refresh_summary:
                    settings.advance_expirations = False
            if state.active_context and (
                agent_context_checksum(state.active_context)
                == context_summary.active_context_checksum
            ):
                state.active_context = ""
            settings.context = current_file_context()
            context_assist_due = request.compaction is None and context_assist.is_due()
            if context_assist_due or prompt_assist.is_due():
                assist_request = build_agent_controller_request(
                    settings, state,
                    hook_contents=hook_contents,
                    limit_context=False,
                )
                if request.compaction is None:
                    context_assist.start_if_due(
                        assist_request.system_prompt, assist_request.user_prompt,
                        assist_request.tools, state.active_task,
                    )
                prompt_assist.start_if_due(
                    assist_request.system_prompt, assist_request.user_prompt,
                    assist_request.tools, state.active_task,
                )
            result = request_agent_model(
                settings,
                request.system_prompt,
                request.user_prompt,
                state.active_task,
                tools=request.tools,
                summary_token_budget=request.summary_token_budget,
                reasoning_items=reasoning_items,
                turn_metadata=build_agent_turn_metadata(state),
            )
            reasoning_items = result.reasoning_items
            if result.turn_dir is None:
                raise ValueError("agent controller request did not create a state turn")
            write_state_meta_task_list(
                result.turn_dir, state.meta_task_list, "response_agent_meta_task_list"
            )
            if request.summary_token_budget is None:
                context_summary.expires_in_turns = max(
                    0, context_summary.expires_in_turns - 1
                )
                settings.context_assist_require_compaction = False
                settings.pending_revision_instruction = ""
                settings.advance_expirations = True
                save_turn_metadata(result.turn_dir)
                return result

            state.active_context = update_agent_context_summary(
                context_summary,
                result.response,
                state.active_context,
                file_contexts,
                turns,
                file_expires_in_turns,
                pinned_paths,
                pinned_turn_numbers,
                current_turn=int(result.turn_dir.name),
                expires_in_turns=settings.agent_context_expires[0],
                compaction=request.compaction,
            )
            if request.compaction is not None:
                settings.last_compaction_turn = int(result.turn_dir.name)
            settings.context_assist_require_compaction = False
            advance_expirations = refresh_summary
            settings.advance_expirations = advance_expirations
            save_turn_metadata(result.turn_dir)
            emit_agent_output(
                settings,
                format_agent_turn_report(
                    "Context summary:\n"
                    f"Context compacted: {'yes' if request.compaction is not None else 'no'}\n"
                    f"{context_summary.content}",
                    int(result.turn_dir.name),
                ),
            )

    try:
        if model_result is None:
            model_result = request_next()
        else:
            refresh_agent_file_contexts(
                settings, file_contexts, turns, file_expires_in_turns
            )
            settings.context = current_file_context()
            context_assist.collect()
            prompt_assist.collect()
            save_turn_metadata(model_result.turn_dir)
    except Exception as exc:
        report_request_error(exc)
        return 1
    while True:
        tool_calls = list(model_result.tool_calls)
        tool_outputs = pending_tool_outputs
        pending_tool_outputs = []
        if not tool_calls:
            print(
                f"ERROR: {AGENT_CONTROLLER_NO_EXECUTABLE_TOOL_CALL_ERROR}",
                file=sys.stderr,
            )
            return 1
        review_action, revision_task = review_tool_text(
            format_agent_tool_call_report(
                tool_calls[len(tool_outputs):],
                meta_task_list=state.meta_task_list,
            ),
            "Run these agent tool calls? [y/n/p/h/e/E <prompt>]: ",
            accept_automatically=settings.agent_auto,
        )
        if review_action == "save":
            return emit_response_output(
                model_result.response,
                reasoning=model_result.reasoning,
                print_reasoning=settings.print_reasoning,
                skip_empty=True,
                suppress_response_output=settings.suppress_response_output,
            )
        if review_action == "reject":
            if VERBOSE:
                print("Aborted.", file=sys.stderr)
            return 0
        if review_action == "edit":
            if revision_task is None:
                try:
                    revision_task = edit_tool_revision_task(
                        format_agent_tool_call_report(
                            tool_calls, meta_task_list=state.meta_task_list
                        ),
                        state.active_task,
                    )
                except Exception as exc:
                    print(
                        f"ERROR: Failed to edit agent revision: {exc}",
                        file=sys.stderr,
                    )
                    continue
            if not revision_task:
                continue
            try:
                model_result = request_next(revision_task)
            except Exception as exc:
                report_request_error(exc)
                return 1
            continue

        tool_revision_instruction = ""
        readfile_contexts_for_turn = (
            load_state_agent_file_contexts(model_result.turn_dir)
            if tool_outputs else None
        )

        def save_tool_outputs(*, log_outputs: bool = True) -> bool:
            try:
                write_state_meta_task_list(
                    model_result.turn_dir,
                    state.meta_task_list,
                    "response_agent_meta_task_list",
                )
                if tool_outputs:
                    pending_outputs = [AGENT_TOOL_NOT_EXECUTED_OUTPUT] * (
                        len(tool_calls) - len(tool_outputs)
                    )
                    tool_output_text = format_agent_tool_outputs(
                        tool_calls, tool_outputs + pending_outputs
                    )
                    write_state_artifact(
                        model_result.turn_dir,
                        "response_agent_tool_output",
                        tool_output_text,
                    )
                    if log_outputs:
                        append_session_log(
                            settings.log_path,
                            "<agent_tool_output>\n"
                            f"{tool_output_text}\n"
                            "</agent_tool_output>\n",
                            settings.log_enabled,
                        )
                write_state_reasoning_items(model_result.turn_dir, reasoning_items)
                if readfile_contexts_for_turn is not None:
                    write_state_agent_file_contexts(
                        model_result.turn_dir, readfile_contexts_for_turn
                    )
                save_turn_metadata(model_result.turn_dir)
            except Exception as exc:
                print(
                    f"ERROR: Failed to save agent tool output: {exc}",
                    file=sys.stderr,
                )
                return False
            return True

        for tool_call_index in range(len(tool_outputs), len(tool_calls)):
            tool_call = tool_calls[tool_call_index]
            if settings.agent_auto:
                try:
                    emit_agent_output(
                        settings,
                        format_agent_tool_call_report(
                            [tool_call],
                            current_turn=int(model_result.turn_dir.name),
                            meta_task_list=state.meta_task_list,
                            tool_call_number_start=tool_call_index + 1,
                            tool_call_count=len(tool_calls),
                        ),
                    )
                except Exception as exc:
                    save_tool_outputs()
                    print(
                        f"ERROR: Failed to write agent tool call output: {exc}",
                        file=sys.stderr,
                    )
                    return 1
            turn_task = state.active_task
            tool_context = "\n\n".join(
                value for value in (state.active_context, tool_call.context) if value
            )

            def estimate_loaded_context_tokens(
                contexts: tuple[tuple[str, str], ...],
                output: str,
            ) -> int:
                context_state = replace(
                    state,
                    turns=turns.copy(),
                    file_contexts=file_contexts.copy(),
                    file_expires_in_turns=file_expires_in_turns.copy(),
                    pinned_paths=pinned_paths.copy(),
                    pinned_turn_numbers=pinned_turn_numbers.copy(),
                    meta_task_list=[task.copy() for task in state.meta_task_list],
                    context_summary=replace(context_summary),
                )
                apply_agent_tool_result(
                    context_state, tool_call,
                    AgentToolExecution(output, readfile_contexts=contexts),
                    state_turn=int(model_result.turn_dir.name),
                    tool_call_index=tool_call_index,
                    turn_unix_time=model_result.turn_unix_time,
                )
                context_state.turns = [
                    limit_agent_shell_turn_for_context(
                        turn, settings.model_settings.model, settings.token_limit
                    )
                    for turn in context_state.turns
                ]
                return build_agent_controller_request(
                    settings, context_state,
                    hook_contents=hook_contents,
                    limit_context=False,
                    file_context_ids=settings.file_context_ids.copy(),
                ).request_tokens

            if tool_call.tool == AGENT_SESSION_TOOL:
                execution = AgentToolExecution("Agent session ended.")
            elif tool_call.tool == AGENT_META_CONTEXT_CONTROL_TOOL:
                execution = AgentToolExecution("")
            elif tool_call.tool == AGENT_LOAD_FILE_FROM_STORAGE_TOOL:
                arguments = tool_call.arguments
                if arguments is None:
                    execution = AgentToolExecution(
                        f"ERROR: {AGENT_LOAD_FILE_FROM_STORAGE_TOOL} tool "
                        "received no paths."
                    )
                else:
                    execution = run_agent_load_file_from_storage_tool(
                        settings, arguments.get("paths"),
                        estimate_context_tokens=estimate_loaded_context_tokens,
                    )
            elif tool_call.tool == AGENT_META_TASK_LIST_TOOL:
                arguments = tool_call.arguments
                if not isinstance(arguments, dict):
                    execution = AgentToolExecution(
                        "ERROR: Task list tool received no operations."
                    )
                else:
                    execution = run_agent_meta_task_list_tool(
                        settings, state.meta_task_list, arguments.get("operations")
                    )
            elif tool_call.tool == AGENT_PATCH_TOOL:
                manifest = tool_call.arguments
                if manifest is None:
                    execution = AgentToolExecution(
                        "ERROR: Patch tool received no manifest."
                    )
                else:
                    execution = run_agent_patch_tool(
                        settings, manifest, model_result.turn_dir, turn_task,
                        tool_call_index=tool_call_index,
                        estimate_context_tokens=estimate_loaded_context_tokens,
                    )
            elif tool_call.tool == AGENT_SHELL_TOOL:
                arguments = tool_call.arguments
                if arguments is None:
                    execution = AgentToolExecution(
                        "ERROR: Shell tool received no command manifest."
                    )
                else:
                    try:
                        commands, _ = parse_shell_response(arguments)
                    except ValueError as exc:
                        execution = AgentToolExecution(
                            f"ERROR: Shell tool received invalid commands: {exc}"
                        )
                    else:
                        execution = run_agent_shell_tool(
                            settings, commands, model_result.turn_dir, turn_task,
                            tool_call_index=tool_call_index,
                        )
            elif tool_call.tool == AGENT_AGENT_TOOL:
                if tool_call.profile_name:
                    execution = run_agent_profile_tool(
                        settings, tool_call.profile_name, tool_call.task,
                        tool_context, reasoning_items=reasoning_items,
                    )
                    reasoning_items = execution.reasoning_items
                else:
                    execution = AgentToolExecution(
                        "Started the requested agent task for the next turn."
                    )
            else:
                continue
            execution = apply_agent_tool_result(
                state, tool_call, execution,
                state_turn=int(model_result.turn_dir.name),
                tool_call_index=tool_call_index,
                turn_unix_time=model_result.turn_unix_time,
            )
            tool_output = execution.output
            if (
                tool_call.tool == AGENT_AGENT_TOOL
                and not tool_call.profile_name
                and tool_output
                and not tool_output.startswith("ERROR:")
                and settings.task_file_prompt is not None
            ):
                settings.task_file_prompt.text = state.active_task
            if tool_call.tool in (AGENT_PATCH_TOOL, AGENT_SHELL_TOOL):
                tool_revision_instruction = execution.revision_instruction or ""
            if tool_output.startswith("ERROR:"):
                print(tool_output, file=sys.stderr)
            if execution.readfile_contexts is not None:
                readfile_contexts_for_turn = (
                    (readfile_contexts_for_turn or ()) + execution.readfile_contexts
                )
            tool_outputs.append(tool_output)
            settings.context = current_file_context()
            if tool_revision_instruction:
                settings.pending_revision_instruction = tool_revision_instruction
            if not save_tool_outputs(
                log_outputs=tool_call_index + 1 == len(tool_calls)
            ):
                return 1
            if tool_call.tool == AGENT_SESSION_TOOL:
                return emit_response_output(
                    "" if settings.agent_auto else tool_call.reason,
                    reasoning=model_result.reasoning,
                    print_reasoning=settings.print_reasoning,
                    skip_empty=True,
                    suppress_response_output=settings.suppress_response_output,
                    append_output=settings.agent_auto,
                )
        try:
            model_result = request_next(tool_revision_instruction)
        except Exception as exc:
            report_request_error(exc)
            return 1


