@dataclass(frozen=True)
class AgentToolCall:
    tool: str
    reason: str = ""
    task: str = ""
    context: str = ""
    context_id: str = ""
    action: str = ""
    expires_in_turns: int = AGENT_EXPIRES_IN_TURNS_DEFAULT
    profile_name: str = ""
    arguments: dict[str, Any] | None = None

    def as_dict(self) -> dict[str, Any]:
        tool_name = (
            agent_profile_tool_name(self.profile_name)
            if self.profile_name
            else self.tool
        )
        if self.arguments is not None:
            value = {"tool": tool_name, **self.arguments}
            if self.tool == AGENT_META_TASK_LIST_TOOL:
                value.pop("expires_in_turns", None)
            else:
                value["expires_in_turns"] = self.expires_in_turns
            return value
        value: dict[str, Any] = {"tool": tool_name}
        for name in AGENT_TOOL_ARGUMENT_SCHEMAS[self.tool]["properties"]:
            value[name] = getattr(self, name)
        return value


