def prompt_type_key(value: str) -> str:
    normalized = " ".join(
        value.strip().lower().replace("_", " ").replace("-", " ").split()
    )
    try:
        return PROMPT_TYPE_ALIASES[normalized]
    except KeyError as exc:
        raise ValueError(
            f"unknown prompt type '{value}'; choose system, linenum, patch, plan, shell, or agent"
        ) from exc


def validate_prompt_name(name: str) -> str:
    try:
        name = validate_session_name(name)
    except ValueError as exc:
        raise ValueError("invalid prompt name") from exc
    if "|" in name:
        raise ValueError("invalid prompt name")
    return name


def validate_session_name(name: str) -> str:
    name = name.strip()
    if (
        not name
        or name in (".", "..")
        or any(character in name for character in ("/", "\\"))
        or any(ord(character) < 32 for character in name)
    ):
        raise ValueError("invalid session name")
    return name


def parse_session_turn(value: str, option_name: str) -> int:
    try:
        turn = int(value)
    except ValueError as exc:
        raise ValueError(
            f"{option_name} TURN must be an integer"
        ) from exc
    if turn < 0:
        raise ValueError(f"{option_name} TURN must be non-negative")
    return turn

def state_turn_directories(state_session_dir: Path) -> list[tuple[int, Path]]:
    if not state_session_dir.is_dir():
        return []
    turn_dirs: list[tuple[int, Path]] = []
    for entry in state_session_dir.iterdir():
        if not entry.is_dir() or entry.is_symlink():
            continue
        try:
            turn = int(entry.name)
        except ValueError:
            continue
        if turn >= 0:
            turn_dirs.append((turn, entry))
    return turn_dirs


def completed_state_turn_directories(
    state_session_dir: Path,
    maximum_turn: int,
) -> list[tuple[int, Path]]:
    return sorted(
        (turn, entry)
        for turn, entry in resumed_state_turn_directories(state_session_dir)
        if (
            turn <= maximum_turn
            and (entry / "response").is_file()
            and not (entry / "response").is_symlink()
        )
    )


def next_state_turn_index(state_session_dir: Path) -> int:
    return max(
        (turn for turn, _ in resumed_state_turn_directories(state_session_dir)),
        default=-1,
    ) + 1

def last_completed_state_turn(
    state_session_dir: Path,
    turn: int | None = None,
    required_file: str = "response",
 ) -> Path:
    if state_session_dir.is_symlink() or not state_session_dir.is_dir():
        raise ValueError(
            f"state session does not exist: {state_session_dir}"
        )
    if turn is not None and turn < 0:
        raise ValueError("session turn must be non-negative")
    for candidate_turn, turn_dir in sorted(
        resumed_state_turn_directories(state_session_dir),
        key=lambda item: item[0],
        reverse=True,
    ):
        if turn is not None and candidate_turn != turn:
            continue
        artifact_path = turn_dir / required_file
        if artifact_path.is_file() and not artifact_path.is_symlink():
            return turn_dir
    if turn is not None:
        raise ValueError(
            f"state session has no completed turn {turn}: "
            f"{state_session_dir}"
        )
    raise ValueError(
        f"state session has no completed turns: {state_session_dir}"
    )

STATE_SESSION_ARTIFACT = "request_files"
STATE_META_TASK_LIST_ARTIFACT = "meta_task_list"
STATE_RESUME_SESSION_ARTIFACT = "resume_session"
STATE_RESUME_SESSION_TURN_ARTIFACT = "resume_session_turn"
STATE_SESSION_ARTIFACTS = (
    STATE_SESSION_ARTIFACT,
    STATE_META_TASK_LIST_ARTIFACT,
    STATE_RESUME_SESSION_ARTIFACT,
    STATE_RESUME_SESSION_TURN_ARTIFACT,
)
STATE_TURN_ARTIFACTS = (
    "request",
    "request_system_prompt",
    "request_task",
    "request_agent_turn_metadata",
    "response_agent_turn_metadata",
    "request_agent_context_summary",
    "response_agent_context_summary",
    "response_reasoning",
    "response_reasoning_encrypted_content",
    "response",
    "response_schema_patch",
    "response_diff_patch",
    "response_schema_patch_applied",
    "response_shell_output",
    "response_agent_tool_output",
    "response_agent_meta_task_list",
    "response_agent_file_contexts",
)
STATE_ARTIFACT_TYPES = (
    *STATE_SESSION_ARTIFACTS,
    *STATE_TURN_ARTIFACTS,
)

def normalize_state_artifact_type(value: str) -> str:
    artifact_type = value.strip()
    if artifact_type not in STATE_ARTIFACT_TYPES:
        choices = ", ".join(STATE_ARTIFACT_TYPES)
        raise ValueError(
            f"unknown state artifact type '{value}'; choose {choices}"
        )
    return artifact_type

def state_artifact_last_modified_time(path: Path) -> int:
    if path.is_symlink() or not path.is_file():
        raise ValueError(f"state artifact does not exist: {path}")
    try:
        return int(path.stat().st_mtime)
    except Exception as exc:
        raise ValueError(
            f"cannot read state artifact last modified time {path} ({exc})"
        ) from exc


def read_state_artifact(path: Path) -> str:
    if path.is_symlink() or not path.is_file():
        raise ValueError(f"state artifact does not exist: {path}")
    try:
        return path.read_text(encoding="utf-8")
    except Exception as exc:
        raise ValueError(f"cannot read state artifact {path} ({exc})") from exc


def read_optional_state_artifact(path: Path) -> str | None:
    if not path.exists() and not path.is_symlink():
        return None
    return read_state_artifact(path)


def state_session_chain(
    state_session_dir: Path,
) -> list[tuple[Path, int | None]]:
    sessions: list[tuple[Path, int | None]] = []
    seen_paths: set[Path] = set()
    maximum_turn: int | None = None
    while True:
        if state_session_dir.is_symlink() or not state_session_dir.is_dir():
            raise ValueError(
                f"state session does not exist: {state_session_dir}"
            )
        resolved_path = state_session_dir.resolve()
        if resolved_path in seen_paths:
            raise ValueError(
                f"state session resume cycle detected at {state_session_dir}"
            )
        seen_paths.add(resolved_path)
        sessions.append((state_session_dir, maximum_turn))
        resume_session = read_optional_state_artifact(
            state_session_dir / STATE_RESUME_SESSION_ARTIFACT
        )
        if resume_session is None:
            return sessions
        resume_session_name = validate_session_name(resume_session)
        resume_turn_text = read_optional_state_artifact(
            state_session_dir / STATE_RESUME_SESSION_TURN_ARTIFACT
        )
        if resume_turn_text is not None:
            resume_turn = parse_session_turn(
                resume_turn_text, STATE_RESUME_SESSION_TURN_ARTIFACT
            )
            maximum_turn = (
                resume_turn
                if maximum_turn is None
                else min(maximum_turn, resume_turn)
            )
        state_session_dir = STATE_DIR / resume_session_name


def resumed_state_turn_directories(
    state_session_dir: Path,
) -> list[tuple[int, Path]]:
    if not state_session_dir.is_dir():
        return []
    turn_dirs: dict[int, Path] = {}
    for source_dir, maximum_turn in state_session_chain(state_session_dir):
        for turn, turn_dir in state_turn_directories(source_dir):
            if maximum_turn is None or turn <= maximum_turn:
                turn_dirs.setdefault(turn, turn_dir)
    return list(turn_dirs.items())


def load_state_reasoning_items(
    turn_dir: Path,
) -> tuple[dict[str, Any], ...]:
    artifact_path = turn_dir / "response_reasoning_encrypted_content"
    artifact_text = read_optional_state_artifact(artifact_path)
    if artifact_text is None:
        return ()
    try:
        items = json.loads(artifact_text)
    except json.JSONDecodeError as exc:
        raise ValueError(
            f"encrypted reasoning must contain JSON: {artifact_path}"
        ) from exc
    if not isinstance(items, list) or any(
        not isinstance(item, dict)
        or item.get("type") != "reasoning"
        or item.get("status") not in (None, "completed")
        or not isinstance(item.get("encrypted_content"), str)
        or not item["encrypted_content"]
        for item in items
    ):
        raise ValueError(
            f"invalid encrypted reasoning items: {artifact_path}"
        )
    return tuple(items)

def state_turn_directory(
    state_session_dir: Path,
    turn: int | None,
 ) -> Path:
    if turn is None:
        return last_completed_state_turn(state_session_dir)
    turn_dir = dict(resumed_state_turn_directories(state_session_dir)).get(turn)
    if turn_dir is None:
        raise ValueError(
            f"state session has no turn {turn}: {state_session_dir}"
        )
    return turn_dir

def handle_state_print_json(values: list[str]) -> int:
    try:
        if not values:
            print(json.dumps(list(STATE_ARTIFACT_TYPES), indent=2, ensure_ascii=False))
            return 0
        session_name = validate_session_name(values[0])
        state_session_dir = STATE_DIR / session_name
        if not state_session_dir.is_dir() or state_session_dir.is_symlink():
            raise ValueError(f"state session does not exist: {state_session_dir}")

        remaining = list(values[1:])
        requested_turn: int | None = None
        if remaining:
            try:
                requested_turn = int(remaining[0])
            except ValueError:
                pass
            else:
                remaining.pop(0)
                if requested_turn < 0:
                    raise ValueError("session turn must be non-negative")

        artifact_types = [
            normalize_state_artifact_type(value)
            for value in remaining
        ]
        if len(set(artifact_types)) != len(artifact_types):
            raise ValueError("state artifact types must be unique")

        turn_artifact_types = [
            artifact_type
            for artifact_type in artifact_types
            if artifact_type not in STATE_SESSION_ARTIFACTS
        ]
        turn_dir: Path | None = None
        if not artifact_types or turn_artifact_types:
            turn_dir = state_turn_directory(
                state_session_dir, requested_turn
            )

        artifacts: dict[str, str] = {}
        if not artifact_types:
            for session_artifact_type in STATE_SESSION_ARTIFACTS:
                artifact_path = state_session_dir / session_artifact_type
                if artifact_path.is_file() and not artifact_path.is_symlink():
                    artifacts[session_artifact_type] = read_state_artifact(
                        artifact_path
                    )
            if turn_dir is not None:
                for artifact_path in sorted(
                    turn_dir.iterdir(), key=lambda path: path.name
                ):
                    if artifact_path.is_file() and not artifact_path.is_symlink():
                        artifacts[artifact_path.name] = read_state_artifact(
                            artifact_path
                        )
        else:
            for artifact_type in artifact_types:
                if artifact_type in STATE_SESSION_ARTIFACTS:
                    artifact_path = state_session_dir / artifact_type
                else:
                    if turn_dir is None:
                        raise ValueError(
                            f"state turn is required for artifact {artifact_type}"
                        )
                    artifact_path = turn_dir / artifact_type
                artifacts[artifact_type] = read_state_artifact(artifact_path)

        print(json.dumps(artifacts, indent=2, ensure_ascii=False))
    except Exception as exc:
        print(f"ERROR: Failed to print state JSON: {exc}", file=sys.stderr)
        return 1
    return 0

def handle_shell_session_print_json(
    values: list[str],
    response_json_repair: bool = False,
) -> int:
    try:
        if len(values) not in (1, 2):
            raise ValueError(
                '--shell-session-print-json requires SESSION and optional TURN'
            )
        session_name = validate_session_name(values[0])
        requested_turn = (
            parse_session_turn(values[1], '--shell-session-print-json')
            if len(values) == 2
            else None
        )
        state_session_dir = STATE_DIR / session_name
        if not state_session_dir.is_dir() or state_session_dir.is_symlink():
            raise ValueError(
                f'state session does not exist: {state_session_dir}'
            )
        turn_dir = last_completed_state_turn(
            state_session_dir,
            requested_turn,
        )
        response = read_state_artifact(turn_dir / 'response')
        response_json = parse_json_response(response, response_json_repair)
        if not isinstance(response_json, dict):
            raise ValueError('shell session response must be a JSON object')
        print(json.dumps(response_json, indent=2, ensure_ascii=False))
    except Exception as exc:
        print(
            f'ERROR: Failed to print shell session JSON: {exc}',
            file=sys.stderr,
        )
        return 1
    return 0


def file_checksum(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as file:
        for chunk in iter(lambda: file.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()

def load_reused_session_files(
    state_session_dir: Path,
 ) -> list[tuple[str, str]]:
    request_files_path = state_session_dir / STATE_SESSION_ARTIFACT
    for source_dir, _ in state_session_chain(state_session_dir):
        artifact_path = source_dir / STATE_SESSION_ARTIFACT
        if artifact_path.exists() or artifact_path.is_symlink():
            request_files_path = artifact_path
            break
    if not request_files_path.is_file():
        raise ValueError(f"state session has no request_files: {state_session_dir}")
    try:
        lines = read_state_artifact(request_files_path).splitlines()
    except Exception as exc:
        raise ValueError(
            f"cannot read reused session files {request_files_path} ({exc})"
        ) from exc
    files: list[tuple[str, str]] = []
    for raw_line in lines:
        line = raw_line.strip()
        if not line:
            continue
        path_text, separator, checksum = line.rpartition(" ")
        if (
            not separator
            or not path_text
            or re.fullmatch(r"[0-9a-fA-F]{64}", checksum) is None
        ):
            raise ValueError(
                "reused session request_files entry must contain an "
                f"absolute path followed by a SHA-256 checksum: {line}"
            )
        path = Path(path_text)
        if not path.is_absolute():
            raise ValueError(
                f"reused session request_files contains non-absolute path: {path_text}"
            )
        files.append((str(path), checksum.lower()))
    return files

def verify_reused_session_files(
    file_records: list[tuple[str, str]],
 ) -> None:
    mismatches: list[str] = []
    for path_text, expected_checksum in file_records:
        try:
            current_checksum = file_checksum(Path(path_text))
        except Exception as exc:
            mismatches.append(
                f"{path_text} (cannot read current file for checksum: {exc})"
            )
            continue
        if current_checksum != expected_checksum:
            mismatches.append(
                f"{path_text} (expected {expected_checksum}, "
                f"current {current_checksum})"
            )
    if mismatches:
        raise ValueError(
            "session context checksums do not match current files: "
            + "; ".join(mismatches)
        )

def load_reused_session_task(
    state_session_dir: Path,
    turn: int | None = None,
) -> str:
    turn_dir = last_completed_state_turn(state_session_dir, turn)
    request_task_path = turn_dir / "request_task"
    if not request_task_path.is_file():
        raise ValueError(f"completed turn has no request_task: {turn_dir}")
    try:
        return request_task_path.read_text(encoding="utf-8")
    except Exception as exc:
        raise ValueError(
            f"cannot read reused session task from {turn_dir} ({exc})"
        ) from exc


def _load_reused_session_turn_artifacts(
    state_session_dir: Path,
    turn: int | None,
    artifact_names: tuple[str, ...],
    missing_message: str,
) -> tuple[Path, dict[str, str]]:
    turn_dir = last_completed_state_turn(state_session_dir, turn)
    artifact_paths = {
        artifact_name: turn_dir / artifact_name
        for artifact_name in artifact_names
    }
    if any(
        path.is_symlink() or not path.is_file()
        for path in artifact_paths.values()
    ):
        raise ValueError(f"{missing_message}: {turn_dir}")
    artifacts = {
        artifact_name: read_state_artifact(path)
        for artifact_name, path in artifact_paths.items()
    }
    return turn_dir, artifacts


@dataclass(frozen=True)
class ReusedPatchTurn:
    turn_dir: Path
    task: str
    response: str


def load_reused_session_patch_turn(
    state_session_dir: Path,
    turn: int | None = None,
) -> ReusedPatchTurn:
    turn_dir, artifacts = _load_reused_session_turn_artifacts(
        state_session_dir,
        turn,
        ("request_task", "response"),
        "completed patch turn has no request_task or response",
    )
    return ReusedPatchTurn(
        turn_dir=turn_dir,
        task=artifacts["request_task"],
        response=artifacts["response"],
    )


@dataclass(frozen=True)
class ReusedShellTurn:
    turn_dir: Path
    system_prompt: str
    task: str
    response: str
    reasoning: str
    shell_output: str | None


def load_reused_session_shell_turn(
    state_session_dir: Path,
    turn: int | None = None,
) -> ReusedShellTurn:
    turn_dir, artifacts = _load_reused_session_turn_artifacts(
        state_session_dir,
        turn,
        ("request_system_prompt", "request_task", "response"),
        "completed shell turn has no request_system_prompt, "
        "request_task, or response",
    )
    return ReusedShellTurn(
        turn_dir=turn_dir,
        system_prompt=artifacts["request_system_prompt"],
        task=artifacts["request_task"],
        response=artifacts["response"],
        reasoning=read_optional_state_artifact(
            turn_dir / "response_reasoning"
        ) or "",
        shell_output=read_optional_state_artifact(
            turn_dir / "response_shell_output"
        ),
    )


def load_reused_session_shell_command_turn(
    state_session_dir: Path,
    turn: int | None = None,
    response_json_repair: bool = False,
) -> ReusedShellTurn:
    selected_turn_dir = last_completed_state_turn(
        state_session_dir,
        turn,
    )
    candidate_turns = completed_state_turn_directories(
        state_session_dir,
        int(selected_turn_dir.name),
    )

    for candidate_turn, _ in reversed(candidate_turns):
        try:
            shell_turn = load_reused_session_shell_turn(
                state_session_dir,
                candidate_turn,
            )
            commands, _ = parse_reused_shell_response(
                shell_turn.response, response_json_repair
            )
        except ValueError:
            continue
        if commands is not None:
            return shell_turn

    raise ValueError(
        "completed shell session has no reusable command turn: "
        f"{state_session_dir}"
    )


def start_state_turn(
    state_session_dir: Path,
    turn: int,
    system_prompt: str,
    task: str,
    file_paths: list[Path],
    skip_missing_files: bool = False,
    user_prompt: str | None = None,
    tools: list[dict[str, Any]] | None = None,
 ) -> Path:
    turn_dir = state_session_dir / str(turn)
    turn_dir.mkdir(parents=True, exist_ok=True)
    state_files = (
        ("request_system_prompt", system_prompt),
        ("request_task", task),
    )
    for filename, content in state_files:
        write_state_artifact(turn_dir, filename, content)
    if user_prompt is not None:
        write_state_artifact(
            turn_dir,
            "request",
            format_request_text(system_prompt, user_prompt, tools),
        )
    request_files_path = state_session_dir / "request_files"
    if not request_files_path.exists():
        request_file_lines: list[str] = []
        for path in file_paths:
            if path == Path("-") or skip_missing_files and not path.exists():
                continue
            resolved_path = Path(path).resolve()
            request_file_lines.append(
                f"{resolved_path} {file_checksum(resolved_path)}"
            )
        try:
            with request_files_path.open("x", encoding="utf-8") as request_files:
                request_files.write("\n".join(request_file_lines))
        except FileExistsError:
            pass
    return turn_dir

def write_state_artifact(
    state_directory: Path,
    artifact_name: str,
    content: str,
) -> None:
    (state_directory / artifact_name).write_text(content, encoding="utf-8")


def write_state_reasoning_items(
