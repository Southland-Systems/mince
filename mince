    try:
        if stream_enabled and not print_reasoning:
            if args.output_file:
                args.output_file.parent.mkdir(parents=True, exist_ok=True)
                stream_file = args.output_file.open("w", encoding="utf-8")

            def emit_stream_text(delta: str) -> None:
                if stream_file is not None:
                    stream_file.write(delta)
                    stream_file.flush()
                else:
                    sys.stdout.write(delta)
                    sys.stdout.flush()

            stream_sink = emit_stream_text

        response_obj, usage = call_openai(
            api_key=api_key,
            openai_base_url=openai_base_url,
            openai_proxy=openai_proxy,
            openai_organization=openai_organization,
            openai_project=openai_project,
            model=model,
            system_prompt=full_system_prompt,
            user_prompt=user_prompt,
            response_format=response_format,
            json_schema=json_schema,
            response_verbosity=response_verbosity,
            temperature=temperature,
            top_p=top_p,
            max_output_tokens=max_output_tokens,
            openai_service_tier=openai_service_tier,
            openai_reasoning=openai_reasoning,
            reasoning_mode=reasoning_mode,
            extra_body=extra_body,
            llm_timeout=llm_timeout,
            safety_identifier=safety_identifier,
            store=api_log,
            stream=stream_enabled,
        )
        if stream_enabled:
            result, usage, completed_response = consume_response_stream(
                response_obj, stream_sink
            )
            if completed_response is not None:
                response_obj = completed_response
            stream_output_emitted = stream_sink is not None
        else:
            result = getattr(response_obj, "output_text", "")
    except Exception as exc:
        if state_turn_path is not None:
            complete_state_turn(state_turn_path, "", f"ERROR: {exc}")
        print(f"API error: {exc}", file=sys.stderr)
        return 1
    finally:
        if stream_file is not None:
            stream_file.close()

    elapsed = time.perf_counter() - start_time
    response_cost = response_cost_line(token_cost, usage)

    reasoning = response_reasoning_text(response_obj)
    if state_turn_path is not None:
        complete_state_turn(
            state_turn_path,
            reasoning,
            str(result or ""),
        )

    statsline = print_stats(
        session_name=session_stem,
        request_characters=request_characters,
        request_tokens=request_tokens,
        processing_time=elapsed,
        response_text=result,
        usage=usage,
        response_cost=response_cost,
    )

    if log_enabled:
        with open(log_path, "a", encoding="utf-8") as f:
            if reasoning:
                f.write(f"<reasoning>\n{reasoning}\n</reasoning>\n")
            f.write(f"<response>\n{result}\n</response>\n")
            f.write(f"<response_stats>\n{statsline}\n</response_stats>\n")
            f.write(f"<end_time>{time.ctime(int(time.time()))} [{int(time.time())}]</end_time>\n")

    def call_patch_revision_request(
        revision_user_prompt: str,
    ) -> tuple[str, str, Any, dict[str, Any] | None]:
        nonlocal state_turn
        revision_request_tokens = (
            estimate_request_tokens(
                model=model,
                system_prompt=full_system_prompt,
                user_prompt=revision_user_prompt,
            )
            + tokenizer_padding
        )
        revision_request_characters = len(
            full_system_prompt + revision_user_prompt
        )
        revision_request_cost_log = ''
        if token_cost is not None:
            revision_request_cost_log = (
                f' request_cost_estimate='
                f'{revision_request_tokens * token_cost[0] / 1_000_000:.4f}'
            )
        if revision_request_tokens > token_limit:
            raise ValueError(
                f'Estimated input token count ({revision_request_tokens}) exceeds '
                f'token limit ({token_limit})'
            )
        revision_state_context = context
        if json_patch_responses:
            revision_state_context += "\n"
            if json_patch_task is not None:
                revision_state_context += (
                    f"<json_patch_task>\n{json_patch_task}\n"
                    f"</json_patch_task>\n"
                )
            revision_state_context += (
                f"<json_patch>\n{json_patch_responses[-1]}\n"
                f"</json_patch>"
            )
        revision_state_turn_path = start_state_turn(
            state_session_dir,
            state_turn,
            full_system_prompt,
            task,
            file_paths=file_paths,
        )
        state_turn += 1
        if log_enabled:
            with open(log_path, 'a', encoding='utf-8') as f:
                f.write(
                    f'<request_stats>\n'
                    f'request_characters={revision_request_characters} '
                    f'request_tokens_estimate={revision_request_tokens}'
                    f'{revision_request_cost_log} model={model} '
                    f'reasoning={openai_reasoning} '
                    f'reasoning_mode={reasoning_mode} '
                    f'max_output_tokens={max_output_tokens} api_log={api_log} '
                    f'timeout={llm_timeout}\n'
                    f'</request_stats>\n'
                )
                f.write(f'<request>\n')
                f.write(
                    f'<system_prompt>\n{full_system_prompt}\n'
                    f'</system_prompt>\n'
                )
                f.write(
                    f'<user_prompt>\n{revision_user_prompt}\n'
                    f'</user_prompt>\n'
                )
                f.write('</request>\n')
        if VERBOSE:
            print(
                f'request_characters={revision_request_characters} '
                f'request_tokens_estimate={revision_request_tokens}'
                f'{revision_request_cost_log} model={model} '
                f'reasoning={openai_reasoning}',
                file=sys.stderr,
            )

        revision_start_time = time.perf_counter()
        revision_response_obj, revision_usage = call_openai(
            api_key=api_key,
            openai_base_url=openai_base_url,
            openai_proxy=openai_proxy,
            openai_organization=openai_organization,
            openai_project=openai_project,
            model=model,
            system_prompt=full_system_prompt,
            user_prompt=revision_user_prompt,
            response_format=response_format,
            json_schema=json_schema,
            response_verbosity=response_verbosity,
            temperature=temperature,
            top_p=top_p,
            max_output_tokens=max_output_tokens,
            openai_service_tier=openai_service_tier,
            openai_reasoning=openai_reasoning,
            reasoning_mode=reasoning_mode,
            extra_body=extra_body,
            llm_timeout=llm_timeout,
            safety_identifier=safety_identifier,
            store=api_log,
            stream=False,
        )
        revision_result = str(
            getattr(revision_response_obj, 'output_text', '') or ''
        )
        revision_elapsed = time.perf_counter() - revision_start_time
        revision_reasoning = response_reasoning_text(revision_response_obj)
        complete_state_turn(
            revision_state_turn_path,
            revision_reasoning,
            revision_result,
        )
        revision_statsline = print_stats(
            session_name=session_stem,
            request_characters=revision_request_characters,
            request_tokens=revision_request_tokens,
            processing_time=revision_elapsed,
            response_text=revision_result,
            usage=revision_usage,
            response_cost=response_cost_line(
                token_cost, revision_usage
            ),
        )
        if log_enabled:
            with open(log_path, 'a', encoding='utf-8') as f:
                f.write(
                    f'<response>\n{revision_result}\n'
                    f'</response>\n'
                )
                f.write(
                    f'<response_stats>\n{revision_statsline}\n'
                    f'</response_stats>\n'
                )
                f.write(
                    f'<end_time>{time.ctime(int(time.time()))} '
                    f'[{int(time.time())}]</end_time>\n'
                )
        return (
            revision_result,
            revision_statsline,
            revision_response_obj,
            revision_usage,
        )

    if patch_mode:
        patch_turn_history: list[tuple[str, str, str]] = [
            (task, str(result or ""), statsline)
        ]
        patch_turn_index = 0
        while True:
            try:
                if not result or not result.strip():
                    print(
                        'ERROR: LLM returned empty response for patch manifest',
                        file=sys.stderr,
                    )
                    return 1

                result = re.sub(
                    r'^(?:<\|[^|]+\|>).+(?:<\|message\|>)',
                    '',
                    result,
                ).strip()
                manifest = json.loads(result)
            except json.JSONDecodeError as exc:
                print(result)
                if VERBOSE:
                    print(statsline, file=sys.stderr)
                print(
                    f'ERROR: Failed to parse patch manifest JSON: {exc}',
                    file=sys.stderr,
                )
                return 1

            patch_commit_message = ''
            if patch_branch_mode:
                if not isinstance(manifest, dict):
                    print('ERROR: Patch manifest must be a JSON object', file=sys.stderr)
                    return 1
                raw_commit_message = manifest.get('commit_message')
                if not isinstance(raw_commit_message, str) or not raw_commit_message.strip():
                    print('ERROR: Patch manifest commit_message cannot be empty', file=sys.stderr)
                    return 1
                patch_commit_message = raw_commit_message.strip()

            updated_texts = apply_combined_patch_manifest(
                original_texts,
                manifest,
            )

            diffs = []
            for fp, ut in updated_texts.items():
                ot = original_texts.get(fp, '')
                if ut != ot:
                    d = generate_unified_diff(ot, ut, fp)
                    if d:
                        diffs.append(d)
            if not diffs:
                if VERBOSE:
                    print('No changes.', file=sys.stderr)
                    print(statsline, file=sys.stderr)
                return 0
            diff_text = '\n'.join(diffs)
            if patch_save_path is not None:
                try:
                    patch_save_path.parent.mkdir(parents=True, exist_ok=True)
                    patch_save_path.write_text(diff_text, encoding='utf-8')
                except Exception as exc:
                    print(
                        f'ERROR: Failed to save patch file to '
                        f'{patch_save_path}: {exc}',
                        file=sys.stderr,
                    )
                    return 1
                if VERBOSE:
                    print(f'patch_file={patch_save_path}', file=sys.stderr)
            if VERBOSE or patch_review:
                print()
                print(diff_text)

            revision_task: str | None = None
            navigate_patch_turn = False
            if patch_review:
                while True:
                    patch_input = input(
                        'Apply these changes? [y/n/p/</>/e/E <prompt>]: '
                    ).strip()
                    if not patch_input:
                        print('Usage: [y]es, [n]o, [p]ager, [<]prevturn, [>]nextturn, [e]dit, E <prompt>')
                        continue
                    if patch_input == '<':
                        if patch_turn_index == 0:
                            print('Already at the first patch turn.')
                            continue
                        patch_turn_index -= 1
                        task, result, statsline = patch_turn_history[patch_turn_index]
                        navigate_patch_turn = True
                        break
                    if patch_input == '>':
                        if patch_turn_index + 1 >= len(patch_turn_history):
                            print('No later patch turn is available.')
                            continue
                        patch_turn_index += 1
                        task, result, statsline = patch_turn_history[patch_turn_index]
                        navigate_patch_turn = True
                        break
                    patch_choice = patch_input.lower()
                    if patch_choice in ('y', 'yes', 'n', 'no'):
                        break
                    if patch_choice == 'p':
                        pydoc.pager(diff_text)
                        continue
                    if patch_choice == 'e':
                        try:
                            edited_text = edit_text(
                                build_patch_revision_editor_text(
                                    diff_text,
                                    task,
                                ),
                            )
                            revision_task = extract_patch_revision_task(
                                edited_text
                            )
                        except Exception as exc:
                            print(
                                f'ERROR: Failed to edit patch revision: {exc}',
                                file=sys.stderr,
                            )
                            continue
                        if not revision_task:
                            continue
                        break
                    if (
                        patch_input.startswith('E')
                        and len(patch_input) > 1
                        and patch_input[1].isspace()
                    ):
                        revision_task = patch_input[1:].strip()
                        if not revision_task:
                            print('Revision task cannot be empty.')
                            continue
                        break
                    print('Please answer y, n, p, <, >, e, E followed by a prompt')
                if navigate_patch_turn:
                    continue
                if patch_choice in ('n', 'no'):
                    if VERBOSE:
                        print('Aborted.', file=sys.stderr)
                        print(statsline, file=sys.stderr)
                    return 0
                if revision_task is not None and patch_choice not in ('y', 'yes'):
                    if VERBOSE:
                        print(statsline, file=sys.stderr)
                    json_patch_task = task
                    task = expand_prompt_names(
                        revision_task, prompt_expansion_enabled
                    )
                    json_patch_responses = [result]
                    user_prompt = build_user_prompt(
                        task=task,
                        context=context,
                        response_format=response_format,
                        json_schema=json_schema,
                        json_patch_responses=json_patch_responses,
                        json_patch_task=json_patch_task,
                    )
                    user_prompt = user_prompt + '\n' + patch_system_prompt
                    try:
                        (result, statsline, response_obj, usage) = call_patch_revision_request(user_prompt)
                    except Exception as exc:
                        print(f'API error: {exc}', file=sys.stderr)
                        return 1
                    patch_turn_history = patch_turn_history[:patch_turn_index + 1]
                    patch_turn_history.append((task, str(result or ""), statsline))
                    patch_turn_index += 1
                    continue

            changed_items = [
                (fp, ut)
                for fp, ut in updated_texts.items()
                if ut != original_texts.get(fp, '')
            ]
            if patch_branch_mode:
                try:
                    patch_branch_name = resolve_patch_branch_name(patch_branch_setting)
                    patch_repo_root = git_repository_root()
                    if patch_repo_root is None:
                        raise ValueError('not inside a git worktree')
                    current_branch = git_current_branch(patch_repo_root)
                    if current_branch is None:
                        raise ValueError(
                            'patch branch mode requires a checked-out branch'
                        )
                    patch_branch_name = validate_git_branch_name(
                        patch_repo_root,
                        patch_branch_name,
                    )
                    for file_name in file_names:
                        git_relative_path(patch_repo_root, Path(file_name))
                    for fp, _ in changed_items:
                        git_relative_path(patch_repo_root, Path(fp))
                    prepare_patch_branch(patch_repo_root, patch_branch_name)
                    for fp, ut in changed_items:
                        Path(fp).write_text(ut, encoding='utf-8')
                    git_commit_patch(
                        patch_repo_root,
                        [Path(fp) for fp, _ in changed_items],
                        patch_commit_message,
                    )
                    run_git_command(
                        patch_repo_root,
                        ['switch', '--', current_branch],
                    )
                except Exception as exc:
                    print(f'ERROR: Failed to write and commit patch branch: {exc}', file=sys.stderr)
                    return 1
                for fp, _ in changed_items:
                    print(f'file_written={fp}')
                print(f'patch_branch={patch_branch_name}')
            else:
                for fp, ut in changed_items:
                    if patch_review:
                        tgt = (
                            append_suffix_to_path(Path(fp), patch_suffix)
                            if suffix_provided
                            else Path(fp)
                        )
                        tgt.write_text(ut, encoding='utf-8')
                        print(
                            f'file_written='
                            f'{str(tgt) if suffix_provided else fp}'
                        )
                    else:
                        outp = append_suffix_to_path(Path(fp), patch_suffix)
                        outp.write_text(ut, encoding='utf-8')
                        print(f'file_written={outp}')

            if VERBOSE:
                print(statsline, file=sys.stderr)

            return 0

    if response_format in ("json", "schema"):
        try:
            if not result or not result.strip():
                print("ERROR: LLM returned empty response", file=sys.stderr)
                return 1

            result = re.sub(r'^(?:<\|[^|]+\|>).+(?:<\|message\|>)', '', result).strip()
            result = json.loads(result)
        except json.JSONDecodeError as exc:
            print(result)
            if VERBOSE:
                print(statsline, file=sys.stderr)
            print(f"ERROR: Failed to parse JSON: {exc}", file=sys.stderr)
            return 1
        finally:
            result = pretty_json(result)

    if print_reasoning:
        output_str = (
            f"<think>\n{reasoning}\n</think>\n\n"
            f"{result}"
        )
    else:
        output_str = result

    if args.output_file:
        if not stream_output_emitted:
            try:
                args.output_file.parent.mkdir(parents=True, exist_ok=True)
                args.output_file.write_text(output_str, encoding="utf-8")
            except Exception as exc:
                print(f"ERROR: Failed to write output to file {args.output_file}: {exc}", file=sys.stderr)
                print(output_str)
                if VERBOSE:
                    print(statsline, file=sys.stderr)
                return 1
    elif stream_output_emitted:
        if not result or not result.endswith("\n"):
            print()
    else:
        print(output_str)

    if VERBOSE:
        print(statsline, file=sys.stderr)

    if DEBUG:
        print("<debug_response>", file=sys.stderr)
        print(json.dumps(response_obj.model_dump(), indent=2), file=sys.stderr)
        print("</debug_response>", file=sys.stderr)

    return 0


