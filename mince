API_RETRY_MAX_DELAY_SECONDS = 8


def _log_api_request_event(error_logger: Any, message: str) -> None:
    if error_logger is None:
        return
    try:
        error_logger(
            "<api_retry>\n"
            f"{message}\n"
            "</api_retry>\n"
        )
    except Exception as exc:
        print(
            f"ERROR: Failed to log API request event: {exc}",
            file=sys.stderr,
        )


def execute_openai_request(
    operation: Any,
    *,
    retry: int,
    operation_name: str,
    error_logger: Any = None,
    retry_if: Callable[[BaseException], bool] | None = None,
) -> Any:
    retry_count = parse_retry_count(retry)
    if retry_if is None:
        retry_if = _is_openai_temp_error
    failed_retries = 0
    while True:
        try:
            response = operation()
        except Exception as exc:
            failed_attempt = failed_retries + 1
            detail = str(exc).strip() or type(exc).__name__
            failure_message = (
                f"ERROR: {operation_name} failed "
                f"(attempt {failed_attempt}/{retry_count + 1}): {detail}"
            )
            print(failure_message, file=sys.stderr)
            _log_api_request_event(error_logger, failure_message)
            if (
                failed_retries >= retry_count
                or not retry_if(exc)
            ):
                raise
            failed_retries += 1
            delay_seconds = min(
                2 ** (failed_retries - 1), API_RETRY_MAX_DELAY_SECONDS
            )
            retry_message = (
                f"INFO: Retrying {operation_name} in {delay_seconds} "
                f"second{'s' if delay_seconds != 1 else ''}."
            )
            print(retry_message, file=sys.stderr)
            _log_api_request_event(error_logger, retry_message)
            time.sleep(delay_seconds)
        else:
            if failed_retries:
                success_message = (
                    f"INFO: {operation_name} succeeded after "
                    f"{failed_retries} "
                    f"{'retry' if failed_retries == 1 else 'retries'}; "
                    "retry counter reset."
                )
                print(success_message, file=sys.stderr)
                _log_api_request_event(error_logger, success_message)
            return response


def resolve_api_key(config: dict[str, Any]) -> str:
    env_key = os.getenv("OPENAI_API_KEY")
    if env_key:
        return env_key
    key = str(config.get("api_key", "")).strip()
    if key:
        return key
    raise SystemExit("No API key found. Set it up in the config file with --init or with 'export OPENAI_API_KEY=key'.")


def create_openai_client(
    api_key: str,
    openai_base_url: str,
    openai_proxy: str = "",
    openai_organization: str = "",
    openai_project: str = "",
    llm_timeout: int | None = None,
) -> OpenAI:
    http_client = (
        DefaultHttpxClient(proxy=openai_proxy)
        if openai_proxy
        else None
    )
    try:
        return OpenAI(
            api_key=api_key,
            base_url=openai_base_url,
            project=openai_project or None,
            organization=openai_organization or None,
            timeout=llm_timeout if llm_timeout is not None else 300,
            max_retries=0,
            http_client=http_client,
        )
    except BaseException:
        if http_client is not None:
            http_client.close()
        raise


def call_openai(
    api_key: str = "",
    openai_base_url: str = "",
    openai_proxy: str = "",
    openai_organization: str = "",
    openai_project: str = "",
    model: str = "",
    system_prompt: str = "",
    user_prompt: str = "",
    response_format: str = "text",
    json_schema: dict[str, Any] | None = None,
    response_verbosity: str | None = None,
    temperature: float | None = None,
    top_p: float | None = None,
    max_output_tokens: int | None = None,
    openai_service_tier: str | None = None,
    openai_reasoning: str | None = None,
    reasoning_mode: str | None = None,
    extra_body: dict[str, Any] | None = None,
    llm_timeout: int | None = None,
    retry: int = 2,
    safety_identifier: str | None = None,
    store: bool = True,
    stream: bool = False,
    tools: list[dict[str, Any]] | None = None,
    tool_choice: str | dict[str, Any] | None = None,
    parallel_tool_calls: bool | None = None,
    error_logger: Any = None,
    explicit_prompt_cache: bool = False,
    request_timer: ModelRequestTimer | None = None,
    reasoning_items: tuple[dict[str, Any], ...] | None = None,
) -> tuple[Any, dict[str, Any] | None]:
    kwargs: dict[str, Any] = {
        "model": model,
        "instructions": system_prompt,
        "input": user_prompt,
        "extra_body": extra_body or {},
        "store": store,
    }

    if reasoning_items is not None:
        kwargs["include"] = ["reasoning.encrypted_content"]
    if explicit_prompt_cache:
        input_items: list[dict[str, Any]] = []
        if system_prompt:
            input_items.append({
                "role": "developer",
                "content": [
                    {
                        "type": "input_text",
                        "text": system_prompt,
                        "prompt_cache_breakpoint": {"mode": "explicit"},
                    },
                ],
            })
        input_items.extend(reasoning_items or ())
        input_items.append({
            "role": "user",
            "content": [
                {
                    "type": "input_text",
                    "text": user_prompt,
                    "prompt_cache_breakpoint": {"mode": "explicit"},
                },
            ],
        })
        kwargs.pop("instructions")
        kwargs["input"] = input_items
        kwargs["prompt_cache_options"] = {"mode": "explicit"}
    elif reasoning_items:
        kwargs["input"] = [
            *reasoning_items,
            {"role": "user", "content": user_prompt},
        ]

    if tools is not None:
        if not tools:
            raise ValueError("tools must be a non-empty array")
        kwargs["tools"] = tools
    if tool_choice is not None:
        if not tools:
            raise ValueError("tool_choice requires tools")
        kwargs["tool_choice"] = tool_choice
    if parallel_tool_calls is not None:
        if not tools:
            raise ValueError("parallel_tool_calls requires tools")
        kwargs["parallel_tool_calls"] = parallel_tool_calls

    if safety_identifier is not None and str(safety_identifier).strip():
        kwargs["safety_identifier"] = str(safety_identifier).strip()

    if temperature is not None:
        kwargs["temperature"] = temperature

    if top_p is not None:
        kwargs["top_p"] = top_p

    if openai_reasoning is not None and str(openai_reasoning).strip().lower() != "off":
        reasoning_payload: dict[str, Any] = {
            "effort": openai_reasoning,
            "summary": "detailed",
        }
        if reasoning_mode is not None:
            reasoning_payload["mode"] = reasoning_mode
        kwargs["reasoning"] = reasoning_payload

    if max_output_tokens is not None:
        kwargs["max_output_tokens"] = max_output_tokens

    if openai_service_tier and str(openai_service_tier).lower() != "off":
        kwargs["service_tier"] = openai_service_tier

    text_payload: dict[str, Any] = {"format": {"type": "text"}}
    if response_format == "json":
        text_payload["format"] = {"type": "json_object"}
    elif response_format == "schema":
        if not json_schema:
            raise ValueError("--response-format schema requires --schema-file")
        text_payload["format"] = json_schema

    if response_verbosity and response_verbosity != "off":
        text_payload["verbosity"] = response_verbosity
    kwargs["text"] = text_payload

    if stream and response_format != "text":
        raise ValueError("Streaming is only supported for text responses")
    if stream:
        kwargs["stream"] = True

    if DEBUG:
        print("<debug_request>", file=sys.stderr)
        print(json.dumps(kwargs, indent=2), file=sys.stderr)
        print("</debug_request>", file=sys.stderr)

    @contextmanager
    def request_response() -> Iterator[Any]:
        with create_openai_client(
            api_key=api_key,
            openai_base_url=openai_base_url,
            openai_proxy=openai_proxy,
            openai_organization=openai_organization,
            openai_project=openai_project,
            llm_timeout=llm_timeout,
        ) as client:
            def create_response() -> Any:
                if request_timer is not None:
                    request_timer.reset()
                response = client.responses.create(**kwargs)
                if not stream:
                    validate_model_response(response)
                return response

            response = execute_openai_request(
                create_response,
                retry=retry,
                operation_name="API request",
                error_logger=error_logger,
            )
            try:
                yield response
            finally:
                if stream:
                    response.close()

    if stream:
        def response_events() -> Iterator[Any]:
            with request_response() as response:
                yield from response

        return response_events(), None

    with request_response() as response:
        return response, usage_to_dict(response_field(response, "usage"))


