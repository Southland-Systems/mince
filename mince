def open_output_file(path: Path) -> None:
    global OUTPUT_FILE
    path.parent.mkdir(parents=True, exist_ok=True)
    OUTPUT_FILE = path.open("w", encoding="utf-8")


def write_output_file(text: str, append: bool = False) -> None:
    if OUTPUT_FILE is None:
        raise ValueError("output file is not open")
    if append and text and OUTPUT_FILE.tell() > 0:
        OUTPUT_FILE.write("\n\n")
    OUTPUT_FILE.write(text)
    OUTPUT_FILE.flush()


def format_response_output(
    response_text: str,
    reasoning: str,
    print_reasoning: bool,
) -> str:
    if print_reasoning:
        return f"<think>\n{reasoning}\n</think>\n\n{response_text}"
    return response_text


def emit_response_output(
    output_text: str,
    *,
    suppress_response_output: bool = False,
    append_output: bool = False,
    stream_output_emitted: bool = False,
    output_file_path: Path | None = None,
) -> int:
    if OUTPUT_FILE is not None:
        if not stream_output_emitted:
            try:
                write_output_file(output_text, append=append_output)
            except Exception as exc:
                output_target = (
                    f" {output_file_path}"
                    if output_file_path is not None
                    else ""
                )
                print(
                    f"ERROR: Failed to write output to file{output_target}: {exc}",
                    file=sys.stderr,
                )
                if not suppress_response_output:
                    print(output_text)
                return 1
    elif stream_output_emitted:
        if not output_text or not output_text.endswith("\n"):
            print()
    elif not suppress_response_output:
        print(output_text)
    return 0


def page_or_print(text: str) -> None:
    if NONINTERACTIVE:
        print(text, end="")
    else:
        pydoc.pager(text)


