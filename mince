def parse_session_turn(value: str, option_name: str) -> int:
    try:
        turn = int(value)
    except ValueError as exc:
        raise ValueError(
            f"{option_name} TURN must be an integer"
        ) from exc
    if turn < 0:
        raise ValueError(f"{option_name} TURN must be non-negative")
    return turn

def state_turn_directories(state_session_dir: Path) -> list[tuple[int, Path]]:
    if not state_session_dir.is_dir():
        return []
    turn_dirs: list[tuple[int, Path]] = []
    for entry in state_session_dir.iterdir():
        if not entry.is_dir() or entry.is_symlink():
            continue
        try:
            turn = int(entry.name)
        except ValueError:
            continue
        if turn >= 0:
            turn_dirs.append((turn, entry))
    return turn_dirs


def iter_completed_state_turn_directories(
    state_session_dir: Path,
    maximum_turn: int | None = None,
    *,
    minimum_turn: int | None = None,
    required_file: str | tuple[str, ...] = "response",
    reverse: bool = False,
) -> Iterator[tuple[int, Path]]:
    required_files = (
        (required_file,) if isinstance(required_file, str) else required_file
    )
    for turn, entry in sorted(
        resumed_state_turn_directories(state_session_dir),
        reverse=reverse,
    ):
        if (
            (minimum_turn is None or turn >= minimum_turn)
            and (maximum_turn is None or turn <= maximum_turn)
            and any(
                path.is_file() and not path.is_symlink()
                for artifact_type in required_files
                for path in state_turn_artifact_paths(entry, artifact_type)
            )
        ):
            yield turn, entry


def next_state_turn_index(state_session_dir: Path) -> int:
    return max(
        (turn for turn, _ in resumed_state_turn_directories(state_session_dir)),
        default=-1,
    ) + 1

def last_completed_state_turn(
    state_session_dir: Path,
    turn: int | None = None,
    required_file: str | tuple[str, ...] = "response",
) -> Path:
    if state_session_dir.is_symlink() or not state_session_dir.is_dir():
        raise ValueError(
            f"state session does not exist: {state_session_dir}"
        )
    if turn is not None and turn < 0:
        raise ValueError("session turn must be non-negative")
    completed_turn = next(
        iter_completed_state_turn_directories(
            state_session_dir,
            maximum_turn=turn,
            minimum_turn=turn,
            required_file=required_file,
            reverse=True,
        ),
        None,
    )
    if completed_turn is not None:
        return completed_turn[1]
    if turn is not None:
        raise ValueError(
            f"state session has no completed turn {turn}: "
            f"{state_session_dir}"
        )
    raise ValueError(
        f"state session has no completed turns: {state_session_dir}"
    )


