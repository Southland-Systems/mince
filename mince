def append_suffix_to_path(original_path: Path, suffix: str) -> Path:
    return original_path.with_name(original_path.name + suffix)

def git_repository_root(cwd: Path | None = None) -> Path | None:
    working_directory = cwd or Path.cwd()
    try:
        completed = subprocess.run(
            ['git', 'rev-parse', '--show-toplevel'],
            cwd=working_directory,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except FileNotFoundError as exc:
        raise ValueError('git executable was not found') from exc
    if completed.returncode != 0:
        return None
    output = completed.stdout.strip()
    return Path(output).resolve() if output else None

def run_git_command(
    repo_root: Path,
    arguments: list[str],
    input_text: str | None = None,
    check: bool = True,
 ) -> Any:
    try:
        completed = subprocess.run(
            ['git', *arguments],
            cwd=repo_root,
            input=input_text,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except FileNotFoundError as exc:
        raise ValueError('git executable was not found') from exc
    if check and completed.returncode != 0:
        detail = (completed.stderr or completed.stdout).strip()
        if not detail:
            detail = f'exit status {completed.returncode}'
        command = 'git ' + ' '.join(arguments)
        raise ValueError(f'{command} failed: {detail}')
    return completed

def validate_git_branch_name(repo_root: Path, branch_name: str) -> str:
    branch_name = branch_name.strip()
    if not branch_name:
        raise ValueError('git branch name cannot be empty')
    if branch_name in ('.', '..', 'HEAD') or branch_name.startswith('-'):
        raise ValueError(f'invalid git branch name: {branch_name}')
    check = run_git_command(
        repo_root,
        ['check-ref-format', f'refs/heads/{branch_name}'],
        check=False,
    )
    if check.returncode != 0:
        detail = (check.stderr or check.stdout).strip()
        raise ValueError(
            f'invalid git branch name {branch_name!r}'
            + (f': {detail}' if detail else '')
        )
    return branch_name

PATCH_BRANCH_PREFIX = 'mce'
PATCH_BRANCH_DEFAULT_NAME = f'{PATCH_BRANCH_PREFIX}branch'

def resolve_patch_branch_name(branch_argument: str | None) -> str:
    branch_name = str(branch_argument or '').strip()
    if not branch_name:
        return PATCH_BRANCH_DEFAULT_NAME
    if not branch_name.startswith(PATCH_BRANCH_PREFIX):
        branch_name = f'{PATCH_BRANCH_PREFIX}{branch_name}'
    return branch_name

def git_worktree_is_clean(repo_root: Path) -> None:
    status = run_git_command(
        repo_root,
        ['status', '--porcelain=v1', '--untracked-files=no'],
    ).stdout.strip()
    if status:
        raise ValueError(
            'git worktree must be clean before using a patch branch; '
            'commit or stash existing changes first'
        )

def git_branch_exists(repo_root: Path, branch_name: str) -> bool:
    result = run_git_command(
        repo_root,
        ['show-ref', '--verify', '--quiet', f'refs/heads/{branch_name}'],
        check=False,
    )
    if result.returncode not in (0, 1):
        detail = (result.stderr or result.stdout).strip()
        raise ValueError(f'git show-ref failed: {detail}')
    return result.returncode == 0

def git_current_branch(repo_root: Path) -> str | None:
    result = run_git_command(
        repo_root,
        ['symbolic-ref', '--quiet', '--short', 'HEAD'],
        check=False,
    )
    if result.returncode != 0:
        return None
    branch_name = result.stdout.strip()
    return branch_name or None


def git_relative_path(repo_root: Path, path: Path) -> str:
    resolved_path = path.resolve()
    try:
        relative_path = resolved_path.relative_to(repo_root)
    except ValueError as exc:
        raise ValueError(
            f'patch path is outside the git repository: {path}'
        ) from exc
    if not relative_path.parts or '.git' in relative_path.parts:
        raise ValueError(f'patch path is not a worktree file: {path}')
    return relative_path.as_posix()

def prepare_patch_branch(repo_root: Path, branch_name: str) -> None:
    branch_name = resolve_patch_branch_name(branch_name)
    branch_name = validate_git_branch_name(repo_root, branch_name)
    if git_branch_exists(repo_root, branch_name):
        if git_current_branch(repo_root) == branch_name:
            uncommitted_status = run_git_command(
                repo_root,
                ['status', '--porcelain=v1', '--untracked-files=no'],
            ).stdout.strip()
            if uncommitted_status:
                run_git_command(
                    repo_root,
                    [
                        'commit',
                        '-a',
                        '-m',
                        f'Uncommitted {branch_name} changes.',
                    ],
                )
        else:
            git_worktree_is_clean(repo_root)
            run_git_command(repo_root, ['switch', '--', branch_name])
        return
    git_worktree_is_clean(repo_root)
    run_git_command(repo_root, ['switch', '--create', branch_name])

def git_commit_patch(
    repo_root: Path,
    paths: list[Path],
    commit_message: str,
 ) -> None:
    if not commit_message.strip():
        raise ValueError('patch commit message cannot be empty')
    relative_paths: list[str] = []
    for path in paths:
        relative_path = git_relative_path(repo_root, path)
        if relative_path not in relative_paths:
            relative_paths.append(relative_path)
    if not relative_paths:
        raise ValueError('patch did not contain any files to commit')
    run_git_command(repo_root, ['add', '--', *relative_paths])
    staged = run_git_command(
        repo_root,
        ['diff', '--cached', '--name-only'],
    ).stdout.strip()
    if not staged:
        raise ValueError(
            'git did not stage any patch files; the files may be ignored'
        )
    run_git_command(
        repo_root,
        ['commit', '--file=-'],
        input_text=commit_message.rstrip() + chr(10),
    )


def handle_patch_merge(branch_name: str, commit_message: str) -> int:
    try:
        branch_name = resolve_patch_branch_name(branch_name)
        repo_root = git_repository_root()
        if repo_root is None:
            raise ValueError('not inside a git worktree')
        branch_name = validate_git_branch_name(repo_root, branch_name)
        if not git_branch_exists(repo_root, branch_name):
            raise ValueError(f'git branch does not exist: {branch_name}')
        current_branch = git_current_branch(repo_root)
        if current_branch is None:
            raise ValueError('patch merge requires a checked-out branch')
        if current_branch == branch_name:
            uncommitted_status = run_git_command(
                repo_root,
                ['status', '--porcelain=v1', '--untracked-files=no'],
            ).stdout.strip()
            if uncommitted_status:
                run_git_command(
                    repo_root,
                    [
                        'commit',
                        '-a',
                        '-m',
                        f"Uncommitted {branch_name} changes.",
                    ],
                )
            run_git_command(repo_root, ['switch', '-'])
            current_branch = git_current_branch(repo_root)
            if current_branch is None:
                raise ValueError(
                    'git switch - did not leave a checked-out branch'
                )
            if current_branch == branch_name:
                raise ValueError(
                    'git switch - did not switch away from patch branch'
                )
        else:
            git_worktree_is_clean(repo_root)
        run_git_command(repo_root, ['merge', '--squash', branch_name])
        staged_result = run_git_command(
            repo_root,
            ['diff', '--cached', '--quiet'],
            check=False,
        )
        if staged_result.returncode == 0:
            raise ValueError(
                'squash merge produced no changes; the patch branch was not deleted'
            )
        if staged_result.returncode != 1:
            detail = (staged_result.stderr or staged_result.stdout).strip()
            raise ValueError(f'could not inspect squash merge: {detail}')
        run_git_command(
            repo_root,
            ['commit', '--file=-'],
            input_text=commit_message.rstrip() + chr(10),
        )
        run_git_command(
            repo_root,
            ['branch', '-D', '--', branch_name],
        )
    except (OSError, ValueError) as exc:
        print(f'ERROR: Failed to merge patch branch: {exc}', file=sys.stderr)
        return 1
    print(f'patch_branch_merged={branch_name}')
    return 0

def handle_patch_branch_remove(branch_name: str) -> int:
    try:
        repo_root = git_repository_root()
        if repo_root is None:
            raise ValueError('not inside a git worktree')
        branch_name = resolve_patch_branch_name(branch_name)
        branch_name = validate_git_branch_name(repo_root, branch_name)
        if not git_branch_exists(repo_root, branch_name):
            raise ValueError(f'git branch does not exist: {branch_name}')
        current_branch = git_current_branch(repo_root)
        if current_branch == branch_name:
            git_worktree_is_clean(repo_root)
            run_git_command(repo_root, ['switch', '-'])
            if git_current_branch(repo_root) == branch_name:
                raise ValueError(
                    'git switch - did not switch away from patch branch'
                )
        run_git_command(
            repo_root,
            ['branch', '-D', '--', branch_name],
        )
    except (OSError, ValueError) as exc:
        print(f'ERROR: Failed to remove patch branch: {exc}', file=sys.stderr)
        return 1
    print(f'patch_branch_removed={branch_name}')
    return 0

def generate_unified_diff(original: str, updated: str, path: str) -> str:
    original_lines = original.splitlines(keepends=True)
    updated_lines = updated.splitlines(keepends=True)

    fromfile = path if original else "/dev/null"
    tofile = path if updated else "/dev/null"

    diff_lines = list(
        difflib.unified_diff(
            original_lines,
            updated_lines,
            fromfile=fromfile,
            tofile=tofile,
        )
    )
    if not diff_lines:
        return ""
    return "".join(diff_lines) + "\n"

def detect_line_ending(text: str) -> str:
    endings = re.findall(r"\r\n|\r|\n", text)
    if not endings or all(ending == "\n" for ending in endings):
        return "lf"
    if all(ending == "\r\n" for ending in endings):
        return "crlf"
    return "mixed"


def eol_for(line_ending: str) -> str:
    return "\r\n" if line_ending == "crlf" else "\n"


def read_text_preserving_line_endings(path: Path) -> str:
    with path.open("r", encoding="utf-8", newline="") as file:
        return file.read()


def write_text_preserving_line_endings(path: Path, text: str) -> None:
    with path.open("w", encoding="utf-8", newline="") as file:
        file.write(text)


@dataclass(frozen=True)
class ShellStep:
    command: str
    lines: tuple[str, ...] = ()
    reason: str = ""

@dataclass(frozen=True)
class ShellTurn:
    commands: tuple[ShellStep, ...]
    output: str

SHELL_OUTPUT_TOKEN_FRACTION = 0.8

def _shell_step_from_value(value: Any, index: int) -> ShellStep:
    if isinstance(value, str):
        command = value.strip()
        if not command:
            raise ValueError(f"shell command {index} cannot be empty")
        return ShellStep(command)
    if not isinstance(value, dict):
        raise ValueError(f"shell command {index} must be an object or string")
    allowed_keys = {"command", "lines", "script", "reason"}
    unexpected = set(value) - allowed_keys
    if unexpected:
        raise ValueError(
            f"shell command {index} has unexpected fields: "
            + ", ".join(sorted(unexpected))
        )
    command_value = value.get("command", value.get("script"))
    if not isinstance(command_value, str) or not command_value.strip():
        raise ValueError(f"shell command {index} requires a non-empty command")
    reason_value = value.get("reason")
    if not isinstance(reason_value, str) or not reason_value.strip():
        raise ValueError(f"shell command {index} requires a non-empty reason")
    reason = reason_value.strip()
    if "lines" not in value:
        return ShellStep(command=command_value.strip(), reason=reason)
    raw_lines = value["lines"]
    if not isinstance(raw_lines, list) or not raw_lines:
        raise ValueError(f"shell script {index} requires a non-empty lines array")
    if any(not isinstance(line, str) for line in raw_lines):
        raise ValueError(f"shell script {index} lines must be strings")
    return ShellStep(
        command=command_value.strip(),
        lines=tuple(raw_lines),
        reason=reason,
    )

def normalize_shell_commands(values: Any) -> list[ShellStep]:
    if not isinstance(values, list) or not values:
        raise ValueError("shell manifest commands must be a non-empty array")
    return [
        _shell_step_from_value(value, index)
        for index, value in enumerate(values, start=1)
    ]


def parse_shell_manifest(raw: str) -> list[ShellStep]:
    try:
        manifest = json.loads(clean_json_response(raw))
    except json.JSONDecodeError:
        raise
    if not isinstance(manifest, dict):
        raise ValueError("shell manifest must contain a JSON object")
    if set(manifest) != {"commands"}:
        raise ValueError("shell manifest must contain only a commands field")
    return normalize_shell_commands(manifest["commands"])

def parse_shell_followup_response(
    raw: str,
 ) -> tuple[str, list[ShellStep] | None, str | None]:
    try:
        response = json.loads(clean_json_response(raw))
    except json.JSONDecodeError:
        raise
    if not isinstance(response, dict):
        raise ValueError("shell follow-up response must contain a JSON object")
    if set(response) != {"action", "commands", "reason"}:
        raise ValueError("shell follow-up response must contain only action, commands, and reason")
    action = response.get("action")
    if action not in ("commands", "session_end"):
        raise ValueError("shell follow-up action must be commands or session_end")
    reason = response["reason"]
    if not isinstance(reason, str):
        raise ValueError("shell follow-up reason must be a string")
    if action == "session_end":
        if not reason.strip():
            raise ValueError("shell follow-up session_end reason cannot be empty")
        return action, None, reason
    return action, normalize_shell_commands(response["commands"]), None

def format_shell_commands(commands: list[ShellStep]) -> str:
    blocks: list[str] = []
    for index, step in enumerate(commands, start=1):
        reason_prefix = (
            f"{step.reason}\n"
            if step.reason
            else ""
        )
        if step.lines:
            block = (
                f"{reason_prefix}[{index}] $ {step.command} <<'MINCE_SCRIPT'\n"
                + "\n".join(step.lines)
                + "\nMINCE_SCRIPT"
            )
        else:
            block = f"{reason_prefix}[{index}] $ {step.command}"
        blocks.append(block)
    return "\n\n".join(blocks)

def format_shell_command_context(commands: list[ShellStep]) -> str:
    blocks: list[str] = []
    for index, step in enumerate(commands, start=1):
        if step.lines:
            block = (
                f"[{index}] $ {step.command} <<'MINCE_SCRIPT'\n"
                + "\n".join(step.lines)
                + "\nMINCE_SCRIPT"
            )
        else:
            block = f"[{index}] $ {step.command}"
        blocks.append(block)
    return "\n\n".join(blocks)

def format_shell_command_archive(
    archived_turns: list[ShellTurn],
 ) -> str:
    turn_blocks: list[str] = []
    for turn in archived_turns:
        if not turn.commands:
            continue
        turn_blocks.append(
            f"<shell_turn index='{len(turn_blocks) + 1}'>\n"
            f"{format_shell_command_context(list(turn.commands))}\n"
            "</shell_turn>"
        )
    return "\n".join(turn_blocks)

def shell_review_usage() -> str:
    return "Usage: [y]es, [n]o, [p]ager, [h]elp, [e]dit, E <prompt>"

def process_shell_review_input(
    shell_input: str,
    command_text: str,
 ) -> str | None:
    choice = shell_input.strip()
    normalized_choice = choice.lower()
    if not choice or normalized_choice == "h":
        print(shell_review_usage())
        return None
    if normalized_choice == "p":
        page_or_print(command_text)
        return None
    return choice

def review_shell_commands(commands: list[ShellStep]) -> tuple[str, str | None]:
    command_text = format_shell_commands(commands)
    print()
    print(command_text)
    if NONINTERACTIVE:
        return 'accept', None
    while True:
        choice = process_shell_review_input(
            input('Run these shell commands? [y/n/p/h/e/E <prompt>]: '),
            command_text,
        )
        if choice is None:
            continue
        normalized_choice = choice.lower()
        if normalized_choice in ('y', 'yes'):
            return 'accept', None
        if normalized_choice in ('n', 'no'):
            return 'reject', None
        if normalized_choice == 'e':
            return 'edit', None
        if (
            choice.startswith('E')
            and len(choice) > 1
            and choice[1].isspace()
        ):
            revision_task = choice[1:].strip()
            if not revision_task:
                print('Revision task cannot be empty.')
                continue
            return 'edit', revision_task
        print('Please answer y, n, p, h, e, or E followed by a prompt.')

def _shell_text(value: Any) -> str:
    if isinstance(value, bytes):
        return value.decode("utf-8", errors="replace")
    return str(value or "")

def execute_shell_commands(
    commands: list[ShellStep],
    timeout: int,
 ) -> str:
    output_blocks: list[str] = []
    command_timeout = max(1, int(timeout))
    for index, step in enumerate(commands, start=1):
        script_input = None
        if step.lines:
            script_input = "\n".join(step.lines) + "\n"
        try:
            completed = subprocess.run(
                step.command,
                shell=True,
                input=script_input,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
                timeout=command_timeout,
            )
            status = str(completed.returncode)
            stdout = _shell_text(completed.stdout)
            stderr = _shell_text(completed.stderr)
        except subprocess.TimeoutExpired as exc:
            status = "timeout"
            stdout = _shell_text(getattr(exc, "stdout", ""))
            stderr = _shell_text(getattr(exc, "stderr", ""))
            stderr = (stderr + "\n" if stderr else "") + (
                f"command exceeded timeout of {command_timeout} seconds"
            )
        except Exception as exc:
            status = "error"
            stdout = ""
            stderr = f"{type(exc).__name__}: {exc}"

        stdout = "\n" + stdout if stdout != "" else stdout
        stderr = "\n" + stderr if stderr != "" else stderr
        output_blocks.append(
            f"<command index='{index}'>\n"
            f"<shell>\n{format_shell_commands([step])}\n</shell>\n"
            f"<exit_status>{status}</exit_status>\n"
            f"<stdout>{stdout}</stdout>\n"
            f"<stderr>{stderr}</stderr>\n"
            "</command>"
        )
    return "\n".join(output_blocks)

def build_shell_followup_prompt(
    task: str,
    shell_output: list[ShellTurn | str] | str,
    json_schema: dict[str, Any] | None = None,
    shell_command_archive: list[ShellTurn] | None = None,
 ) -> str:
    schema_block = ""
    if json_schema is not None:
        schema_block = (
            "\n<json_schema instructions='Return JSON that matches this schema exactly'>\n"
            f"{json.dumps(json_schema, indent=2, ensure_ascii=False)}\n"
            "</json_schema>"
        )
    output_values = (
        [shell_output] if isinstance(shell_output, str) else shell_output
    )
    output_history = [
        value
        if isinstance(value, ShellTurn)
        else ShellTurn(commands=(), output=str(value))
        for value in output_values
    ]
    archive_text = format_shell_command_archive(
        shell_command_archive or []
    )
    archive_block = (
        "\n<shell_command_context name='archive'>\n"
        f"{archive_text}\n"
        "</shell_command_context>\n"
        if archive_text
        else ""
    )
    shell_turn_blocks = "\n\n".join(
        f"<shell_turn index='{index}'>\n"
        f"<shell_output>\n{turn.output}\n</shell_output>\n"
        "</shell_turn>"
        for index, turn in enumerate(output_history, start=1)
    )
    return (
        "The task was:\n"
        f"\n{task}\n\n\n"
        "The accepted shell commands from each turn have now been executed. "
        "Their actual output is below.\n"
        f"{archive_block}{shell_turn_blocks}\n"
        "Decide whether more commands are needed or end the session. Use "
        "action=commands with commands when more shell work is needed; "
        "otherwise use action=session_end with a reason that completes the session.\n"
        f"{schema_block}"
    )

PATCH_REVISION_HEADING = (
    "# Changes made below this line will be ignored; only text above this line will be used as the next task."
)


def patch_review_usage(allow_navigation: bool = False) -> str:
    options = (
        "[y]es, [n]o, [p]ager, [h]elp, "
        "[S] toggle patch suffix"
    )
    if allow_navigation:
        options += ", [<]prevturn, [>]nextturn, [e]dit, E <prompt>"
    return f"Usage: {options}"


def process_patch_review_input(
    patch_input: str,
    diff_text: str,
    suffix_provided: bool,
    allow_navigation: bool = False,
 ) -> tuple[str | None, bool]:
    choice = patch_input.strip()
    normalized_choice = choice.lower()
    if not choice or normalized_choice == "h":
        print(patch_review_usage(allow_navigation))
        return None, suffix_provided
    if normalized_choice == "p":
        page_or_print(diff_text)
        return None, suffix_provided
    if normalized_choice == "s":
        suffix_provided = not suffix_provided
        state = "enabled" if suffix_provided else "disabled"
        print(f"Patch suffix {state}.")
        return None, suffix_provided
    return choice, suffix_provided


def build_patch_revision_editor_text(
    diff_text: str,
    previous_task: str = "",
 ) -> str:
    previous_task = previous_task.strip()
    return (
        ("\n" * 2)
        + f"{PATCH_REVISION_HEADING}\n\n"
        + (f"{previous_task}\n\n" if previous_task else "")
        + diff_text
    )


def extract_patch_revision_task(edited_text: str) -> str:
    task_text, separator, _ = edited_text.partition(PATCH_REVISION_HEADING)
    return (task_text if separator else edited_text).strip()
def build_shell_revision_editor_text(
    commands: list[ShellStep],
    previous_task: str = '',
 ) -> str:
    return build_patch_revision_editor_text(
        format_shell_command_context(commands),
        previous_task,
    )



def prefix_line_numbers(text: str) -> str:
    lines = text.splitlines(keepends=True)
    return "".join(f"{i} {line}" for i, line in enumerate(lines, start=1))

@dataclass(frozen=True)
class PatchRange:
    patch_id: str
    start_line: int
    end_line: int


def validate_patch_ranges(
    patches: list[dict[str, Any]],
    total_lines: int,
    declared_total_lines: int | None = None,
 ) -> list[PatchRange]:
    ranges: list[PatchRange] = []

    for patch in patches:
        patch_id = str(patch["patch_id"])
        start_line = int(patch["start_line"])
        end_line = int(patch["end_line"])

        if start_line < 1:
            raise ValueError(f'{patch_id}: start_line must be >= 1')
        if end_line < 1:
            raise ValueError(f'{patch_id}: end_line must be >= 1')
        if total_lines == 0:
            full_document_creation = (
                start_line == 1
                and declared_total_lines is not None
                and declared_total_lines > 1
                and end_line == declared_total_lines
            )
            if start_line != 1 or (
                end_line != 1 and not full_document_creation
            ):
                raise ValueError(
                    f'{patch_id}: empty documents only support line 1 insertion '
                    'or full-document creation'
                )
        elif end_line > total_lines and not (
            start_line == end_line == total_lines + 1
        ):
            raise ValueError(
                f'{patch_id}: end_line cannot exceed document total_lines '
                f'({total_lines})'
            )
        if start_line > end_line:
            raise ValueError(f'{patch_id}: start_line cannot be greater than end_line')

        ranges.append(
            PatchRange(
                patch_id=patch_id,
                start_line=start_line,
                end_line=end_line,
            )
        )

    ranges_sorted = sorted(
        ranges,
        key=lambda item: (item.start_line, item.end_line, item.patch_id),
    )
    for previous, current in zip(ranges_sorted, ranges_sorted[1:]):
        if current.start_line <= previous.end_line:
            raise ValueError(
                'Overlapping or nested blocks detected: '
                f'{previous.patch_id} [{previous.start_line}, {previous.end_line}] '
                f'and {current.patch_id} [{current.start_line}, {current.end_line}]'
            )

    return ranges

def apply_combined_patch_manifest(
    original_texts: dict[str, str],
    manifest: dict[str, Any],
) -> dict[str, str]:
    updated_texts: dict[str, str] = {}
    seen_paths: set[str] = set()

    for file_entry in manifest.get("files", []):
        path = str(patch_manifest_document_path(file_entry))
        if path in seen_paths:
            raise ValueError(f"patch contains duplicate document path: {path}")
        seen_paths.add(path)
        if path not in original_texts:
            original = ""
        else:
            original = original_texts[path]

        updated = apply_file_patch_manifest(original, file_entry)
        updated_texts[path] = updated

    for path, text in original_texts.items():
        if path not in updated_texts:
            updated_texts[path] = text

    return updated_texts

def apply_file_patch_manifest(original_text: str, file_manifest: dict[str, Any]) -> str:
    if not file_manifest.get("patches"):
        return original_text

    document = file_manifest["document"]
    line_ending = document["line_ending"]
    eol = eol_for(line_ending)

    lines = original_text.splitlines(keepends=False)
    total_lines = len(lines)
    declared_total_lines = int(document["total_lines"])
#    if total_lines == 0:
#        total_lines_match = declared_total_lines in (0, 1)
#    else:
#        total_lines_match = declared_total_lines == total_lines
#    if not total_lines_match:
#        print(
#            f"WARNING: patch document line count ({total_lines}) does not match "
#            f"manifest total_lines ({declared_total_lines})",
#            file=sys.stderr
#        )
#    if original_text and detect_line_ending(original_text) != line_ending:
#        raise ValueError(
#            f"patch document line ending does not match manifest: "
#            f"expected {line_ending}, detected "
#            f"{detect_line_ending(original_text)}"
#        )

    validate_patch_ranges(
        file_manifest["patches"],
        total_lines,
        declared_total_lines=declared_total_lines,
    )

    # Apply patches in reverse order so earlier line numbers stay valid
    patches = sorted(
        file_manifest["patches"],
        key=lambda p: int(p["start_line"]),
        reverse=True,
    )

    for patch in patches:
        start_line = int(patch["start_line"])
        end_line = int(patch["end_line"])
        lines[start_line - 1 : end_line] = patch["content_line_array"]
    result = eol.join(lines)
    if original_text.endswith(eol):
        result += eol
    return result

def patch_manifest_document_path(file_entry: dict[str, Any]) -> Path:
    document = file_entry["document"]
    path = Path(str(document["path"])).expanduser()
    if not path.is_absolute():
        path = Path.cwd() / path
    return path.resolve()


def resolve_patch_suffix(
    config: dict[str, Any],
    patch_suffix_argument: str | None,
 ) -> tuple[str, bool]:
    configured_suffix = str(
        config.get('patch_suffix', DEFAULT_CONFIG['patch_suffix']) or ''
    ).strip()
    if patch_suffix_argument is not None:
        return patch_suffix_argument, True
    if configured_suffix and configured_suffix.lower() != 'off':
        return configured_suffix, configured_suffix != DEFAULT_CONFIG['patch_suffix']
    return DEFAULT_CONFIG['patch_suffix'], False


def build_patch_changes(
    original_texts: dict[str, str],
    manifest: dict[str, Any],
 ) -> tuple[dict[str, str], str, list[tuple[str, str]]]:
    updated_texts = apply_combined_patch_manifest(
        original_texts,
        manifest,
    )
    diffs: list[str] = []
    changed_items: list[tuple[str, str]] = []
    for path, updated_text in updated_texts.items():
        original_text = original_texts.get(path, "")
        if updated_text == original_text:
            continue
        changed_items.append((path, updated_text))
        diff = generate_unified_diff(original_text, updated_text, path)
        if diff:
            diffs.append(diff)
    return updated_texts, "\n".join(diffs), changed_items


def load_patch_manifest(path: Path) -> dict[str, Any]:
    if not path.is_file():
        raise ValueError(f"patch JSON file does not exist: {path}")
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        raise ValueError(f"cannot read patch JSON file {path} ({exc})") from exc
    if not isinstance(raw, dict):
        raise ValueError("patch manifest must contain a JSON object")
    files = raw.get("files")
    if not isinstance(files, list) or not files:
        raise ValueError("patch manifest must contain a non-empty files array")
    commit_message = raw.get("commit_message")
    if not isinstance(commit_message, str) or not commit_message.strip():
        raise ValueError("patch manifest commit_message cannot be empty")
    return raw


def resolve_patch_file_argument(
    value: str,
    turn: int | None = None,
    option_name: str = "--patch-file-apply",
 ) -> Path:
    raw_value = value.strip()
    if not raw_value:
        raise ValueError("patch session or file path cannot be empty")
    try:
        session_name = validate_session_name(raw_value)
    except ValueError as exc:
        if turn is not None:
            raise ValueError(
                f"{option_name} TURN requires a session name"
            ) from exc
        return Path(raw_value).expanduser()
    state_session_dir = STATE_DIR / session_name
    if turn is not None or state_session_dir.is_dir():
        if option_name == "--patch-file-apply" and state_session_dir.is_dir():
            for entry in state_session_dir.iterdir():
                if not entry.is_dir() or entry.is_symlink():
                    continue
                try:
                    applied_turn = int(entry.name)
                except ValueError:
                    continue
                if applied_turn >= 0 and (
                    entry / "response_schema_patch_applied"
                ).is_file():
                    raise ValueError(
                        "response_schema_patch_applied already exists in "
                        f"patch session {state_session_dir} "
                        f"(turn {applied_turn})"
                    )
        turn_dir = last_completed_state_turn(
            state_session_dir,
            turn,
            required_file="response_schema_patch",
        )
        return turn_dir / "response_schema_patch"
    return Path(raw_value).expanduser()


def load_patch_original_texts(
    manifest: dict[str, Any],
 ) -> dict[str, str]:
    original_texts: dict[str, str] = {}
    for file_entry in manifest["files"]:
        path = patch_manifest_document_path(file_entry)
        path_text = str(path)
        if path_text in original_texts:
            raise ValueError(f"patch contains duplicate document path: {path}")
        if not path.exists():
            original_texts[path_text] = ""
            continue
        if not path.is_file():
            raise ValueError(f"patch document path is not a file: {path}")
        try:
            original_texts[path_text] = read_text_preserving_line_endings(path)
        except Exception as exc:
            raise ValueError(f"cannot read patch document {path} ({exc})") from exc
    return original_texts


def write_patch_changes(
    changed_items: list[tuple[str, str]],
    all_paths: list[Path],
    patch_review: bool,
    patch_suffix: str,
    suffix_provided: bool,
    patch_branch_setting: str | None,
    patch_commit_message: str,
 ) -> list[str]:
    written_paths: list[str] = []
    if patch_branch_setting is not None:
        branch_name = resolve_patch_branch_name(patch_branch_setting)
        repo_root = git_repository_root()
        if repo_root is None:
            raise ValueError("not inside a git worktree")
        current_branch = git_current_branch(repo_root)
        if current_branch is None:
            raise ValueError("patch branch mode requires a checked-out branch")
        branch_name = validate_git_branch_name(repo_root, branch_name)
        for path in all_paths:
            git_relative_path(repo_root, path)
        for path_text, _ in changed_items:
            git_relative_path(repo_root, Path(path_text))
        prepare_patch_branch(repo_root, branch_name)
        for path_text, updated_text in changed_items:
            target_path = Path(path_text)
            target_path.parent.mkdir(parents=True, exist_ok=True)
            write_text_preserving_line_endings(target_path, updated_text)
            written_paths.append(str(target_path))
        git_commit_patch(
            repo_root,
            [Path(path_text) for path_text, _ in changed_items],
            patch_commit_message,
        )
        for path_text, _ in changed_items:
            print(f"file_written={path_text}")
        print(f"patch_branch={branch_name}")
        return written_paths

    for path_text, updated_text in changed_items:
        original_path = Path(path_text)
        use_suffix = not patch_review or suffix_provided
        target_path = (
            append_suffix_to_path(original_path, patch_suffix)
            if use_suffix
            else original_path
        )
        target_path.parent.mkdir(parents=True, exist_ok=True)
        write_text_preserving_line_endings(target_path, updated_text)
        written_paths.append(str(target_path))
        print(
            f"file_written="
            f"{str(target_path) if use_suffix else path_text}"
        )
    return written_paths


def handle_patch_file_apply(
    patch_file_argument: str,
    config: dict[str, Any],
    patch_review_argument: bool | None,
    patch_suffix_argument: str | None,
    patch_branch_argument: str | None,
    patch_turn: int | None = None,
 ) -> int:
    try:
        patch_path = resolve_patch_file_argument(
            patch_file_argument,
            turn=patch_turn,
        )
        manifest = load_patch_manifest(patch_path)
        original_texts = load_patch_original_texts(manifest)
    except Exception as exc:
        print(f"ERROR: Failed to load patch file: {exc}", file=sys.stderr)
        return 1

    patch_review = (
        patch_review_argument
        if patch_review_argument is not None
        else coerce_bool(config.get("patch_review", "off"))
    )
    patch_suffix, suffix_provided = resolve_patch_suffix(
        config, patch_suffix_argument
    )

    try:
        patch_branch_setting = resolve_patch_branch_setting(
            patch_branch_argument
            if patch_branch_argument is not None
            else config.get("patch_branch", DEFAULT_CONFIG["patch_branch"])
        )
    except ValueError as exc:
        print(f"ERROR: Invalid patch branch value: {exc}", file=sys.stderr)
        return 1
    if patch_branch_setting is not None:
        patch_suffix = ""
        suffix_provided = False

    patch_commit_message = str(manifest["commit_message"]).strip()
    try:
        _, diff_text, changed_items = build_patch_changes(
            original_texts,
            manifest,
        )
    except Exception as exc:
        print(f"ERROR: Failed to apply patch manifest: {exc}", file=sys.stderr)
        return 1

    if not changed_items:
        if VERBOSE:
            print("No changes.", file=sys.stderr)
        return 0

    if VERBOSE or patch_review:
        print()
        print(diff_text)

    if patch_review:
        while True:
            patch_input = input("Apply these changes? [y/n/p/h/S]: ")
            patch_input, suffix_provided = process_patch_review_input(
                patch_input,
                diff_text,
                suffix_provided,
            )
            if patch_input is None:
                continue
            patch_choice = patch_input.lower()
            if patch_choice in ("y", "yes"):
                break
            if patch_choice in ("n", "no"):
                if VERBOSE:
                    print("Aborted.", file=sys.stderr)
                return 0
            print("Please answer y, n, or p.")

    try:
        written_patch_paths = write_patch_changes(
            changed_items=changed_items,
            all_paths=[Path(path) for path in original_texts],
            patch_review=patch_review,
            patch_suffix=patch_suffix,
            suffix_provided=suffix_provided,
            patch_branch_setting=patch_branch_setting,
            patch_commit_message=patch_commit_message,
        )
        if patch_path.name == "response_schema_patch":
            write_state_schema_patch_applied(
                patch_path.parent,
                written_patch_paths,
            )
    except Exception as exc:
        action = (
            "write and commit patch branch"
            if patch_branch_setting is not None
            else "write patch files"
        )
        print(f"ERROR: Failed to {action}: {exc}", file=sys.stderr)
        return 1
    return 0

def handle_patch_file_print(
    patch_file_argument: str,
    patch_turn: int | None = None,
 ) -> int:
    try:
        patch_path = resolve_patch_file_argument(
            patch_file_argument,
            turn=patch_turn,
            option_name="--patch-file-print",
        )
        manifest = load_patch_manifest(patch_path)
        original_texts = load_patch_original_texts(manifest)
        _, diff_text, _ = build_patch_changes(
            original_texts,
            manifest,
        )
    except Exception as exc:
        print(
            f"ERROR: Failed to print patch file: {exc}",
            file=sys.stderr,
        )
        return 1
    sys.stdout.write(diff_text)
    return 0

