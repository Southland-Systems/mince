            )
    return args


def disable_patch_shell_conflicting_options(args: argparse.Namespace) -> None:
    disabled_options: dict[str, Any] = {
        "patch": False,
        "shell": False,
        "patch_branch": False,
        "patch_branch_remove": None,
        "patch_merge": None,
        "patch_file_apply": None,
        "patch_file_print": None,
    }
    for option_name, value in disabled_options.items():
        setattr(args, option_name, value)


def disable_ask_conflicting_options(args: argparse.Namespace) -> None:
    disable_patch_shell_conflicting_options(args)
    disabled_options: dict[str, Any] = {
        "files": None,
        "files_list": None,
        "plan": False,
        "plan_system_prompt": None,
        "agent": False,
        "agent_review": False,
        "agent_auto": False,
        "agent_context_expires": None,
        "agent_context_assist": None,
        "agent_prompt_assist": None,
        "agent_hook_context": None,
        "agent_profiles": None,
        "agent_profile_default": None,
        "contain": None,
        "shell_networking": False,
        "shell_trace": False,
        "shell_timeout": 0,
        "patch_review": False,
        "patch_suffix": None,
        "patch_system_prompt": None,
        "shell_system_prompt": None,
        "agent_system_prompt": None,
        "resume_session": None,
        "resume_session_skip_verify": False,
        "tree_files": None,
        "tree_files_list": None,
        "tree_task": None,
        "tree_task_file": None,
        "tree_system_prompt_file": None,
        "tree_exclude": None,
        "tree_exclude_git": None,
        "tree_include": None,
        "tree_show_only": False,
        "tree_parallel": None,
        "linenum_system_prompt": None,
        "no_line_numbers": None,
    }
    for option_name, value in disabled_options.items():
        setattr(args, option_name, value)

