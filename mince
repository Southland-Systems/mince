    active_context: str
    meta_task_list: tuple[dict[str, Any], ...] = ()
    context_summary: AgentContextSummary | None = None
    context_assist_summary: str = ""
    context_assist_require_compaction: bool = False
    context_assist_skip_next_interval: bool = False
    turn_metadata: dict[str, Any] | None = None
    runtime_state: dict[str, Any] | None = None
    next_state_turn: int | None = None
    pending_model_result: AgentModelResult | None = None
