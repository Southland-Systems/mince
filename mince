        def __init__(self, path: Path) -> None:
            self.path = path
            config = CONFIG_STORE.merged(path)
            self.parent_name = CONFIG_STORE.inherit_profile_name(config, path)
            defaults = (
                CONFIG_STORE.merged(get_profile_path(self.parent_name))
                if self.parent_name is not None
                else DEFAULT_CONFIG.copy()
            )
            fields = tuple(
                Field(
                    name=name,
                    label=name,
                    kind=(
                        "bool" if name in CONFIG_BOOLEAN_KEYS
                        else "enum" if name in CONFIG_VALUE_CHOICES
                        else "number" if (
                            isinstance(default, int)
                            and name not in ("agent_context_assist", "agent_prompt_assist")
                        )
                        else "text"
                    ),
                    default=coerce_bool(default) if name in CONFIG_BOOLEAN_KEYS else default,
                    choices=CONFIG_VALUE_CHOICES.get(name, ()),
                    description=self.FIELD_HELP.get(name, ""),
                    secret=name == "api_key",
                )
                for name, default in DEFAULT_CONFIG.items()
            )
            super().__init__(
                "Configuration", str(path), fields, config, defaults,
                self.save_values, editor=edit_text,
            )
            self.default_label = (
                f"Inherited from {self.parent_name}"
                if self.parent_name is not None
                else "Built-in default"
            )

        boolean_value = staticmethod(coerce_bool)

        def field_label(self, field: Field) -> str:
            inherited = (
                self.parent_name is not None
                and self.values[field.name] == self.defaults[field.name]
            )
            return ("^" if inherited else "") + field.label

        def format_value(self, field: Field, value: Any) -> str:
            if field.kind == "bool":
                return "on" if coerce_bool(value) else "off"
            if field.kind == "enum":
                return str(parse_config_value(field.name, value))
            if field.name == "agent_context_expires":
                return normalize_agent_context_expires(value)
            if (
                field.name in (
                    "agent_backup", "agent_context_assist", "agent_prompt_assist",
                    "files", "task_files", "images", "token_cost",
                )
                and isinstance(value, (list, tuple))
            ):
                return shlex.join(str(part) for part in value)
            return format_config_value(value)

        def parse_value(self, field: Field, value: str) -> Any:
            name = field.name
            if value.strip() == "DEFAULT":
                return self.defaults[name]
            assignment = parse_config_assignment(
                f"{name}={value}", self.values
            )
            parsed_value = assignment.value
            parsed = parse_config_value(name, parsed_value)
            for existing in (self.applied[name], self.defaults[name]):
                if parsed == parse_config_value(name, existing):
                    return existing
            return parsed_value

        def validate_value(self, field: Field, value: Any) -> Any:
            parse_config_value(field.name, value)
            return value

        def save_values(self, values: dict[str, Any]) -> None:
            CONFIG_STORE.save(values, self.path)

    screen = ConfigurationScreen(CONFIG_FILE)
    saved = Terminal.run(screen.run, palette=(("Amber", (214, 3)),))
    print("Configuration saved." if saved else "Configuration unchanged.")


