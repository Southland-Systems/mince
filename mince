def agent_system_prompts(settings: AgentRunSettings) -> dict[str, str]:
    prompts = {
        **{
            name: getattr(settings, name)
            for name in AGENT_BASE_SYSTEM_PROMPT_NAMES
        },
        "task_priority_system_prompt": AGENT_TASK_PRIORITY_SYSTEM_PROMPT,
        "context_assist_system_prompt": AGENT_CONTEXT_ASSIST_SYSTEM_PROMPT,
        "prompt_assist_system_prompt": AGENT_PROMPT_ASSIST_SYSTEM_PROMPT,
        "context_summary_system_prompt": AGENT_SUMMARY_INSTRUCTIONS,
        **AGENT_TOOL_CALL_SYSTEM_PROMPTS,
    }
    profiles = settings.agent_profiles
    if settings.agent_profile_default is not None:
        profiles += (settings.agent_profile_default,)
    prompts.update({
        f"agent_profile_{profile.name}": profile.description
        for profile in profiles
    })
    prompts.update(settings.system_prompt_overrides)
    return prompts


def format_agent_system_prompt_inventory(settings: AgentRunSettings) -> str:
    prompts = agent_system_prompts(settings)
    if not settings.original_system_prompts:
        settings.original_system_prompts = prompts.copy()
    inventories = (
        ("agent_system_prompts", prompts),
        (
            "previous_agent_system_prompts",
            {
                name: content
                for name, content in settings.previous_system_prompts.items()
                if name in prompts
            },
        ),
        (
            "original_agent_system_prompts",
            {
                name: settings.original_system_prompts.get(name, content)
                for name, content in prompts.items()
            },
        ),
    )
    return join_prompt_sections(*(
        format_context_entry(
            name,
            f"{json.dumps(inventory, indent=2, ensure_ascii=False)}\n",
            include_token_count=False,
        )
        for name, inventory in inventories
    ))

def write_state_agent_runtime_state(
    turn_dir: Path,
    settings: AgentRunSettings,
    artifact_prefix: str = "response",
    turn_metadata: dict[str, Any] | None = None,
) -> None:
    context_summary = (
        settings.context_summary.as_dict()
        if settings.context_summary is not None
        else None
    )
    state = {
        "version": 1,
        "turn_metadata": turn_metadata,
        "prior_token_estimates": settings.prior_token_estimates,
        "file_context_ids": settings.file_context_ids,
        "pending_revision_instruction": settings.pending_revision_instruction,
        "advance_expirations": settings.advance_expirations,
        "base_system_prompts": {
            name: getattr(settings, name)
            for name in AGENT_BASE_SYSTEM_PROMPT_NAMES
        },
        "system_prompt_overrides": settings.system_prompt_overrides,
        "previous_system_prompts": settings.previous_system_prompts,
        "original_system_prompts": settings.original_system_prompts,
        "cumulative_stats": settings.cumulative_stats.as_dict(),
        "agent_profiles": [vars(profile) for profile in settings.agent_profiles],
        "agent_profile_default": (
            vars(settings.agent_profile_default)
            if settings.agent_profile_default is not None
            else None
        ),
        "agent_hook_context_scripts": settings.agent_hook_context_scripts,
        "assist_last_turns": settings.assist_last_turns,
        "assist_retry_turns": settings.assist_retry_turns,
        "pending_assists": settings.pending_assists,
        "context_summary": context_summary,
        "context_assist_summary": settings.context_assist_summary,
        "context_assist_require_compaction": settings.context_assist_require_compaction,
        "context_assist_skip_next_interval": settings.context_assist_skip_next_interval,
        "last_compaction_turn": settings.last_compaction_turn,
    }
    if turn_metadata is not None:
        write_state_artifact(
            turn_dir,
            f"{artifact_prefix}_agent_turn_metadata",
            json.dumps(turn_metadata, ensure_ascii=False),
        )
    if context_summary is not None:
        write_state_artifact(
            turn_dir,
            f"{artifact_prefix}_agent_context_summary",
            json.dumps(context_summary, ensure_ascii=False),
        )
    write_state_agent_context_assist(turn_dir, settings, artifact_prefix)
    write_state_artifact(
        turn_dir,
        f"{artifact_prefix}_agent_runtime_state",
        json.dumps(state, ensure_ascii=False, allow_nan=False),
    )


def parse_state_agent_profile(value: Any) -> AgentProfile:
    fields = {"name", "profile_type", "content", "description"}
    if (
        not isinstance(value, dict)
        or set(value) != fields
        or any(not isinstance(value[name], str) for name in fields)
    ):
        raise ValueError("invalid saved agent profile")
    profile = AgentProfile(
        name=validate_agent_profile_name(value["name"]),
        profile_type=normalize_agent_profile_type(value["profile_type"]),
        content=value["content"],
        description=value["description"],
    )
    agent_profile_response_schema(profile)
    return profile


def load_state_agent_runtime_state(turn_dir: Path) -> dict[str, Any] | None:
    artifact = read_first_present_state_artifact(tuple(
        turn_dir / f"{prefix}_agent_runtime_state"
        for prefix in ("response", "request")
    ))
    if artifact is None:
        return None
    artifact_path, artifact_text = artifact

    try:
        state = json.loads(artifact_text)
        if isinstance(state, dict):
            state.pop("context_assist_write_context_summary", None)
            state.setdefault("file_context_ids", {})
            state.setdefault("assist_retry_turns", {})
            history = state.pop("system_prompt_history", [])
            if not isinstance(history, list) or any(
                not isinstance(entry, dict)
                or set(entry) != {"name", "content"}
                or not isinstance(entry["name"], str) or not entry["name"]
                or not isinstance(entry["content"], str)
                for entry in history
            ):
                raise ValueError("invalid system prompt history")
            state.setdefault("previous_system_prompts", {
                entry["name"]: entry["content"] for entry in history
            })
            state.setdefault("original_system_prompts", {})
            state.setdefault("last_compaction_turn", None)
        expected_fields = {
            "version", "turn_metadata", "prior_token_estimates",
            "file_context_ids",
            "pending_revision_instruction", "advance_expirations",
            "base_system_prompts", "system_prompt_overrides",
            "previous_system_prompts", "original_system_prompts",
            "cumulative_stats",
            "agent_profiles", "agent_profile_default",
            "agent_hook_context_scripts", "assist_last_turns",
            "assist_retry_turns", "pending_assists", "context_summary",
            "context_assist_summary",
            "context_assist_require_compaction",
            "context_assist_skip_next_interval", "last_compaction_turn",
        }
        if (
            not isinstance(state, dict)
            or set(state) != expected_fields
            or not is_integer(state["version"])
            or state["version"] != 1
        ):
            raise ValueError("invalid fields or version")
        file_context_ids = state["file_context_ids"]
        if (
            not isinstance(file_context_ids, dict)
            or any(
                not isinstance(path, str) or not path
                or not is_integer(identifier)
                for path, identifier in file_context_ids.items()
            )
            or len(set(file_context_ids.values())) != len(file_context_ids)
        ):
            raise ValueError("invalid file context IDs")
        if state["turn_metadata"] is not None and not isinstance(
            state["turn_metadata"], dict
        ):
            raise ValueError("turn metadata must be an object")
        if state["last_compaction_turn"] is not None and not is_integer(
            state["last_compaction_turn"]
        ):
            raise ValueError("invalid last compaction turn")
        for name in ("pending_revision_instruction", "context_assist_summary"):
            if not isinstance(state[name], str):
                raise ValueError(f"{name} must be a string")
        for name in (
            "advance_expirations", "context_assist_require_compaction",
            "context_assist_skip_next_interval",
        ):
            if not isinstance(state[name], bool):
                raise ValueError(f"{name} must be a boolean")
        estimates = state["prior_token_estimates"]
        if (
            not isinstance(estimates, list)
            or len(estimates) > AGENT_PRIOR_TOKEN_ESTIMATES_MAX_TURNS
            or any(
                not isinstance(entry, list)
                or len(entry) != 2
                or any(not is_integer(value) for value in entry)
                for entry in estimates
            )
        ):
            raise ValueError("invalid token estimate history")
        estimate_turns = [entry[0] for entry in estimates]
        if estimate_turns != sorted(set(estimate_turns)):
            raise ValueError("token estimate turns must be unique and ordered")
        for name in (
            "base_system_prompts", "system_prompt_overrides",
            "previous_system_prompts", "original_system_prompts",
        ):
            prompts = state[name]
            if not isinstance(prompts, dict) or any(
                not isinstance(key, str) or not key
                or not isinstance(content, str)
                for key, content in prompts.items()
            ):
                raise ValueError(f"invalid {name}")
        if set(state["base_system_prompts"]) != set(AGENT_BASE_SYSTEM_PROMPT_NAMES):
            raise ValueError("invalid base system prompt inventory")
        profiles = state["agent_profiles"]
        if not isinstance(profiles, list):
            raise ValueError("agent profiles must be an array")
        profile_names = [parse_state_agent_profile(profile).name for profile in profiles]
        if len(set(profile_names)) != len(profile_names):
            raise ValueError("saved agent profile names must be unique")
        if state["agent_profile_default"] is not None:
            parse_state_agent_profile(state["agent_profile_default"])
        scripts = state["agent_hook_context_scripts"]
        if not isinstance(scripts, list) or any(
            not isinstance(script, str) or not script or "\x00" in script
            for script in scripts
        ):
            raise ValueError("invalid agent hook context scripts")
        for name in ("assist_last_turns", "assist_retry_turns"):
            assist_turns = state[name]
            if (
                not isinstance(assist_turns, dict)
                or not set(assist_turns).issubset(("context", "prompt"))
                or any(not is_integer(turn) for turn in assist_turns.values())
            ):
                raise ValueError("invalid assist scheduling state")
        pending = state["pending_assists"]
        if not isinstance(pending, dict) or not set(pending).issubset(
            ("context", "prompt")
        ):
            raise ValueError("invalid pending assists")
        for entry in pending.values():
            if (
                not isinstance(entry, dict)
                or set(entry) != {"session_name", "turn"}
                or not isinstance(entry["session_name"], str)
                or not is_integer(entry["turn"])
            ):
                raise ValueError("invalid pending assist request")
            if validate_session_name(entry["session_name"]) != entry["session_name"]:
                raise ValueError("invalid pending assist session name")
        if state["context_summary"] is not None:
            parse_state_agent_context_summary(state["context_summary"], artifact_path)
        CumulativeStats().restore(state["cumulative_stats"])
        json.dumps(state, ensure_ascii=False, allow_nan=False).encode("utf-8")
    except (TypeError, ValueError, UnicodeError) as exc:
        raise ValueError(
            f"invalid saved agent runtime state: {artifact_path} ({exc})"
        ) from exc
    return state


def restore_agent_runtime_state(
    settings: AgentRunSettings,
    state: dict[str, Any],
    *,
    restore_profiles: bool = True,
    restore_default_profile: bool = True,
    restore_hook_context_scripts: bool = True,
    prompt_overrides: dict[str, str] | None = None,
) -> None:
    if restore_profiles:
        settings.agent_profiles = tuple(
            parse_state_agent_profile(profile)
            for profile in state["agent_profiles"]
        )
    if restore_default_profile:
        settings.agent_profile_default = (
            parse_state_agent_profile(state["agent_profile_default"])
            if state["agent_profile_default"] is not None
            else None
        )
    agent_tool_schemas(
        settings.agent_profiles,
        default_profile=settings.agent_profile_default,
    )
    if restore_hook_context_scripts:
        settings.agent_hook_context_scripts = tuple(state["agent_hook_context_scripts"])
    for name, content in state["base_system_prompts"].items():
        setattr(settings, name, content)
    available_prompts = agent_system_prompts(
        replace(settings, system_prompt_overrides={})
    )
    settings.system_prompt_overrides = {
        name: content
        for name, content in state["system_prompt_overrides"].items()
        if name in available_prompts
    }
    settings.system_prompt_overrides.update(prompt_overrides or {})
    settings.previous_system_prompts = {
        name: content
        for name, content in state["previous_system_prompts"].items()
        if name in available_prompts
    }
    settings.original_system_prompts = {
        **available_prompts,
        **{
            name: content
            for name, content in state["original_system_prompts"].items()
            if name in available_prompts
        },
    }
    settings.file_context_ids = state["file_context_ids"].copy()
    settings.prior_token_estimates = [
        tuple(entry) for entry in state["prior_token_estimates"]
        if entry[0] < settings.state_turn
    ]
    settings.pending_revision_instruction = state["pending_revision_instruction"]
    settings.advance_expirations = state["advance_expirations"]
    settings.assist_last_turns = state["assist_last_turns"].copy()
    settings.assist_retry_turns = state["assist_retry_turns"].copy()
    settings.last_compaction_turn = state["last_compaction_turn"]
    settings.pending_assists = {
        name: entry.copy() for name, entry in state["pending_assists"].items()
    }
    saved_stats = CumulativeStats()
    saved_stats.restore(state["cumulative_stats"])
    settings.cumulative_stats.merge(saved_stats)



def agent_controller_tool_call_instructions(settings: AgentRunSettings) -> str:
    parts = [
        agent_tool_call_system_prompt(
            settings.agent_profiles, settings.system_prompt_overrides
        ),
    ]
    for assist_type in ("context", "prompt"):
        interval = getattr(settings, f"agent_{assist_type}_assist")
        if interval is not None and interval > 0:
            parts.append(
                f"Independent {assist_type} assist reviews are scheduled every "
                f"{interval} agent turns."
            )
    return join_prompt_sections(*parts)


