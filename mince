    max_file_size_kb: int,
    tree_parallel: int,
    token_limit: int,
    model: str,
    api_key: str,
    openai_base_url: str,
    openai_proxy: str,
    openai_organization: str,
    openai_project: str,
    response_format: str,
    json_schema: dict[str, Any] | None,
    response_verbosity: str,
    temperature: float | None,
    top_p: float | None,
    max_output_tokens: int,
    openai_service_tier: str,
    openai_reasoning: str | None,
    reasoning_mode: str,
    extra_body: dict[str, Any],
    llm_timeout: int,
    safety_identifier: Any,
    api_log: bool,
    token_cost: tuple[float, float] | None,
    print_reasoning: bool,
    tree_session_dir: Path,
    state_session_dir: Path,
    combined_tree_path: Path,
    log_enabled: bool,
    log_path: Path | None,
    tree_session_stem: str,
) -> int:
    log_lock = threading.Lock()
    db_lock = threading.Lock()
    records: list[dict[str, Any]] = []
    state_turn_lock = threading.Lock()
    next_state_turn = next_state_turn_index(state_session_dir)

    def start_tree_state_turn(
        system_prompt: str,
        task: str,
    ) -> Path:
        nonlocal next_state_turn
        with state_turn_lock:
            turn = next_state_turn
            next_state_turn += 1
        return start_state_turn(
            state_session_dir,
            turn,
            system_prompt,
            task,
            file_paths=file_paths,
        )

    state_db_path = str(tree_session_dir / f"{tree_session_stem}.dbm")
    rel_to_path: dict[str, Path] = {}
    for fp in file_paths:
        rel = relative_paths[fp].as_posix()
        rel_to_path[rel] = fp
    try:
        with db_lock:
            state_db = dbm.open(state_db_path, "c")
            try:
                for rel in rel_to_path:
                    key = rel.encode("utf-8")
                    if key not in state_db:
                        state_db[key] = b"pending"
                for key in list(state_db.keys()):
                    try:
                        val = state_db[key].decode("utf-8", errors="replace")
                        if val.startswith("perm"):
                            state_db[key] = b"temp"
                    except Exception:
                        pass
            finally:
                state_db.close()
    except Exception as exc:
        print(f"ERROR: Failed to open tree state db {state_db_path}: {exc}", file=sys.stderr)
        return 1

    def get_status(rel: str) -> str:
        key = rel.encode("utf-8")
        with db_lock:
            state_db = dbm.open(state_db_path, "c")
            try:
                if key in state_db:
                    try:
                        return state_db[key].decode("utf-8", errors="replace")
                    except Exception:
                        return "pending"
                return "pending"
            finally:
                state_db.close()
    def set_status(rel: str, status: str) -> None:
        key = rel.encode("utf-8")
        with db_lock:
            state_db = dbm.open(state_db_path, "c")
            try:
                state_db[key] = status.encode("utf-8")
            finally:
                state_db.close()

    def get_pending_files() -> list[tuple[str, Path]]:
        pending: list[tuple[str, Path]] = []
        for rel, fp in list(rel_to_path.items()):
            status = get_status(rel)
            if not status.startswith("complete") and not status.startswith("perm_error"):
                pending.append((rel, fp))
        return pending
    def process_file(file_path: Path) -> dict[str, Any]:
        relative_path = relative_paths[file_path]
        rel_str = relative_path.as_posix()
        output_path = tree_session_dir / relative_path
        request_characters = 0
        request_tokens = 0
        request_cost_log = ""
        full_system_prompt = ""
        user_prompt = ""
        result = ""
        usage: dict[str, Any] | None = None
        response_obj: Any = None
        error_text: str | None = None
        error_type: str = "none"
        state_turn_path: Path | None = None
        start_time = time.perf_counter()
        try:
            context = build_context(
                file_paths=[file_path],
                max_file_size_kb=max_file_size_kb,
                add_line_numbers=add_line_numbers,
            )
            selected_task = tree_prompt_for_path(
                file_path, tree_task_prompts, task
            )
            selected_system_prompt = tree_prompt_for_path(
                file_path, tree_system_prompts, system_prompt
            )
            if add_line_numbers:
                full_system_prompt = linenum_system_prompt + "\n" + selected_system_prompt
            else:
                full_system_prompt = selected_system_prompt
            user_prompt = build_user_prompt(
                task=selected_task,
                context=context,
                response_format=response_format,
                json_schema=json_schema,
            )
            request_tokens = estimate_request_tokens(
                model=model,
                system_prompt=full_system_prompt,
                user_prompt=user_prompt,
            )
            request_characters = len(full_system_prompt + user_prompt)
            if token_cost is not None:
                request_cost_log = f" request_cost_estimate={request_tokens * token_cost[0] / 1_000_000:.4f}"
            state_turn_path = start_tree_state_turn(
                system_prompt=full_system_prompt,
                task=selected_task,
            )
            if request_tokens > token_limit:
                raise ValueError(
                    f"Estimated input token count ({request_tokens}) exceeds token limit ({token_limit})"
                )
            response_obj, usage = call_openai(
                api_key=api_key,
                openai_base_url=openai_base_url,
                openai_proxy=openai_proxy,
                openai_organization=openai_organization,
                openai_project=openai_project,
                model=model,
                system_prompt=full_system_prompt,
                user_prompt=user_prompt,
                response_format=response_format,
                json_schema=json_schema,
                response_verbosity=response_verbosity,
                temperature=temperature,
                top_p=top_p,
                max_output_tokens=max_output_tokens,
                openai_service_tier=openai_service_tier,
                openai_reasoning=openai_reasoning,
                reasoning_mode=reasoning_mode,
                extra_body=extra_body,
                llm_timeout=llm_timeout,
                safety_identifier=safety_identifier,
                store=api_log,
                stream=False,
            )
            result = str(getattr(response_obj, "output_text", "") or "")
            if not result.strip():
                error_text = "LLM returned an empty response"
                error_type = "temp"
            if response_format in ("json", "schema") and result.strip():
                cleaned_result = re.sub(r'^(?:<\|[^|]+\|>).+(?:<\|message\|>)', '', result).strip()
                try:
                    result = json.dumps(json.loads(cleaned_result), indent=2, ensure_ascii=False)
                except json.JSONDecodeError as exc:
                    error_text = f"Failed to parse JSON response: {exc}"
                    error_type = "temp"
        except BaseException as exc:
            error_text = _tree_exception_message(exc)
            if _is_openai_temp_error(exc):
                error_type = "temp"
            elif _is_openai_perm_error(exc):
                error_type = "perm"
            else:
                error_type = "perm"
        elapsed = time.perf_counter() - start_time
        reasoning = _tree_reasoning(response_obj) if response_obj is not None else ""
        stored_result = result
        if not stored_result:
            stored_result = f"ERROR: {error_text}" if error_text else ""
        if state_turn_path is not None:
            state_response = result if result else (f"ERROR: {error_text}" if error_text else "")
            complete_state_turn(state_turn_path, reasoning, state_response)
        if print_reasoning:
            stored_result = f"<think>\n{reasoning}\n</think>\n\n{stored_result}"
        output_error: str | None = None
        try:
            output_path.parent.mkdir(parents=True, exist_ok=True)
            output_path.write_text(stored_result, encoding="utf-8")
        except Exception as exc:
            output_error = _tree_exception_message(exc)
            if error_text is None:
                error_text = output_error
            error_type = "perm"
        response_cost_components = response_cost_amounts(token_cost, usage)
        response_cost = response_cost_line(token_cost, usage)
        statsline = print_stats(
            session_name=tree_session_stem,
            request_characters=request_characters,
            request_tokens=request_tokens,
            processing_time=elapsed,
            response_text=stored_result,
            usage=usage,
            response_cost=response_cost,
        )
        if log_enabled:
            with log_lock:
                with open(log_path, "a", encoding="utf-8") as log_file:
                    log_file.write(f"<tree_file path='{file_path}'>\n")
                    log_file.write("<tree_request_stats>\n")
                    log_file.write(
                        f"request_characters={request_characters} request_tokens_estimate={request_tokens}{request_cost_log} model={model} "
                        f"reasoning={openai_reasoning} reasoning_mode={reasoning_mode} "
                        f"max_output_tokens={max_output_tokens} api_log={api_log} timeout={llm_timeout}\n"
                    )
                    log_file.write(f"<system_prompt>\n{full_system_prompt}\n</system_prompt>\n")
                    log_file.write(f"<user_prompt>\n{user_prompt}\n</user_prompt>\n")
                    if reasoning:
                        log_file.write(f"<reasoning>\n{reasoning}\n</reasoning>\n")
                    if error_text:
                        log_file.write(f"<error>{error_text}</error>\n")
                    log_file.write(f"<response>\n{stored_result}\n</response>\n")
                    log_file.write(f"<response_stats>\n{statsline}\n</response_stats>\n")
                    log_file.write(f"<end_time>{time.ctime(int(time.time()))} [{int(time.time())}]</end_time>\n")
                    log_file.write("</tree_file>\n")
                    log_file.flush()
        if error_text is None and output_error is None:
            set_status(rel_str, "complete")
            success = True
            error_type = "none"
        else:
            if error_type == "none":
                error_type = "perm"
            set_status(rel_str, f"{error_type}_error:{error_text or 'unknown'}")
            success = False
        record = {
            "path": file_path,
            "relative_path": relative_path,
            "output_path": output_path,
            "result": stored_result,
            "statsline": statsline,
            "usage": usage,
            "response_cost_components": response_cost_components,
            "success": success,
            "error_type": error_type,
        }
        return record
    records: list[dict[str, Any]] = []
    max_backoff = 120
    backoff = 5
    concurrency = max(1, tree_parallel)
    while True:
        pending = get_pending_files()
        if not pending:
            break
        workers = min(concurrency, len(pending))
        if workers < 1:
            workers = 1
        temp_errors_this_round = 0
        success_this_round = 0
        try:
            with ThreadPoolExecutor(max_workers=workers) as executor:
                future_to_rel: dict = {}
                for rel, fp in pending:
                    fut = executor.submit(process_file, fp)
                    future_to_rel[fut] = rel
                for future in as_completed(future_to_rel):
                    rel = future_to_rel[future]
                    try:
                        record = future.result()
                        with log_lock:
                            records.append(record)
                            if VERBOSE:
                                status = "ok" if record["success"] else "error"
                                print(f"tree_file={record['path']} status={status} {record['statsline']}", file=sys.stderr)
                        if record.get("success"):
                            success_this_round += 1
                        elif record.get("error_type") == "temp":
                            temp_errors_this_round += 1
                    except BaseException as exc:
                        print(f"ERROR: Tree worker failed: {_tree_exception_message(exc)}", file=sys.stderr)
                        set_status(rel, f"temp_error:{_tree_exception_message(exc)}")
                        temp_errors_this_round += 1
        except Exception as exc:
            print(f"ERROR: Failed to run tree workers: {exc}", file=sys.stderr)
            temp_errors_this_round += 1
        if temp_errors_this_round > 0:
            concurrency = max(1, concurrency // 2)
            backoff = min(backoff * 2, max_backoff)
            time.sleep(backoff)
        else:
            concurrency = min(tree_parallel, concurrency + 1)
            backoff = 1
        if temp_errors_this_round > 0 and success_this_round == 0:
            time.sleep(min(5, backoff))
    all_complete = True
    for rel in rel_to_path:
        if not get_status(rel).startswith("complete"):
            all_complete = False
            break
    total_input_tokens = 0
    total_output_tokens = 0
    total_response_cost = 0.0
    for record in records:
        usage = record.get("usage") or {}
        try:
            total_input_tokens += int(usage.get("input_tokens", 0))
            total_output_tokens += int(usage.get("output_tokens", 0))
        except (KeyError, TypeError, ValueError):
            pass
        comps = record.get("response_cost_components")
        if comps is not None:
            total_response_cost += comps[2] if len(comps) > 2 else 0
    tree_token_total_line = (
        f" tree_input_tokens={total_input_tokens}"
        f" tree_output_tokens={total_output_tokens}"
    )
    response_cost_total_line = ""
    if token_cost is not None:
        response_cost_total_line = f" tree_token_cost={total_response_cost:.4f}"
    combined_parts: list[str] = []
    for rel in sorted(rel_to_path.keys()):
        out_path = tree_session_dir / rel
        try:
            res = out_path.read_text(encoding="utf-8") if out_path.exists() else ""
        except Exception:
            res = f"ERROR: cannot read {out_path}"
        combined_parts.append(
            f"------------------------------------------------------------------------\n"
            f"# **{rel}**\n"
            f"------------------------------------------------------------------------\n"
            f"\n{res.rstrip()}\n\n"
        )
    try:
        combined_tree_path.parent.mkdir(parents=True, exist_ok=True)
        combined_tree_path.write_text("\n".join(combined_parts), encoding="utf-8")
    except Exception as exc:
        print(f"ERROR: Failed to write combined tree result {combined_tree_path}: {exc}", file=sys.stderr)
        return 1
    if VERBOSE:
        print(
            f"tree_output_file={combined_tree_path} "
            f"tree_output_directory={tree_session_dir}{tree_token_total_line}{response_cost_total_line}",
            file=sys.stderr,
        )
    return 0 if all_complete else 1


