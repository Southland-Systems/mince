def is_integer(value: Any, minimum: int = 0) -> bool:
    return (
        isinstance(value, int)
        and not isinstance(value, bool)
        and value >= minimum
    )


def number_lines(text: str) -> str:
    return "".join(
        f"{i} {line}"
        for i, line in enumerate(text.splitlines(keepends=True), start=1)
    )


def token_encoding_for_model(model: str) -> Any:
    try:
        return tiktoken.encoding_for_model(model)
    except Exception:
        return tiktoken.get_encoding("o200k_base")


def quote_tag_attribute(value: Any) -> str:
    return json.dumps(str(value), ensure_ascii=False)


def file_context_relative_path_attribute(path: str) -> str:
    if not path or path == "/proc/self/stdin":
        return ""
    try:
        relative_path = Path(os.path.abspath(path)).relative_to(Path.cwd())
    except (OSError, ValueError):
        return ""
    return f" relative_path={quote_tag_attribute(relative_path.as_posix())}"


def format_context_entry(
    name: str,
    content: str,
    model: str = "",
    attributes: str = "",
    include_token_count: bool = True,
) -> str:
    token_count_attribute = (
        f" token_count='{len(token_encoding_for_model(model).encode(content))}'"
        if include_token_count
        else ""
    )
    return (
        f"<{name}{attributes}{token_count_attribute}>\n"
        f"{content}</{name}>"
    )


def format_tools_context(tools: list[dict[str, Any]]) -> str:
    return format_context_entry(
        "tools",
        f"{json.dumps(tools, indent=2, ensure_ascii=False)}\n",
        include_token_count=False,
    )


def format_request_text(
    system_prompt: str,
    user_prompt: str,
    tools: list[dict[str, Any]] | None = None,
) -> str:
    sections = [
        format_context_entry(
            "system", f"{system_prompt}\n", include_token_count=False
        ),
        format_context_entry(
            "user", f"{user_prompt}\n", include_token_count=False
        ),
    ]
    if tools:
        sections.append(format_tools_context(tools))
    return "\n\n".join(sections)


def estimate_request_tokens(
    model: str,
    system_prompt: str,
    user_prompt: str,
    tools: list[dict[str, Any]] | None = None,
) -> int:
    encoding = token_encoding_for_model(model)
    return len(
        encoding.encode(
            format_request_text(system_prompt, user_prompt, tools=tools)
        )
    )

def truncate_text_to_tokens(
    text: str,
    model: str,
    max_tokens: int,
    *,
    fits_context: Callable[[str], bool] | None = None,
    marker: str = "\n[... shell output truncated ...]\n",
) -> str:
    if max_tokens <= 0 or not text:
        return ""
    encoding = token_encoding_for_model(model)
    tokens = encoding.encode(text)
    if len(tokens) <= max_tokens and (
        fits_context is None or fits_context(text)
    ):
        return text

    lower = 0
    upper = min(len(tokens) - 1, max_tokens)
    best = ""
    while lower <= upper:
        midpoint = (lower + upper) // 2
        prefix_tokens = (midpoint + 1) // 2
        suffix_tokens = midpoint // 2
        candidate = (
            encoding.decode(tokens[:prefix_tokens], errors="ignore")
            + marker
            + (
                encoding.decode(tokens[-suffix_tokens:], errors="ignore")
                if suffix_tokens
                else ""
            )
        )
        if len(encoding.encode(candidate)) <= max_tokens and (
            fits_context is None or fits_context(candidate)
        ):
            best = candidate
            lower = midpoint + 1
        else:
            upper = midpoint - 1
    return best


def limit_shell_output_for_context(
    shell_output: str,
    model: str,
    token_limit: int,
    *,
    estimate_context_tokens: Callable[[str], int] | None = None,
) -> str:
    max_output_tokens = max(
        0, int(token_limit * SHELL_OUTPUT_TOKEN_FRACTION)
    )

    def fits_context(output: str) -> bool:
        return (
            estimate_context_tokens is None
            or estimate_context_tokens(output) <= token_limit
        )

    return truncate_text_to_tokens(
        shell_output,
        model,
        max_output_tokens,
        fits_context=fits_context,
    )


RESPONSE_TOKEN_KEYS = ("input_tokens", "output_tokens", "total_tokens")


def response_token_usage(usage: dict[str, Any] | None) -> dict[str, int]:
    usage = usage or {}
    counts = {
        key: max(0, coerce_int(usage[key], 0))
        for key in RESPONSE_TOKEN_KEYS
        if key in usage
    }
    if "total_tokens" not in counts and all(
        key in counts for key in RESPONSE_TOKEN_KEYS[:2]
    ):
        counts["total_tokens"] = counts["input_tokens"] + counts["output_tokens"]
    return counts


def response_cost_amounts(
    token_cost: tuple[float, float] | None,
    usage: dict[str, Any] | None,
 ) -> tuple[float, float, float] | None:
    counts = response_token_usage(usage)
    if token_cost is None or not all(
        key in counts for key in RESPONSE_TOKEN_KEYS[:2]
    ):
        return None
    input_cost = counts["input_tokens"] * token_cost[0] / 1_000_000
    output_cost = counts["output_tokens"] * token_cost[1] / 1_000_000
    return input_cost, output_cost, input_cost + output_cost


def format_response_cost_line(
    costs: tuple[float, float, float] | None,
) -> str | None:
    if costs is None:
        return None
    input_cost, output_cost, total_cost = costs
    return f"response_cost={input_cost:.4f}:{output_cost:.4f}:{total_cost:.4f}"


def usage_to_dict(usage: Any) -> dict[str, Any] | None:
    if usage is None:
        return None
    if isinstance(usage, dict):
        return usage
    if hasattr(usage, "model_dump"):
        return usage.model_dump()
    if hasattr(usage, "dict"):
        return usage.dict()
    return {"raw": str(usage)}


@dataclass
class ModelRequestTimer:
    start_time: float | None = None
    usage: dict[str, int] | None = None
    response_text: str = ""

    def start_attempt(self) -> None:
        if self.start_time is None:
            self.start_time = time.perf_counter()
        self.response_text = ""

    def elapsed(self) -> float:
        if self.start_time is None:
            return 0.0
        return time.perf_counter() - self.start_time

    def record_response(
        self,
        response_obj: Any,
        response_text: str | None = None,
    ) -> None:
        self.response_text = (
            response_log_text(response_obj)
            if response_text is None
            else response_text
        )
        usage = response_token_usage(
            usage_to_dict(response_field(response_obj, "usage"))
        )
        if usage:
            if self.usage is None:
                self.usage = {}
            for key, count in usage.items():
                self.usage[key] = self.usage.get(key, 0) + count


def format_request_stats(
    *,
    request_characters: int,
    request_tokens: int,
    token_cost: tuple[float, float] | None,
    model_settings: ModelSettings,
    turn: int | None = None,
    prefix: str = "",
) -> str:
    stats = [prefix] if prefix else []
    if turn is not None:
        stats.append(f"turn={turn}")
    stats.extend([
        f"request_characters={request_characters}",
        f"request_tokens_estimate={request_tokens}",
    ])
    if token_cost is not None:
        stats.append(
            "request_cost_estimate="
            f"{request_tokens * token_cost[0] / 1_000_000:.4f}"
        )
    stats.extend([
        f"model={model_settings.model}",
        f"reasoning={model_settings.openai_reasoning}",
        f"reasoning_mode={model_settings.reasoning_mode}",
    ])
    if SESSION_NAME is not None:
        stats.append(f"session_name={SESSION_NAME}")
    return " ".join(stats)


def format_response_stats(
    *,
    request_characters: int,
    request_tokens: int,
    processing_time: float = 0.0,
    response_text: str,
    usage: dict[str, Any] | None = None,
    response_cost: str | None = None,
    cumulative_stats: CumulativeStats | None = None,
    turn: int | None = None,
    prefix: str = "",
 ) -> str:
    stats = [prefix] if prefix else []
    if turn is not None:
        stats.append(f"turn={turn}")
    stats.extend([
        f"processing_time={int(processing_time)}s",
        f"request_characters={request_characters}",
        f"request_tokens_estimate={request_tokens}",
        f"response_characters={len(response_text)}",
    ])
    stats.extend(
        f"response_{key}={count}"
        for key, count in response_token_usage(usage).items()
    )
    if response_cost is not None:
        stats.append(response_cost)
    if cumulative_stats is not None:
        accumulated_cost = cumulative_stats.total_cost_line("accumulated_cost")
        if accumulated_cost is not None:
            stats.append(accumulated_cost)
    return " ".join(stats)


@dataclass
class CumulativeStats:
    processing_time: float = 0.0
    usage: dict[str, int] = field(default_factory=dict)
    enabled: bool = False
    token_cost: tuple[float, float] | None = None
    log_path: Path | None = None
    log_enabled: bool = False
    costs: tuple[float, float, float] | None = (0.0, 0.0, 0.0)
    _pending_stats: list[CumulativeStats] = field(default_factory=list, repr=False)
    _lock: Any = field(default_factory=threading.RLock, repr=False)

    def as_dict(self, *, include_pending: bool = False) -> dict[str, Any]:
        with self._lock:
            snapshot = {
                "processing_time": self.processing_time,
                "usage": self.usage.copy(),
                "costs": self.costs,
            }
            if not include_pending or not self._pending_stats:
                return snapshot
            totals = CumulativeStats(**snapshot)
            for stats in self._pending_stats:
                totals.merge(stats)
            return totals.as_dict()

    def restore(self, value: Any) -> None:
        if not isinstance(value, dict) or set(value) != {
            "processing_time", "usage", "costs",
        }:
            raise ValueError("invalid saved cumulative statistics")
        processing_time = parse_optional_float(value["processing_time"])
        if processing_time is None or processing_time < 0:
            raise ValueError("invalid saved cumulative processing time")
        usage = value["usage"]
        if (
            not isinstance(usage, dict)
            or not set(usage).issubset(RESPONSE_TOKEN_KEYS)
            or any(not is_integer(count) for count in usage.values())
        ):
            raise ValueError("invalid saved cumulative token usage")
        costs = value["costs"]
        if costs is not None:
            if not isinstance(costs, (list, tuple)) or len(costs) != 3:
                raise ValueError("invalid saved cumulative costs")
            costs = tuple(parse_optional_float(cost) for cost in costs)
            if any(cost is None or cost < 0 for cost in costs):
                raise ValueError("invalid saved cumulative costs")
        with self._lock:
            self.processing_time = processing_time
            self.usage = response_token_usage(usage)
            self.costs = costs

    def _add(
        self,
        processing_time: float,
        usage: dict[str, Any] | None,
        costs: tuple[float, float, float] | None,
    ) -> None:
        with self._lock:
            self.processing_time += processing_time
            usage = response_token_usage(usage)
            for key, count in usage.items():
                self.usage[key] = self.usage.get(key, 0) + count
            if self.costs is not None:
                if costs is not None:
                    self.costs = (
                        self.costs[0] + costs[0],
                        self.costs[1] + costs[1],
                        self.costs[2] + costs[2],
                    )
                elif usage:
                    self.costs = None

    def add(
        self,
        processing_time: float,
        usage: dict[str, Any] | None,
        token_cost: tuple[float, float] | None,
    ) -> None:
        self._add(
            processing_time,
            usage,
            response_cost_amounts(token_cost, usage),
        )

    def merge(self, stats: CumulativeStats) -> None:
        snapshot = stats.as_dict(include_pending=True)
        self._add(
            snapshot["processing_time"], snapshot["usage"], snapshot["costs"]
        )

    def track_pending(self, stats: CumulativeStats) -> None:
        if stats is self:
            raise ValueError("cumulative statistics cannot track themselves")
        with self._lock:
            if not any(entry is stats for entry in self._pending_stats):
                self._pending_stats.append(stats)

    def merge_pending(self, stats: CumulativeStats) -> None:
        with self._lock:
            if not any(entry is stats for entry in self._pending_stats):
                return
            self.merge(stats)
            self._pending_stats[:] = [
                entry for entry in self._pending_stats if entry is not stats
            ]

    def total_cost_line(self, name: str) -> str | None:
        if self.token_cost is None:
            return None
        costs = self.as_dict(include_pending=True)["costs"]
        return f"{name}={costs[2]:.4f}" if costs is not None else None

    def emit(self) -> None:
        if not self.enabled:
            return
        snapshot = self.as_dict(include_pending=True)
        stats = [f"total_processing_time={int(snapshot['processing_time'])}s"]
        stats.extend(
            f"total_response_{key}={snapshot['usage'].get(key, 0)}"
            for key in RESPONSE_TOKEN_KEYS
        )
        response_cost = (
            format_response_cost_line(snapshot["costs"])
            if self.token_cost is not None
            else None
        )
        if response_cost is not None:
            stats.append(f"total_{response_cost}")
        emit_stats(
            " ".join(stats),
            partial(
                append_session_log, self.log_path, enabled=self.log_enabled
            ),
            "cumulative_stats",
        )


def record_response_stats(
    request_timer: ModelRequestTimer,
    cumulative_stats: CumulativeStats,
    *,
    request_characters: int,
    request_tokens: int,
    token_cost: tuple[float, float] | None,
    session_stats: CumulativeStats | None = None,
    turn: int | None = None,
    prefix: str = "",
) -> str:
    processing_time = request_timer.elapsed()
    session_stats = session_stats or cumulative_stats
    with session_stats._lock:
        cumulative_stats.add(processing_time, request_timer.usage, token_cost)
        return format_response_stats(
            request_characters=request_characters,
            request_tokens=request_tokens,
            processing_time=processing_time,
            response_text=request_timer.response_text,
            usage=request_timer.usage,
            response_cost=format_response_cost_line(
                response_cost_amounts(token_cost, request_timer.usage)
            ),
            cumulative_stats=session_stats,
            turn=turn,
            prefix=prefix,
        )


def emit_stats(
    statsline: str,
    logger: Callable[[str], None],
    tag: str = "response_stats",
) -> None:
    logger(f"<{tag}>\n{statsline}\n</{tag}>\n")
    if VERBOSE:
        print(statsline, file=sys.stderr)


@dataclass
class AgentBackup:
    source_dirs: tuple[Path, ...] = ()
    backup_dir: Path | None = None
    interval_minutes: float = DEFAULT_CONFIG["agent_backup_interval"]
    last_backup_time: float | None = None

    def __post_init__(self) -> None:
        self.source_dirs = tuple(dict.fromkeys(
            path.expanduser().resolve()
            for path in (self.source_dirs or (Path.cwd(),))
        ))
        if self.backup_dir is not None:
            self.backup_dir = self.backup_dir.expanduser().resolve()

    def destination_dirs(self) -> tuple[Path, ...]:
        return tuple(
            (
                self.backup_dir / source_dir.parent.relative_to(source_dir.anchor)
                if self.backup_dir is not None
                else source_dir.parent / ".mce-agent-backup"
            ).resolve()
            for source_dir in self.source_dirs
        )

    def run_if_due(self) -> None:
        if (
            self.last_backup_time is not None
            and time.monotonic() - self.last_backup_time < self.interval_minutes * 60
        ):
            return
        backup_dirs = self.destination_dirs()
        for source_dir in self.source_dirs:
            if not source_dir.is_dir():
                raise ValueError(
                    f"agent backup source is not a directory: {source_dir}"
                )
            if any(
                backup_dir == source_dir or source_dir in backup_dir.parents
                for backup_dir in backup_dirs
            ):
                raise ValueError(
                    "agent backup directories must be outside all source directories"
                )
        timestamp = int(time.time())
        timestamp_ns = time.time_ns()
        backup_paths: list[Path] = []
        try:
            for source_dir, backup_dir in zip(self.source_dirs, backup_dirs):
                backup_dir.mkdir(parents=True, exist_ok=True)
                backup_path = backup_dir / f"{source_dir.name}-{timestamp}"
                while True:
                    try:
                        backup_path.mkdir()
                    except FileExistsError:
                        seconds, nanoseconds = divmod(timestamp_ns, 1_000_000_000)
                        backup_path = backup_dir / (
                            f"{source_dir.name}-{seconds}.{nanoseconds:09d}"
                        )
                        timestamp_ns += 1
                    else:
                        break
                backup_paths.append(backup_path)
                completed = subprocess.run(
                    [
                        "cp", "-a", "--reflink=auto", "--",
                        f"{source_dir}/.", str(backup_path),
                    ],
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True,
                    check=False,
                )
                if completed.returncode != 0:
                    detail = (completed.stderr or completed.stdout).strip()
                    if not detail:
                        detail = f"exit status {completed.returncode}"
                    raise ValueError(f"cp --reflink=auto failed: {detail}")
        except BaseException:
            for backup_path in backup_paths:
                shutil.rmtree(backup_path, ignore_errors=True)
            raise
        self.last_backup_time = time.monotonic()
        if VERBOSE:
            for backup_path in backup_paths:
                print(f"agent_backup={backup_path}", file=sys.stderr)


def resolve_config_option(
    override: Any,
    config: dict[str, Any],
    key: str,
    default: Any = None,
 ) -> Any:
    if override is not None:
        return override
    return config.get(key, default)


def resolve_bool_option(
    override: bool | None,
    config: dict[str, Any],
    key: str,
    default: bool = False,
 ) -> bool:
    return coerce_bool(
        resolve_config_option(override, config, key, default),
        default,
    )

def parse_bool(value: str) -> bool:
    try:
        return parse_boolean(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError(str(exc)) from exc


def change_working_directory(value: Any) -> None:
    path_text = parse_config_value("chdir", value)
    if not path_text:
        return
    try:
        os.chdir(Path(path_text).expanduser())
    except (OSError, RuntimeError, ValueError) as exc:
        raise ValueError(
            f"cannot change working directory to {path_text!r} ({exc})"
        ) from exc


def resolve_runtime_config(
    config: dict[str, Any],
    args: argparse.Namespace,
) -> dict[str, Any]:
    resolved_config = config.copy()
    for name, default in DEFAULT_CONFIG.items():
        override = (
            getattr(args, name, None)
            if name not in ("api_key", "files", "line_numbers")
            else None
        )
        resolved_config[name] = resolve_config_option(
            override, config, name, default
        )
    if args.no_line_numbers is not None:
        resolved_config["line_numbers"] = not args.no_line_numbers
    if args.model is not None and args.token_cost is None:
        resolved_config["token_cost"] = "off"
    if (
        args.apikey
        or args.apikey_from_fd is not None
        or os.getenv("OPENAI_API_KEY")
    ):
        resolved_config["api_key"] = ""
    if args.files is not None or args.files_list is not None:
        resolved_config["files"] = ""
    if args.task_file is not None:
        resolved_config["task_files"] = [str(path) for path in args.task_file]

    return parse_config_values(resolved_config)


def edit_text(text: str, suffix: str = ".txt") -> str:
    editor = os.environ.get("EDITOR", "").strip() or "vi"
    editor_command = shlex.split(editor)
    if not editor_command:
        editor_command = ["vi"]

    temporary_path: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            suffix=suffix,
            delete=False,
        ) as temporary_file:
            temporary_path = Path(temporary_file.name)
            temporary_file.write(text)

        subprocess.run(
            [*editor_command, str(temporary_path)],
            check=True,
        )
        return temporary_path.read_text(encoding="utf-8")
    finally:
        if temporary_path is not None:
            try:
                temporary_path.unlink()
            except FileNotFoundError:
                pass


def read_prompt_argument(value: str | list[str]) -> str:
    if isinstance(value, list):
        value = " ".join(value)
    if value == "e":
        edited_text = edit_text("").strip()
        if not edited_text:
            raise ValueError("Aborted")
        return edited_text
    if value == "-":
        return sys.stdin.read().strip()
    return value.strip()


def read_prompt_arguments(values: list[list[str]]) -> str:
    return join_prompt_sections(
        *(read_prompt_argument(value) for value in values)
    )


