API_RETRY_MAX_DELAY_SECONDS = 8


def format_exception_message(
    exc: BaseException | str,
    *,
    include_type: bool = False,
) -> str:
    text = str(exc).strip()
    if isinstance(exc, APIConnectionError):
        details: list[str] = []
        request = getattr(exc, "request", None)
        if request is not None:
            url = urlsplit(str(request.url))
            endpoint = urlunsplit(
                (url.scheme, url.netloc.rsplit("@", 1)[-1], url.path, "", "")
            )
            details.append(f"{request.method} {endpoint}")
        cause = exc.__cause__ or (
            exc.__context__ if not exc.__suppress_context__ else None
        )
        seen = {id(exc)}
        while cause is not None and id(cause) not in seen:
            seen.add(id(cause))
            cause_text = " ".join(str(cause).split())
            cause_detail = (
                f"{type(cause).__name__}: {cause_text}"
                if cause_text
                else type(cause).__name__
            )
            if cause_detail not in details:
                details.append(cause_detail)
            cause = cause.__cause__ or (
                cause.__context__ if not cause.__suppress_context__ else None
            )
        if len(seen) == 1:
            details.append("underlying connection cause unavailable")
        text = " ".join(text.split()) or type(exc).__name__
        text += f" ({'; '.join(details)})"
    if text:
        return f"{type(exc).__name__}: {text}" if include_type else text
    return type(exc).__name__ if isinstance(exc, BaseException) else ""


def report_request_error(
    exc: BaseException,
    message: str | None = None,
) -> None:
    if message is None:
        if getattr(exc, "_mince_request_error_reported", False):
            return
        message = f"ERROR: {format_exception_message(exc)}"
    print(message, file=sys.stderr)
    setattr(exc, "_mince_request_error_reported", True)


def _log_api_request_event(error_logger: Any, message: str) -> None:
    if error_logger is None:
        return
    try:
        error_logger(
            "<api_retry>\n"
            f"{message}\n"
            "</api_retry>\n"
        )
    except Exception as exc:
        print(
            f"ERROR: Failed to log API request event: {exc}",
            file=sys.stderr,
        )


def execute_openai_request(
    operation: Any,
    *,
    retry: int,
    operation_name: str,
    error_logger: Any = None,
    retry_if: Callable[[BaseException], bool] | None = None,
    report_errors: bool = True,
) -> Any:
    retry_count = max(1, parse_retry_count(retry))
    if retry_if is None:
        retry_if = _is_openai_temp_error
    for failed_retries in range(retry_count):
        try:
            return operation()
        except Exception as exc:
            should_retry = (
                failed_retries + 1 < retry_count and retry_if(exc)
            )
            delay_seconds = min(
                2 ** (failed_retries - 1), API_RETRY_MAX_DELAY_SECONDS
            )
            retry_delay = f" +{delay_seconds}s" if should_retry else ""
            failure_message = (
                f"ERROR: {operation_name} failed "
                f"({failed_retries + 1}/{retry_count}{retry_delay}): "
                f"{format_exception_message(exc)}"
            )
            if report_errors:
                report_request_error(exc, failure_message)
            _log_api_request_event(error_logger, failure_message)
            if not should_retry:
                raise
            time.sleep(delay_seconds)


def resolve_api_key(
    config: dict[str, Any],
    prompt: bool = False,
    from_fd: int | None = None,
) -> str:
    try:
        if prompt:
            key = getpass.getpass("API key: ").strip()
        elif from_fd is not None:
            with os.fdopen(
                from_fd, "r", encoding="utf-8", closefd=False
            ) as key_file:
                key = key_file.read().strip()
        else:
            key = os.getenv("OPENAI_API_KEY") or str(
                config.get("api_key", "")
            ).strip()
    except (EOFError, OSError, OverflowError, ValueError) as exc:
        detail = format_exception_message(exc)
        raise ValueError(f"cannot read API key ({detail})") from exc
    if key:
        return key
    raise ValueError(
        "No API key found. Use --apikey or --apikey-from-fd FD, "
        "configure it with --init, or set OPENAI_API_KEY."
    )


