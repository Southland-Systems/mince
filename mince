                )
            else:
                tree_system_prompts = ({}, None, None)
        except ValueError as exc:
            print(f"ERROR: {exc}", file=sys.stderr)
            return 1
        tree_relative_paths: dict[Path, Path] = {}
        used_relative_paths: set[Path] = set()
        for tree_file_path in tree_file_paths:
            relative_path = tree_result_relative_path(tree_file_path, tree_roots)
            if relative_path in used_relative_paths:
                print(f"ERROR: Multiple tree inputs map to the same result path: {relative_path}", file=sys.stderr)
                return 1
            used_relative_paths.add(relative_path)
            tree_relative_paths[tree_file_path] = relative_path
        tree_session_stem = session_stem
        SESSION_NAME = tree_session_stem
        tree_session_dir = APP_DIR / "trees" / tree_session_stem
        tree_state_session_dir = STATE_DIR / tree_session_stem
        combined_tree_path = tree_session_dir / f"{tree_session_stem}.md"
        try:
            tree_session_dir.mkdir(parents=True, exist_ok=True)
            tree_state_session_dir.mkdir(parents=True, exist_ok=True)
        except Exception as exc:
            print(f"ERROR: Failed to create tree output/state directory {tree_session_dir}: {exc}", file=sys.stderr)
            return 1
        max_file_size_kb = coerce_int(config.get("max_file_size_kb", 512), 512)
        return run_tree_mode(
            file_paths=tree_file_paths,
            relative_paths=tree_relative_paths,
            task=task,
            tree_task_prompts=tree_task_prompts,
            tree_system_prompts=tree_system_prompts,
            system_prompt=system_prompt,
            system_prompt_with_task=system_prompt_with_task,
            linenum_system_prompt=linenum_system_prompt,
            add_line_numbers=add_line_numbers,
            max_file_size_kb=max_file_size_kb,
            tree_parallel=tree_parallel,
            token_limit=token_limit,
            model_settings=model_settings,
            response_format=response_format,
            json_schema=json_schema,
            token_cost=token_cost,
            print_reasoning=print_reasoning,
            tree_session_dir=tree_session_dir,
            state_session_dir=tree_state_session_dir,
            combined_tree_path=combined_tree_path,
            log_enabled=log_enabled,
            log_path=log_path,
            tree_session_stem=tree_session_stem,
        )

    context_sections: list[tuple[str, str]] = []
    if ask_mode:
        context = ""
        if args.ask is not None:
            ask_prompt = expand_prompt_names(
                read_prompt_argument(args.ask),
                prompt_expansion_enabled,
            )
        else:
            ask_prompt = expand_prompt_names(
                read_prompt_files(args.ask_file),
                prompt_expansion_enabled,
            )
        full_system_prompt = append_task_to_system_prompt(
            system_prompt,
            ask_prompt,
            system_prompt_with_task,
        )
        user_prompt = ask_prompt
    else:
        file_paths = resolve_context_file_paths(file_names)
        max_file_size_kb=coerce_int(config.get("max_file_size_kb", 512), 512)
        try:
            stdin_content = (
                sys.stdin.read() if "-" in file_names else None
            )
            context_sections = build_context_sections(
                file_paths=file_paths,
                max_file_size_kb=max_file_size_kb,
                add_line_numbers=add_line_numbers,
                stdin_content=stdin_content,
                include_last_modified_time=agent_mode,
                include_last_refreshed_time=agent_mode,
                missing_file_expires_in_turns=(
                    agent_context_expires[1] if agent_mode else None
                ),
                model=model,
            )
            context = "\n".join(
                section for _, section in context_sections
            )
        except Exception as exc:
            try:
                restore_patch_branch()
            except Exception:
                pass
            print(
                f"ERROR: Could not build file context: {exc}",
                file=sys.stderr,
            )
            return 1
        if add_line_numbers or patch_mode:
            base_full_system_prompt = (
                system_prompt + "\n" + linenum_system_prompt
            )
        else:
            base_full_system_prompt = system_prompt
        full_system_prompt = append_task_to_system_prompt(
            base_full_system_prompt,
            task,
            system_prompt_with_task,
        )
        user_prompt = build_user_prompt(
            task=task,
            context=context,
            response_format=response_format,
            json_schema=json_schema,
            json_patch_responses=(
                [reused_patch_turn.response]
                if reused_patch_turn is not None
                else None
            ),
            json_patch_task=(
                reused_patch_turn.task
                if reused_patch_turn is not None
                else None
            ),
            include_task=not system_prompt_with_task,
            additional_instructions=(
                patch_system_prompt if reused_patch_turn is not None else ""
            ),
        )
        if patch_mode:
            original_texts: dict[str, str] = {}
            for path in file_paths:
                try:
                    original_texts[str(path)] = read_text_preserving_line_endings(path)
                except Exception as exc:
                    try:
                        restore_patch_branch()
                    except Exception:
                        pass
                    print(f"ERROR: Could not read '{path}': {exc}", file=sys.stderr)
                    return 1
            try:
                restore_patch_branch()
            except Exception as exc:
                print(
                    f"ERROR: Failed to restore original branch: {exc}",
                    file=sys.stderr,
                )
                return 1

    if args.output_file is not None:
        try:
            open_output_file(args.output_file)
        except Exception as exc:
            print(
                f"ERROR: Failed to open output file {args.output_file}: {exc}",
                file=sys.stderr,
            )
            return 1

    if (agent_mode or shell_mode) and not args.estimate_only:
        cumulative_stats.enabled = True
        cumulative_stats.token_cost = token_cost
        cumulative_stats.log_path = log_path
        cumulative_stats.log_enabled = log_enabled

    if plan_mode:
        plan_system_base = (
            agent_worker_system_prompt if agent_mode else system_prompt
        )
        plan_user_prompt = build_user_prompt(
            task=task,
            context=context,
            response_format="text",
            json_schema=None,
            include_task=not system_prompt_with_task,
            current_unix_time=(
                int(time.time()) if agent_mode else None
            ),
        )
        plan_full_system_prompt = plan_system_base + "\n" + plan_system_prompt
        if add_line_numbers or patch_mode:
            plan_full_system_prompt = (
                plan_system_base + "\n" + linenum_system_prompt + "\n"
                + plan_system_prompt
            )
        if patch_mode:
            plan_full_system_prompt = (plan_full_system_prompt + "\n" +
                "Design the prompt with the understanding that a patch will be generated but do not include language to indicate this explicitly.")
        plan_full_system_prompt = append_task_to_system_prompt(
            plan_full_system_prompt,
            task,
            system_prompt_with_task,
        )
        plan_request_tokens = estimate_request_tokens(
            model=model,
            system_prompt=plan_full_system_prompt,
            user_prompt=plan_user_prompt,
        )
        if args.estimate_only:
            print(plan_request_tokens)
            return 0
        plan_request_characters = len(plan_full_system_prompt + plan_user_prompt)
        plan_request_cost_log = request_cost_estimate_log(
            token_cost, plan_request_tokens
        )
        if plan_request_tokens > token_limit:
            print(f"ERROR: Estimated plan input token count ({plan_request_tokens}) exceeds token limit ({token_limit})", file=sys.stderr)
            return 1
        plan_turn_log = f"turn={state_turn} " if agent_mode else ""
        plan_state_turn_path = start_state_turn(
            state_session_dir,
            state_turn,
            plan_full_system_prompt,
            task,
            file_paths=file_paths,
            skip_missing_files=agent_mode,
            user_prompt=plan_user_prompt,
        )
        state_turn += 1
        append_log(
            "<plan_request>\n"
            f"<plan_request_stats>\n{plan_turn_log}request_characters={plan_request_characters} request_tokens_estimate={plan_request_tokens}{plan_request_cost_log} model={model} reasoning={openai_reasoning} reasoning_mode={reasoning_mode}\n</plan_request_stats>\n"
            f"<system_prompt>\n{plan_full_system_prompt}\n</system_prompt>\n"
            f"<user_prompt>\n{plan_user_prompt}\n</user_prompt>\n"
            "</plan_request>\n"
        )
        if VERBOSE:
            print(f"{plan_turn_log}request_characters={plan_request_characters} request_tokens_estimate={plan_request_tokens}{plan_request_cost_log} model={model} reasoning={openai_reasoning} session_name={session_stem}", file=sys.stderr)
        plan_request_timer = ModelRequestTimer()
        plan_response_obj: Any = None
        plan_usage: dict[str, Any] | None = None
        try:
            plan_response_obj, plan_usage = call_model(
                model_settings,
                plan_full_system_prompt,
                plan_user_prompt,
                response_format="text",
                error_logger=append_log,
                request_timer=plan_request_timer,
                reasoning_items=reasoning_items,
            )
            plan_result = response_output_text(plan_response_obj).strip()
        except Exception as exc:
            complete_state_turn(plan_state_turn_path, "", f"ERROR: {exc}")
            print(f"API error: {exc}", file=sys.stderr)
            return 1
        finally:
            plan_elapsed = plan_request_timer.elapsed()
            cumulative_stats.add(
                plan_request_timer.elapsed(total=True), plan_usage
            )
        plan_reasoning = response_reasoning_text(plan_response_obj)
        reasoning_items = response_reasoning_encrypted_items(plan_response_obj)
        complete_state_turn(
            plan_state_turn_path, plan_reasoning, plan_result, reasoning_items
        )
        if not plan_result:
            print("ERROR: LLM returned an empty AI prompt plan", file=sys.stderr)
            return 1
        plan_response_cost = response_cost_line(token_cost, plan_usage)
        plan_statsline = print_stats(
            request_characters=plan_request_characters,
            request_tokens=plan_request_tokens,
            processing_time=plan_elapsed,
            response_text=plan_result,
            usage=plan_usage,
            response_cost=plan_response_cost,
            turn=int(plan_state_turn_path.name) if agent_mode else None,
        )
        append_log(
            f"<plan_response>\n{plan_result}\n</plan_response>\n"
            f"<plan_response_stats>\n{plan_statsline}\n</plan_response_stats>\n"
        )
        if args.noninteractive:
            if VERBOSE:
                print(plan_statsline, file=sys.stderr)
            return 0
        while True:
            print()
            print(plan_result)
            print()
            plan_choice = input("Use this plan? [y/n/p/e]: ").strip().lower()
            if plan_choice == "p":
                page_or_print(plan_result)
                continue
            if plan_choice in ("e", "edit"):
                try:
                    plan_result = edit_text(plan_result).strip()
                except Exception as exc:
                    print(f"ERROR: Failed to edit plan: {exc}", file=sys.stderr)
                continue
            if plan_choice in ("y", "yes", "n", "no"):
                accepted = plan_choice in ("y", "yes")
                break
            print("Please answer y, n, p, or e.")
        append_log(
            f"<plan_review>{'accepted' if accepted else 'rejected'}</plan_review>\n"
        )
        if not accepted:
            if VERBOSE:
                print("Aborted.", file=sys.stderr)
                print(plan_statsline, file=sys.stderr)
            return 0
        if VERBOSE:
            print(plan_statsline, file=sys.stderr)
        print()
        task = expand_prompt_names(plan_result, prompt_expansion_enabled)
        full_system_prompt = append_task_to_system_prompt(
            base_full_system_prompt,
            task,
            system_prompt_with_task,
        )
        user_prompt = build_user_prompt(
            task=task,
            context=context,
            response_format=response_format,
            json_schema=json_schema,
            include_task=not system_prompt_with_task,
        )
    if agent_mode:
        agent_settings = AgentRunSettings(
            model_settings=model_settings,
            token_limit=token_limit,
            token_cost=token_cost,
            state_session_dir=state_session_dir,
            state_turn=state_turn,
            file_paths=file_paths,
            log_enabled=log_enabled,
            log_path=log_path,
            task=task,
            context=context,
            context_sections=context_sections,
            agent_system_prompt=base_full_system_prompt,
            worker_system_prompt=agent_worker_system_prompt,
            linenum_system_prompt=linenum_system_prompt,
            shell_system_prompt=shell_system_prompt,
            contain=contain,
            shell_networking=shell_networking,
            shell_timeout=shell_timeout,
            patch_system_prompt=patch_system_prompt,
            system_prompt_with_task=system_prompt_with_task,
            add_line_numbers=add_line_numbers,
            max_file_size_kb=max_file_size_kb,
            patch_suffix=patch_suffix,
            suffix_provided=suffix_provided,
            patch_review=patch_review,
            agent_auto=agent_auto,
            print_reasoning=print_reasoning,
            suppress_response_output=suppress_response_output,
            agent_profiles=selected_agent_profiles,
            agent_profile_default=default_agent_profile,
            agent_context_expires=agent_context_expires,
            patch_suffix_argument_provided=args.patch_suffix is not None,
            pinned_file_paths=(
                tuple(
                    path for path, section in context_sections
                    if not (agent_file_context_attributes(section) or {}).get("error")
                )
                if args.files is not None
                else ()
            ),
            initial_turns=(
                reused_agent_history.turns
                if reused_agent_history is not None
                else ()
            ),
            initial_meta_task_list=(
                reused_agent_history.meta_task_list
                if reused_agent_history is not None
                else ()
            ),
            initial_active_context=reused_agent_active_context,
            agent_hook_context_scripts=tuple(
                args.agent_hook_context or []
            ),
            context_summary=(
                reused_agent_history.context_summary
                if reused_agent_history is not None
                else None
            ),
            initial_reasoning_items=reasoning_items,
            initial_turn_metadata=(
                reused_agent_history.turn_metadata
                if reused_agent_history is not None
                else None
            ),
            initial_turn_number_base=(
                1
                if reused_agent_history is not None
                and reused_agent_history.turn_metadata is None
                else 0
            ),
            refresh_initial_file_contexts=(
                args.files is not None or args.files_list is not None
            ),
            cumulative_stats=cumulative_stats,
        )
        return run_agent_mode(agent_settings)

    resume_reused_shell_turn = (
        shell_mode
        and args.noninteractive
        and reused_shell_turn is not None
    )
    complete_reused_shell_turn_after_execution = (
        resume_reused_shell_turn
        and shell_revision_task is not None
    )
    if (
        resume_reused_shell_turn
        and reused_shell_turn.system_prompt
    ):
        full_system_prompt = reused_shell_turn.system_prompt

    request_tokens = estimate_request_tokens(
        model=model,
        system_prompt=full_system_prompt,
        user_prompt=user_prompt,
    )
    if args.estimate_only:
        print(request_tokens)
        return 0

    if not resume_reused_shell_turn and request_tokens > token_limit:
        print(f"ERROR: Estimated input token count ({request_tokens}) exceeds token limit ({token_limit})", file=sys.stderr)
        return 1

    state_turn_path: Path | None = None
    stream_output_emitted = False
    response_obj: Any = None

    def request_model_turn(
        request_system_prompt: str,
        request_user_prompt: str,
        *,
        response_format_override: str | None = None,
        json_schema_override: dict[str, Any] | None = None,
        request_tokens: int | None = None,
        print_request_stats: bool = False,
        include_model_settings: bool = True,
        request_session_name: str | None = None,
        stream: bool = False,
    ) -> tuple[str, str, str]:
        nonlocal state_turn, state_turn_path, response_obj, stream_output_emitted
        nonlocal reasoning_items
        if request_tokens is None:
            request_tokens = estimate_request_tokens(
                model=model,
                system_prompt=request_system_prompt,
                user_prompt=request_user_prompt,
            )
        request_characters = len(
            request_system_prompt + request_user_prompt
        )
        request_cost_log = request_cost_estimate_log(
            token_cost, request_tokens
        )
        if request_tokens > token_limit:
            raise ValueError(
                f"Estimated input token count ({request_tokens}) exceeds "
                f"token limit ({token_limit})"
            )
        log_model_request(
            request_characters=request_characters,
            request_tokens=request_tokens,
            request_cost_log=request_cost_log,
            request_system_prompt=request_system_prompt,
            request_user_prompt=request_user_prompt,
            include_model_settings=include_model_settings,
        )
        if VERBOSE and print_request_stats:
            session_context = (
                f" session_name={request_session_name}"
                if request_session_name is not None
                else ""
            )
            print(
                f"request_characters={request_characters} "
                f"request_tokens_estimate={request_tokens}"
                f"{request_cost_log} model={model} "
                f"reasoning={openai_reasoning}{session_context}",
                file=sys.stderr,
            )
        request_timer = ModelRequestTimer()
        request_state_path: Path | None = None
        if state_enabled:
            request_state_path = start_state_turn(
                state_session_dir,
                state_turn,
                request_system_prompt,
                task,
                file_paths=file_paths,
                user_prompt=request_user_prompt,
            )
            state_turn += 1
        stream_sink = None
        usage: dict[str, Any] | None = None
        try:
            if stream and not print_reasoning:
                def emit_stream_text(delta: str) -> None:
                    if OUTPUT_FILE is not None:
                        write_output_file(delta)
                    else:
                        sys.stdout.write(delta)
                        sys.stdout.flush()

                stream_sink = emit_stream_text

            response_obj, usage = call_model(
                model_settings,
                request_system_prompt,
                request_user_prompt,
                response_format=(
                    response_format
                    if response_format_override is None
                    else response_format_override
                ),
                json_schema=(
                    json_schema
                    if response_format_override is None
                    else json_schema_override
                ),
                stream=stream,
                error_logger=append_log,
                request_timer=request_timer,
                reasoning_items=reasoning_items if state_enabled else None,
            )
            if stream:
                response, usage, completed_response = consume_response_stream(
                    response_obj, stream_sink
                )
                if completed_response is not None:
                    response_obj = completed_response
                stream_output_emitted = stream_sink is not None
            else:
                response = response_output_text(response_obj)
        except Exception as exc:
            if request_state_path is not None:
                complete_state_turn(request_state_path, "", f"ERROR: {exc}")
            raise
        finally:
            elapsed = request_timer.elapsed()
            cumulative_stats.add(request_timer.elapsed(total=True), usage)
        reasoning = response_reasoning_text(response_obj)
        reasoning_items = response_reasoning_encrypted_items(response_obj)
        if request_state_path is not None:
            complete_state_turn(
                request_state_path, reasoning, response, reasoning_items
            )
        state_turn_path = request_state_path
        statsline = print_stats(
            request_characters=request_characters,
            request_tokens=request_tokens,
            processing_time=elapsed,
            response_text=response,
            usage=usage,
            response_cost=response_cost_line(token_cost, usage),
        )
        log_model_response(
            response_text=response,
            reasoning=reasoning,
            statsline=statsline,
        )
        return response, reasoning, statsline

    if resume_reused_shell_turn:
        result = reused_shell_turn.response
        reasoning = reused_shell_turn.reasoning
        try:
            state_turn_path = start_state_turn(
                state_session_dir,
                state_turn,
                full_system_prompt,
                task,
                file_paths=file_paths,
            )
            state_turn += 1
            reused_request = read_optional_state_artifact(
                reused_shell_turn.turn_dir / "request"
            )
            if reused_request is not None:
                write_state_artifact(
                    state_turn_path,
                    "request",
                    reused_request,
                )
            complete_state_turn(
                state_turn_path, reasoning, result, reasoning_items
            )
            if reused_shell_turn.shell_output is not None:
                write_state_artifact(
                    state_turn_path,
                    "response_shell_output",
                    reused_shell_turn.shell_output,
                )
        except Exception as exc:
            print(
                f"ERROR: Failed to save resumed shell turn: {exc}",
                file=sys.stderr,
            )
            return 1
        statsline = print_stats(
            request_characters=len(full_system_prompt + user_prompt),
            request_tokens=request_tokens,
            processing_time=0.0,
            response_text=result,
        )
    else:
        try:
            result, reasoning, statsline = request_model_turn(
                full_system_prompt,
                user_prompt,
                request_tokens=request_tokens,
                print_request_stats=True,
                include_model_settings=False,
                request_session_name=session_stem,
                stream=stream_enabled,
            )
        except Exception as exc:
            print(f"API error: {exc}", file=sys.stderr)
            return 1

    if shell_mode and VERBOSE:
        print(statsline, file=sys.stderr)

    shell_turn_history: list[ShellTurn] = []
    archived_shell_turns: list[ShellTurn] = []
    pending_reused_shell_output = (
        reused_shell_turn.shell_output
        if resume_reused_shell_turn and reused_shell_turn is not None
        else None
    )

    def request_shell_revision(
        revision_task: str,
        shell_commands: list[ShellStep],
    ) -> tuple[str, str, str]:
        nonlocal task, full_system_prompt
        previous_task = task
        task = revision_task
        full_system_prompt = append_task_to_system_prompt(
            base_full_system_prompt,
            task,
            system_prompt_with_task,
        )
        revision_user_prompt = build_user_prompt(
            task=task,
            context=context,
            response_format=response_format,
            json_schema=json_schema,
            include_task=not system_prompt_with_task,
            additional_prompt=(
                '<shell_revision>\n'
                f'<previous_task>\n{previous_task}\n</previous_task>\n'
                '<previous_commands>\n'
                f'{format_shell_commands(shell_commands, include_reasons=False)}\n'
                '</previous_commands>\n'
                '</shell_revision>'
            ),
            additional_instructions=(
                "Use the `<previous_task>` and `<previous_commands>` with the "
                "provided updated user instructions; keep everything as-is that "
                "was not changed by the updated user instructions."
            ),
        )
        revision_result, revision_reasoning, revision_statsline = request_model_turn(
            full_system_prompt,
            revision_user_prompt,
            print_request_stats=True,
        )
        if VERBOSE:
            print(revision_statsline, file=sys.stderr)
        return revision_result, revision_reasoning, revision_statsline

    def request_shell_followup(
        shell_output: str,
        shell_commands: list[ShellStep],
    ) -> tuple[str, str]:
        followup_schema = SHELL_FOLLOWUP_SCHEMA
        shell_turn_history.append(
            ShellTurn(
                commands=tuple(shell_commands),
                output=limit_shell_output_for_context(
                    shell_output,
                    model,
                    token_limit,
                ),
            )
        )
        followup_system_prompt = (
            append_task_to_system_prompt(
                base_full_system_prompt,
                task,
                system_prompt_with_task,
            )
            + "\nAfter shell output, choose whether to run more commands "
            + "or use session_end with a reason that completes the session."
        )

        def build_followup_request(
            history: list[ShellTurn],
        ) -> tuple[str, int]:
            followup_user_prompt = build_shell_followup_prompt(
                task,
                shell_output=history,
                json_schema=followup_schema,
                shell_command_archive=archived_shell_turns,
                include_task=not system_prompt_with_task,
            )
            return (
                followup_user_prompt,
                estimate_request_tokens(
                    model=model,
                    system_prompt=followup_system_prompt,
                    user_prompt=followup_user_prompt,
                ),
            )

        while True:
            followup_user_prompt, followup_request_tokens = build_followup_request(
                shell_turn_history
            )
            if followup_request_tokens <= token_limit:
                break
            if len(shell_turn_history) > 1:
                removed_turn = shell_turn_history.pop(0)
                if removed_turn.commands:
                    archived_shell_turns.append(removed_turn)
                continue
            if archived_shell_turns:
                archived_shell_turns.pop(0)
                continue
            current_turn = shell_turn_history[-1]
            current_output_token_count = len(
                token_encoding_for_model(model).encode(current_turn.output)
            )
            if not current_turn.output or current_output_token_count == 0:
                raise ValueError(
                    f'Estimated shell follow-up input token count '
                    f'({followup_request_tokens}) exceeds token limit '
                    f'({token_limit})'
                )

            lower = 0
            upper = current_output_token_count - 1
            best_output: str | None = None
            while lower <= upper:
                midpoint = (lower + upper) // 2
                candidate_output = truncate_text_to_tokens(
                    current_turn.output,
                    model,
                    midpoint,
                )
                candidate_history = [
                    *shell_turn_history[:-1],
                    replace(current_turn, output=candidate_output),
                ]
                _, candidate_request_tokens = build_followup_request(
                    candidate_history
                )
                if candidate_request_tokens <= token_limit:
                    best_output = candidate_output
                    lower = midpoint + 1
                else:
                    upper = midpoint - 1

            if best_output is None:
                empty_history = [
                    *shell_turn_history[:-1],
                    replace(current_turn, output=""),
                ]
                _, empty_request_tokens = build_followup_request(empty_history)
                if empty_request_tokens > token_limit:
                    raise ValueError(
                        f'Estimated shell follow-up input token count '
                        f'({empty_request_tokens}) exceeds token limit '
                        f'({token_limit})'
                    )
                best_output = ""
            shell_turn_history[-1] = replace(
                current_turn,
                output=best_output,
            )
        followup_result, followup_reasoning, followup_statsline = request_model_turn(
            followup_system_prompt,
            followup_user_prompt,
            response_format_override="schema",
            json_schema_override=followup_schema,
            request_tokens=followup_request_tokens,
        )
        if VERBOSE:
            print(followup_statsline, file=sys.stderr)
        return followup_result, followup_reasoning

    def finish_shell_response(
        response_text: str,
        response_reasoning: str,
    ) -> int:
        return emit_response_output(
            format_response_output(
                response_text,
                response_reasoning,
                print_reasoning,
            ),
            suppress_response_output=suppress_response_output,
            output_file_path=args.output_file,
        )

    if shell_mode:
        try:
            if resume_reused_shell_turn:
                shell_steps, reused_session_end_reason = (
                    parse_reused_shell_response(
                        str(result or ''), response_json_repair
                    )
                )
                if reused_session_end_reason is not None:
                    return finish_shell_response(
                        reused_session_end_reason,
                        reasoning,
                    )
                if shell_steps is None:
                    raise ValueError("reused shell turn returned no commands")
            else:
                shell_steps = parse_shell_manifest(
                    str(result or ''), response_json_repair
                )
        except Exception as exc:
            print(f'ERROR: Failed to parse shell command manifest: {exc}', file=sys.stderr)
            return 1
        shell_response_reasoning = reasoning
        pending_shell_revision_task = shell_revision_task
        while True:
            if pending_shell_revision_task is not None:
                review_action = 'edit'
                revision_task = pending_shell_revision_task
                pending_shell_revision_task = None
            else:
                review_action, revision_task = review_shell_commands(
                    shell_steps,
                    accept_noninteractive=resume_reused_shell_turn,
                )
            if review_action == 'edit':
                pending_reused_shell_output = None
                if revision_task is None:
                    try:
                        revision_task = edit_tool_revision_task(
                            format_shell_commands(shell_steps, include_reasons=False),
                            task,
                        )
                    except Exception as exc:
                        print(
                            f'ERROR: Failed to edit shell revision: {exc}',
                            file=sys.stderr,
                        )
                        continue
                if not revision_task:
                    continue
                revision_task = expand_prompt_names(
                    revision_task,
                    prompt_expansion_enabled,
                )
                try:
                    result, shell_response_reasoning, statsline = request_shell_revision(
                        revision_task,
                        shell_steps,
                    )
                except ValueError as exc:
                    print(f'ERROR: {exc}', file=sys.stderr)
                    return 1
                except Exception as exc:
                    print(f'API error: {exc}', file=sys.stderr)
                    return 1
                try:
                    shell_steps = parse_shell_manifest(
                        str(result or ''), response_json_repair
                    )
                except Exception as exc:
                    print(
                        f'ERROR: Failed to parse shell command manifest: {exc}',
                        file=sys.stderr,
                    )
                    return 1
                continue
            if review_action == 'save':
                return finish_shell_response(
                    str(result or ''),
                    shell_response_reasoning,
                )
            if review_action != 'accept':
                if VERBOSE:
                    print('Aborted.', file=sys.stderr)
                return 0
            shell_output_is_new = pending_reused_shell_output is None
            if shell_output_is_new:
                shell_output = execute_shell_commands(
                    shell_steps,
                    shell_timeout,
                    contain=contain,
                    shell_networking=shell_networking,
                )
                if state_turn_path is not None:
                    try:
                        write_state_artifact(state_turn_path, "response_shell_output", shell_output)
                    except Exception as exc:
                        print(f"ERROR: Failed to save shell output: {exc}", file=sys.stderr)
                        return 1
            else:
                shell_output = pending_reused_shell_output
                pending_reused_shell_output = None

            if VERBOSE:
                print("<shell_execution>", file=sys.stderr)
                print(shell_output, file=sys.stderr)
                print("</shell_execution>", file=sys.stderr)
            if (
                resume_session_name is not None
                and (
                    not resume_reused_shell_turn
                    or complete_reused_shell_turn_after_execution
                )
            ):
                return finish_shell_response(
                    "Shell command turn completed.",
                    shell_response_reasoning,
                )
            try:
                result, followup_reasoning = request_shell_followup(
                    shell_output,
                    shell_steps,
                )
            except ValueError as exc:
                print(f"ERROR: {exc}", file=sys.stderr)
                return 1
            except Exception as exc:
                print(f"API error: {exc}", file=sys.stderr)
                return 1
            try:
                (
                    action,
                    next_shell_steps,
                    session_reason,
                ) = parse_shell_followup_response(
                    result, response_json_repair
                )
            except Exception as exc:
                print(f"ERROR: Failed to parse shell follow-up response: {exc}", file=sys.stderr)
                return 1
            if action == "commands":
                if next_shell_steps is None:
                    print("ERROR: Shell follow-up returned no commands", file=sys.stderr)
                    return 1
                shell_steps = next_shell_steps
                continue
            if action != "session_end":
                print("ERROR: Shell follow-up returned an unknown action", file=sys.stderr)
                return 1
            if session_reason is None:
                print("ERROR: Shell follow-up returned no session reason", file=sys.stderr)
                return 1
            return finish_shell_response(
                session_reason,
                followup_reasoning,
            )

    if patch_mode:
        patch_turn_history: list[
            tuple[str, str, str, tuple[dict[str, Any], ...]]
        ] = [
            (task, str(result or ""), statsline, reasoning_items)
        ]
        patch_state_turn_history: list[Path | None] = [state_turn_path]
        patch_turn_index = 0

        def request_patch_revision(revision_task: str) -> None:
            nonlocal task, result, statsline, full_system_prompt
            nonlocal patch_turn_index

            if VERBOSE:
                print(statsline, file=sys.stderr)
            previous_task = task
            task = expand_prompt_names(
                revision_task, prompt_expansion_enabled
            )
            revision_user_prompt = build_user_prompt(
                task=task,
                context=context,
                response_format=response_format,
                json_schema=json_schema,
                json_patch_responses=[result],
                json_patch_task=previous_task,
                include_task=not system_prompt_with_task,
                additional_instructions=patch_system_prompt,
            )
            full_system_prompt = append_task_to_system_prompt(
                base_full_system_prompt,
                task,
                system_prompt_with_task,
            )
            result, _, statsline = request_model_turn(
                full_system_prompt,
                revision_user_prompt,
                print_request_stats=True,
            )
            del patch_turn_history[patch_turn_index + 1:]
            del patch_state_turn_history[patch_turn_index + 1:]
            patch_turn_history.append(
                (task, str(result or ""), statsline, reasoning_items)
            )
            patch_state_turn_history.append(state_turn_path)
            patch_turn_index += 1

        while True:
            try:
                if not result or not result.strip():
                    print(
                        'ERROR: LLM returned empty response for patch manifest',
                        file=sys.stderr,
                    )
                    return 1

                cleaned_result = clean_json_response(result)
                manifest = parse_json_response(result, response_json_repair)
                result = (
                    json.dumps(manifest, indent=2, ensure_ascii=False)
                    if response_json_repair
                    else cleaned_result
                )
            except (ValueError, TypeError) as exc:
                print('<invalid_json_patch>')
                print(result)
                print('</invalid_json_patch>')
                if VERBOSE:
                    print(statsline, file=sys.stderr)
                print(
                    f'ERROR: Failed to parse patch manifest JSON: {exc}',
                    file=sys.stderr,
                )
                return 1

            patch_commit_message = ''
            if patch_branch_mode:
                if not isinstance(manifest, dict):
                    print('ERROR: Patch manifest must be a JSON object', file=sys.stderr)
                    return 1
                raw_commit_message = manifest.get('commit_message')
                if not isinstance(raw_commit_message, str) or not raw_commit_message.strip():
                    print('ERROR: Patch manifest commit_message cannot be empty', file=sys.stderr)
                    return 1
                patch_commit_message = raw_commit_message.strip()

            try:
                updated_texts, diff_text, changed_items = build_patch_changes(
                    original_texts,
                    manifest,
                )
            except Exception as exc:
                print(
                    f'ERROR: Failed to apply patch manifest: {exc}',
                    file=sys.stderr,
                )
                return 1

            if state_turn_path is not None:
                try:
                    write_state_patch_artifacts(
                        state_turn_path,
                        result,
                        diff_text,
                    )
                except Exception as exc:
                    print(
                        f'ERROR: Failed to save validated patch artifacts to '
                        f'{state_turn_path}: {exc}',
                        file=sys.stderr,
                    )
                    return 1


            if not changed_items:
                if VERBOSE:
                    print('No changes.', file=sys.stderr)
                    print(statsline, file=sys.stderr)
                return 0
            if args.noninteractive:
                if VERBOSE:
                    print(statsline, file=sys.stderr)
                return 0
            if VERBOSE or patch_review:
                print()
                print(diff_text)

            revision_task: str | None = None
            navigate_patch_turn = False
            if patch_review:
                while True:
                    review_action, revision_task, suffix_provided = review_patch_changes(
                        diff_text,
                        suffix_provided,
                        prompt=(
                            'Apply these changes? '
                            '[y/n/p/h/S/</>/e/E <prompt>]: '
                        ),
                        allow_navigation=True,
                        display_text=False,
                    )
                    if review_action == '<':
                        if patch_turn_index == 0:
                            print('Already at the first patch turn.')
                            continue
                        patch_turn_index -= 1
                        task, result, statsline, reasoning_items = (
                            patch_turn_history[patch_turn_index]
                        )
                        state_turn_path = patch_state_turn_history[patch_turn_index]
                        navigate_patch_turn = True
                        break
                    if review_action == '>':
                        if patch_turn_index + 1 >= len(patch_turn_history):
                            print('No later patch turn is available.')
                            continue
                        patch_turn_index += 1
                        task, result, statsline, reasoning_items = (
                            patch_turn_history[patch_turn_index]
                        )
                        state_turn_path = patch_state_turn_history[patch_turn_index]
                        navigate_patch_turn = True
                        break
                    if review_action == 'edit':
                        if revision_task is None:
                            try:
                                revision_task = edit_tool_revision_task(
                                    diff_text,
                                    task,
                                )
                            except Exception as exc:
                                print(
                                    f'ERROR: Failed to edit patch revision: {exc}',
                                    file=sys.stderr,
                                )
                                continue
                        if not revision_task:
                            continue
                    break
                if navigate_patch_turn:
                    continue
                if review_action == 'reject':
                    if VERBOSE:
                        print('Aborted.', file=sys.stderr)
                        print(statsline, file=sys.stderr)
                    return 0
                if review_action == 'edit':
                    try:
                        request_patch_revision(revision_task)
                    except Exception as exc:
                        print(f'API error: {exc}', file=sys.stderr)
                        return 1
                    continue

            try:
                written_patch_paths = write_patch_changes(
                    changed_items=changed_items,
                    all_paths=[Path(path) for path in updated_texts],
                    patch_review=patch_review,
                    patch_suffix=patch_suffix,
                    suffix_provided=suffix_provided,
                    patch_branch_setting=patch_branch_setting,
                    patch_commit_message=patch_commit_message,
                )
                if state_turn_path is not None:
                    write_state_artifact(
                        state_turn_path,
                        "response_schema_patch_applied",
                        "\n".join(written_patch_paths),
                    )
            except Exception as exc:
                action = (
                    'write and commit patch branch'
                    if patch_branch_mode
                    else 'write patch files'
                )
                print(f'ERROR: Failed to {action}: {exc}', file=sys.stderr)
                return 1

            if VERBOSE:
                print(statsline, file=sys.stderr)

            return 0

    if response_format in ("json", "schema"):
        try:
            if not result or not result.strip():
                print("ERROR: LLM returned empty response", file=sys.stderr)
                return 1

            result = parse_json_response(result, response_json_repair)
        except (ValueError, TypeError) as exc:
            print(result)
            if VERBOSE:
                print(statsline, file=sys.stderr)
            print(f"ERROR: Failed to parse JSON: {exc}", file=sys.stderr)
            return 1
        finally:
            result = pretty_json(result)

    output_str = format_response_output(
        result,
        reasoning,
        print_reasoning,
    )
    output_status = emit_response_output(
        output_str,
        suppress_response_output=suppress_response_output,
        stream_output_emitted=stream_output_emitted,
        output_file_path=args.output_file,
    )

    if VERBOSE:
        print(statsline, file=sys.stderr)
    if output_status:
        return output_status

    if DEBUG:
        print("<debug_response>", file=sys.stderr)
        print(json.dumps(usage_to_dict(response_obj), indent=2), file=sys.stderr)
        print("</debug_response>", file=sys.stderr)

    return 0


def main() -> int:
    cumulative_stats = CumulativeStats()
    try:
        return run_main(cumulative_stats)
    finally:
        cumulative_stats.emit()


# -------------------------------------------------------------------
# Run
# -------------------------------------------------------------------

rv = 0
err = None
try:
    rv = main()
except KeyboardInterrupt:
    rv = 130
    err = "\nStopped."
except SystemExit as exc:
    if exc.code is None:
        rv = 0
    elif isinstance(exc.code, int):
        rv = exc.code
    else:
        rv = 1
except Exception as e:
    rv = 1
    err = e
finally:
    if OUTPUT_FILE is not None:
        try:
            OUTPUT_FILE.close()
        except Exception:
            pass
    if SESSION_NAME is not None:
        if VERBOSE and not NONINTERACTIVE:
            print(f"session_name={SESSION_NAME}", file=sys.stderr)
        elif NONINTERACTIVE:
            print(f"{SESSION_NAME}")

    if err is not None:
        print(f"{err}", file=sys.stderr)
    sys.exit(rv)

