def _handle_openai_error(exc: Exception) -> None:
    if isinstance(exc, AuthenticationError):
        msg = "Authentication failed – check your API key."
    elif isinstance(exc, RateLimitError):
        msg = "Rate limit exceeded – try again later."
    elif isinstance(exc, BadRequestError):
        msg = f"Bad request: {exc}"
    elif isinstance(exc, PermissionDeniedError):
        msg = f"Permission denied: {exc}"
    elif isinstance(exc, NotFoundError):
        msg = f"Resource not found: {exc}"
    elif isinstance(exc, APITimeoutError):
        msg = f"Request timed out: {exc}"
    elif isinstance(exc, APIConnectionError):
        msg = f"Network error: {exc}"
    elif isinstance(exc, UnprocessableEntityError):
        msg = f"Cannot process request despite it being correct: {exc}"
    elif isinstance(exc, InternalServerError):
        msg = f"API internal server error: {exc}"
    elif isinstance(exc, APIError):
        msg = f"API error: {exc}"
    else:
        msg = f"Unexpected error: {exc}"
    raise exc


def resolve_api_key(config: dict[str, Any]) -> str:
    env_key = os.getenv("OPENAI_API_KEY")
    if env_key:
        return env_key
    key = str(config.get("api_key", "")).strip()
    if key:
        return key
    raise SystemExit("No API key found. Set it up in the config file with --init or with 'export OPENAI_API_KEY=key'.")


def call_openai(
    api_key: str = "",
    openai_base_url: str = "",
    openai_proxy: str = "",
    openai_organization: str = "",
    openai_project: str = "",
    model: str = "",
    system_prompt: str = "",
    user_prompt: str = "",
    response_format: str = "text",
    json_schema: dict[str, Any] | None = None,
    response_verbosity: str | None = None,
    temperature: float | None = None,
    top_p: float | None = None,
    max_output_tokens: int | None = None,
    openai_service_tier: str | None = None,
    openai_reasoning: str | None = None,
    reasoning_mode: str | None = None,
    extra_body: dict[str, Any] | None = None,
    llm_timeout: int | None = None,
    safety_identifier: str | None = None,
    store: bool = True,
    stream: bool = False,
) -> tuple[Any, dict[str, Any] | None]:
    http_client = None
    if openai_proxy:
        http_client = httpx.Client(proxy=openai_proxy)

    client = OpenAI(
        api_key=api_key,
        base_url=openai_base_url,
        project=openai_project or None,
        organization=openai_organization or None,
        timeout=llm_timeout if llm_timeout is not None else 300,
        max_retries=0,
        http_client=http_client,
    )

    kwargs: dict[str, Any] = {
        "model": model,
        "instructions": system_prompt,
        "input": user_prompt,
        "extra_body": extra_body or {},
        "store": store,
    }

    if safety_identifier is not None and str(safety_identifier).strip():
        kwargs["safety_identifier"] = str(safety_identifier).strip()

    if temperature is not None:
        kwargs["temperature"] = temperature

    if top_p is not None:
        kwargs["top_p"] = top_p

    if openai_reasoning is not None and str(openai_reasoning).strip().lower() != "off":
        reasoning_payload: dict[str, Any] = {
            "effort": openai_reasoning,
            "summary": "detailed",
        }
        if reasoning_mode is not None:
            reasoning_payload["mode"] = reasoning_mode
        kwargs["reasoning"] = reasoning_payload

    if max_output_tokens is not None:
        kwargs["max_output_tokens"] = max_output_tokens

    if openai_service_tier and str(openai_service_tier).lower() != "off":
        kwargs["service_tier"] = openai_service_tier

    if response_format == "json":
        kwargs["text"] = {"format": {"type": "json_object"}}
    elif response_format == "schema":
        if not json_schema:
            raise ValueError("--response-format schema requires --schema-file")
        kwargs["text"] = {"format": json_schema}
    else:
        text_payload: dict[str, Any] = {"format": {"type": "text"}}
        if response_verbosity and response_verbosity != "off":
            text_payload["verbosity"] = response_verbosity
        kwargs["text"] = text_payload

    if stream and response_format != "text":
        raise ValueError("Streaming is only supported for text responses")
    if stream:
        kwargs["stream"] = True

    if DEBUG:
        print("<debug_request>", file=sys.stderr)
        print(json.dumps(kwargs, indent=2), file=sys.stderr)
        print("</debug_request>", file=sys.stderr)

    try:
        response = client.responses.create(**kwargs)
    except Exception as exc:
        _handle_openai_error(exc)

    return response, usage_to_dict(getattr(response, "usage", None))

def consume_response_stream(
    stream: Any,
    emit: Any = None,
) -> tuple[str, dict[str, Any] | None, Any]:
    chunks: list[str] = []
    usage: dict[str, Any] | None = None
    completed_response = None

    for event in stream:
        event_type = getattr(event, "type", "")
        if event_type == "response.output_text.delta":
            delta = getattr(event, "delta", "")
            if delta:
                chunks.append(delta)
                if emit is not None:
                    emit(delta)
        elif event_type == "response.completed":
            completed_response = getattr(event, "response", None)
            usage = usage_to_dict(
                getattr(completed_response, "usage", None)
            )

    return "".join(chunks), usage, completed_response



def read_tree_prompt_file(
    path: Path | list[Path],
) -> tuple[dict[str, str], str | None, str | None]:
    prompt_paths = path if isinstance(path, list) else [path]
    lines: list[str] = []
    for prompt_path in prompt_paths:
        try:
            lines.extend(
                prompt_path.read_text(encoding="utf-8").splitlines()
            )
        except Exception as exc:
            raise ValueError(
                f"cannot read tree prompt file {prompt_path} ({exc})"
            ) from exc
    default_key = "__default__"
    prompt_lines: dict[str, list[str]] = {}

    for raw_line in lines:
        line = raw_line.strip()
        if not line:
            continue
        key, separator, value = raw_line.partition(":")
        extension = key.strip().lower()
        if separator and (extension == "*" or extension.startswith(".")):
            prompt_lines.setdefault(extension, []).append(value.strip())
        else:
            prompt_lines.setdefault(default_key, []).append(line)

    def combine(lines_for_prompt: list[str]) -> str:
        return "\n".join(lines_for_prompt).strip()

    exact_prompts = {
        extension: combine(lines_for_prompt)
        for extension, lines_for_prompt in prompt_lines.items()
        if extension not in (default_key, "*")
    }
    wildcard_prompt = (
        combine(prompt_lines["*"])
        if "*" in prompt_lines
        else None
    )
    default_prompt = (
        combine(prompt_lines[default_key])
        if default_key in prompt_lines
        else None
    )
    return exact_prompts, wildcard_prompt, default_prompt


def expand_tree_prompt_values(
    prompts: tuple[dict[str, str], str | None, str | None],
    enabled: bool,
 ) -> tuple[dict[str, str], str | None, str | None]:
    exact_prompts, wildcard_prompt, default_prompt = prompts
    return (
        {
            extension: expand_prompt_names(prompt, enabled)
            for extension, prompt in exact_prompts.items()
        },
        (
            expand_prompt_names(wildcard_prompt, enabled)
            if wildcard_prompt is not None
            else None
        ),
        (
            expand_prompt_names(default_prompt, enabled)
            if default_prompt is not None
            else None
        ),
    )


def read_tree_system_prompts(path: Path) -> tuple[dict[str, str], str | None, str | None]:
    return read_tree_prompt_file(path)


def tree_prompt_for_path(
    path: Path,
    prompts: tuple[dict[str, str], str | None, str | None],
    fallback: str,
 ) -> str:
    exact_prompts, wildcard_prompt, default_prompt = prompts
    suffixes = path.suffixes
    extension_candidates: list[str] = []
    if suffixes:
        extension_candidates.append("".join(suffixes).lower())
        extension_candidates.extend(suffix.lower() for suffix in reversed(suffixes))

    selected_prompt: str | None = None
    for extension in extension_candidates:
        if extension in exact_prompts:
            selected_prompt = exact_prompts[extension]
            break

    if selected_prompt is None:
        selected_prompt = wildcard_prompt
    if selected_prompt is None:
        selected_prompt = default_prompt
    if selected_prompt is None:
        return fallback
    if default_prompt is not None and selected_prompt != default_prompt:
        return f"{default_prompt}\n{selected_prompt}"
    return selected_prompt


def tree_system_prompt_for_path(
    path: Path,
    prompts: tuple[dict[str, str], str | None, str | None],
    fallback: str,
 ) -> str:
    return tree_prompt_for_path(path, prompts, fallback)



def _tree_path_candidates(path: Path, roots: list[Path]) -> set[str]:
    candidates = {path.as_posix(), path.name}
    cwd = Path.cwd().resolve()
    try:
        candidates.add(path.relative_to(cwd).as_posix())
    except ValueError:
        pass

    for root in roots:
        base = root if root.is_dir() else root.parent
        try:
            relative = path.relative_to(base)
        except ValueError:
            continue
        candidates.add(relative.as_posix())
        candidates.add((Path(base.name) / relative).as_posix())
    return candidates



def _tree_pattern_matches(path: Path, patterns: list[str], roots: list[Path]) -> bool:
    candidates = _tree_path_candidates(path, roots)
    for raw_pattern in patterns:
        pattern = raw_pattern.replace("\\", "/")
        for candidate in candidates:
            if fnmatch.fnmatchcase(candidate, pattern):
                return True
            try:
                if Path(candidate).match(pattern):
                    return True
            except Exception:
                continue
    return False



def expand_tree_file_paths(
    input_names: list[str],
    include_patterns: list[str],
    exclude_patterns: list[str],
    exclude_git: bool = True,
 ) -> tuple[list[Path], list[Path]]:
    roots: list[Path] = []
    candidates: list[Path] = []

    for raw_name in input_names:
        root = Path(raw_name).expanduser().resolve()
        if not root.exists():
            raise ValueError(f"tree input does not exist: {raw_name}")
        roots.append(root)
        if root.is_dir():
            if exclude_git and ".git" in root.parts:
                continue
            for current_root, dir_names, file_names in os.walk(root):
                if exclude_git:
                    dir_names[:] = [
                        name for name in dir_names if name != ".git"
                    ]
                for name in file_names:
                    path = Path(current_root) / name
                    if path.is_file():
                        candidates.append(path)
        elif root.is_file():
            candidates.append(root)
        else:
            raise ValueError(f"tree input is not a file or directory: {raw_name}")

    unique_candidates: dict[Path, None] = {}
    for path in candidates:
        if exclude_git and ".git" in path.parts[:-1]:
            continue
        resolved = path.resolve()
        if resolved in unique_candidates:
            continue
        if exclude_git and ".git" in resolved.parts[:-1]:
            continue
        if exclude_patterns and _tree_pattern_matches(resolved, exclude_patterns, roots):
            continue
        if include_patterns and not _tree_pattern_matches(resolved, include_patterns, roots):
            continue
        unique_candidates[resolved] = None

    return sorted(unique_candidates, key=lambda path: path.as_posix()), roots



def tree_result_relative_path(path: Path, roots: list[Path]) -> Path:
    cwd = Path.cwd().resolve()
    try:
        relative = path.relative_to(cwd)
    except ValueError:
        relative = None
        for root in roots:
            base = root if root.is_dir() else root.parent
            try:
                under_root = path.relative_to(base)
            except ValueError:
                continue
            relative = Path(base.name) / under_root
            break
        if relative is None:
            relative = Path(*path.parts[1:])
    safe_parts = [part for part in relative.parts if part not in ("", ".", "..")]
    if not safe_parts:
        safe_parts = [path.name or "file"]
    return Path(*safe_parts)



def response_reasoning_text(response_obj: Any) -> str:
    reasoning = ""
    try:
        for item in getattr(response_obj, "output", []):
            if getattr(item, "type", None) == "reasoning":
                for content in getattr(item, "content", []):
                    if getattr(content, "type", None) == "reasoning_text":
                        reasoning = getattr(content, "text", "")
        if not reasoning:
            for item in getattr(response_obj, "output", []):
                if getattr(item, "type", None) == "reasoning":
                    for content in getattr(item, "summary", []):
                        if getattr(content, "type", None) == "summary_text":
                            reasoning = getattr(content, "text", "")
    except Exception:
        return ""
    return str(reasoning or "")

def _tree_reasoning(response_obj: Any) -> str:
    return response_reasoning_text(response_obj)



def _tree_exception_message(exc: BaseException) -> str:
    text = str(exc).strip()
    if text:
        return f"{type(exc).__name__}: {text}"
    return type(exc).__name__



def _is_openai_temp_error(exc: BaseException) -> bool:
    if _is_openai_perm_error(exc):
        return False
    return isinstance(exc, (
        RateLimitError,
        APIConnectionError,
        APITimeoutError,
        InternalServerError,
        APIError,
    ))
def _is_openai_perm_error(exc: BaseException) -> bool:
    return isinstance(exc, (
        AuthenticationError,
        BadRequestError,
        PermissionDeniedError,
        NotFoundError,
        UnprocessableEntityError,
    ))

def run_tree_mode(
    *,
    file_paths: list[Path],
    relative_paths: dict[Path, Path],
    task: str,
    tree_task_prompts: tuple[dict[str, str], str | None, str | None],
    tree_system_prompts: tuple[dict[str, str], str | None, str | None],
    system_prompt: str,
    linenum_system_prompt: str,
    add_line_numbers: bool,
    max_file_size_kb: int,
    tree_parallel: int,
    token_limit: int,
    model: str,
    api_key: str,
    openai_base_url: str,
    openai_proxy: str,
    openai_organization: str,
    openai_project: str,
    response_format: str,
    json_schema: dict[str, Any] | None,
    response_verbosity: str,
    temperature: float | None,
    top_p: float | None,
    max_output_tokens: int,
    openai_service_tier: str,
    openai_reasoning: str | None,
    reasoning_mode: str,
    extra_body: dict[str, Any],
    llm_timeout: int,
    safety_identifier: Any,
    api_log: bool,
    token_cost: tuple[float, float] | None,
    print_reasoning: bool,
    tree_session_dir: Path,
    state_session_dir: Path,
    combined_tree_path: Path,
    log_enabled: bool,
    log_path: Path | None,
    system_prompt_with_task: bool = False,
    tree_session_stem: str = "",

) -> int:
    log_lock = threading.Lock()
    db_lock = threading.Lock()
    state_turn_lock = threading.Lock()
    next_state_turn = next_state_turn_index(state_session_dir)

    def start_tree_state_turn(
        system_prompt: str,
        task: str,
    ) -> Path:
        nonlocal next_state_turn
        with state_turn_lock:
            turn = next_state_turn
            next_state_turn += 1
        return start_state_turn(
            state_session_dir,
            turn,
            system_prompt,
            task,
            file_paths=file_paths,
        )

    state_db_path = str(tree_session_dir / f"{tree_session_stem}.dbm")
    rel_to_path: dict[str, Path] = {}
    for fp in file_paths:
        rel = relative_paths[fp].as_posix()
        rel_to_path[rel] = fp
    try:
        with db_lock:
            state_db = dbm.open(state_db_path, "c")
            try:
                for rel in rel_to_path:
                    key = rel.encode("utf-8")
                    if key not in state_db:
                        state_db[key] = b"pending"
                for key in list(state_db.keys()):
                    try:
                        val = state_db[key].decode("utf-8", errors="replace")
                        if val.startswith("perm"):
                            state_db[key] = b"temp"
                    except Exception:
                        pass
            finally:
                state_db.close()
    except Exception as exc:
        print(f"ERROR: Failed to open tree state db {state_db_path}: {exc}", file=sys.stderr)
        return 1

    def get_status(rel: str) -> str:
        key = rel.encode("utf-8")
        with db_lock:
            state_db = dbm.open(state_db_path, "c")
            try:
                if key in state_db:
                    try:
                        return state_db[key].decode("utf-8", errors="replace")
                    except Exception:
                        return "pending"
                return "pending"
            finally:
                state_db.close()
    def set_status(rel: str, status: str) -> None:
        key = rel.encode("utf-8")
        with db_lock:
            state_db = dbm.open(state_db_path, "c")
            try:
                state_db[key] = status.encode("utf-8")
            finally:
                state_db.close()

    def get_pending_files() -> list[tuple[str, Path]]:
        pending: list[tuple[str, Path]] = []
        for rel, fp in list(rel_to_path.items()):
            status = get_status(rel)
            if not status.startswith("complete") and not status.startswith("perm_error"):
                pending.append((rel, fp))
        return pending
    def process_file(file_path: Path) -> dict[str, Any]:
        relative_path = relative_paths[file_path]
        rel_str = relative_path.as_posix()
        output_path = tree_session_dir / relative_path
        request_characters = 0
        request_tokens = 0
        request_cost_log = ""
        full_system_prompt = ""
        user_prompt = ""
        result = ""
        usage: dict[str, Any] | None = None
        response_obj: Any = None
        error_text: str | None = None
        error_type: str = "none"
        state_turn_path: Path | None = None
        start_time = time.perf_counter()
        try:
            context = build_context(
                file_paths=[file_path],
                max_file_size_kb=max_file_size_kb,
                add_line_numbers=add_line_numbers,
            )
            selected_task = tree_prompt_for_path(
                file_path, tree_task_prompts, task
            )
            selected_system_prompt = tree_prompt_for_path(
                file_path, tree_system_prompts, system_prompt
            )
            if add_line_numbers:
                full_system_prompt = selected_system_prompt + "\n" + linenum_system_prompt
            else:
                full_system_prompt = selected_system_prompt
            full_system_prompt = append_task_to_system_prompt(
                full_system_prompt,
                selected_task,
                system_prompt_with_task,
            )
            user_prompt = build_user_prompt(
                task=selected_task,
                context=context,
                response_format=response_format,
                json_schema=json_schema,
                include_task=not system_prompt_with_task,
            )
            request_tokens = estimate_request_tokens(
                model=model,
                system_prompt=full_system_prompt,
                user_prompt=user_prompt,
            )
            request_characters = len(full_system_prompt + user_prompt)
            if token_cost is not None:
                request_cost_log = f" request_cost_estimate={request_tokens * token_cost[0] / 1_000_000:.4f}"
            state_turn_path = start_tree_state_turn(
                system_prompt=full_system_prompt,
                task=selected_task,
            )
            if request_tokens > token_limit:
                raise ValueError(
                    f"Estimated input token count ({request_tokens}) exceeds token limit ({token_limit})"
                )
            response_obj, usage = call_openai(
                api_key=api_key,
                openai_base_url=openai_base_url,
                openai_proxy=openai_proxy,
                openai_organization=openai_organization,
                openai_project=openai_project,
                model=model,
                system_prompt=full_system_prompt,
                user_prompt=user_prompt,
                response_format=response_format,
                json_schema=json_schema,
                response_verbosity=response_verbosity,
                temperature=temperature,
                top_p=top_p,
                max_output_tokens=max_output_tokens,
                openai_service_tier=openai_service_tier,
                openai_reasoning=openai_reasoning,
                reasoning_mode=reasoning_mode,
                extra_body=extra_body,
                llm_timeout=llm_timeout,
                safety_identifier=safety_identifier,
                store=api_log,
                stream=False,
            )
            result = str(getattr(response_obj, "output_text", "") or "")
            if not result.strip():
                error_text = "LLM returned an empty response"
                error_type = "temp"
            if response_format in ("json", "schema") and result.strip():
                cleaned_result = clean_json_response(result)
                try:
                    result = json.dumps(json.loads(cleaned_result), indent=2, ensure_ascii=False)
                except json.JSONDecodeError as exc:
                    error_text = f"Failed to parse JSON response: {exc}"
                    error_type = "temp"
        except BaseException as exc:
            error_text = _tree_exception_message(exc)
            if _is_openai_perm_error(exc):
                error_type = "perm"
            elif _is_openai_temp_error(exc):
                error_type = "temp"
            else:
                error_type = "perm"
        elapsed = time.perf_counter() - start_time
        reasoning = _tree_reasoning(response_obj) if response_obj is not None else ""
        stored_result = result
        if not stored_result:
            stored_result = f"ERROR: {error_text}" if error_text else ""
        if state_turn_path is not None:
            state_response = result if result else (f"ERROR: {error_text}" if error_text else "")
            complete_state_turn(state_turn_path, reasoning, state_response)
        if print_reasoning:
            stored_result = f"<think>\n{reasoning}\n</think>\n\n{stored_result}"
        output_error: str | None = None
        try:
            output_path.parent.mkdir(parents=True, exist_ok=True)
            output_path.write_text(stored_result, encoding="utf-8")
        except Exception as exc:
            output_error = _tree_exception_message(exc)
            if error_text is None:
                error_text = output_error
            error_type = "perm"
        response_cost_components = response_cost_amounts(token_cost, usage)
        response_cost = response_cost_line(token_cost, usage)
        statsline = print_stats(
            request_characters=request_characters,
            request_tokens=request_tokens,
            processing_time=elapsed,
            response_text=stored_result,
            usage=usage,
            response_cost=response_cost,
        )
        if log_enabled:
            with log_lock:
                with open(log_path, "a", encoding="utf-8") as log_file:
                    log_file.write(f"<tree_file path='{file_path}'>\n")
                    log_file.write("<tree_request_stats>\n")
                    log_file.write(
                        f"request_characters={request_characters} request_tokens_estimate={request_tokens}{request_cost_log} model={model} "
                        f"reasoning={openai_reasoning} reasoning_mode={reasoning_mode} "
                        f"max_output_tokens={max_output_tokens} api_log={api_log} timeout={llm_timeout}\n"
                    )
                    log_file.write(f"<system_prompt>\n{full_system_prompt}\n</system_prompt>\n")
                    log_file.write(f"<user_prompt>\n{user_prompt}\n</user_prompt>\n")
                    if reasoning:
                        log_file.write(f"<reasoning>\n{reasoning}\n</reasoning>\n")
                    if error_text:
                        log_file.write(f"<error>{error_text}</error>\n")
                    log_file.write(f"<response>\n{stored_result}\n</response>\n")
                    log_file.write(f"<response_stats>\n{statsline}\n</response_stats>\n")
                    log_file.write(f"<end_time>{time.ctime(int(time.time()))} [{int(time.time())}]</end_time>\n")
                    log_file.write("</tree_file>\n")
                    log_file.flush()
        if error_text is None and output_error is None:
            set_status(rel_str, "complete")
            success = True
            error_type = "none"
        else:
            if error_type == "none":
                error_type = "perm"
            set_status(rel_str, f"{error_type}_error:{error_text or 'unknown'}")
            success = False
        record = {
            "path": file_path,
            "relative_path": relative_path,
            "output_path": output_path,
            "result": stored_result,
            "statsline": statsline,
            "usage": usage,
            "response_cost_components": response_cost_components,
            "success": success,
            "error_type": error_type,
        }
        return record
    records: list[dict[str, Any]] = []
    max_backoff = 120
    backoff = 5
    concurrency = max(1, tree_parallel)
    while True:
        pending = get_pending_files()
        if not pending:
            break
        workers = min(concurrency, len(pending))
        if workers < 1:
            workers = 1
        temp_errors_this_round = 0
        success_this_round = 0
        try:
            with ThreadPoolExecutor(max_workers=workers) as executor:
                future_to_rel: dict = {}
                for rel, fp in pending:
                    fut = executor.submit(process_file, fp)
                    future_to_rel[fut] = rel
                for future in as_completed(future_to_rel):
                    rel = future_to_rel[future]
                    try:
                        record = future.result()
                        with log_lock:
                            records.append(record)
                            if VERBOSE:
                                status = "ok" if record["success"] else "error"
                                print(f"tree_file={record['path']} status={status} {record['statsline']}", file=sys.stderr)
                        if record.get("success"):
                            success_this_round += 1
                        elif record.get("error_type") == "temp":
                            temp_errors_this_round += 1
                    except BaseException as exc:
                        print(f"ERROR: Tree worker failed: {_tree_exception_message(exc)}", file=sys.stderr)
                        set_status(rel, f"temp_error:{_tree_exception_message(exc)}")
                        temp_errors_this_round += 1
        except Exception as exc:
            print(f"ERROR: Failed to run tree workers: {exc}", file=sys.stderr)
            temp_errors_this_round += 1
        if temp_errors_this_round > 0:
            concurrency = max(1, concurrency // 2)
            backoff = min(backoff * 2, max_backoff)
            time.sleep(backoff)
        else:
            concurrency = min(tree_parallel, concurrency + 1)
            backoff = 1
        if temp_errors_this_round > 0 and success_this_round == 0:
            time.sleep(min(5, backoff))
    all_complete = True
    for rel in rel_to_path:
        if not get_status(rel).startswith("complete"):
            all_complete = False
            break
    total_input_tokens = 0
    total_output_tokens = 0
    total_response_cost = 0.0
    for record in records:
        usage = record.get("usage") or {}
        try:
            total_input_tokens += int(usage.get("input_tokens", 0))
            total_output_tokens += int(usage.get("output_tokens", 0))
        except (KeyError, TypeError, ValueError):
            pass
        comps = record.get("response_cost_components")
        if comps is not None:
            total_response_cost += comps[2] if len(comps) > 2 else 0
    tree_token_total_line = (
        f" tree_input_tokens={total_input_tokens}"
        f" tree_output_tokens={total_output_tokens}"
    )
    response_cost_total_line = ""
    if token_cost is not None:
        response_cost_total_line = f" tree_token_cost={total_response_cost:.4f}"
    combined_parts: list[str] = []
    for rel in sorted(rel_to_path.keys()):
        out_path = tree_session_dir / rel
        try:
            res = out_path.read_text(encoding="utf-8") if out_path.exists() else ""
        except Exception:
            res = f"ERROR: cannot read {out_path}"
        combined_parts.append(
            f"------------------------------------------------------------------------\n"
            f"# **{rel}**\n"
            f"------------------------------------------------------------------------\n"
            f"\n{res.rstrip()}\n\n"
        )
    try:
        combined_tree_path.parent.mkdir(parents=True, exist_ok=True)
        combined_tree_path.write_text("\n".join(combined_parts), encoding="utf-8")
    except Exception as exc:
        print(f"ERROR: Failed to write combined tree result {combined_tree_path}: {exc}", file=sys.stderr)
        return 1
    if VERBOSE:
        print(
            f"tree_output_file={combined_tree_path} "
            f"tree_output_directory={tree_session_dir}{tree_token_total_line}{response_cost_total_line}",
            file=sys.stderr,
        )
    return 0 if all_complete else 1


