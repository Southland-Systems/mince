def get_default_config_value(name: str) -> Any:
    if name not in DEFAULT_CONFIG:
        raise ValueError(f"{name} has no built-in default value")
    return DEFAULT_CONFIG[name]


def parse_patch_branch_value(value: Any) -> bool | str:
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        raw_value = value.strip()
        if raw_value:
            try:
                return parse_bool(raw_value)
            except argparse.ArgumentTypeError:
                return raw_value
    raise ValueError('patch_branch must be a boolean or branch name')


def resolve_patch_branch_setting(value: Any) -> str | None:
    if value == "":
        return ""
    parsed = parse_patch_branch_value(value)
    if isinstance(parsed, bool):
        return "" if parsed else None
    return parsed


def parse_config_assignment(value: str, config: dict[str, Any]) -> tuple[str, Any]:
    if "=" not in value:
        raise ValueError("expected NAME=VALUE")

    name, raw_value = value.split("=", 1)
    name = name.strip()
    if not name:
        raise ValueError("configuration name cannot be empty")
    raw_value = raw_value.strip()

    if name in DEPRECATED_CONFIG_KEYS and name not in config:
        raise ValueError(
            f"{name} is deprecated and is not present in the config"
        )

    canonical_name = DEPRECATED_CONFIG_KEYS.get(name) or name
    if canonical_name == INHERIT_PROFILE_CONFIG_KEY:
        raise ValueError(
            f"{INHERIT_PROFILE_CONFIG_KEY} is managed by --inherit-profile"
        )
    if raw_value == "DEFAULT":
        return name, get_default_config_value(canonical_name)

    if canonical_name == "patch_branch":
        return name, parse_patch_branch_value(raw_value)
    if canonical_name == "agent_context_expires":
        return name, normalize_agent_context_expires(raw_value)
    if canonical_name == "retry":
        return name, parse_retry_count(raw_value)
    expected = (
        DEFAULT_CONFIG[canonical_name]
        if canonical_name in DEFAULT_CONFIG
        else config.get(name)
    )
    if isinstance(expected, int) and not isinstance(expected, bool):
        try:
            return name, int(raw_value)
        except ValueError as exc:
            raise ValueError(f"{name} must be an integer") from exc
    if isinstance(expected, float):
        try:
            return name, float(raw_value)
        except ValueError as exc:
            raise ValueError(f"{name} must be a number") from exc
    if isinstance(expected, bool):
        try:
            return name, parse_bool(raw_value)
        except argparse.ArgumentTypeError as exc:
            raise ValueError(f"{name} must be a boolean") from exc
    return name, raw_value


def format_config_value(value: Any) -> str:
    if isinstance(value, (dict, list)):
        return json.dumps(value, ensure_ascii=False, separators=(",", ":"))
    if value is None:
        return ""
    return str(value)


def mask_api_key(value: Any) -> str:
    key = "" if value is None else str(value)
    if not key:
        return ""
    if len(key) > 8:
        return f"{key[:4]}{'*' * (len(key) - 8)}{key[-4:]}"
    return "*" * len(key)

def format_config_line(
    config_name: str,
    value: Any,
    inherited: bool = False,
 ) -> str:
    output_value = (
        mask_api_key(value)
        if config_name == "api_key"
        else format_config_value(value)
    )
    prefix = "^" if inherited else ""
    return f"{prefix}{config_name}={output_value}"

def format_config_lines(config: dict[str, Any]) -> list[str]:
    return [
        format_config_line(config_name, value)
        for config_name, value in config.items()
    ]


def format_log_settings(
    config: dict[str, Any],
    args: argparse.Namespace,
) -> str:
    logged_config = config.copy()
    if "api_key" in logged_config:
        logged_config["api_key"] = mask_api_key(
            logged_config["api_key"]
        )
    return (
        "<settings>\n"
        f"<configuration path=\"{CONFIG_FILE}\">\n"
        f"{json.dumps(logged_config, separators=(', ', ': '), ensure_ascii=False, default=str)}\n"
        "</configuration>\n"
        "<arguments>\n"
        f"{json.dumps(vars(args), separators=(', ', ': '), ensure_ascii=False, default=str)}\n"
        "</arguments>\n"
        "</settings>\n"
    )


def prompt_config_value(
    config: dict[str, Any],
    key: str,
    label: str,
    cast: type | None = None,
    mask: bool = False,
) -> None:
    current = config.get(key)

    masked = (
        mask_api_key(current)
        if mask and isinstance(current, str) and current
        else current
    )
    value = input(f"{label} [{masked}]: ").strip()

    if not value:
        return

    try:
        if value == "DEFAULT":
            parent_name = _inherit_profile_name(config, CONFIG_FILE)
            if parent_name is None:
                config[key] = get_default_config_value(key)
            else:
                inherited_config = merged_config(get_profile_path(parent_name))
                if key in inherited_config:
                    config[key] = inherited_config[key]
                else:
                    config.pop(key, None)
        elif value == "-" and key in PROMPT_CONFIG_KEYS:
            config[key] = ""
        else:
            config[key] = cast(value) if cast else value
    except Exception:
        print(f"WARNING: Invalid value for {key}; keeping existing value.")


