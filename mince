        append_log(
            f"<request_stats>\n{request_stats}\n</request_stats>\n"
            f"<request>\n"
            f"<system_prompt>\n{request_system_prompt}\n</system_prompt>\n"
            f"<user_prompt>\n{request_user_prompt}\n</user_prompt>\n"
            "</request>\n"
        )

