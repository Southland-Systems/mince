def _validate_inherit_profile_name(value: Any) -> str:
    if not isinstance(value, str) or not value.strip() or not value.strip().isidentifier():
        raise ValueError(f"invalid inherited profile name: {value!r}")
    return value.strip()


def _inherit_profile_name(
    document: dict[str, Any],
    path: Path,
 ) -> str | None:
    if INHERIT_PROFILE_CONFIG_KEY not in document:
        return None
    try:
        return _validate_inherit_profile_name(
            document[INHERIT_PROFILE_CONFIG_KEY]
        )
    except ValueError as exc:
        raise ValueError(
            f"invalid {INHERIT_PROFILE_CONFIG_KEY} in {path}: {exc}"
        ) from exc


def _read_config_document_for_merge(path: Path) -> dict[str, Any]:
    if not path.exists():
        return {}
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        raise ValueError(f"cannot read configuration file {path} ({exc})") from exc
    if not isinstance(raw, dict):
        raise ValueError(f"configuration file {path} must contain a JSON object")
    return raw


def _merged_config_from_path(
    path: Path,
    active_paths: set[Path],
 ) -> dict[str, Any]:
    resolved_path = path.resolve()
    if resolved_path in active_paths:
        raise ValueError(f"configuration inheritance cycle detected at {path}")
    active_paths.add(resolved_path)
    try:
        config = DEFAULT_CONFIG.copy()
        raw = _read_config_document_for_merge(path)
        parent_name = _inherit_profile_name(raw, path)
        if parent_name is not None:
            parent_path = get_profile_path(parent_name)
            if not parent_path.exists():
                raise ValueError(
                    f"inherited profile '{parent_name}' does not exist"
                )
            config.update(_merged_config_from_path(parent_path, active_paths))
        config.update(raw)
        for deprecated, replacement in DEPRECATED_CONFIG_KEYS.items():
            if deprecated in raw and replacement not in raw:
                config[replacement] = raw[deprecated]
        return config
    finally:
        active_paths.remove(resolved_path)


def merged_config(config_path: Path | None = None) -> dict[str, Any]:
    path = CONFIG_FILE if config_path is None else config_path
    try:
        return _merged_config_from_path(path, set())
    except Exception as exc:
        print(f"ERROR: Failed to parse config: {path} ({exc})", file=sys.stderr)
        raise SystemExit(1)


def migrate_deprecated_config(config: dict[str, Any]) -> bool:
    changed = False
    for deprecated, replacement in DEPRECATED_CONFIG_KEYS.items():
        if deprecated not in config:
            continue
        if replacement not in config:
            config[replacement] = config[deprecated]
        del config[deprecated]
        changed = True
    return changed


def ensure_config_exists() -> None:
    APP_DIR.mkdir(parents=True, exist_ok=True)

    if not CONFIG_FILE.exists():
        save_config(DEFAULT_CONFIG.copy())


def load_config() -> dict[str, Any]:
    ensure_config_exists()
    return merged_config()


def _prune_inherited_config(
    config: dict[str, Any],
    parent_name: str,
 ) -> dict[str, Any]:
    parent_config = merged_config(get_profile_path(parent_name))
    pruned: dict[str, Any] = {
        INHERIT_PROFILE_CONFIG_KEY: parent_name
    }
    for config_name, value in config.items():
        if config_name == INHERIT_PROFILE_CONFIG_KEY:
            continue
        if config_name not in parent_config or value != parent_config[config_name]:
            pruned[config_name] = value
    return pruned


def save_config(config: dict[str, Any]) -> None:
    migrated_config = config.copy()
    migrate_deprecated_config(migrated_config)

    raw_document = read_config_document(CONFIG_FILE, missing_ok=True)
    parent_name = _inherit_profile_name(raw_document, CONFIG_FILE)
    if parent_name is not None:
        migrated_config[INHERIT_PROFILE_CONFIG_KEY] = parent_name
        output_config = _prune_inherited_config(
            migrated_config, parent_name
        )
    else:
        if INHERIT_PROFILE_CONFIG_KEY in raw_document:
            migrated_config[INHERIT_PROFILE_CONFIG_KEY] = raw_document[
                INHERIT_PROFILE_CONFIG_KEY
            ]
        else:
            migrated_config.pop(INHERIT_PROFILE_CONFIG_KEY, None)
        output_config = DEFAULT_CONFIG.copy()
        output_config.update(migrated_config)

    CONFIG_FILE.write_text(
        json.dumps(output_config, indent=2, ensure_ascii=False),
        encoding="utf-8",
    )

