        "completed turn has no request_task",
    )
    return artifacts["request_task"]


def _load_reused_session_turn_artifacts(
    state_session_dir: Path,
    turn: int | None,
    artifact_names: tuple[str, ...],
    missing_message: str,
) -> tuple[Path, dict[str, str]]:
    turn_dir = last_completed_state_turn(state_session_dir, turn)
    artifact_paths = {
        artifact_name: turn_dir / artifact_name
        for artifact_name in artifact_names
    }
    if any(
        path.is_symlink() or not path.is_file()
        for path in artifact_paths.values()
    ):
        raise ValueError(f"{missing_message}: {turn_dir}")
    artifacts = {
        artifact_name: read_state_artifact(path)
        for artifact_name, path in artifact_paths.items()
    }
    return turn_dir, artifacts


