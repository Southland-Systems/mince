def read_config_document(path: Path, missing_ok: bool = False) -> dict[str, Any]:
    if not path.exists():
        if missing_ok:
            return {}
        raise ValueError(f"configuration file does not exist: {path}")
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        raise ValueError(f"cannot read configuration file {path} ({exc})") from exc
    if not isinstance(raw, dict):
        raise ValueError(f"configuration file {path} must contain a JSON object")
    return raw


def write_config_document(path: Path, config: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        json.dumps(config, indent=2, ensure_ascii=False),
        encoding="utf-8",
    )


def parse_prompt_file_definitions(value: Any) -> tuple[list[str], str] | None:
    if not isinstance(value, str):
        return None

    prompt = value.strip()
    if not prompt.startswith(("/", "./")):
        return None

    match = re.match(r"^(\S+)(?:\s+(.*))?$", prompt, re.DOTALL)
    if match is None:
        return None

    definitions = match.group(1).split("|")
    if not definitions or any(
        not definition
        or not definition.startswith(("/", "./"))
        for definition in definitions
    ):
        return None
    return definitions, (match.group(2) or "").strip()


def configured_prompt_file_path(value: str) -> Path:
    candidate = value.strip()
    if candidate.startswith("./"):
        filename = candidate[2:]
        if (
            not filename
            or filename in (".", "..")
            or Path(filename).name != filename
        ):
            raise ValueError(
                "relative configured prompt files must be filenames"
            )
        return APP_DIR / "prompts" / filename
    return Path(candidate)


def prompt_path_matches(value: str, prompt_path: Path) -> bool:
    candidate = value.strip()
    if candidate == str(prompt_path):
        return True
    if not candidate.startswith(("/", "./")):
        return False
    try:
        return (
            configured_prompt_file_path(candidate).resolve()
            == prompt_path.resolve()
        )
    except Exception:
        return False


def remove_prompt_reference(
    value: Any,
    prompt_path: Path,
 ) -> tuple[Any, bool]:
    if not isinstance(value, str):
        return value, False

    parsed = parse_prompt_file_definitions(value)
    if parsed is None:
        return value, False

    definitions, prompt_text = parsed
    remaining: list[str] = []
    removed = False
    for definition in definitions:
        if prompt_path_matches(definition, prompt_path):
            removed = True
        else:
            remaining.append(definition)
    if not removed:
        return value, False
    if not remaining:
        return prompt_text or None, True

    new_value = "|".join(remaining)
    if prompt_text:
        new_value += f" {prompt_text}"
    return new_value, True


def unassign_prompt_from_config(
    config: dict[str, Any],
    prompt_path: Path,
    keys: tuple[str, ...],
 ) -> bool:
    changed = False
    for key in keys:
        if key not in config:
            continue
        new_value, removed = remove_prompt_reference(config[key], prompt_path)
        if not removed:
            continue
        config[key] = (
            get_default_config_value(key)
            if new_value is None
            else new_value
        )
        changed = True
    return changed


