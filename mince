def resolve_prompt_setting(
    explicit_value: str | None,
    prompt_file: Path | None,
    config: dict[str, Any],
    config_key: str,
    default: str,
    prompt_expansion_enabled: bool,
    strip_configured_result: bool = False,
 ) -> str:
    if explicit_value is not None:
        prompt = str(explicit_value).strip()
    elif prompt_file is not None:
        prompt = read_prompt_files(prompt_file)
    else:
        prompt = PROMPTS.resolve(
            config.get(config_key, default),
            default,
        )

    expanded = expand_prompt_names(prompt, prompt_expansion_enabled)
    if strip_configured_result and explicit_value is None and prompt_file is None:
        return expanded.strip()
    return expanded


def format_config_detail_line(
    config_name: str,
    value: Any,
    config: dict[str, Any],
    inherited: bool = False,
) -> str:
    if config_name not in PROMPT_CONFIG_KEYS:
        return format_config_line(config_name, value, inherited)

    expanded_prompt = resolve_prompt_setting(
        explicit_value=None,
        prompt_file=None,
        config=config,
        config_key=config_name,
        default=get_default_config_value(config_name),
        prompt_expansion_enabled=coerce_bool(
            config.get("prompt_expansion", "off")
        ),
        strip_configured_result=True,
    )
    one_line_expanded_prompt = " ".join(expanded_prompt.splitlines())
    return (
        f"{format_config_line(config_name, value, inherited)} "
        f"[{one_line_expanded_prompt}]"
    )


def read_files_list(
    paths: Path | list[Path],
) -> list[str]:
    list_paths = paths if isinstance(paths, list) else [paths]
    files: list[str] = []
    for list_path in list_paths:
        try:
            lines = list_path.read_text(encoding="utf-8").splitlines()
        except Exception as exc:
            raise ValueError(
                f"cannot read files list {list_path} ({exc})"
            ) from exc

        for raw_line in lines:
            line = raw_line.strip()
            if not line or line.startswith("#"):
                continue
            files.append(line)
    return files

def resolve_context_file_paths(file_names: list[str]) -> list[Path]:
    return [
        Path(file_name) if file_name == "-" else Path(file_name).expanduser().resolve()
        for file_name in file_names
    ]


def load_image_urls(file_paths: list[Path]) -> tuple[str, ...]:
    image_urls: list[str] = []
    for path in file_paths:
        try:
            base64_image = base64.b64encode(path.read_bytes()).decode("ascii")
        except Exception as exc:
            raise ValueError(f"cannot read image {path} ({exc})") from exc
        mime_type = mimetypes.guess_type(path.name)[0] or "image/webp"
        image_urls.append(f"data:{mime_type};base64,{base64_image}")
    return tuple(image_urls)


FILE_CONTEXT_TOKEN_LIMIT_ERROR = (
    "TOKEN LIMIT EXCEEDED: file could not be loaded"
)


def build_context_sections(
    file_paths: list[Path],
    max_file_size_kb: int,
    add_line_numbers: bool = True,
    stdin_content: str | None = None,
    missing_file_expires_in_turns: int | None = None,
    model: str = "",
    token_limit: int | None = None,
    current_token_estimate: int = 0,
    existing_context_sections: tuple[tuple[str, str], ...] = (),
    file_context_ids: dict[str, int] | None = None,
    estimate_context_tokens: Callable[
        [tuple[tuple[str, str], ...]], int
    ] | None = None,
) -> list[tuple[str, str]]:
    paths = {
        ("/proc/self/stdin" if path == Path("-") else str(path)): path
        for path in file_paths
    }
    encoding = (
        token_encoding_for_model(model)
        if token_limit is not None
        else None
    )
    existing_sections = dict(existing_context_sections)
    base_token_estimate = current_token_estimate
    if encoding is not None:
        base_token_estimate = max(
            0,
            current_token_estimate - len(
                encoding.encode("\n".join(existing_sections.values()))
            ),
        )
    max_bytes = max_file_size_kb * 1024

    def build_section(
        context_path: str,
        content: str = "",
        error: str = "",
    ) -> str:
        if (
            error
            and error != FILE_CONTEXT_TOKEN_LIMIT_ERROR
            and missing_file_expires_in_turns is None
        ):
            return f"[{error}]"
        file_id_attribute = (
            f" ID='{agent_file_context_id(context_path, file_context_ids)}'"
            if file_context_ids is not None
            else ""
        )
        content_line_ending = detect_line_ending(content)
        content_total_lines = len(content.splitlines())
        numbered_content = ""
        if not error:
            numbered_content = (
                number_lines(content) if add_line_numbers else content
            )
        context_ending = (
            ""
            if error or numbered_content.endswith(("\r", "\n"))
            else "\n"
        )
        error_attribute = (
            f" error={quote_tag_attribute(error)}" if error else ""
        )
        if error and missing_file_expires_in_turns is not None:
            error_attribute += (
                f" expires_in_turns='{missing_file_expires_in_turns}'"
            )
        return format_context_entry(
            "file",
            f"{numbered_content}{context_ending}",
            model=model,
            attributes=(
                f"{file_id_attribute}{error_attribute} path={quote_tag_attribute(context_path)}"
                f"{file_context_relative_path_attribute(context_path)} "
                f"encoding='utf-8' line_ending='{content_line_ending}' "
                f"total_lines='{content_total_lines}'"
            ),
        )

    sections: list[tuple[str, str]] = [
        (
            context_path,
            (
                build_section(
                    context_path, error=FILE_CONTEXT_TOKEN_LIMIT_ERROR
                )
                if token_limit is not None
                else ""
            ),
        )
        for context_path in paths
    ]

    def estimate_sections_tokens() -> int:
        if estimate_context_tokens is not None:
            return estimate_context_tokens(tuple(sections))
        if encoding is None:
            return base_token_estimate
        contexts = existing_sections.copy()
        contexts.update(sections)
        return base_token_estimate + len(
            encoding.encode("\n".join(contexts.values()))
        )

    token_limit_reached = False
    for index, (context_path, path) in enumerate(paths.items()):
        if token_limit_reached:
            break
        content = ""
        error = ""
        try:
            if (
                path == Path("-") and stdin_content is None
                or path != Path("-") and not path.exists()
            ):
                error = f"MISSING FILE: {context_path}"
            else:
                if path == Path("-"):
                    file_size = len(stdin_content.encode("utf-8"))
                else:
                    file_size = path.stat().st_size
                if file_size > max_bytes:
                    error = (
                        f"SKIPPED LARGE FILE: {context_path} "
                        f"({file_size} bytes)"
                    )
                    print(f"WARNING: {error}", file=sys.stderr)
                elif path == Path("-"):
                    content = stdin_content
                else:
                    content = read_file(path, raise_errors=True)
        except Exception as exc:
            error = f"ERROR: cannot read file {context_path} ({exc})"
        previous_section = sections[index]
        section = build_section(context_path, content, error)
        sections[index] = (context_path, section)
        if encoding is not None and token_limit is not None and (
            len(encoding.encode(section)) > token_limit
            or estimate_sections_tokens() > token_limit
        ):
            sections[index] = (
                context_path,
                build_section(
                    context_path,
                    content,
                    FILE_CONTEXT_TOKEN_LIMIT_ERROR,
                ),
            )
            if estimate_sections_tokens() > token_limit:
                sections[index] = previous_section
            token_limit_reached = True

    return sections


def load_json_schema(path: Path) -> dict[str, Any]:
    try:
        raw = read_json_document(path, "schema file")
        if not isinstance(raw, dict):
            raise ValueError("Schema file must contain a JSON object")
        return raw
    except Exception as exc:
        print(f"ERROR: Failed to load JSON schema: {path}\n{exc}", file=sys.stderr)
        raise SystemExit(1)


def clean_json_response(raw: str) -> str:
    return re.sub(r'^(?:<\|[^|]+\|>).+(?:<\|message\|>)', '', raw).strip()


def parse_json_response(
    raw: str,
    response_json_repair: bool = False,
) -> Any:
    cleaned = clean_json_response(raw)
    if response_json_repair:
        return json_repair.loads(cleaned)
    return json.loads(cleaned)

def pretty_json(
    raw: str,
    response_json_repair: bool = False,
) -> str:
    return json.dumps(
        parse_json_response(raw, response_json_repair),
        indent=2,
        ensure_ascii=False,
    )


