def append_task_to_system_prompt(
    system_prompt: str,
    task: str,
    enabled: bool,
 ) -> str:
    if not enabled or not task:
        return system_prompt
    return f"{system_prompt}\n{task}"

def build_user_prompt(
    task: str,
    context: str,
    response_format: str = "text",
    json_schema: dict[str, Any] | None = None,
    json_patch_responses: list[str] | None = None,
    json_patch_task: str | None = None,
    json_patch_block = "",
    include_task: bool = True,
    additional_prompt: str = "",
    schema_block = ""
 ) -> str:
    additional_prompt_block = (
        f'\n{additional_prompt.strip()}'
        if additional_prompt.strip()
        else ''
    )

    if response_format == "schema" and json_schema is not None:
        schema_block = (
            "<json_schema instructions='Return JSON that matches this schema exactly'>\n"
            f"{json.dumps(json_schema, indent=2, ensure_ascii=False)}\n"
            "</json_schema>\n"
        )
    if json_patch_responses:
        last_response = json_patch_responses[-1]
        task_block = (
            f"<json_patch_task>\n{json_patch_task}\n</json_patch_task>\n"
            if json_patch_task is not None
            else ""
        )
        json_patch_block = (
            f"{task_block}<json_patch>\n"
            f"{last_response}\n</json_patch>"
        )

    return f"""
{task if include_task else ""}

<files current_working_directory='{os.getcwd()}'>
{context}
</files>
{schema_block}{json_patch_block}{additional_prompt_block}
""".strip()


