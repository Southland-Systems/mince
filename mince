def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="MinCE: minimal AI assistant"
    )

    mode_group = parser.add_mutually_exclusive_group()
    mode_group.add_argument(
        "-a",
        "--ask",
        metavar="TEXT",
        type=str,
        help="Prompt without file context or the configured system prompt (use - for STDIN or e to edit)",
    )

    mode_group.add_argument(
        "--ask-file",
        metavar="FILE",
        nargs="+",
        action="extend",
        type=Path,
        help="Read and combine ask prompts from one or more files",
    )

    mode_group.add_argument(
        "-t",
        "--task",
        metavar="TEXT",
        help="Task/prompt for the model with file context (use - for STDIN or e to edit)",
    )

    mode_group.add_argument(
        "--task-file",
        metavar="FILE",
        nargs="+",
        action="extend",
        type=Path,
