        log_model_response(
            response_text=revision_result,
            reasoning=revision_reasoning,
            statsline=revision_statsline,
        )
        if VERBOSE:
            print(revision_statsline, file=sys.stderr)
        return revision_result, revision_reasoning, revision_statsline

    def request_shell_followup(
        shell_output: str,
        shell_commands: list[ShellStep],
    ) -> tuple[str, str]:
        nonlocal state_turn, state_turn_path
        followup_schema = SHELL_FOLLOWUP_SCHEMA
        shell_turn_history.append(
            ShellTurn(
                commands=tuple(shell_commands),
                output=limit_shell_output_for_context(
                    shell_output,
                    model,
                    token_limit,
                ),
            )
        )
        while True:
            followup_user_prompt = build_shell_followup_prompt(
                task,
                shell_output=shell_turn_history,
                json_schema=followup_schema,
                shell_command_archive=archived_shell_turns,
            )
            followup_system_prompt = (
                full_system_prompt
                + "\nAfter shell output, choose whether to run more commands "
                + "or use session_end with a reason that completes the session."
            )
            followup_request_tokens = (
                estimate_request_tokens(
                    model=model,
                    system_prompt=followup_system_prompt,
                    user_prompt=followup_user_prompt,
                )
                + tokenizer_padding
            )
            followup_request_characters = len(
                followup_system_prompt + followup_user_prompt
            )
            if followup_request_tokens <= token_limit:
                break
            if len(shell_turn_history) > 1:
                removed_turn = shell_turn_history.pop(0)
                if removed_turn.commands:
                    archived_shell_turns.append(removed_turn)
                continue

            current_turn = shell_turn_history[-1]
            current_output_token_count = len(
                token_encoding_for_model(model).encode(current_turn.output)
            )
            if not current_turn.output or current_output_token_count == 0:
                raise ValueError(
                    f'Estimated shell follow-up input token count '
                    f'({followup_request_tokens}) exceeds token limit '
                    f'({token_limit})'
                )

            lower = 0
            upper = current_output_token_count - 1
            best_output: str | None = None
            while lower <= upper:
                midpoint = (lower + upper) // 2
                candidate_output = truncate_text_to_tokens(
                    current_turn.output,
                    model,
                    midpoint,
                )
                candidate_turn = ShellTurn(
                    commands=current_turn.commands,
                    output=candidate_output,
                )
                candidate_history = [
                    *shell_turn_history[:-1],
                    candidate_turn,
                ]
                candidate_user_prompt = build_shell_followup_prompt(
                    task,
                    shell_output=candidate_history,
                    json_schema=followup_schema,
                    shell_command_archive=archived_shell_turns,
                )
                candidate_request_tokens = (
                    estimate_request_tokens(
                        model=model,
                        system_prompt=followup_system_prompt,
                        user_prompt=candidate_user_prompt,
                    )
                    + tokenizer_padding
                )
                if candidate_request_tokens <= token_limit:
                    best_output = candidate_output
                    lower = midpoint + 1
                else:
                    upper = midpoint - 1

            if best_output is None:
                empty_turn = ShellTurn(
                    commands=current_turn.commands,
                    output="",
                )
                empty_history = [
                    *shell_turn_history[:-1],
                    empty_turn,
                ]
                empty_user_prompt = build_shell_followup_prompt(
                    task,
                    shell_output=empty_history,
                    json_schema=followup_schema,
                    shell_command_archive=archived_shell_turns,
                )
                empty_request_tokens = (
                    estimate_request_tokens(
                        model=model,
                        system_prompt=followup_system_prompt,
                        user_prompt=empty_user_prompt,
                    )
                    + tokenizer_padding
                )
                if empty_request_tokens > token_limit:
                    raise ValueError(
                        f'Estimated shell follow-up input token count '
                        f'({empty_request_tokens}) exceeds token limit '
                        f'({token_limit})'
                    )
                best_output = ""
            shell_turn_history[-1] = ShellTurn(
                commands=current_turn.commands,
                output=best_output,
            )
            continue
        followup_request_cost_log = (
            f" request_cost_estimate="
            f"{followup_request_tokens * token_cost[0] / 1_000_000:.4f}"
            if token_cost is not None
            else ""
        )
        followup_state_path = start_state_turn(
            state_session_dir,
            state_turn,
            followup_system_prompt,
            task,
            file_paths=file_paths,
        )
        state_turn += 1
        log_model_request(
            request_characters=followup_request_characters,
            request_tokens=followup_request_tokens,
            request_cost_log=followup_request_cost_log,
            request_system_prompt=followup_system_prompt,
            request_user_prompt=followup_user_prompt,
        )
        followup_start_time = time.perf_counter()
        try:
            followup_response_obj, followup_usage = call_model(
                followup_system_prompt,
                followup_user_prompt,
                response_format_override="schema",
                json_schema_override=followup_schema,
            )
            followup_result = str(
                getattr(followup_response_obj, "output_text", "") or ""
            )
        except Exception as exc:
            complete_state_turn(followup_state_path, "", f"ERROR: {exc}")
            raise
        followup_elapsed = time.perf_counter() - followup_start_time
        followup_reasoning = response_reasoning_text(followup_response_obj)
        complete_state_turn(
            followup_state_path,
            followup_reasoning,
            followup_result,
        )
        state_turn_path = followup_state_path
        followup_statsline = print_stats(
            request_characters=followup_request_characters,
            request_tokens=followup_request_tokens,
            processing_time=followup_elapsed,
            response_text=followup_result,
            usage=followup_usage,
            response_cost=response_cost_line(
                token_cost, followup_usage
            ),
        )
        log_model_response(
            response_text=followup_result,
            reasoning=followup_reasoning,
            statsline=followup_statsline,
        )
        if VERBOSE:
            print(followup_statsline, file=sys.stderr)
        return followup_result, followup_reasoning

    def finish_shell_response(
        response_text: str,
        response_reasoning: str,
    ) -> int:
        output_str = response_text
        if print_reasoning:
            output_str = (
                f"<think>\n{response_reasoning}\n</think>\n\n"
                f"{output_str}"
            )
        if args.output_file:
            try:
                args.output_file.parent.mkdir(parents=True, exist_ok=True)
                args.output_file.write_text(output_str, encoding="utf-8")
            except Exception as exc:
                print(
                    f"ERROR: Failed to write output to file {args.output_file}: {exc}",
                    file=sys.stderr,
                )
                print(output_str)
                return 1
        else:
            print(output_str)
        if args.noninteractive:
            print(f"state_session_name={state_session_dir.name}")
        return 0

    if shell_mode:
        try:
            shell_steps = parse_shell_manifest(str(result or ''))
        except Exception as exc:
            print(f'ERROR: Failed to parse shell command manifest: {exc}', file=sys.stderr)
            return 1
        while True:
            review_action, revision_task = review_shell_commands(shell_steps)
            if review_action == 'edit':
                if revision_task is None:
                    try:
                        edited_text = edit_text(
                            build_shell_revision_editor_text(
                                shell_steps,
                                task,
                            ),
                        )
                        revision_task = extract_patch_revision_task(
                            edited_text
                        )
                    except Exception as exc:
                        print(
                            f'ERROR: Failed to edit shell revision: {exc}',
                            file=sys.stderr,
                        )
                        continue
                if not revision_task:
                    continue
                revision_task = expand_prompt_names(
                    revision_task,
                    prompt_expansion_enabled,
                )
                try:
                    result, _, statsline = request_shell_revision(
                        revision_task,
                        shell_steps,
                    )
                except ValueError as exc:
                    print(f'ERROR: {exc}', file=sys.stderr)
                    return 1
                except Exception as exc:
                    print(f'API error: {exc}', file=sys.stderr)
                    return 1
                try:
                    shell_steps = parse_shell_manifest(str(result or ''))
                except Exception as exc:
                    print(
                        f'ERROR: Failed to parse shell command manifest: {exc}',
                        file=sys.stderr,
                    )
                    return 1
                continue
            if review_action != 'accept':
                if VERBOSE:
                    print('Aborted.', file=sys.stderr)
                return 0
            shell_output = execute_shell_commands(shell_steps, llm_timeout)
            if state_turn_path is not None:
                try:
                    write_state_shell_output(state_turn_path, shell_output)
                except Exception as exc:
                    print(f"ERROR: Failed to save shell output: {exc}", file=sys.stderr)
                    return 1
            if VERBOSE:
                print("<shell_execution>", file=sys.stderr)
                print(shell_output, file=sys.stderr)
                print("</shell_execution>", file=sys.stderr)
            append_log(
                f"<shell_output>\n{shell_output}\n</shell_output>\n"
            )
            try:
                result, followup_reasoning = request_shell_followup(
                    shell_output,
                    shell_steps,
                )
            except ValueError as exc:
                print(f"ERROR: {exc}", file=sys.stderr)
                return 1
            except Exception as exc:
                print(f"API error: {exc}", file=sys.stderr)
                return 1
            try:
                (
                    action,
                    next_shell_steps,
                    session_reason,
                ) = parse_shell_followup_response(
                    result
                )
            except Exception as exc:
                print(f"ERROR: Failed to parse shell follow-up response: {exc}", file=sys.stderr)
                return 1
            if action == "commands":
                if next_shell_steps is None:
                    print("ERROR: Shell follow-up returned no commands", file=sys.stderr)
                    return 1
                shell_steps = next_shell_steps
                continue
            if action != "session_end":
                print("ERROR: Shell follow-up returned an unknown action", file=sys.stderr)
                return 1
            if session_reason is None:
                print("ERROR: Shell follow-up returned no session reason", file=sys.stderr)
                return 1
            return finish_shell_response(
                session_reason,
                followup_reasoning,
            )
    def call_patch_revision_request(
        revision_user_prompt: str,
    ) -> tuple[str, str, Any, dict[str, Any] | None]:
        nonlocal state_turn, state_turn_path, full_system_prompt
        full_system_prompt = append_task_to_system_prompt(
            base_full_system_prompt,
            task,
            system_prompt_with_task,
        )
        revision_request_tokens = (
            estimate_request_tokens(
                model=model,
                system_prompt=full_system_prompt,
                user_prompt=revision_user_prompt,
            )
            + tokenizer_padding
        )
        revision_request_characters = len(
            full_system_prompt + revision_user_prompt
        )
        revision_request_cost_log = ''
        if token_cost is not None:
            revision_request_cost_log = (
                f' request_cost_estimate='
                f'{revision_request_tokens * token_cost[0] / 1_000_000:.4f}'
            )
        if revision_request_tokens > token_limit:
            raise ValueError(
                f'Estimated input token count ({revision_request_tokens}) exceeds '
                f'token limit ({token_limit})'
            )
        revision_state_context = context
        if json_patch_responses:
            revision_state_context += "\n"
            if json_patch_task is not None:
                revision_state_context += (
                    f"<json_patch_task>\n{json_patch_task}\n"
                    f"</json_patch_task>\n"
                )
            revision_state_context += (
                f"<json_patch>\n{json_patch_responses[-1]}\n"
                f"</json_patch>"
            )
        revision_state_turn_path = start_state_turn(
            state_session_dir,
            state_turn,
            full_system_prompt,
            task,
            file_paths=file_paths,
        )
        state_turn += 1
        if log_enabled:
            with open(log_path, 'a', encoding='utf-8') as f:
                f.write(
                    f'<request_stats>\n'
                    f'request_characters={revision_request_characters} '
                    f'request_tokens_estimate={revision_request_tokens}'
                    f'{revision_request_cost_log} model={model} '
                    f'reasoning={openai_reasoning} '
                    f'reasoning_mode={reasoning_mode} '
                    f'max_output_tokens={max_output_tokens} api_log={api_log} '
                    f'timeout={llm_timeout}\n'
                    f'</request_stats>\n'
                )
                f.write(f'<request>\n')
                f.write(
                    f'<system_prompt>\n{full_system_prompt}\n'
                    f'</system_prompt>\n'
                )
                f.write(
                    f'<user_prompt>\n{revision_user_prompt}\n'
                    f'</user_prompt>\n'
                )
                f.write('</request>\n')
        if VERBOSE:
            print(
                f'request_characters={revision_request_characters} '
                f'request_tokens_estimate={revision_request_tokens}'
                f'{revision_request_cost_log} model={model} '
                f'reasoning={openai_reasoning}',
                file=sys.stderr,
            )

        revision_start_time = time.perf_counter()
        revision_response_obj, revision_usage = call_model(
            full_system_prompt,
            revision_user_prompt,
        )
        revision_result = str(
            getattr(revision_response_obj, 'output_text', '') or ''
        )
        revision_elapsed = time.perf_counter() - revision_start_time
        revision_reasoning = response_reasoning_text(revision_response_obj)
        complete_state_turn(
            revision_state_turn_path,
            revision_reasoning,
            revision_result,
        )
        state_turn_path = revision_state_turn_path
        revision_statsline = print_stats(
            request_characters=revision_request_characters,
            request_tokens=revision_request_tokens,
            processing_time=revision_elapsed,
            response_text=revision_result,
            usage=revision_usage,
            response_cost=response_cost_line(
                token_cost, revision_usage
            ),
        )
        if log_enabled:
            with open(log_path, 'a', encoding='utf-8') as f:
                f.write(
                    f'<response>\n{revision_result}\n'
                    f'</response>\n'
                )
                f.write(
                    f'<response_stats>\n{revision_statsline}\n'
                    f'</response_stats>\n'
                )
                f.write(
                    f'<end_time>{time.ctime(int(time.time()))} '
                    f'[{int(time.time())}]</end_time>\n'
                )
        return (
            revision_result,
            revision_statsline,
            revision_response_obj,
            revision_usage,
        )

    if patch_mode:
        patch_turn_history: list[tuple[str, str, str]] = [
            (task, str(result or ""), statsline)
        ]
        patch_state_turn_history: list[Path | None] = [state_turn_path]
        patch_turn_index = 0
        while True:
            try:
                if not result or not result.strip():
                    print(
                        'ERROR: LLM returned empty response for patch manifest',
                        file=sys.stderr,
                    )
                    return 1

                result = clean_json_response(result)
                manifest = json.loads(result)
            except json.JSONDecodeError as exc:
                print('<invalid_json_patch>')
                print(result)
                print('</invalid_json_patch>')
                if VERBOSE:
                    print(statsline, file=sys.stderr)
                print(
                    f'ERROR: Failed to parse patch manifest JSON: {exc}',
                    file=sys.stderr,
                )
                return 1

            patch_commit_message = ''
            if patch_branch_mode:
                if not isinstance(manifest, dict):
                    print('ERROR: Patch manifest must be a JSON object', file=sys.stderr)
                    return 1
                raw_commit_message = manifest.get('commit_message')
                if not isinstance(raw_commit_message, str) or not raw_commit_message.strip():
                    print('ERROR: Patch manifest commit_message cannot be empty', file=sys.stderr)
                    return 1
                patch_commit_message = raw_commit_message.strip()

            try:
                updated_texts, diff_text, changed_items = build_patch_changes(
                    original_texts,
                    manifest,
                )
            except Exception as exc:
                print(
                    f'ERROR: Failed to apply patch manifest: {exc}',
                    file=sys.stderr,
                )
                return 1

            if state_turn_path is not None:
                try:
                    write_state_schema_patch(
                        state_turn_path,
                        result,
                    )
                    write_state_diff_patch(
                        state_turn_path,
                        diff_text,
                    )
                except Exception as exc:
                    print(
                        f'ERROR: Failed to save validated patch artifacts to '
                        f'{state_turn_path}: {exc}',
                        file=sys.stderr,
                    )
                    return 1

            if not changed_items:
                if VERBOSE:
                    print('No changes.', file=sys.stderr)
                    print(statsline, file=sys.stderr)
                if args.noninteractive:
                    print(f'state_session_name={state_session_dir.name}')
                return 0
            if patch_save_path is not None:
                try:
                    patch_save_path.parent.mkdir(parents=True, exist_ok=True)
                    patch_save_path.write_text(diff_text, encoding='utf-8')
                    patch_json_save_path.write_text(result, encoding='utf-8')
                except Exception as exc:
                    print(
                        f'ERROR: Failed to save patch files to '
                        f'{patch_save_path} and {patch_json_save_path}: {exc}',
                        file=sys.stderr,
                    )
                    return 1
                if VERBOSE:
                    print(f'patch_file={patch_save_path} patch_json_file={patch_json_save_path}', file=sys.stderr)
                if args.noninteractive:
                    if VERBOSE:
                        print(statsline, file=sys.stderr)
                    print(f'state_session_name={state_session_dir.name}')
                    return 0
            if VERBOSE or patch_review:
                print()
                print(diff_text)

            revision_task: str | None = None
            navigate_patch_turn = False
            if patch_review:
                while True:
                    patch_input = input(
                        'Apply these changes? '
                        '[y/n/p/h/S/</>/e/E <prompt>]: '
                    )
                    patch_input, suffix_provided = process_patch_review_input(
                        patch_input,
                        diff_text,
                        suffix_provided,
                        allow_navigation=True,
                    )
                    if patch_input is None:
                        continue
                    if patch_input == '<':
                        if patch_turn_index == 0:
                            print('Already at the first patch turn.')
                            continue
                        patch_turn_index -= 1
                        task, result, statsline = patch_turn_history[patch_turn_index]
                        state_turn_path = patch_state_turn_history[patch_turn_index]
                        navigate_patch_turn = True
                        break
                    if patch_input == '>':
                        if patch_turn_index + 1 >= len(patch_turn_history):
                            print('No later patch turn is available.')
                            continue
                        patch_turn_index += 1
                        task, result, statsline = patch_turn_history[patch_turn_index]
                        state_turn_path = patch_state_turn_history[patch_turn_index]
                        navigate_patch_turn = True
                        break
                    patch_choice = patch_input.lower()
                    if patch_choice in ('y', 'yes', 'n', 'no'):
                        break
                    if patch_choice == 'p':
                        page_or_print(diff_text)
                        continue
                    if patch_choice == 'e':
                        try:
                            edited_text = edit_text(
                                build_patch_revision_editor_text(
                                    diff_text,
                                    task,
                                ),
                            )
                            revision_task = extract_patch_revision_task(
                                edited_text
                            )
                        except Exception as exc:
                            print(
                                f'ERROR: Failed to edit patch revision: {exc}',
                                file=sys.stderr,
                            )
                            continue
                        if not revision_task:
                            continue
                        break
                    if (
                        patch_input.startswith('E')
                        and len(patch_input) > 1
                        and patch_input[1].isspace()
                    ):
                        revision_task = patch_input[1:].strip()
                        if not revision_task:
                            print('Revision task cannot be empty.')
                            continue
                        break
                    print('Please answer y, n, p, <, >, e, E followed by a prompt')
                if navigate_patch_turn:
                    continue
                if patch_choice in ('n', 'no'):
                    if VERBOSE:
                        print('Aborted.', file=sys.stderr)
                        print(statsline, file=sys.stderr)
                    return 0
                if revision_task is not None and patch_choice not in ('y', 'yes'):
                    if VERBOSE:
                        print(statsline, file=sys.stderr)
                    json_patch_task = task
                    task = expand_prompt_names(
                        revision_task, prompt_expansion_enabled
                    )
                    json_patch_responses = [result]
                    user_prompt = build_user_prompt(
                        task=task,
                        context=context,
                        response_format=response_format,
                        json_schema=json_schema,
                        json_patch_responses=json_patch_responses,
                        json_patch_task=json_patch_task,
                        include_task=not system_prompt_with_task,
                    )
                    user_prompt = user_prompt + '\n' + patch_system_prompt
                    try:
                        (result, statsline, response_obj, usage) = call_patch_revision_request(user_prompt)
                    except Exception as exc:
                        print(f'API error: {exc}', file=sys.stderr)
                        return 1
                    patch_turn_history = patch_turn_history[:patch_turn_index + 1]
                    patch_state_turn_history = patch_state_turn_history[:patch_turn_index + 1]
                    patch_turn_history.append((task, str(result or ""), statsline))
                    patch_state_turn_history.append(state_turn_path)
                    patch_turn_index += 1
                    continue

            try:
                written_patch_paths = write_patch_changes(
                    changed_items=changed_items,
                    all_paths=[Path(path) for path in updated_texts],
                    patch_review=patch_review,
                    patch_suffix=patch_suffix,
                    suffix_provided=suffix_provided,
                    patch_branch_setting=patch_branch_setting,
                    patch_commit_message=patch_commit_message,
                )
                if state_turn_path is not None:
                    write_state_schema_patch_applied(
                        state_turn_path,
                        written_patch_paths,
                    )
            except Exception as exc:
                action = (
                    'write and commit patch branch'
                    if patch_branch_mode
                    else 'write patch files'
                )
                print(f'ERROR: Failed to {action}: {exc}', file=sys.stderr)
                return 1

            if VERBOSE:
                print(statsline, file=sys.stderr)

            return 0

    if response_format in ("json", "schema"):
        try:
            if not result or not result.strip():
                print("ERROR: LLM returned empty response", file=sys.stderr)
                return 1

            result = clean_json_response(result)
            result = json.loads(result)
        except json.JSONDecodeError as exc:
            print(result)
            if VERBOSE:
                print(statsline, file=sys.stderr)
            print(f"ERROR: Failed to parse JSON: {exc}", file=sys.stderr)
            return 1
        finally:
            result = pretty_json(result)

    if print_reasoning:
        output_str = (
            f"<think>\n{reasoning}\n</think>\n\n"
            f"{result}"
        )
    else:
        output_str = result

    if args.output_file:
        if not stream_output_emitted:
            try:
                args.output_file.parent.mkdir(parents=True, exist_ok=True)
                args.output_file.write_text(output_str, encoding="utf-8")
            except Exception as exc:
                print(f"ERROR: Failed to write output to file {args.output_file}: {exc}", file=sys.stderr)
                print(output_str)
                if VERBOSE:
                    print(statsline, file=sys.stderr)
                return 1
    elif stream_output_emitted:
        if not result or not result.endswith("\n"):
            print()
    else:
        print(output_str)

    if VERBOSE:
        print(statsline, file=sys.stderr)

    if DEBUG:
        print("<debug_response>", file=sys.stderr)
        print(json.dumps(response_obj.model_dump(), indent=2), file=sys.stderr)
        print("</debug_response>", file=sys.stderr)

    return 0


