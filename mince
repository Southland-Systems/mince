def next_state_turn_index(state_session_dir: Path) -> int:
    if not state_session_dir.is_dir():
        return 0
    turn_numbers: list[int] = []
    for entry in state_session_dir.iterdir():
        if not entry.is_dir() or entry.is_symlink():
            continue
        try:
            turn = int(entry.name)
        except ValueError:
            continue
        if turn >= 0:
            turn_numbers.append(turn)
    return max(turn_numbers, default=-1) + 1

def last_completed_state_turn(
    state_session_dir: Path,
    turn: int | None = None,
    required_file: str = "response",
 ) -> Path:
    if not state_session_dir.is_dir():
        raise ValueError(
            f"state session does not exist: {state_session_dir}"
        )
    if turn is not None:
        if turn < 0:
            raise ValueError("session turn must be non-negative")
        turn_dir = state_session_dir / str(turn)
        if (
            not turn_dir.is_dir()
            or turn_dir.is_symlink()
            or not (turn_dir / required_file).is_file()
        ):
            raise ValueError(
                f"state session has no completed turn {turn}: "
                f"{state_session_dir}"
            )
        return turn_dir
    turn_dirs: list[tuple[int, Path]] = []
    for entry in state_session_dir.iterdir():
        if not entry.is_dir() or entry.is_symlink():
            continue
        try:
            turn = int(entry.name)
        except ValueError:
            continue
        if turn >= 0:
            turn_dirs.append((turn, entry))
    for _, turn_dir in sorted(
        turn_dirs, key=lambda item: item[0], reverse=True
    ):
        if (turn_dir / required_file).is_file():
            return turn_dir
    raise ValueError(
        f"state session has no completed turns: {state_session_dir}"
    )

STATE_SESSION_ARTIFACT = "request_files"
STATE_TURN_ARTIFACTS = (
    "request_system_prompt",
    "request_task",
    "response_reasoning",
    "response",
    "response_schema_patch",
    "response_diff_patch",
    "response_schema_patch_applied",
    "response_shell_output",
 )
STATE_ARTIFACT_TYPES = (
    STATE_SESSION_ARTIFACT,
    *STATE_TURN_ARTIFACTS,
 )

def normalize_state_artifact_type(value: str) -> str:
    artifact_type = value.strip()
    if artifact_type not in STATE_ARTIFACT_TYPES:
        choices = ", ".join(STATE_ARTIFACT_TYPES)
        raise ValueError(
            f"unknown state artifact type '{value}'; choose {choices}"
        )
    return artifact_type

def read_state_artifact(path: Path) -> str:
    if path.is_symlink() or not path.is_file():
        raise ValueError(f"state artifact does not exist: {path}")
    try:
        return path.read_text(encoding="utf-8")
    except Exception as exc:
        raise ValueError(f"cannot read state artifact {path} ({exc})") from exc

def state_turn_directory(
    state_session_dir: Path,
    turn: int | None,
 ) -> Path:
    if turn is None:
        return last_completed_state_turn(state_session_dir)
    turn_dir = state_session_dir / str(turn)
    if not turn_dir.is_dir() or turn_dir.is_symlink():
        raise ValueError(
            f"state session has no turn {turn}: {state_session_dir}"
        )
    return turn_dir

def handle_state_print_json(values: list[str]) -> int:
    try:
        if not values:
            print(json.dumps(list(STATE_ARTIFACT_TYPES), indent=2, ensure_ascii=False))
            return 0
        session_name = validate_session_name(values[0])
        state_session_dir = STATE_DIR / session_name
        if not state_session_dir.is_dir() or state_session_dir.is_symlink():
            raise ValueError(f"state session does not exist: {state_session_dir}")

        remaining = list(values[1:])
        requested_turn: int | None = None
        if remaining:
            try:
                requested_turn = int(remaining[0])
            except ValueError:
                pass
        else:
            remaining.pop(0)
            if requested_turn < 0:
                raise ValueError("session turn must be non-negative")

        artifact_types = [
            normalize_state_artifact_type(value)
            for value in remaining
        ]
        if len(set(artifact_types)) != len(artifact_types):
            raise ValueError("state artifact types must be unique")

        turn_artifact_types = [
            artifact_type
            for artifact_type in artifact_types
            if artifact_type != STATE_SESSION_ARTIFACT
        ]
        turn_dir: Path | None = None
        if not artifact_types or turn_artifact_types:
            turn_dir = state_turn_directory(
                state_session_dir, requested_turn
            )

        artifacts: dict[str, str] = {}
        if not artifact_types:
            request_files_path = state_session_dir / STATE_SESSION_ARTIFACT
            if request_files_path.is_file() and not request_files_path.is_symlink():
                artifacts[STATE_SESSION_ARTIFACT] = read_state_artifact(
                    request_files_path
                )
            if turn_dir is not None:
                for artifact_path in sorted(
                    turn_dir.iterdir(), key=lambda path: path.name
                ):
                    if artifact_path.is_file() and not artifact_path.is_symlink():
                        artifacts[artifact_path.name] = read_state_artifact(
                            artifact_path
                        )
        else:
            for artifact_type in artifact_types:
                if artifact_type == STATE_SESSION_ARTIFACT:
                    artifact_path = state_session_dir / artifact_type
                else:
                    if turn_dir is None:
                        raise ValueError(
                            f"state turn is required for artifact {artifact_type}"
                        )
                    artifact_path = turn_dir / artifact_type
                artifacts[artifact_type] = read_state_artifact(artifact_path)

        print(json.dumps(artifacts, indent=2, ensure_ascii=False))
    except Exception as exc:
        print(f"ERROR: Failed to print state JSON: {exc}", file=sys.stderr)
        return 1
    return 0

def file_checksum(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as file:
        for chunk in iter(lambda: file.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()

def load_reused_session_files(
    state_session_dir: Path,
 ) -> list[tuple[str, str]]:
    request_files_path = state_session_dir / "request_files"
    if not request_files_path.is_file():
        raise ValueError(f"state session has no request_files: {state_session_dir}")
    try:
        lines = request_files_path.read_text(encoding="utf-8").splitlines()
    except Exception as exc:
        raise ValueError(
            f"cannot read reused session files {request_files_path} ({exc})"
        ) from exc
    files: list[tuple[str, str]] = []
    for raw_line in lines:
        line = raw_line.strip()
        if not line:
            continue
        path_text, separator, checksum = line.rpartition(" ")
        if (
            not separator
            or not path_text
            or re.fullmatch(r"[0-9a-fA-F]{64}", checksum) is None
        ):
            raise ValueError(
                "reused session request_files entry must contain an "
                f"absolute path followed by a SHA-256 checksum: {line}"
            )
        path = Path(path_text)
        if not path.is_absolute():
            raise ValueError(
                f"reused session request_files contains non-absolute path: {path_text}"
            )
        files.append((str(path), checksum.lower()))
    return files

def verify_reused_session_files(
    file_records: list[tuple[str, str]],
 ) -> None:
    mismatches: list[str] = []
    for path_text, expected_checksum in file_records:
        try:
            current_checksum = file_checksum(Path(path_text))
        except Exception as exc:
            mismatches.append(
                f"{path_text} (cannot read current file for checksum: {exc})"
            )
            continue
        if current_checksum != expected_checksum:
            mismatches.append(
                f"{path_text} (expected {expected_checksum}, "
                f"current {current_checksum})"
            )
    if mismatches:
        raise ValueError(
            "session context checksums do not match current files: "
            + "; ".join(mismatches)
        )

def load_reused_session_patch_history(
    state_session_dir: Path,
    turn: int | None = None,
 ) -> str:
    turn_dir = last_completed_state_turn(state_session_dir, turn)
    response_path = turn_dir / "response"
    request_task_path = turn_dir / "request_task"
    if not request_task_path.is_file():
        raise ValueError(f"completed turn has no request_task: {turn_dir}")
    try:
        previous_task = request_task_path.read_text(encoding="utf-8")
        previous_response = response_path.read_text(encoding="utf-8")
    except Exception as exc:
        raise ValueError(
            f"cannot read reused patch history from {turn_dir} ({exc})"
        ) from exc
    return (
        "<previous_turn>\n"
        "<request_task>\n"
        f"{previous_task}\n"
        "</request_task>\n"
        "<response>\n"
        f"{previous_response}\n"
        "</response>\n"
        "</previous_turn>"
    )

def load_reused_session_shell_history(
    state_session_dir: Path,
    turn: int | None = None,
 ) -> str:
    turn_dir = last_completed_state_turn(state_session_dir, turn)
    request_task_path = turn_dir / "request_task"
    response_path = turn_dir / "response"
    shell_output_path = turn_dir / "response_shell_output"
    if not request_task_path.is_file() or not response_path.is_file():
        raise ValueError(
            f"completed shell turn has no request_task or response: {turn_dir}"
        )
    try:
        previous_task = request_task_path.read_text(encoding="utf-8")
        previous_response = response_path.read_text(encoding="utf-8")
        previous_shell_output = (
            shell_output_path.read_text(encoding="utf-8")
            if shell_output_path.is_file()
            else ""
        )
    except Exception as exc:
        raise ValueError(
            f"cannot read reused shell history from {turn_dir} ({exc})"
        ) from exc
    shell_output_block = (
        f"<shell_output>\n{previous_shell_output}\n</shell_output>\n"
        if previous_shell_output
        else ""
    )
    return (
        "<previous_turn>\n"
        "<request_task>\n"
        f"{previous_task}\n"
        "</request_task>\n"
        "<response>\n"
        f"{previous_response}\n"
        "</response>\n"
        f"{shell_output_block}"
        "</previous_turn>"
    )

def start_state_turn(
    state_session_dir: Path,
    turn: int,
    system_prompt: str,
    task: str,
    file_paths: list[Path],
 ) -> Path:
    turn_dir = state_session_dir / str(turn)
    turn_dir.mkdir(parents=True, exist_ok=True)
    state_files = (
        ("request_system_prompt", system_prompt),
        ("request_task", task),
    )
    for filename, content in state_files:
        (turn_dir / filename).write_text(content, encoding="utf-8")
    request_files_path = state_session_dir / "request_files"
    if not request_files_path.exists():
        request_file_lines: list[str] = []
        for path in file_paths:
            if path == Path("-"):
                continue
            resolved_path = Path(path).resolve()
            request_file_lines.append(
                f"{resolved_path} {file_checksum(resolved_path)}"
            )
        try:
            with request_files_path.open("x", encoding="utf-8") as request_files:
                request_files.write("\n".join(request_file_lines))
        except FileExistsError:
            pass
    return turn_dir

