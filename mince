# -------------------------------------------------------------------
# Main
# -------------------------------------------------------------------

def run_main(cumulative_stats: CumulativeStats) -> int:
    json_schema = None

    global CONFIG_FILE
    global VERBOSE
    global DEBUG
    global NONINTERACTIVE
    global SESSION_NAME
    global OUTPUT_FILE

    SESSION_NAME = None

    ensure_config_exists()

    args = parse_args()
    if args.profile is not None:
        if not args.profile.isidentifier():
            print(f"ERROR: Invalid profile name '{args.profile}'.", file=sys.stderr)
            return 1
        if not get_profile_path(args.profile).is_file():
            print(
                f"ERROR: Profile '{args.profile}' does not exist.",
                file=sys.stderr,
            )
            return 1
    if args.noninteractive:
        args.log = True
        args.quiet = True

    if args.shell_session_print_json is not None:
        return handle_shell_session_print_json(
            args.shell_session_print_json,
            resolve_bool_option(
                args.response_json_repair,
                merged_config(get_profile_path(args.profile or "config")),
                "response_json_repair",
            ),
        )
    if args.state_print_json is not None:
        return handle_state_print_json(args.state_print_json)
    if args.agent_tool_list:
        return handle_agent_tool_list(
            args.agent_profiles, args.agent_profile_default
        )
    ask_mode = args.ask is not None or args.ask_file is not None
    if ask_mode:
        disable_ask_conflicting_options(args)
    elif args.agent:
        disable_patch_shell_conflicting_options(args)

    patch_file_turn: int | None = None
    patch_file_print_turn: int | None = None
    for option_name in ("patch_file_apply", "patch_file_print"):
        option_values = getattr(args, option_name)
        if not isinstance(option_values, list):
            continue
        option_flag = f"--{option_name.replace('_', '-')}"
        if len(option_values) > 2:
            print(
                f"ERROR: {option_flag} accepts SESSION|PATH and optional TURN",
                file=sys.stderr,
            )
            return 1
        parsed_turn: int | None = None
        if len(option_values) == 2:
            try:
                parsed_turn = parse_session_turn(option_values[1], option_flag)
            except ValueError as exc:
                print(f"ERROR: {exc}", file=sys.stderr)
                return 1
        setattr(args, option_name, option_values[0])
        if option_name == "patch_file_apply":
            patch_file_turn = parsed_turn
        else:
            patch_file_print_turn = parsed_turn
    NONINTERACTIVE = args.noninteractive
    if args.noninteractive and (args.init or args.init_profile is not None):
        print(
            "ERROR: --init and --init-profile cannot be used with "
            "--noninteractive",
            file=sys.stderr,
        )
        return 1
    patch_file_option_name: str | None = None
    if args.patch_file_apply is not None:
        patch_file_option_name = "--patch-file-apply"
    if args.patch_file_print is not None:
        if patch_file_option_name is not None:
            print(
                "ERROR: --patch-file-apply cannot be combined with "
                "--patch-file-print",
                file=sys.stderr,
            )
            return 1
        patch_file_option_name = "--patch-file-print"

    if patch_file_option_name is not None:
        patch_file_conflicts = (
            ("--ask", args.ask is not None),
            ("--ask-file", args.ask_file is not None),
            ("--task", args.task is not None),
            ("--task-file", args.task_file is not None),
            ("--files", args.files is not None),
            ("--files-list", args.files_list is not None),
            ("--patch", args.patch is not None),
            ("--plan", args.plan is not None),
            ("--agent", args.agent),
            ("--agent-review", args.agent_review),
            ("--agent-auto", args.agent_auto),
            (
                "--agent-context-expires",
                args.agent_context_expires is not None,
            ),
            (
                "--agent-hook-context",
                args.agent_hook_context is not None,
            ),
            ("--agent-profile", args.agent_profiles is not None),
            (
                "--agent-profile-default",
                args.agent_profile_default is not None,
            ),
            ("--output-file", args.output_file is not None),
            ("--shell", args.shell is not None),
            ("--contain", args.contain is not None),
            ("--shell-networking", args.shell_networking is not None),
            ("--shell-timeout", args.shell_timeout is not None),
            ("--resume-session", args.resume_session is not None),
            ("--tree-files", args.tree_files is not None),
            ("--tree-files-list", args.tree_files_list is not None),
            ("--tree-task", args.tree_task is not None),
            ("--tree-task-file", args.tree_task_file is not None),
            ("--tree-show-only", args.tree_show_only),
            ("--list-models", args.list_models),
            ("--estimate-only", args.estimate_only),
            ("--patch-branch-remove", args.patch_branch_remove is not None),
            ("--patch-merge", args.patch_merge is not None),
            ("--remove-expired-data", args.remove_expired_data is not None),
            ("--log-view", args.log_view is not None),
            ("--patch-view", args.patch_view is not None),
            ("--tree-view", args.tree_view is not None),
            ("--init", args.init),
            ("--init-profile", args.init_profile is not None),
            ("--copy-profile", args.copy_profile is not None),
            ("--inherit-profile", args.inherit_profile is not None),
            ("--remove-profile", args.remove_profile is not None),
            ("--list-profiles", args.list_profiles),
            ("--print-profiles", args.print_profiles is not None),
            ("--print-profiles-json", args.print_profiles_json is not None),
            ("--prompt-list", args.prompt_list),
            ("--prompt-reset-default", args.prompt_reset_default is not None),
            ("--prompt-edit", args.prompt_edit is not None),
            ("--prompt-assign", args.prompt_assign is not None),
            ("--prompt-assign-text", args.prompt_assign_text is not None),
            ("--prompt-assign-replace", args.prompt_assign_replace is not None),
            ("--prompt-unassign", args.prompt_unassign is not None),
            ("--prompt-remove", args.prompt_remove is not None),
            ("--prompt-print", args.prompt_print is not None),
            ("--prompt-print-json", args.prompt_print_json is not None),
            ("--agent-profile-edit", args.agent_profile_edit is not None),
            (
                "--agent-profile-description",
                args.agent_profile_description is not None,
            ),
            ("--agent-profile-type", args.agent_profile_type is not None),
            ("--agent-profile-copy", args.agent_profile_copy is not None),
            ("--agent-profile-rename", args.agent_profile_rename is not None),
            ("--agent-profile-remove", args.agent_profile_remove is not None),
            (
                "--agent-profile-print-json",
                args.agent_profile_print_json is not None,
            ),
            ("--agent-profile-list", args.agent_profile_list),
            ("--set-config", args.set_config is not None),
            ("--set-config-from", args.set_config_from is not None),
            ("--get-config", args.get_config is not None),
            ("--get-config-detail", args.get_config_detail is not None),
            ("--print-default-config", args.print_default_config),
            ("--print-current-config", args.print_current_config),
        )
        conflict = next(
            (name for name, used in patch_file_conflicts if used),
            None,
        )
        if conflict is not None:
            print(
                f"ERROR: {patch_file_option_name} cannot be combined with {conflict}",
                file=sys.stderr,
            )
            return 1

    if args.patch_branch_remove is not None:
        if any(
            value is not None
            for value in (
                args.patch_merge,
                args.patch_branch,
                args.ask,
                args.ask_file,
                args.task,
                args.task_file,
                args.patch,
            )
        ):
            print(
                'ERROR: --patch-branch-remove cannot be combined with '
                'patch, ask, task, or another patch branch option',
                file=sys.stderr,
            )
            return 1
        try:
            remove_branch_name = resolve_patch_branch_name(
                args.patch_branch_remove
            )
        except ValueError as exc:
            print(f'ERROR: {exc}', file=sys.stderr)
            return 1
        return handle_patch_branch_remove(remove_branch_name)

    if args.patch_merge is not None:
        try:
            if git_repository_root() is None:
                raise ValueError('not inside a git worktree')
        except (OSError, ValueError) as exc:
            print(f'ERROR: {exc}', file=sys.stderr)
            return 1
        if any(
            value is not None
            for value in (
                args.ask,
                args.ask_file,
                args.shell,
                args.task,
                args.task_file,
                args.patch,
            )
        ):
            print(
                'ERROR: --patch-merge cannot be combined with ask, task, or --patch',
                file=sys.stderr,
            )
            return 1
        try:
            merge_branch_name = resolve_patch_branch_name(args.patch_branch)
            merge_commit_message = ' '.join(args.patch_merge).strip()
            if not merge_commit_message:
                raise ValueError('--patch-merge commit message cannot be empty')
        except ValueError as exc:
            print(f'ERROR: {exc}', file=sys.stderr)
            return 1
        return handle_patch_merge(merge_branch_name, merge_commit_message)

    resume_session_turn: int | None = None
    if isinstance(args.resume_session, list):
        if len(args.resume_session) > 2:
            print(
                "ERROR: --resume-session accepts SESSION_NAME and optional TURN",
                file=sys.stderr,
            )
            return 1
        if len(args.resume_session) == 2:
            try:
                resume_session_turn = parse_session_turn(
                    args.resume_session[1], "--resume-session"
                )
            except ValueError as exc:
                print(f"ERROR: {exc}", file=sys.stderr)
                return 1
        args.resume_session = args.resume_session[0]

    if args.remove_expired_data is not None:
        return handle_remove_expired_data(args.remove_expired_data)

    if args.log_view is not None:
        return handle_session_view("log", args.log_view)
    if args.patch_view is not None:
        return handle_session_view("patch", args.patch_view)
    if args.tree_view is not None:
        return handle_session_view("tree", args.tree_view)

    if args.quiet:
        VERBOSE = 0

    if args.debug:
        DEBUG = 1

    if args.init:
        init_config_interactive()
        return 0

    base_profile = args.profile or "config"

    if args.agent_profile_list:
        return handle_agent_profile_list()
    if args.agent_profile_print_json is not None:
        return handle_agent_profile_print_json(args.agent_profile_print_json)
    if args.agent_profile_edit is not None:
        return handle_agent_profile_edit(args.agent_profile_edit)
    if args.agent_profile_description is not None:
        return handle_agent_profile_edit(
            args.agent_profile_description,
            edit_description=True,
        )
    if args.agent_profile_type is not None:
        return handle_agent_profile_type(args.agent_profile_type)
    if args.agent_profile_copy is not None:
        return handle_agent_profile_transfer(args.agent_profile_copy)
    if args.agent_profile_rename is not None:
        return handle_agent_profile_transfer(
            args.agent_profile_rename,
            rename=True,
        )
    if args.agent_profile_remove is not None:
        return handle_agent_profile_remove(args.agent_profile_remove)

    if args.prompt_list:
        return handle_prompt_list()
    if args.prompt_reset_default is not None:
        return handle_prompt_reset_default(args.prompt_reset_default)
    if args.prompt_print_json is not None:
        return handle_prompt_print(args.prompt_print_json, json_output=True)
    if args.prompt_print is not None:
        return handle_prompt_print(args.prompt_print)
    if args.prompt_edit is not None:
        return handle_prompt_edit(args.prompt_edit)
    if args.prompt_assign is not None:
        return handle_prompt_assign(args.prompt_assign, base_profile)
    if args.prompt_assign_text is not None:
        return handle_prompt_assign(
            args.prompt_assign_text, base_profile, "string"
        )
    if args.prompt_assign_replace is not None:
        return handle_prompt_assign(
            args.prompt_assign_replace, base_profile, "replace"
        )
    if args.prompt_unassign is not None:
        return handle_prompt_unassign(args.prompt_unassign, base_profile)
    if args.prompt_remove is not None:
        return handle_prompt_remove(args.prompt_remove)


    if args.list_profiles:
        for name in sorted(configuration_profile_names()):
            print(name)
        return 0

    if args.print_profiles is not None:
        return handle_show_profiles(args.print_profiles)
    if args.print_profiles_json is not None:
        return handle_show_profiles(
            args.print_profiles_json,
            json_output=True,
        )

    if args.init_profile:
        new_name = args.init_profile
        if not new_name.isidentifier():
            print(f"ERROR: Invalid profile name '{new_name}'.", file=sys.stderr)
            return 1
        CONFIG_FILE = get_profile_path(new_name)
        init_config_interactive()
        return 0

    if args.inherit_profile:
        return handle_inherit_profile(base_profile, args.inherit_profile)

    if args.copy_profile:
        new_name = args.copy_profile
        if new_name == "config":
            print("ERROR: Cannot copy to profile name 'config'.", file=sys.stderr)
            return 1
        if not new_name.isidentifier():
            print(f"ERROR: Invalid profile name '{new_name}'.", file=sys.stderr)
            return 1
        src_path = get_profile_path(base_profile)
        dst_path = get_profile_path(new_name)
        if not src_path.exists():
            print(f"ERROR: Source profile '{base_profile}' does not exist.", file=sys.stderr)
            return 1
        if dst_path.exists():
            print(f"ERROR: Destination profile '{new_name}' already exists.", file=sys.stderr)
            return 1
        try:
            dst_path.write_text(src_path.read_text(encoding="utf-8"), encoding="utf-8")
        except Exception as exc:
            print(f"ERROR: Failed to copy profile: {exc}", file=sys.stderr)
            return 1
        print(f"Profile '{base_profile}' copied to '{new_name}'.")
        return 0

    if args.remove_profile:
        name = args.remove_profile
        if name == "config":
            print("ERROR: Cannot remove the default 'config' profile.", file=sys.stderr)
            return 1
        if not name.isidentifier():
            print(f"ERROR: Invalid profile name '{name}'.", file=sys.stderr)
            return 1
        path = get_profile_path(name)
        if not path.exists():
            print(f"ERROR: Profile '{name}' does not exist.", file=sys.stderr)
            return 1
        try:
            path.unlink()
        except Exception as exc:
            print(f"ERROR: Failed to remove profile: {exc}", file=sys.stderr)
            return 1
        print(f"Profile '{name}' removed.")
        return 0

    CONFIG_FILE = get_profile_path(base_profile)
    if args.patch_file_print is not None:
        return handle_patch_file_print(
            args.patch_file_print,
            patch_turn=patch_file_print_turn,
        )
    if args.patch_file_apply is not None:
        patch_config = load_config()
        return handle_patch_file_apply(
            args.patch_file_apply,
            patch_config,
            patch_turn=patch_file_turn,
            patch_review_argument=args.patch_review,
            patch_suffix_argument=args.patch_suffix,
            patch_branch_argument=args.patch_branch,
        )
    if args.set_config_from:
        name, source_profile = args.set_config_from
        try:
            name = name.strip()
            if not name:
                raise ValueError("configuration name cannot be empty")
            if name == INHERIT_PROFILE_CONFIG_KEY:
                raise ValueError(
                    f"{INHERIT_PROFILE_CONFIG_KEY} is managed by --inherit-profile"
                )
            source_profile = validate_prompt_profile_name(source_profile)
            source_config = read_config_document(
                get_profile_path(source_profile)
            )
            if name in source_config:
                value = source_config[name]
            else:
                replacement = DEPRECATED_CONFIG_KEYS.get(name)
                if replacement is None or replacement not in source_config:
                    raise ValueError(
                        f"configuration value '{name}' does not exist in "
                        f"profile '{source_profile}'"
                    )
                value = source_config[replacement]

            config = load_config()
            config[name] = value
            replacement = DEPRECATED_CONFIG_KEYS.get(name)
            if replacement is not None:
                config[replacement] = value
            save_config(config)
        except Exception as exc:
            print(
                f"ERROR: Failed to set configuration from profile: {exc}",
                file=sys.stderr,
            )
            return 1
        return 0

    if args.set_config:
        config = load_config()
        try:
            raw_config = read_config_document(CONFIG_FILE, missing_ok=True)
            inherited_parent = _inherit_profile_name(raw_config, CONFIG_FILE)
            updates: list[tuple[str, Any, bool]] = []
            for assignment in args.set_config:
                if inherited_parent is not None and "=" in assignment:
                    raw_name, raw_value = assignment.split("=", 1)
                    name = raw_name.strip()
                    if raw_value.strip() == "DEFAULT":
                        if not name:
                            raise ValueError(
                                "configuration name cannot be empty"
                            )
                        canonical_name = DEPRECATED_CONFIG_KEYS.get(name) or name
                        if canonical_name == INHERIT_PROFILE_CONFIG_KEY:
                            raise ValueError(
                                f"{INHERIT_PROFILE_CONFIG_KEY} is managed by "
                                "--inherit-profile"
                            )
                        if name in DEPRECATED_CONFIG_KEYS and name not in config:
                            raise ValueError(
                                f"{name} is deprecated and is not present in the config"
                            )
                        if (
                            name not in config
                            and canonical_name not in config
                        ):
                            raise ValueError(
                                f"{name} has no built-in default value"
                            )
                        updates.append((name, None, True))
                        continue
                name, value = parse_config_assignment(assignment, config)
                updates.append((name, value, False))
        except ValueError as exc:
            print(f"ERROR: Invalid config assignment: {exc}", file=sys.stderr)
            return 1

        if inherited_parent is not None:
            for name, value, remove_from_child in updates:
                canonical_name = DEPRECATED_CONFIG_KEYS.get(name) or name
                if remove_from_child:
                    raw_config.pop(name, None)
                    raw_config.pop(canonical_name, None)
                    for deprecated, replacement in DEPRECATED_CONFIG_KEYS.items():
                        if replacement == canonical_name:
                            raw_config.pop(deprecated, None)
                    continue
                raw_config[name] = value
                replacement = DEPRECATED_CONFIG_KEYS.get(name)
                if replacement is not None:
                    raw_config[replacement] = value
            migrate_deprecated_config(raw_config)
            raw_config = _prune_inherited_config(
                raw_config, inherited_parent
            )
            write_json_document(CONFIG_FILE, raw_config)
        else:
            for name, value, _ in updates:
                config[name] = value
                replacement = DEPRECATED_CONFIG_KEYS.get(name)
                if replacement is not None:
                    config[replacement] = value
            save_config(config)
        return 0

    if args.get_config is not None or args.get_config_detail is not None:
        config = load_config()
        detail_requested = args.get_config_detail is not None
        requested_name = (
            args.get_config_detail
            if detail_requested
            else args.get_config
        )
        name = str(requested_name or "").strip()
        if name:
            if name not in config:
                print(f"ERROR: Configuration value '{name}' does not exist.", file=sys.stderr)
                return 1
            items = ((name, config[name]),)
        else:
            items = config.items()

        inherited_names = inherited_config_names(CONFIG_FILE)
        if detail_requested:
            try:
                output_lines = [
                    format_config_detail_line(
                        config_name,
                        value,
                        config,
                        inherited=config_name in inherited_names,
                    )
                    for config_name, value in items
                ]
            except Exception as exc:
                print(
                    f"ERROR: Failed to get config detail: {exc}",
                    file=sys.stderr,
                )
                return 1
        else:
            output_lines = [
                format_config_line(
                    config_name,
                    value,
                    inherited=config_name in inherited_names,
                )
                for config_name, value in items
            ]
        for output_line in output_lines:
            print(output_line)
        return 0

    if args.print_default_config:
        print(json.dumps(DEFAULT_CONFIG, indent=2, ensure_ascii=False))
        return 0

    if args.print_current_config:
        ensure_config_exists()
        try:
            current_config = read_config_document(CONFIG_FILE)
            current_config["api_key"] = mask_api_key(current_config.get("api_key", ""))
            print(json.dumps(current_config, indent=2, ensure_ascii=False))
        except Exception as exc:
            print(f"ERROR: Unable to read config file: {exc}", file=sys.stderr)
            return 1
        return 0

    tree_mode = (
        args.tree_files is not None or args.tree_files_list is not None
    )

    tree_exclude_git = (
        args.tree_exclude_git
        if args.tree_exclude_git is not None
        else True
    )
    tree_option_used = any(
        value is not None
        for value in (
            args.tree_task,
            args.tree_task_file,
            args.tree_system_prompt_file,
            args.tree_exclude,
            args.tree_include,
            args.tree_exclude_git,
            args.tree_parallel,
        )
    ) or args.tree_show_only
    file_names: list[str] = []
    tree_task_prompts: tuple[dict[str, str], str | None, str | None] = ({}, None, None)

    if tree_mode:
        if ask_mode or args.task is not None or args.task_file is not None or args.files is not None or args.files_list is not None:
            print("ERROR: tree mode cannot be combined with regular task, ask, or file options", file=sys.stderr)
            return 1
        if not args.tree_show_only and args.tree_task is None and args.tree_task_file is None:
            print("ERROR: tree mode requires --tree-task or --tree-task-file", file=sys.stderr)
            return 1
        if args.tree_show_only:
            task = ""
        elif args.tree_task is not None:
            task = read_prompt_argument(args.tree_task)
        else:
            try:
                tree_task_prompts = read_tree_prompt_file(args.tree_task_file)
            except ValueError as exc:
                print(f"ERROR: {exc}", file=sys.stderr)
                return 1
            task = ""
    elif tree_option_used:
        print("ERROR: tree options require --tree-files or --tree-files-list", file=sys.stderr)
        return 1
    elif not ask_mode and not args.list_models:
        if args.task:
            task = read_prompt_argument(args.task)
        elif args.task_file:
            task = read_prompt_files(args.task_file)
        elif args.resume_session is not None:
            task = ""
        else:
            print("ERROR: --ask or --task required (--help for help)", file=sys.stderr)
            return 1

        if args.files_list:
            try:
                file_names = read_files_list(args.files_list)
            except ValueError as exc:
                print(f"ERROR: {exc}", file=sys.stderr)
                return 1
        elif args.files:
            file_names = args.files

    else:
        task = ""

    if tree_mode and args.tree_show_only:
        try:
            tree_file_paths, _ = resolve_tree_file_paths(
                args, tree_exclude_git
            )
        except ValueError as exc:
            print(f"ERROR: {exc}", file=sys.stderr)
            return 1

        for tree_file_path in tree_file_paths:
            print(tree_file_path)
        return 0

    config = load_config()
    patch_mode = resolve_bool_option(
        args.patch,
        config,
        'patch',
    )
    shell_mode = resolve_bool_option(
        args.shell,
        config,
        'shell',
    )
    shell_networking = resolve_bool_option(
        args.shell_networking,
        config,
        'shell_networking',
    )
    try:
        contain = (
            tuple(path.expanduser().resolve() for path in args.contain)
            if args.contain is not None
